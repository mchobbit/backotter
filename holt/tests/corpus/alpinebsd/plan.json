  "text": "# bko-holt load plan for layout.json\n# Source: alpinebsd, AlpineBSD v1.0, UEFI boot with netbsd, dumped 2026-11-08T02:43:07Z\n#\n# Disks:\n#   ld0 (16 GiB) -> /dev/sdq\n#\n# Notes:\n#   - dk0: the ESP, written as the source's with the partition table\n\n# ---- partition ----\n# ld0 -> /dev/sdq: the source's table, GUIDs and boot code exactly\nsh -c 'bko-holt write-table layout.json ld0 /dev/rsdqd $(disklabel sdq | awk '\\''/^bytes.sector:/ { b = $2 } /^total sectors:/ { t = $3 } END { print b * t }'\\'')'\n# the GPT's partitions as wedges\nsh -c 'dkctl sdq listwedges | grep -q '\\''^dk'\\'' || dkctl sdq makewedges'\n\n# ---- assemble ----\n# (nothing to do)\n\n# ---- format ----\n# dk2: UFS as the source's (dumpfs -m)\nnewfs -O 2ea -b 16384 -f 2048 -n 1654272 -m 5 -o time NAME=AlpineBSD\n\n# ---- mount ----\nmkdir -p /mnt/bko-target\nmount -t ffs -o rw,log NAME=AlpineBSD /mnt/bko-target\n\n# ---- restore ----\n# snapshot latest of /srv/bko-repo, with BackOtter's restore flags\nRUSTIC_STRICT_EXIT=true rustic-bko --repository /srv/bko-repo --no-progress restore --numeric-id --glob '!/.bko-holt/system.json' --glob '!/.bko-holt' latest /mnt/bko-target\n\n# ---- boot ----\n# the boot code (MBR, freebsd-boot) was written with the partition table\n# the ESP's loader (BOOTX64.EFI), as the source's\nsh -c 'mkdir -p /run/bko-holt/esp && mount -t msdos NAME=EFI /run/bko-holt/esp && mkdir -p /run/bko-holt/esp/EFI/BOOT && cp /usr/mdec/bootx64.efi /run/bko-holt/esp/EFI/BOOT/BOOTX64.EFI; s=$?; umount /run/bko-holt/esp; exit $s'\nmkdir -p /mnt/bko-target/var/log/bko-holt\n# this restore's log, on the restored system\ncp -Rp /run/bko-holt/log/. /mnt/bko-target/var/log/bko-holt/\n\n# ---- close ----\n# everything under the target, deepest first\nsh -c 'mount | sed -n '\\''s/^.* on \\(.*\\) type .*/\\1/p'\\'' | awk '\\''$0 == \"/mnt/bko-target\" || index($0, \"/mnt/bko-target/\") == 1'\\'' | sort -r | while read -r m; do umount \"$m\" || exit; done'\n\n# Nothing was written.  To run it: bko-holt load layout.json ... --through close --commit\n"
