  "text": "# bko-holt load plan for layout.json\n# Source: host1, FreeBSD 15.1-RELEASE-p6, BIOS boot with freebsd, dumped 2026-11-08T02:46:33Z\n#\n# Disks:\n#   vtbd0 (16 GiB) -> /dev/sdq\n\n# ---- partition ----\n# vtbd0 -> /dev/sdq: the source's table, GUIDs and boot code exactly\nsh -c 'bko-holt write-table layout.json vtbd0 /dev/sdq $(diskinfo /dev/sdq | cut -f3)'\ngpart show sdq\n\n# ---- assemble ----\n# ZFS pool zroot, with the source's feature flags only; its vdevs' ashift 12, as the source's\nsh -c 'old=$(sysctl -n vfs.zfs.min_auto_ashift); sysctl vfs.zfs.min_auto_ashift=12 >/dev/null; zpool create -f -d -o cachefile=none -o feature@async_destroy=enabled -o feature@empty_bpobj=enabled -o feature@lz4_compress=enabled -o feature@multi_vdev_crash_dump=enabled -o feature@spacemap_histogram=enabled -o feature@enabled_txg=enabled -o feature@hole_birth=enabled -o feature@extensible_dataset=enabled -o feature@embedded_data=enabled -o feature@bookmarks=enabled -o feature@filesystem_limits=enabled -o feature@large_blocks=enabled -o feature@large_dnode=enabled -o feature@sha512=enabled -o feature@skein=enabled -o feature@edonr=enabled -o feature@userobj_accounting=enabled -o feature@encryption=enabled -o feature@project_quota=enabled -o feature@device_removal=enabled -o feature@obsolete_counts=enabled -o feature@zpool_checkpoint=enabled -o feature@spacemap_v2=enabled -o feature@allocation_classes=enabled -o feature@resilver_defer=enabled -o feature@bookmark_v2=enabled -o feature@redaction_bookmarks=enabled -o feature@redacted_datasets=enabled -o feature@bookmark_written=enabled -o feature@log_spacemap=enabled -o feature@livelist=enabled -o feature@device_rebuild=enabled -o feature@zstd_compress=enabled -o feature@draid=enabled -o feature@zilsaxattr=enabled -o feature@head_errlog=enabled -o feature@blake3=enabled -o feature@block_cloning=enabled -o feature@vdev_zaps_v2=enabled -o feature@redaction_list_spill=enabled -o feature@raidz_expansion=enabled -o feature@fast_dedup=enabled -o feature@longname=enabled -o feature@large_microzap=enabled -o feature@dynamic_gang_header=enabled -o feature@block_cloning_endian=enabled -o feature@physical_rewrite=enabled -O mountpoint=/zroot -O compression=on -O atime=off -R /mnt/bko-target zroot /dev/sdqp3; s=$?; sysctl vfs.zfs.min_auto_ashift=$old >/dev/null; exit $s'\n# the source pool's GUID (vdev GUIDs can't be kept)\nzpool reguid -g 1000000000000000001 zroot\n# mount mounts every dataset in order\nsh -c '[ \"$(zfs get -H -o value mounted zroot)\" != yes ] || zfs unmount zroot'\n\n# ---- format ----\nzfs create -u -o mountpoint=none zroot/ROOT\nzfs create -u -o mountpoint=/ -o canmount=noauto zroot/ROOT/default\nzfs create -u -o mountpoint=/home zroot/home\nzfs create -u -o mountpoint=/tmp -o exec=on -o setuid=off zroot/tmp\nzfs create -u -o mountpoint=/usr -o canmount=off zroot/usr\nzfs create -u -o setuid=off zroot/usr/ports\nzfs create -u zroot/usr/src\nzfs create -u -o mountpoint=/var -o canmount=off zroot/var\nzfs create -u -o exec=off -o setuid=off zroot/var/audit\nzfs create -u -o exec=off -o setuid=off zroot/var/crash\nzfs create -u -o exec=off -o setuid=off zroot/var/log\nzfs create -u -o atime=on zroot/var/mail\nzfs create -u -o setuid=off zroot/var/tmp\nzpool set bootfs=zroot/ROOT/default zroot\n\n# ---- mount ----\nzfs mount zroot/ROOT/default\nzfs mount zroot/home\nzfs mount zroot/tmp\nzfs mount zroot\nzfs mount zroot/usr/ports\nzfs mount zroot/usr/src\nzfs mount zroot/var/audit\nzfs mount zroot/var/crash\nzfs mount zroot/var/log\nzfs mount zroot/var/mail\nzfs mount zroot/var/tmp\n\n# ---- restore ----\n# snapshot latest of /srv/bko-repo, with BackOtter's restore flags\nRUSTIC_STRICT_EXIT=true rustic-bko --repository /srv/bko-repo --no-progress restore --numeric-id latest /mnt/bko-target\n\n# ---- boot ----\n# the boot code (MBR, freebsd-boot) was written with the partition table\n# the restored system's zpool.cache names the new pool\nsh -c 'for c in /etc/zfs/zpool.cache /boot/zfs/zpool.cache; do [ -f /mnt/bko-target$c ] && zpool set cachefile=/mnt/bko-target$c zroot; done; true'\nmkdir -p /mnt/bko-target/var/log/bko-holt\n# this restore's log, on the restored system\ncp -Rp /run/bko-holt/log/. /mnt/bko-target/var/log/bko-holt/\n\n# ---- close ----\n# everything under the target, deepest first\nsh -c 'mount -p | awk '\\''{ print $2 }'\\'' | awk '\\''$0 == \"/mnt/bko-target\" || index($0, \"/mnt/bko-target/\") == 1'\\'' | sort -r | while read -r m; do umount \"$m\" || exit; done'\nzpool export zroot\n\n# Nothing was written.  To run it: bko-holt load layout.json ... --through close --commit\n"
}

