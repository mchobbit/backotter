  "text": "# bko-holt load plan for layout.json\n# Source: host-1, Guix System, UEFI boot with grub, dumped 2026-11-24T14:10:47Z\n#\n# Disks:\n#   vda (20 GiB) -> /dev/sdq\n#\n# Notes:\n#   - Guix System: each generation's kernel and initrd are store items, restored with /, where grub.cfg names them; nothing to rebuild\n#   - Guix System: UEFI GRUB's EFI image came back with the ESP, and grub.cfg (which names each generation's kernel and initrd in the store) with /; only the boot entry is made, and the image's prefix set to /boot's partition number where it names one\n\n# ---- partition ----\n# vda -> /dev/sdq: clear the old table and signatures\nwipefs --all /dev/sdq\n# /dev/sdq: its first 4 MiB zeroed, and its last 1 MiB (a GPT's backup, md 0.90/1.0 superblocks, ZFS's end labels)\ndd if=/dev/zero of=/dev/sdq bs=1M count=4 conv=fsync\nsh -c 'n=$(blockdev --getsz /dev/sdq) && dd if=/dev/zero of=/dev/sdq bs=512 seek=$((n - 2048)) count=2048 conv=fsync'\n# the new partitions' old content zeroed through /dev/sdq, before its table names them (blocks of 512 bytes, at their start= sectors)\n# vda1: its first 4 MiB and its last 1 MiB\ndd if=/dev/zero of=/dev/sdq bs=512 seek=2048 count=8192 conv=fsync\ndd if=/dev/zero of=/dev/sdq bs=512 seek=1048576 count=2048 conv=fsync\n# vda2: its first 4 MiB and its last 1 MiB\ndd if=/dev/zero of=/dev/sdq bs=512 seek=1050624 count=8192 conv=fsync\ndd if=/dev/zero of=/dev/sdq bs=512 seek=5242880 count=2048 conv=fsync\n# vda3: its first 4 MiB and its last 1 MiB\ndd if=/dev/zero of=/dev/sdq bs=512 seek=5244928 count=8192 conv=fsync\ndd if=/dev/zero of=/dev/sdq bs=512 seek=41938944 count=2048 conv=fsync\n# udev done with /dev/sdq before sfdisk takes it\nudevadm settle\nsfdisk --wipe always --wipe-partitions always /dev/sdq <<'EOF'\nlabel: gpt\nlabel-id: bc000000-0000-4000-8000-000000000001\nunit: sectors\nsector-size: 512\ntable-length: 128\nfirst-lba: 2048\nlast-lba: 41943006\n\n/dev/sdq1 : start=2048, size=1048576, type=C12A7328-F81F-11D2-BA4B-00A0C93EC93B, uuid=BC000000-0000-4000-8000-000000000002, name=\"esp\"\n/dev/sdq2 : start=1050624, size=4194304, type=0657FD6D-A4AB-43C4-84E5-0933C84B4F4F, uuid=BC000000-0000-4000-8000-000000000003, name=\"swap\"\n/dev/sdq3 : start=5244928, size=36696064, type=0FC63DAF-8483-4772-8E79-3D69D8477DE4, uuid=BC000000-0000-4000-8000-000000000005, name=\"root\"\nEOF\nudevadm settle\n\n# ---- assemble ----\nmkdir -p -m 700 /run/bko-holt/keys\n# LUKS1 on /dev/sdq3: a volume key for luksFormat, so that its digest can be made with the source's 394795 iterations; removed once it is\ndd if=/dev/urandom of=/run/bko-holt/keys/cryptroot.volume-key bs=64 count=1 status=none\n# LUKS1 on /dev/sdq3: asks for the new passphrase\ncryptsetup luksFormat --batch-mode --type=luks1 --volume-key-file=/run/bko-holt/keys/cryptroot.volume-key --cipher=aes-xts-plain64 --key-size=512 --hash=sha256 --offset=4096 --pbkdf-force-iterations=6297752 --uuid=bc000000-0000-4000-8000-000000000006 /dev/sdq3\n# LUKS1 on /dev/sdq3: the volume key digest with the source's 394795 iterations (luksFormat's own count is 1000)\nbko-holt luks1-digest /dev/sdq3 /run/bko-holt/keys/cryptroot.volume-key 394795\nrm -f /run/bko-holt/keys/cryptroot.volume-key\ncryptsetup open /dev/sdq3 cryptroot\n\n# ---- format ----\n# vda1: vfat \"ESP\"\nmkfs.fat -F 32 -i BC000001 -n ESP -S 512 -s 8 -f 2 -R 32 -h 2048 /dev/sdq1\n# check: /dev/sdq1 is vfat with the source's FAT size, sector and cluster size (read back by bko-holt's own probe)\n# vda2: swap \"swap\"\nmkswap -U bc000000-0000-4000-8000-000000000004 -L swap --pagesize 4096 /dev/sdq2\n# check: /dev/sdq2 is swap with the source's UUID, label and page size (read back by bko-holt's own probe)\n# dm-0: btrfs \"label1\"\nmkfs.btrfs -f -O extref,skinny-metadata,no-holes,^raid56,^raid1c34,^zoned,^squota,free-space-tree,^block-group-tree -U bc000000-0000-4000-8000-000000000007 -L label1 --csum crc32c -n 16384 -s 4096 -d single -m dup --device-uuid bc000000-0000-4000-8000-000000000008 /dev/mapper/cryptroot\n# check: /dev/mapper/cryptroot is btrfs with the source's features (read back by bko-holt's own probe)\nmkdir -p /run/bko-holt/btrfs/bc000000-0000-4000-8000-000000000007\n# btrfs bc000000-0000-4000-8000-000000000007: its subvolumes\nmount -t btrfs -o subvolid=5 /dev/mapper/cryptroot /run/bko-holt/btrfs/bc000000-0000-4000-8000-000000000007\nbtrfs subvolume create /run/bko-holt/btrfs/bc000000-0000-4000-8000-000000000007/@\nbtrfs subvolume create /run/bko-holt/btrfs/bc000000-0000-4000-8000-000000000007/@home\nbtrfs subvolume create /run/bko-holt/btrfs/bc000000-0000-4000-8000-000000000007/@gnu\numount /run/bko-holt/btrfs/bc000000-0000-4000-8000-000000000007\n\n# ---- mount ----\nmkdir -p /mnt/bko-target\nmount -t btrfs -o subvol=@ /dev/mapper/cryptroot /mnt/bko-target\nmkdir -p /mnt/bko-target/gnu\nmount -t btrfs -o subvol=@gnu,compress=zstd /dev/mapper/cryptroot /mnt/bko-target/gnu\nmkdir -p /mnt/bko-target/home\nmount -t btrfs -o subvol=@home /dev/mapper/cryptroot /mnt/bko-target/home\nmkdir -p /mnt/bko-target/boot/efi\n# tz=UTC: the source's vfat kept /boot/efi's FAT local-time stamps as UTC (sys_tz tz_minuteswest 0), whatever the rescue's kernel time zone; the restore and the boot stage write through this mount\nmount -t vfat -o tz=UTC /dev/sdq1 /mnt/bko-target/boot/efi\n\n# ---- restore ----\n# snapshot latest of /srv/bko-repo, with BackOtter's restore flags\nRUSTIC_STRICT_EXIT=true rustic-bko --repository /srv/bko-repo --no-progress restore --numeric-id latest /mnt/bko-target\n# the atimes the restore set, for boot to put back after its reads\nsh -c 'mkdir -p -m 700 /run/bko-holt && find /mnt/bko-target \\( -path /mnt/bko-target/dev -o -path /mnt/bko-target/proc -o -path /mnt/bko-target/sys -o -path /mnt/bko-target/run \\) -prune -o -printf '\\''%A@\\t%p\\0'\\'' | LC_ALL=C sort -z > /run/bko-holt/atimes.before'\n\n# ---- boot ----\n# refuses to start unless /mnt/bko-target/etc/fstab is the restored system's (its / matches the layout's)\n# the restored atimes (the restore stage lists them), to put back after this stage's reads\nsh -c '[ -s /run/bko-holt/atimes.before ] || { mkdir -p -m 700 /run/bko-holt && find /mnt/bko-target \\( -path /mnt/bko-target/dev -o -path /mnt/bko-target/proc -o -path /mnt/bko-target/sys -o -path /mnt/bko-target/run \\) -prune -o -printf '\\''%A@\\t%p\\0'\\'' | LC_ALL=C sort -z > /run/bko-holt/atimes.before; }'\n# the restored LVM devices file, kept\nsh -c 'rm -rf /run/bko-holt/lvm-devices; [ ! -d /mnt/bko-target/etc/lvm/devices ] || { cp -a /mnt/bko-target/etc/lvm/devices /run/bko-holt/lvm-devices && touch -r /mnt/bko-target/etc/lvm /run/bko-holt/lvm-devices.parent; }'\nmount --rbind --make-rslave /dev /mnt/bko-target/dev\nmount --rbind --make-rslave /proc /mnt/bko-target/proc\nmount --rbind --make-rslave /sys /mnt/bko-target/sys\nmount --rbind --make-rslave /run /mnt/bko-target/run\n# NVRAM's entries for this partition and loader, from an earlier restore here, deleted\nbko-holt efi-dedupe /dev/sdq 1 '\\EFI\\Guix\\grubx64.efi'\nefibootmgr --quiet --create --disk /dev/sdq --part 1 --label Guix --loader '\\EFI\\Guix\\grubx64.efi'\nmkdir -p /mnt/bko-target/var/log/bko-holt\n# this restore's log, on the restored system\ncp -a /run/bko-holt/log/. /mnt/bko-target/var/log/bko-holt/\numount --recursive /mnt/bko-target/run\numount --recursive /mnt/bko-target/sys\numount --recursive /mnt/bko-target/proc\numount --recursive /mnt/bko-target/dev\n# the restored LVM devices file, put back\nsh -c '[ ! -d /run/bko-holt/lvm-devices ] || { rm -rf /mnt/bko-target/etc/lvm/devices && cp -a /run/bko-holt/lvm-devices /mnt/bko-target/etc/lvm/devices && touch -r /run/bko-holt/lvm-devices.parent /mnt/bko-target/etc/lvm; }'\n# the atimes this stage's reads changed, put back\nbash -c 'find /mnt/bko-target \\( -path /mnt/bko-target/dev -o -path /mnt/bko-target/proc -o -path /mnt/bko-target/sys -o -path /mnt/bko-target/run \\) -prune -o -printf '\\''%A@\\t%p\\0'\\'' | LC_ALL=C sort -z > /run/bko-holt/atimes.after && LC_ALL=C comm -z -23 /run/bko-holt/atimes.before /run/bko-holt/atimes.after | \\\n             while IFS=$'\\''\\t'\\'' read -r -d '\\'''\\'' a p; do [ -L \"$p\" ] || [ -e \"$p\" ] || continue; touch -a -h -d \"@$a\" -- \"$p\" 2>/dev/null || { [ ! -L \"$p\" ] && lsattr -d -- \"$p\" 2>/dev/null | cut -d'\\'' '\\'' -f1 | grep -q i && { chattr -i -- \"$p\"; touch -a -h -d \"@$a\" -- \"$p\"; chattr +i -- \"$p\"; }; }; done'\n\n# ---- close ----\numount --recursive /mnt/bko-target\n# other mount namespaces' copies of the target's mounts\nsh -c 'me=$(readlink /proc/self/ns/mnt); seen=\" $me \"; at() { awk -v t=/mnt/bko-target '\\''{ m = $5; if (m == t || length(m) > length(t) && substr(m, length(m) - length(t) + 1) == t) print m }'\\''; }; for f in /proc/[0-9]*/mountinfo; do grep -q '\\''/mnt/bko-target[ /]'\\'' \"$f\" 2>/dev/null || continue; p=${f#/proc/}; p=${p%/mountinfo}; ns=$(readlink /proc/$p/ns/mnt) || continue; case $seen in *\" $ns \"*) continue;; esac; seen=\"$seen$ns \"; echo \"unmounting /mnt/bko-target in $ns (pid $p, $(cat /proc/$p/comm))\"; for m in $(at <\"$f\"); do nsenter -t \"$p\" -m umount --recursive \"$m\" || true; done; done; awk '\\''{ for (i = 7; i < NF; i++) if ($i == \"-\") { if ($(i + 1) == \"nsfs\" && $4 ~ /^mnt:\\[/) print $4, $5; break } }'\\'' /proc/self/mountinfo | while read -r ns b; do case $seen in *\" $ns \"*) continue;; esac; seen=\"$seen$ns \"; ms=$(nsenter --mount=\"$b\" cat /proc/self/mountinfo | at); [ -n \"$ms\" ] || continue; echo \"unmounting /mnt/bko-target in $ns (bound at $b)\"; for m in $ms; do nsenter --mount=\"$b\" umount --recursive \"$m\" || true; done; done'\nsh -c 'i=0; until udevadm settle; cryptsetup close cryptroot; do i=$((i + 1)); [ $i -lt 5 ] || exit 1; sleep 1; done'\n\n# Nothing was written.  To run it: bko-holt load layout.json ... --through close --commit\n"
