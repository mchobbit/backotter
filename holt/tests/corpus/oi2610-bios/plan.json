  "text": "# bko-holt load plan for layout.json\n# Source: host-1, OpenIndiana Hipster 2026.10, BIOS boot with illumos, dumped 2026-11-14T07:14:51Z\n#\n# Disks:\n#   c3t0d0 (16 GiB, Virtio Block Device) -> /dev/sdq\n#\n# Notes:\n#   - ZFS pool rpool: illumos can't set a pool's GUID; it gets a new one\n#   - c3t0d0s0: the ESP, written as the source's with the partition table\n#   - ZFS volume rpool/swap: made empty; archivers back up files, not zvols\n\n# ---- partition ----\n# c3t0d0 -> /dev/sdq: the source's table, GUIDs and boot code exactly\nsh -c 'bko-holt write-table layout.json c3t0d0 /dev/rdsk/sdqp0 auto'\n\n# ---- assemble ----\n# ZFS pool rpool, with the source's feature flags only\nzpool create -f -d -o cachefile=none -o ashift=12 -O compression=on -R /mnt/bko-target rpool /dev/dsk/sdqs1\n# mount mounts every dataset in order\nsh -c '[ \"$(zfs get -H -o value mounted rpool)\" != yes ] || zfs unmount rpool'\n\n# ---- format ----\nzfs create -o mountpoint=legacy -o canmount=off rpool/ROOT\nsh -c '[ \"$(zfs get -H -o value mounted rpool/ROOT)\" != yes ] || zfs unmount rpool/ROOT'\nzfs create -o mountpoint=legacy -o canmount=noauto -o org.opensolaris.libbe:policy=static -o org.opensolaris.libbe:uuid=bc000000-0000-4000-8000-000000000005 rpool/ROOT/b5afac2a\nsh -c '[ \"$(zfs get -H -o value mounted rpool/ROOT/b5afac2a)\" != yes ] || zfs unmount rpool/ROOT/b5afac2a'\nzfs create -o mountpoint=/export rpool/export\nsh -c '[ \"$(zfs get -H -o value mounted rpool/export)\" != yes ] || zfs unmount rpool/export'\nzfs create -o mountpoint=/export/home rpool/export/home\nsh -c '[ \"$(zfs get -H -o value mounted rpool/export/home)\" != yes ] || zfs unmount rpool/export/home'\nzfs create -V 3224371200 -o refreservation=3327393792 -o volblocksize=8192 rpool/swap\nzpool set bootfs=rpool/ROOT/b5afac2a rpool\n\n# ---- mount ----\nmkdir -p /mnt/bko-target\nmount -F zfs rpool/ROOT/b5afac2a /mnt/bko-target\nzfs mount -O rpool/export\nzfs mount -O rpool\nzfs mount -O rpool/export/home\n\n# ---- restore ----\n# snapshot latest of /srv/bko-repo, with BackOtter's restore flags\nRUSTIC_STRICT_EXIT=true rustic-bko --repository /srv/bko-repo --no-progress restore --numeric-id --glob '!/.bko-holt/luks-headers/**' --glob '!/.bko-holt/luks-headers' --glob '!/.bko-holt/system.json' --glob '!/.bko-holt' latest /mnt/bko-target\n\n# ---- boot ----\n# the boot code (MBR, freebsd-boot) was written with the partition table\n# the restored system's zpool.cache names the new pool\nsh -c 'for c in /etc/zfs/zpool.cache /boot/zfs/zpool.cache; do [ -f /mnt/bko-target$c ] && zpool set cachefile=/mnt/bko-target$c rpool; done; true'\n# etc/versions/build as a fragment of itself, so OmniOS' bootadm remakes it rather than deleting it\nsh -c '[ -f /mnt/bko-target/etc/versions/build ] && [ ! -h /mnt/bko-target/etc/versions/build ] || exit 0; for f in /mnt/bko-target/etc/versions/build.*; do if [ -e \"$f\" ] || [ -h \"$f\" ]; then exit 0; fi; done; touch -r /mnt/bko-target/etc/versions /run/bko-holt/versref && cp -p /mnt/bko-target/etc/versions/build /mnt/bko-target/etc/versions/build.bko-holt && s=$(/usr/gnu/bin/stat -c %.9Y /mnt/bko-target/etc/versions/build) && case $s in *.000000000) /usr/gnu/bin/touch -m -d @${s%.*}.000000001 /mnt/bko-target/etc/versions/build;; esac'\n# the boot archive, with the new pool's zpool.cache\nbootadm update-archive -R /mnt/bko-target\n# etc/versions/build's fragment gone again, and its mtime back\nsh -c '[ ! -f /run/bko-holt/versref ] || { /usr/gnu/bin/touch -m -r /mnt/bko-target/etc/versions/build.bko-holt /mnt/bko-target/etc/versions/build && rm -f /mnt/bko-target/etc/versions/build.bko-holt && touch -r /run/bko-holt/versref /mnt/bko-target/etc/versions && rm -f /run/bko-holt/versref; }'\n# illumos' gptzfsboot, in the pool's boot area\ninstallboot -f -b /mnt/bko-target/boot /dev/rdsk/sdqs1\nmkdir -p /mnt/bko-target/var/log/bko-holt\n# this restore's log, on the restored system\ncp -Rp /run/bko-holt/log/. /mnt/bko-target/var/log/bko-holt/\n\n# ---- close ----\n# everything under the target, deepest first\nsh -c 'awk '\\''{ print $2 }'\\'' /etc/mnttab | awk '\\''$0 == \"/mnt/bko-target\" || index($0, \"/mnt/bko-target/\") == 1'\\'' | sort -r | while read -r m; do umount \"$m\" || exit; done'\nzpool export rpool\n\n# Nothing was written.  To run it: bko-holt load layout.json ... --through close --commit\n"
}

