  "text": "# bko-holt load plan for layout.json\n# Source: host1, OpenBSD 8.0, BIOS boot with openbsd, dumped 2026-11-08T02:30:50Z\n#\n# Disks:\n#   sd0 (16 GiB) -> /dev/sdq\n\n# ---- partition ----\n# sd0 -> /dev/sdq: the source's table, GUIDs and boot code exactly\nsh -c 'bko-holt write-table layout.json sd0 /dev/rsdqc $(disklabel sdq | awk '\\''/^bytes.sector:/ { b = $2 } /^total sectors:/ { t = $3 } END { print b * t }'\\'')'\ncat > /run/bko-holt/sd0.disklabel <<'EOF'\n# /dev/rsd0c:\ntype: SCSI\ndisk: SCSI disk\nlabel: Block Device    \nduid: bc00000000000001\nflags:\nbytes/sector: 512\nsectors/track: 63\ntracks/cylinder: 255\nsectors/cylinder: 16065\ncylinders: 2088\ntotal sectors: 33554432\nboundstart: 64\nboundend: 33554432\n\n16 partitions:\n#                size           offset  fstype [fsize bsize   cpg]\n  a:         29360064               64  4.2BSD   2048 16384 12960 # /\n  b:          4194304         29360128    swap                    # none\n  c:         33554432                0  unused                    \nEOF\n# sd0's disklabel\ndisklabel -R sdq /run/bko-holt/sd0.disklabel\n# sd0's disklabel UID, bc00000000000001\nsh -c 'printf '\\''i\\n%s\\nw\\nq\\n'\\'' bc00000000000001 | disklabel -E sdq >/dev/null'\n\n# ---- assemble ----\n# (nothing to do)\n\n# ---- format ----\n# sd0a: UFS as the source's (dumpfs -m)\nnewfs -O 2 -b 16384 -f 2048 -i 8192 -m 5 -o time -s 29360064 /dev/rsdqa\n\n# ---- mount ----\nmkdir -p /mnt/bko-target\nmount -t ffs -o rw,wxallowed /dev/sdqa /mnt/bko-target\n\n# ---- restore ----\n# snapshot latest of /srv/bko-repo, with BackOtter's restore flags\nRUSTIC_STRICT_EXIT=true rustic-bko --repository /srv/bko-repo --no-progress restore --numeric-id --glob '!/.bko-holt/luks-headers/**' --glob '!/.bko-holt/luks-headers' --glob '!/.bko-holt/system.json' --glob '!/.bko-holt' latest /mnt/bko-target\n\n# ---- boot ----\n# the boot code (MBR, freebsd-boot) was written with the partition table\n# OpenBSD's biosboot, and /boot it loads\ninstallboot -v -r /mnt/bko-target '' /usr/mdec/biosboot /usr/mdec/boot\nmkdir -p /mnt/bko-target/var/log/bko-holt\n# this restore's log, on the restored system\ncp -Rp /run/bko-holt/log/. /mnt/bko-target/var/log/bko-holt/\n\n# ---- close ----\n# everything under the target, deepest first\nsh -c 'mount | sed -n '\\''s/^.* on \\(.*\\) type .*/\\1/p'\\'' | awk '\\''$0 == \"/mnt/bko-target\" || index($0, \"/mnt/bko-target/\") == 1'\\'' | sort -r | while read -r m; do umount \"$m\" || exit; done'\n\n# Nothing was written.  To run it: bko-holt load layout.json ... --through close --commit\n"
