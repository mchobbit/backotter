#!/bin/sh
# BackOtter rescue stick, BSD flavours and illumos: turn on remote access over
# SSH.
#
# As on the Linux image: creates the "backotter" user if needed, gives it a
# fresh random one-time password, starts sshd (making this boot's host keys
# first), and prints how to connect, also keeping that in
# /var/run/backotter/remote-access (root only), which the console shows.
# The base systems have no sudo, so root gets the same one-time password and
# "backotter" joins wheel (illumos has none: anyone may su there): "su" then
# works.  sshd itself refuses root (the image's sshd_config).  Nothing
# survives a reboot: /etc and /var are in memory.

set -eu
PATH=/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin
user=backotter
os=$(uname -s)
# illumos: POSIX id (-u) first.
[ "$os" = SunOS ] && PATH=/usr/xpg4/bin:$PATH

[ "$(id -u)" -eq 0 ] || { echo "remote-access: must run as root" >&2; exit 1; }

if ! id "$user" >/dev/null 2>&1; then
    case $os in
        FreeBSD|DragonFly) pw useradd "$user" -m -s /bin/sh -G wheel -c "BackOtter remote access" ;;
        SunOS) mkdir -p /home; useradd -m -d "/home/$user" -s /bin/sh -c "BackOtter remote access" "$user" ;;
        *) useradd -m -s /bin/sh -G wheel -c "BackOtter remote access" "$user" ;;
    esac
fi
# Four groups of four from 31 characters without look-alikes (no i, l, o, 0,
# 1): about 79 bits.  tr -dc keeps the bytes that are in the alphabet, so each
# character is uniform over it.
s=$(LC_ALL=C tr -dc abcdefghjkmnpqrstuvwxyz23456789 </dev/urandom | dd bs=16 count=1 2>/dev/null)
[ ${#s} -eq 16 ] || { echo "remote-access: no random password" >&2; exit 1; }
password=$(echo "$s" | sed 's/\(....\)\(....\)\(....\)\(....\)/\1-\2-\3-\4/')
for u in "$user" root; do
    case $os in
        FreeBSD|DragonFly) echo "$password" | pw usermod "$u" -h 0 ;;
        NetBSD) usermod -p "$(pwhash "$password")" "$u" ;;
        OpenBSD) usermod -p "$(echo "$password" | encrypt)" "$u" ;;
        # No password option: the hash (SHA-512, crypt.conf's "6") goes into
        # /etc/shadow, and a last change of 0 there would force a new one.
        SunOS)
            hash=$(echo "$password" | openssl passwd -6 -stdin)
            (umask 077; awk -F: -v OFS=: -v u="$u" -v h="$hash" '$1 == u { $2 = h; if ($3 == "0") $3 = "" } { print }' \
                /etc/shadow >/etc/shadow.new)
            cat /etc/shadow.new >/etc/shadow
            rm /etc/shadow.new ;;
    esac
done

ssh-keygen -A >/dev/null
# Chosen a second time, sshd is already up: only the passwords change.
case $os in
    OpenBSD) rcctl check sshd >/dev/null || rcctl -f start sshd >/dev/null ;;
    NetBSD) /etc/rc.d/sshd onestatus >/dev/null 2>&1 || /etc/rc.d/sshd onestart >/dev/null ;;
    SunOS) svcadm enable -st network/ssh ;;
    *) service sshd onestatus >/dev/null 2>&1 || service sshd onestart >/dev/null ;;
esac

mkdir -p -m 700 /var/run/backotter
{
    echo "Remote access is ON.  Connect with:"
    ifconfig -a | awk -v u="$user" '$1 == "inet" && $2 !~ /^127\./ { sub("/.*", "", $2); print "  ssh " u "@" $2 }'
    echo "Password: $password  (also root's, for su)"
    echo "Host key fingerprints (check them on first connection):"
    for key in /etc/ssh/ssh_host_*_key.pub; do
        echo "  $(ssh-keygen -l -f "$key")"
    done
} >/var/run/backotter/remote-access
chmod 600 /var/run/backotter/remote-access
cat /var/run/backotter/remote-access
