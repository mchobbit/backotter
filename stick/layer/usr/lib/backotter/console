#!/bin/bash
# BackOtter rescue stick: the console on tty1 (and on a serial console).
#
# A placeholder until BackOtter's restore interface exists: it shows what the
# stick can see and offers a shell.  agetty starts it as root, ignoring the
# "-f root" arguments agetty passes, and starts it again whenever it exits.

show_status() {
    echo "BackOtter rescue stick (placeholder console) on $(hostname)"
    echo
    echo "Network:"
    ip -brief -4 address show scope global 2>/dev/null | sed 's/^/  /' | grep . ||
        echo "  no IPv4 address yet"
    echo
    echo "Disks:"
    lsblk --nodeps --noheadings --exclude 7,11 -o NAME,SIZE,TRAN,MODEL 2>/dev/null |
        sed 's/^/  /' | grep . || echo "  none found"
    if [[ -s /run/backotter/remote-access ]]; then
        echo
        cat /run/backotter/remote-access
    fi
    echo
}

while :; do
    clear 2>/dev/null
    show_status
    echo "  1) Shell"
    echo "  2) Allow remote access (SSH)"
    echo "  3) Reboot"
    echo "  4) Power off"
    echo
    # No terminal to read from: let agetty start a fresh one.
    read -r -p "Choose [1-4]: " choice || exit 0
    case $choice in
        1) bash --login ;;
        2) /usr/lib/backotter/remote-access; read -r -p "Press Enter to continue. " _ ;;
        3) systemctl reboot ;;
        4) systemctl poweroff ;;
    esac
done
