+                    _ = e.sid.as_deref().map(super::super::illumos_acl::split_sid);
+                }
+                _ = super::super::unix_time(meta.mtime);
+                _ = super::super::unix_time(meta.atime);
+            }
+            Ok(())
+        });
+        for name in [
+            "",
+            ".",
+            "..",
+            "a/b",
+            "/",
+            "../x",
+            "a\0b",
+            "SUNWattr_rw",
+            "SUNWattr_ro",
+        ] {
+            assert!(attr_name_refused(name).is_some(), "{name:?} not refused");
+        }
+    }
 }
