#!/usr/bin/env python3
"""BackShot2 on a KVM test host (docs/design/backshot2.md): what testvm/backshot2/bs2
runs over SSH.  Run from a private copy (~/backotter-work/bs2-wt/testvm/backshot2),
never the shared ~/backotter-work/testvm.

  bs2-host source SOURCE [--force] [--tools|--drop-tools]
                                         (root) the source prepared for its cases, once per generation
                                         (ht1.sh's source and backup phases, BS2_PREPARE); --tools: and its
                                         tools for tier 0 (a lead's), --drop-tools: none here; older
                                         preparations nothing uses removed
  bs2-host room [SOURCE...]              (root) /bkoscratch's free bytes and each source's preparation and
                                         tools here, as JSON (bs2's space preflight)
  bs2-host prepared SOURCE --holt FILE --tier T [--rustic-sha SHA]
                                         (ht1-bs2.sh) what a case may take from the preparation, as shell
  bs2-host rescuer-key --image IMG --memory M --rfw=... --extra=...
                                         (ht1-bs2.sh) the key of the rescuer's saved state
  bs2-host tier0 SOURCE N [--from SEED] [--run RUN] [--keep-passes K]
                                         N new cases from SOURCE, through tier 0
  bs2-host tier0-cases CASE... [--run RUN]   given cases, through tier 0
  bs2-host tier1 CASE --tier 1|2 [--run RUN] [--port P] [--scratch auto|ram|ssd]
                                         (root, under cmp-run.sh --reserve, or --reserve-ssd for
                                         scratch ssd) one case through ht1.sh
  bs2-host enqueue SOURCE N --tier 1|2 --run RUN [--from SEED] [--to FILE]
                                         (root) N cases that pass tier 0, for the queue (RUN/queue.txt,
                                         or FILE: bs2 splits them over its hosts)
  bs2-host queue RUN [--slots N]         (as m) N workers (1-6, ports 2943-2948) taking RUN/queue.txt
  bs2-host leftovers [SET] [--run RUN] [--port P] [--from N] [--release] [--plan]
                                         (as m) the leftovers set: its steps in order on one disk
  bs2-host reserve CASE [--disk D] [--mem M] [--words]
                                         the RAM disk (GiB) CASE's tier 1 reserves: D (2) and its
                                         inode tables on LUKS past the source's (case.disk_gib);
                                         --words: the whole reservation, --reserve D M or, for a
                                         source over this host's RAM disk, --reserve-ssd D M
  bs2-host lane CASE -- CMD...           CMD (cmp-run.sh ... tier1 CASE) holding this host's SSD lane when
                                         CASE is an SSD case here (one at a time, taken before CMD's
                                         reservation); else CMD as it is
  bs2-host gen SOURCE SEED              print the case SEED gives (no run)
  bs2-host caps                          what the bko-holt under test supports (--new-uuids)

Paths (ROOT=/bkoscratch/backshot2, BS2_ROOT overrides):
  ROOT/sources/SOURCE/  gen (the generation), src.json (its live dump: holds
                        identifiers, never leaves the host), tools/ (a copy of
                        its root, for tier 0's dry runs, on the hosts that run its
                        tier 0 only; tools.json: its generation, version, bytes),
                        prep (a symlink to the current preps/NAME: what tier 1 and
                        2's cases reuse, bs2lib/reuse.py, with its prep.json; an
                        older one kept while live work uses it, prune_preps())
  ROOT/rescuer-state/HASH/  the rescuer's saved state (ht1-bs2.sh makes it in a
                        case's rebuild, once per rescuer, firmware, QEMU and host)
  ROOT/runs/RUN/        tier0.jsonl and tier1.jsonl (a line per case; tierN-queue.jsonl:
                        the queue's HARNESS rows for cases that wrote none), cases/
                        (each case run, as a .case file), logs/
  ROOT/bin/             the bko-holt and planner under test (BS2_HOLT, BS2_PLANNER override)
Work goes in /mnt/bko-ram/backshot2/ (RAM), deleted on a pass; a case whose source's
room is over this host's RAM-disk ceiling, on a host whose holt_disk_mode is true
(bs2lib/room.py scratch(): vanilla3), works on /bkoscratch instead (HT_RAM=0, cmp-run.sh
--reserve-ssd), one such case at a time (ssd_token()).
"""

import argparse
import glob
import hashlib
import json
import os
import shutil
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
from bs2lib import case as C, dumpx, generate as G, ledger as L, tier0 as T0  # noqa: E402

ROOT = os.environ.get("BS2_ROOT", "/bkoscratch/backshot2")
RAM = os.environ.get("BS2_RAM", "/mnt/bko-ram/backshot2")
TESTVM = os.path.dirname(HERE)
WORK = os.path.expanduser("~m/backotter-work") if os.path.isdir(os.path.expanduser("~m/backotter-work")) else os.path.expanduser("~/backotter-work")
VMS = os.environ.get("BS2_VMS") or f"{WORK}/vms"   # (BS2_VMS: tests)


def die(msg, code=2):
    print(f"bs2-host: {msg}", file=sys.stderr)
    sys.exit(code)


def sh(cmd, **kw):
    return subprocess.run(cmd, check=True, **kw)


# ---- sources -----------------------------------------------------------------------

def generation(source):
    """gen:HEX from the guest's image-state, else img:HEX of its image (cached by size, mtime and inode);
    a slimmed source's (bs2lib/slim.py) with the slim recipe after it (+slimN), so a change to the
    recipe prepares it anew and its cases' ledger rows name the slimmed source, not the guest."""
    from bs2lib import slim as SL
    if source.startswith("run:"):
        return source
    return base_generation(source) + SL.suffix(source)


def base_generation(source):
    """generation() of the guest itself, without the slim recipe."""
    d = f"{VMS}/{source}"
    try:
        with open(f"{d}/image-state") as f:
            g = json.load(f)["generation"]
        if g:   # (a store copy's image-state may have "generation": null: its image's sum, then)
            return "gen:" + g
    except (OSError, ValueError, KeyError, TypeError):
        pass
    img = f"{d}/{source}.qcow2"
    st = os.stat(img)
    stamp = f"{st.st_size}:{st.st_mtime_ns}:{st.st_ino}"
    cache = f"{ROOT}/sources/{source}/imgsum"
    try:
        with open(cache) as f:
            s, h = f.read().split()
            if s == stamp:
                return "img:" + h
    except (OSError, ValueError):
        pass
    h = hashlib.sha256()
    with open(img, "rb") as f:
        for b in iter(lambda: f.read(1 << 22), b""):
            h.update(b)
    os.makedirs(os.path.dirname(cache), exist_ok=True)
    with open(cache, "w") as f:
        f.write(f"{stamp} {h.hexdigest()}\n")
    return "img:" + h.hexdigest()


def source_dir(source):
    return f"{ROOT}/sources/{source.replace(':', '-')}"


def source_ready(source):
    d = source_dir(source)
    try:
        with open(f"{d}/gen") as f:
            gen = f.read().strip()
    except OSError:
        return None
    if not os.path.exists(f"{d}/src.json"):
        return None
    if not source.startswith("run:") and gen != generation(source):
        return None
    return gen


def holt_bin():
    return os.environ.get("BS2_HOLT") or f"{ROOT}/bin/bko-holt"


def prep_dir(source):
    """The source's current preparation (ROOT/sources/SOURCE/prep, a symlink into preps/), or None."""
    p = f"{source_dir(source)}/prep"
    return os.path.realpath(p) if os.path.isdir(p) else None


def prep_reasons(source, holt_file, tier=1):
    """(its dir, its prep.json, [why the current preparation can't stand in for a
    case's source phase now]: [] when it can)."""
    from bs2lib import reuse as RU
    d = prep_dir(source)
    saved = RU.load_prep(d) if d else None
    try:
        gen = generation(source)
    except OSError as e:
        return d, saved, [f"no generation of {source}: {e}"]
    now = RU.fields_now(TESTVM, VMS, source, gen, RU.sha256_file(holt_file))
    return d, saved, RU.source_stale(saved, now, tier, d)


def prepare_with_ht1(src, port, d, gen):
    """ht1.sh's own source and backup phases on SRC, as a case runs them (HT_VARIANT=bs2,
    BS2_PREPARE=1: no case, no edits), on /bkoscratch in d/preps/NAME (HT_RAM=0,
    HT_CLEAN=0: kept as it ends); then what cases don't need goes, prep.json is written
    and d/prep points at it.  Returns its directory; dies when the run didn't pass."""
    from bs2lib import reuse as RU
    name = time.strftime("p-%Y%m%d-%H%M%S-") + str(os.getpid())
    k = f"{d}/preps/{name}"
    os.makedirs(f"{d}/preps", mode=0o755, exist_ok=True)
    env = dict(os.environ, HT_VARIANT="bs2", BS2_PREPARE="1", BS2_NAME=name, BS2_TIER="1", BS2_HOST=os.path.join(HERE, "bs2-host"),
               HT_RAM="0", HT_CLEAN="0", HT_RECORDS=d, HT_WORK=f"{RAM}/prep", HT_HOLT=holt_bin(), HT_PORT=str(port))
    for v in ("BS2_CASE", "BS2_CHAIN_IN", "BS2_CHAIN_OUT", "HT_KEEP", "HT_QUICK", "HT_THROUGH", "HT_FAIL_AT", "HT_SOURCE_PREP",
              "HT_RESCUER", "HT_RESCUER_IMG", "HT_RESERVE_PID", "HT_HOLT_BIN"):
        env.pop(v, None)
    # A slimmed source: the slim step runs in the booted source, in this preparation's own
    # overlay, before its dump; the source is booted again from cold after it (bs2lib/slim.py).
    from bs2lib import slim as SL
    slim_sh = None
    if SL.slimmed(src):
        slim_sh = f"{d}/preps/{name}.slim.sh"
        with open(slim_sh, "w") as f:
            f.write(SL.script(src))
        env["HT_SOURCE_PREP"] = slim_sh
    log = f"{d}/preps/{name}.log"
    with open(log, "w") as f:
        r = subprocess.run([f"{TESTVM}/holttest1d/ht1.sh", src, "preps", "source", "backup"], env=env,
                           stdin=subprocess.DEVNULL, stdout=f, stderr=subprocess.STDOUT)
    try:
        with open(f"{k}/report.txt") as f:
            rep = f.read()
    except OSError:
        rep = ""
    if r.returncode or not rep.rstrip().endswith("RESULT: PASS"):
        fails = [l for l in rep.splitlines() if l.startswith("FAIL ")][:3]
        die(f"preparing {src}: ht1.sh exit {r.returncode}: {'; '.join(fails) or 'no report'} (see {k} and {log})", 1)
    # (A RESULT: PASS for phases that never ran or ended is no preparation: bs2lib/tier1.py.)
    from bs2lib import tier1 as T1
    gap = T1.phase_gaps(rep, T1.read_or(f"{k}/logs/phases.tsv"), T1.read_or(log))
    if gap:
        die(f"preparing {src}: ht1.sh said RESULT: PASS, but {gap} (see {k} and {log})", 1)
    if slim_sh:
        try:
            rec = SL.record(T1.read_or(f"{k}/logs/source-prep.txt"), T1.read_or(f"{k}/logs/source-bootstate.txt"), src)
        except ValueError as e:
            die(f"preparing {src}: {e} (see {k}/logs/source-prep.txt)", 1)
        with open(f"{k}/slim.json", "w") as f:
            f.write(SL.dumps(rec))
        os.replace(slim_sh, f"{k}/slim.sh")
    # What the cases take: the overlays, dumps/, logs/, the report, the backup and its records.
    rustic = ""
    with open(f"{k}/logs/manifest.txt") as f:
        for line in f:
            w = line.split()
            if len(w) >= 3 and w[0] == "rustic-bko":
                rustic = w[2]
    holt = RU.sha256_file(f"{k}/share/bko-holt")
    os.makedirs(f"{k}/backup")
    for x in ("repo", "repo-password"):
        os.replace(f"{k}/share/{x}", f"{k}/backup/{x}")
    for x in ("share", "tmp", ".ht"):
        shutil.rmtree(f"{k}/{x}", ignore_errors=True)
    if os.path.exists(f"{k}/rustic-bko"):
        os.remove(f"{k}/rustic-bko")
    saved = RU.fields_now(TESTVM, VMS, src, gen, holt)
    saved.update(name=name, made=time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                 backup={"snapshot_path": f"/mnt/ht1-src-{name}", "rustic": rustic})
    with open(f"{k}/prep.json", "w") as f:
        json.dump(saved, f, indent=1)
    subprocess.run(["chmod", "-R", "a+rX", k])
    tmp = f"{d}/prep.new"
    if os.path.lexists(tmp):
        os.remove(tmp)
    os.symlink(f"preps/{name}", tmp)
    os.replace(tmp, f"{d}/prep")
    # (The older ones go once nothing uses them: cmd_source's prune_preps().)
    return k


def cmd_source(a):
    """The source prepared for its cases, and its dump, once per generation (and again
    when bko-holt or what made the preparation changed); with --tools, its tools for tier
    0's dry runs too (tools_wanted(): a family whose tier 0 is "chroot"), on the hosts that
    run its tier 0 (bs2 passes it to a source's lead); with --drop-tools, its tools gone
    (bs2 passes it to every other host of a run).  Preparations nothing uses any more go
    (prune_preps())."""
    import fcntl
    src = a.source
    if os.geteuid() != 0:
        die("source: run as root (sudo -E)")
    if src.startswith("run:"):
        die("a BackShot1 run's source is copied in by bs2 on the Mac (layout.json and the run's tools)")
    if a.tools and a.drop_tools:
        die("source: --tools or --drop-tools, not both")
    d = source_dir(src)
    # (Readable by m, who runs the queue and the shrinker: a test guest's
    # dump stays on the host, never the Mac or the repository.)
    os.makedirs(d, mode=0o755, exist_ok=True)
    with open(f"{d}/.prep.lock", "a") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)   # (one preparation of a source at a time; the second finds it ready)
        gen = generation(src)
        _, _, why = prep_reasons(src, holt_bin())
        ready = source_ready(src) == gen
        if not a.force and ready and not why:
            k, note = prep_dir(src), "ready"
        else:
            k = prepare_with_ht1(src, a.port, d, gen) if why or a.force else prep_dir(src)
            with open(f"{k}/dumps/src.json") as f:
                dump = f.read()
            json.loads(dump)
            with open(f"{d}/src.json.part", "w") as f:
                f.write(dump)
            os.replace(f"{d}/src.json.part", f"{d}/src.json")
            with open(f"{d}/gen", "w") as f:
                f.write(gen + "\n")
            note = (f"{'prepared anew' if why or a.force else 'preparation kept'} ({os.path.basename(k)}"
                    f"{': ' + '; '.join(why[:2]) if why else ''})")
        tnote = ""
        if a.tools:
            if not tools_wanted(dumpx.load(f"{d}/src.json")):
                tnote = drop_tools(d, "its family's tier 0 runs no dry runs")
            elif a.force or not tools_fresh(src):
                tnote = copy_tools_locked(src, k, d, gen)
        elif a.drop_tools:
            tnote = drop_tools(d, "this host runs none of its tier 0")
        pruned = prune_preps(d)
        print(f"{src}: {note}{', ' + tnote if tnote else ''}, at {gen[:16]}{pruned_words(pruned)}")


# ---- the tools: a copy of the source's root for tier 0's dry runs (bs2lib/tier0.py) -----
#
# Only a host that runs a source's tier 0 needs them (its lead: the draws and the sweep;
# a replay, shrink or corpus at tier 0 copies them where it runs, tier0_cases()), and only
# for a family whose tier 0 is "chroot" (NixOS's is "plan": none).  They hold what the dry
# runs (sfdisk, mke2fs, tune2fs, mkfs.xfs, /usr/bin/env, through chroot with LC_ALL=C) can
# reach: the root less what none of them reads.  TOOLS_VERSION 2 (2026-11-25) left out
# more than 1 did, kept hard links as links (-H: an ostree or ABRoot tree's are many), and
# copies an ostree source's default deployment, not its physical root (which has no /usr:
# every dry run of kinoite44 was refused); tier 0's verdicts were the same with either
# (README "Sources and tools").  A copy of another version is copied anew.
TOOLS_VERSION = 2
TOOLS_EXCLUDE = (
    # Never read by a mkfs or a partitioner: the kernel's, the boot's, the users', the logs,
    # package managers' and containers' stores, a swap file, snapshots of the root, and
    # ABRoot's other root (vanilla3's /part-future; its /etc uppers in /var/lib/abroot:
    # the dry runs, as before, see the lower /etc).
    "/boot", "/lib/modules", "/lib/firmware", "/usr/lib/modules", "/usr/lib/firmware", "/usr/src",
    "/home", "/root", "/srv", "/opt", "/tmp", "/var/tmp", "/var/cache", "/var/log", "/var/opt",
    "/var/lib/flatpak", "/var/lib/snapd", "/var/lib/abroot", "/var/lib/docker", "/var/lib/containers",
    "/var/lib/libvirt", "/var/lib/machines", "/var/lib/apt/lists", "/var/lib/systemd/coredump",
    "/.snapshots", "/part-future", "/swapfile", "/swap.img", "/swap",
)
# /usr/share is left out but for what a mkfs or sfdisk could read there: xfsprogs' mkfs
# configs, a stateless distro's default /etc (Solus, AerynOS: /usr/share/defaults), systemd's
# factory /etc, e2fsprogs' and util-linux's own, misc and zoneinfo.  (Messages: LC_ALL=C.)
TOOLS_SHARE_KEEP = ("xfsprogs", "e2fsprogs", "util-linux", "defaults", "factory", "misc", "zoneinfo")


def tools_rsync_args(src_dir, dest):
    """rsync's command for the tools from SRC_DIR (the mounted root, or an ostree source's
    deployment in it) to DEST."""
    f = [f"--include=/usr/share/{x}/***" for x in TOOLS_SHARE_KEEP] + ["--exclude=/usr/share/*"]
    f += [f"--exclude={x}" for x in TOOLS_EXCLUDE]
    return ["rsync", "-aH"] + f + [f"{src_dir.rstrip('/')}/", f"{dest.rstrip('/')}/"]


def tools_wanted(dump):
    """Whether the source of DUMP has dry runs at tier 0 (its family's tier0 is "chroot")."""
    from bs2lib import families
    return families.hooks(None, dump).tier0 == "chroot"


def tools_meta(d):
    """The tools' record (D/tools.json: gen, version, bytes), or None (none, or a copy
    before TOOLS_VERSION 2 made one: version 1, its size unknown)."""
    try:
        with open(f"{d}/tools.json") as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def tools_fresh(source, gen=None):
    """Whether SOURCE's tools here are its generation GEN's (default: now) at TOOLS_VERSION."""
    d = source_dir(source)
    m = tools_meta(d)
    if not os.path.isdir(f"{d}/tools") or not m:
        return False
    try:
        gen = gen or generation(source)
    except OSError:
        return False
    return m.get("gen") == gen and m.get("version") == TOOLS_VERSION


def tools_lock(d, exclusive, wait=True):
    """The tools' flock (D/.tools.lock): shared while a tier 0 runs in them, exclusive to
    copy or drop them.  The open file (close it to let go), or None when WAIT is false
    and another holds it."""
    import fcntl
    f = open(f"{d}/.tools.lock", "a")
    try:
        fcntl.flock(f, (fcntl.LOCK_EX if exclusive else fcntl.LOCK_SH) | (0 if wait else fcntl.LOCK_NB))
    except OSError:
        f.close()
        return None
    return f


def du_bytes(path):
    """The bytes PATH takes on disk (du -sx, hard links once), 0 when it isn't there."""
    if not os.path.lexists(path):
        return 0
    r = subprocess.run(["du", "-sx", "--block-size=1", path], capture_output=True, text=True)
    try:
        return int(r.stdout.split()[0])
    except (IndexError, ValueError):
        return 0


def copy_tools_locked(src, k, d, gen):
    """copy_tools() under the tools' exclusive lock (it waits for a tier 0 using them)."""
    lk = tools_lock(d, True)
    try:
        n = copy_tools(src, k, d, gen)
    finally:
        lk.close()
    return f"its tools copied ({n / 2**30:.1f} GiB)"


def drop_tools(d, why):
    """D's tools gone, unless a tier 0 holds them now (then kept, said).  Returns a note."""
    if not os.path.lexists(f"{d}/tools") and not os.path.exists(f"{d}/tools.json"):
        return ""
    lk = tools_lock(d, True, wait=False)
    if lk is None:
        return "its tools kept (a tier 0 runs in them now)"
    try:
        n = (tools_meta(d) or {}).get("bytes") or du_bytes(f"{d}/tools")
        shutil.rmtree(f"{d}/tools", ignore_errors=True)
        if os.path.exists(f"{d}/tools.json"):
            os.remove(f"{d}/tools.json")
    finally:
        lk.close()
    return f"its tools removed ({n / 2**30:.1f} GiB: {why})"


def copy_tools(src, k, d, gen, dest=None):
    """The tools: the guest's root (an ostree source's default deployment: vm-mount says
    which), copied out of a read-only mount of the preparation K's overlay, to DEST
    (default D/tools, its record D/tools.json).  Returns their bytes."""
    w = f"{RAM}/source-{src}"
    shutil.rmtree(w, ignore_errors=True)
    os.makedirs(w)
    env = dict(os.environ, TMPDIR=w)
    mp = f"{w}/mnt"
    os.makedirs(mp)
    from bs2lib import reuse as RU
    _, imgs = RU.vm_options(VMS, src)
    extra = []
    for i in range(1, len(imgs)):
        extra += ["--disk", f"{k}/src-{i}.qcow2"]
    key_args = []
    for kf in ("console-passphrase", "zfs-passphrase", "luks-passphrase", "luks-keyfile"):
        if os.path.exists(f"{VMS}/{src}/{kf}"):
            key_args = ["--key", f"{VMS}/{src}/{kf}"]
            break
    r = subprocess.run([f"{TESTVM}/vm-mount", "--ro"] + extra + key_args + [f"{k}/src-0.qcow2", mp], env=env,
                       stdout=subprocess.PIPE, text=True)
    if r.returncode:
        raise subprocess.CalledProcessError(r.returncode, "vm-mount")
    try:
        tools = dest or f"{d}/tools"
        if not dest and os.path.exists(f"{d}/tools.json"):
            os.remove(f"{d}/tools.json")
        shutil.rmtree(tools, ignore_errors=True)
        sh(tools_rsync_args(f"{mp}/{ostree_deployment(r.stdout)}", tools))
    finally:
        subprocess.run([f"{TESTVM}/vm-umount", mp], env=env, stdout=subprocess.DEVNULL)
        shutil.rmtree(w, ignore_errors=True)
    n = du_bytes(tools)
    if not dest:
        with open(f"{d}/tools.json.part", "w") as f:
            json.dump({"gen": gen, "version": TOOLS_VERSION, "bytes": n,
                       "made": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}, f)
        os.replace(f"{d}/tools.json.part", f"{d}/tools.json")
    return n


def ostree_deployment(text):
    """The default deployment vm-mount names in TEXT ("ostree: the default deployment is
    ostree/deploy/..."), relative to its mount point; "" for any other source."""
    for line in text.splitlines():
        if line.startswith("ostree: the default deployment is "):
            p = line[len("ostree: the default deployment is "):].split(" (")[0].strip()
            if p and not p.startswith("/") and ".." not in p.split("/"):
                return p
    return ""


def ensure_tools(source):
    """SOURCE's tools here at its generation and TOOLS_VERSION, copied from its current
    preparation when they aren't (as root, under the source's .prep.lock): for a tier 0
    on a host that isn't the source's lead (a replay, shrink or corpus at tier 0).  Dies
    when there is no preparation to copy them from."""
    import fcntl
    d = source_dir(source)
    with open(f"{d}/.prep.lock", "a") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        if tools_fresh(source):
            return
        k = prep_dir(source)
