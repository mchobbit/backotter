def slim_own_boot(src, tier, run):
    """A case of a slimmed source that boots the source itself (its preparation can't stand
    in, or BS2_REUSE_SOURCE=0) runs the same slim step in its own source phase
    (HT_SOURCE_PREP), so it is judged on the slimmed source its case was drawn from."""
    from bs2lib import slim as SL
    if not SL.slimmed(src):
        return
    why = ["BS2_REUSE_SOURCE=0"] if os.environ.get("BS2_REUSE_SOURCE", "1") != "1" else prep_reasons(src, holt_bin(), tier)[2]
    if not why:
        return
    p = f"{run_dir(run)}/logs/slim-{src}.sh"
    os.makedirs(os.path.dirname(p), exist_ok=True)
    with open(p + ".part", "w") as f:
        f.write(SL.script(src))
    os.replace(p + ".part", p)
    os.environ["HT_SOURCE_PREP"] = p
    print(f"bs2-host: {src}: the case boots the source itself ({'; '.join(why[:2])}): the slim step runs in it too",
          file=sys.stderr)


