    return _HOSTS[0]


def host_name():
    import socket
    return os.environ.get("BS2_HOSTNAME") or socket.gethostname().split(".")[0]


def disk_ok():
    """Whether this host takes cases on its SSD: its holt_disk_mode is true in hosts.json
    (Chopin and Cinqcent: bs2-all.md, one disk slot per big host; a scratch_mode overflow
    alone, the small hosts', doesn't).  No, when the table can't say."""
    try:
        return hosts_table().limit(host_name(), "holt_disk_mode") is True
    except Exception:
        return False


# One case on the SSD at a time on this host (bs2-all.md: one disk slot per big host),
# across runs: a flock on ROOT/ssd.lock, held for the case's whole cmp-run.sh.  A queue's
# worker holds it and says so to its case (BS2_SSD_HELD=1); shrink and a tier1 by hand take
# it themselves, waiting.
def ssd_token(wait=True):
    """The SSD lane's token: an open file holding the flock (close it to give it back; a
    child given its fd, pass_fds, holds the lane on until it exits too), or None when WAIT
    is false and another case has it, or when the lock file can't be opened at all (a
    warning on stderr: the lane counts as busy)."""
    import fcntl
    try:
        os.makedirs(ROOT, exist_ok=True)
        try:   # (m's queue and root's tier1 both take it: made a+rw, else opened read-only)
            f = os.fdopen(os.open(f"{ROOT}/ssd.lock", os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o666), "a")
            try:
                os.fchmod(f.fileno(), 0o666)
            except OSError:
                pass
        except PermissionError:
            f = open(f"{ROOT}/ssd.lock")
    except OSError as e:
        print(f"bs2-host: the SSD lane's lock {ROOT}/ssd.lock: {e}: taken as busy", file=sys.stderr)
        return None
    try:
        fcntl.flock(f, fcntl.LOCK_EX | (0 if wait else fcntl.LOCK_NB))
    except OSError:   # (BlockingIOError: another holds it)
        f.close()
        return None
    return f


def pick(lines, taken, ssd_of, token):
    """The index of the next line of LINES (queue.txt's, split) to take, not in TAKEN: the
    earliest SSD case (SSD_OF(path)) whenever TOKEN() hands the lane's token, before any RAM
    case, so the lane runs from the queue's start as split() and wall() plan it (vanilla3's
    cases sit late in queue.txt); else the earliest RAM case.  (index, token or None), or
    (None, None) when none can start now (only SSD cases left, the lane busy)."""
    left = [i for i in range(len(lines)) if i not in taken]
    ssd = [i for i in left if ssd_of(lines[i][1])]
    if ssd:
        t = token()
        if t is not None:
            return ssd[0], t
    ram = [i for i in left if i not in ssd]
    return (ram[0], None) if ram else (None, None)


def case_scratch(path):
    """Where the case at PATH works here: "ssd" (/bkoscratch, HT_RAM=0, under --reserve-ssd)
    when its source's room is over this host's RAM-disk ceiling and this host takes SSD
    cases (disk_ok(): holt_disk_mode) (bs2lib/room.py scratch(), as bs2 placed it: bs2 deals such a
    source here only when no host of the run could hold it in RAM); else "ram", as before."""
    from bs2lib import room as RM
    try:
        return RM.scratch(C.source_name(C.read(path)), ceiling(), disk_ok()) or RM.RAM
    except Exception:   # (an estimate: never what stops a case)
        return RM.RAM


def case_disk(path, base=C.DISK_GIB, ssd=False):
    """The RAM disk (GiB) the case at PATH reserves: C.disk_gib on its source's
    dump, from BASE or the source's own room if more (bs2lib/room.py: Alpine's
    bs2's own, the others HoltTest1's), within this host's cmp-run.sh --ceiling.
    BASE when either can't be read (a warning on stderr): the case still runs,
    and its row says if it went over.  SSD: the same of the SSD, with no ceiling."""
    from bs2lib import room as RM
    base = int(float(base))
    try:
        c = C.read(path)
        src = C.source_name(c)
        base = max(base, RM.of(src)[0])
        if src not in _DUMPS:
            _DUMPS[src] = dumpx.load(f"{source_dir(src)}/src.json")
        return C.disk_gib(c, _DUMPS[src], base, None if ssd else (ceiling() or (None,))[0])
    except Exception as e:   # (an estimate: never what stops a case)
        print(f"bs2-host: {path}: its reservation as {base} GiB, the estimate failed: {e}", file=sys.stderr)
        return base


def case_mem(path, base="3"):
    """The memory (GiB) the case at PATH reserves: BASE, or its source's own room
    if more (bs2lib/room.py); BASE when the case can't be read."""
    from bs2lib import room as RM
    try:
        return str(max(int(float(base)), RM.of(C.source_name(C.read(path)))[1]))
    except Exception:   # (an estimate: never what stops a case)
        return str(base)


def ssd_reserve():
    """How cmp-run.sh holds a job whose scratch is on /bkoscratch here, as ht1-queue.sh does:
    "--reserve-ssd" (its D against the SSD's room) when this host's scratch_mode isn't ram
    and its cmp-run.sh has --reserve-ssd; else "--reserve 0" (holt_disk_mode's older way:
    no RAM disk, the memory only)."""
    try:
        mode = hosts_table().holt_scratch(host_name())
    except Exception:
        mode = "ram"
    try:
        with open(os.path.realpath(f"{WORK}/cmp-run.sh"), errors="replace") as f:
            has = "--reserve-ssd" in f.read()
    except OSError:
        has = False
    return "--reserve-ssd" if mode != "ram" and has else "--reserve 0"


def reserve_words(path, disk=str(C.DISK_GIB), mem="3"):
    """(cmp-run.sh's reservation words for the case at PATH, where it works: "ram" or
    "ssd"): --reserve D M in the RAM disk (case_disk, case_mem), or on /bkoscratch
    --reserve-ssd D M (or --reserve 0 M: ssd_reserve()), D then uncapped by the RAM disk."""
    m = case_mem(path, mem)
    if case_scratch(path) == "ssd":
        how = ssd_reserve()
        if how == "--reserve-ssd":
            return ["--reserve-ssd", str(case_disk(path, disk, ssd=True)), m], "ssd"
        return ["--reserve", "0", m], "ssd"
    return ["--reserve", str(case_disk(path, disk)), m], "ram"


def cmd_reserve(a):
    """The --reserve DISK for CASE (bs2's replay, soak and corpus put it on their cmp-run.sh);
    with --mem M, "DISK MEM", the memory its source's room asks if more than M; with --words,
    the whole reservation ("--reserve D M", or "--reserve-ssd D M" for a case that works on
    /bkoscratch here: reserve_words())."""
    if a.words:
        print(" ".join(reserve_words(a.case, a.disk, a.mem or "3")[0]))
        return
    print(case_disk(a.case, a.disk) if a.mem is None else f"{case_disk(a.case, a.disk)} {case_mem(a.case, a.mem)}")


# ---- the leftovers set (bs2lib/leftovers.py) ----------------------------------------

def leftovers_cases(name):
    from bs2lib import leftovers as LO
    dumps, gens = {}, {}
    for s_ in LO.sources(name):
        gens[s_], dumps[s_] = load_source(s_)
    return LO.generate(name, dumps, gens), dumps, gens


def cmd_leftovers(a):
    """The set's steps in order on one disk (each step's restored disk is the
    next step's target, in RAM), each a tier 1 under its own reservation, as
    m.  Stops at the first step that doesn't pass: the steps after it would
    start on a disk the set didn't mean.  The rows go to RUN/leftovers.jsonl."""
    from bs2lib import leftovers as LO
    cases, dumps, gens = leftovers_cases(a.set)
    os.environ["BS2_NO_LEDGER"] = "1"   # (not the generator's draws: its own rows, leftovers.jsonl)
    rd = run_dir(a.run)
    for c in cases:
        C.write(f"{rd}/cases/{c['name']}.case", c)
        al = c["chain"].get("aligned")
        print(f"{c['chain']['step']}/{c['chain']['of']} {c['name']}: {c['note']}" +
              (f"; vda{al['partition']} starts at sector {al['sector']}, on the {al['from']}'s {al['on']}" if al else ""))
    # Tier 0 first: a plan load refuses or gets wrong stops the set before a VM starts.
    for c in cases:
        src = C.source_name(c)
        res = tier0_cases(src, gens[src], dumps[src], [(c["name"], c)], a.run + "-t0")
        if res[0][1] != "PASS":
            die(f"{c['name']}: tier 0 {res[0][1]}: {res[0][2][:2]}", 1)
    if a.plan:
        print(f"{len(cases)} steps, ~{len(cases) * 3} min at tier 1, one after another")
        return
    chain = f"{RAM}/leftovers-{a.run}"
    os.makedirs(chain, exist_ok=True)
    prev = f"{chain}/{cases[a.start - 2]['chain']['id']}.qcow2" if a.start > 1 else ""
    if prev and not os.path.exists(prev):
        die(f"--from {a.start}: no {prev} (the step before's disk)")
    stop = None
    for c in cases[a.start - 1:]:
        out = f"{chain}/{c['chain']['id']}.qcow2"
        p = f"{rd}/cases/{c['name']}.case"
        env = dict(os.environ, BS2_CHAIN_IN=prev, BS2_CHAIN_OUT=out, BS2_RELEASE="1" if a.release else "0",
                   WEAR_TAG=f"bs2:{a.run}:{c['chain']['id']}")
        r = subprocess.run([f"{WORK}/cmp-run.sh", "--reserve", str(case_disk(p, a.disk)), a.mem, "sudo", "-E", os.path.join(HERE, "bs2-host"), "tier1", p,
                            "--tier", "1", "--run", a.run, "--port", str(a.port)], cwd=WORK, env=env, capture_output=True, text=True)
        try:
            line = json.loads([l for l in r.stdout.splitlines() if l.startswith("{")][-1])
        except (IndexError, ValueError):
            line = {"verdict": "HARNESS", "check": "no result", "why": [r.stdout[-300:] + r.stderr[-300:]]}
        notes = []
        try:
            with open(f"{line.get('dir')}/report.txt") as f:
                notes = [l.rstrip() for l in f if l.startswith(("note: leftovers", "FAIL leftovers", "PASS leftovers"))]
        except (OSError, TypeError):
            pass
        row = {"set": a.set, "release": a.release, "step": c["chain"]["step"], "id": c["chain"]["id"], "case": c["name"], "verdict": line["verdict"],
               "check": line.get("check"), "why": line.get("why"), "aligned": c["chain"].get("aligned"), "seed": c.get("layer_seed"),
               "leftovers": notes, "dir": line.get("dir"), "holt": holt_bin(), "bins": bins(),
               "t": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
        with open(f"{rd}/leftovers.jsonl", "a") as f:
            f.write(json.dumps(row) + "\n")
        print(f"{c['chain']['id']}: {line['verdict']}{' (' + str(line.get('check')) + ')' if line['verdict'] != 'PASS' else ''}")
        for n in notes:
            print(f"   {n}")
        if line["verdict"] != "PASS" or not os.path.exists(out):
            # (The step's input disk stays, for --from: rerun from this step.)
            stop = c["chain"]["step"], c["chain"]["id"]
            break
        if prev and not a.keep:
            os.remove(prev)
        prev = out
    if not stop and prev and not a.keep:
        os.remove(prev)
    if stop:
        print(f"stopped at {stop[1]}: the steps after it would start on a disk the set didn't mean (rerun it: --run {a.run} --from {stop[0]})")
        sys.exit(1)
    print("leftovers: every step passed")


# ---- shrinking ---------------------------------------------------------------------------

def t0_check(why):
    """A tier 0 failure's check, without its numbers: what a shrink must keep failing."""
    import re
    w = why[0] if why else ""
    w = re.sub(r"(layout|made) [^;,]*", r"\1 X", w)
    w = re.sub(r"\b(vd|sd|nvme)[a-z0-9]+", "DEV", w)
    w = re.sub(r"\d+", "N", w)
    return w[:90]


def cmd_shrink(a):
    """CASE (failing at TIER) down to the smallest case failing the same way;
    saved as ROOT/fails/fail-NNN-NAME.case with the check and an excerpt."""
    from bs2lib import shrink as S, tier1 as T1
    c = C.read(a.case)
    src = C.source_name(c)
    gen, dump = load_source(src)
    name0 = c.get("name") or C.name_of(c)
    work_run = f"shrink-{name0}"
    os.environ["BS2_NO_LEDGER"] = "1"

    def run(case):
        nm = C.name_of(case)
        if a.tier == 0:
            res = tier0_cases(src, gen, dump, [(nm, case)], work_run)
            v, why = res[0][1], res[0][2]
            return v, (t0_check(why) if v == "FAIL" else None), why
        p = f"{run_dir(work_run)}/cases/{nm}.case"
        C.write(p, dict(case, name=nm))
        res, where = reserve_words(p)
        tok = ssd_token() if where == "ssd" else None
        if where == "ssd" and tok is None:
            return "HARNESS", None, [f"the SSD lane's lock {ROOT}/ssd.lock couldn't be taken"]
        r = subprocess.run([f"{WORK}/cmp-run.sh"] + res + ["sudo", "-E", "BS2_NO_LEDGER=1", os.path.join(HERE, "bs2-host"), "tier1", p,
                            "--tier", str(a.tier), "--run", work_run, "--port", str(a.port), "--scratch", where], cwd=WORK,
                           capture_output=True, text=True, pass_fds=(tok.fileno(),) if tok else (),
                           env=dict(os.environ, **({"WEAR_SCRATCH": "ssd", "BS2_SSD_HELD": "1"} if where == "ssd" else {})))
        if tok:
            tok.close()
        try:
            line = json.loads([l for l in r.stdout.splitlines() if l.startswith("{")][-1])
        except (IndexError, ValueError):
            return "HARNESS", None, [r.stdout[-300:] + r.stderr[-300:]]
        return line["verdict"], line.get("check"), line.get("why") or []

    v, check, why = run(c)
    if v != "FAIL":
        die(f"{name0} doesn't fail at tier {a.tier} now ({v}: {why[:1]})", 1)
    print(f"{name0}: fails at tier {a.tier}: {check}")

    def still(case):
        v2, ch2, _ = run(case)
        return v2 == "FAIL" and ch2 == check

    sh_ = S.Shrinker(dump, still, budget=a.budget)
    best = sh_.shrink(c)
    v, check2, why = run(best)
    os.makedirs(f"{ROOT}/fails", exist_ok=True)
    n = len(glob.glob(f"{ROOT}/fails/fail-*.case")) + 1
    short = "".join(ch if ch.isalnum() else "-" for ch in (a.short or check.split(":")[0]).lower())[:32].strip("-")
    out = f"{ROOT}/fails/fail-{n:03d}-{short}.case"
    best = dict(best, name=f"fail-{n:03d}-{short}", failed={"tier": a.tier, "check": check, "excerpt": [str(x)[:300] for x in why[:3]]},
                **{"from": name0})
    best["source"] = c["source"]
    C.write(out, best)
    print(json.dumps({"saved": out, "edits": len(best["edits"]), "options": best.get("load_options"), "runs": sh_.runs, "check": check}))


# ---- the queue ------------------------------------------------------------------------

def cmd_enqueue(a):
    """Cases for tier T: drawn from SEED on, kept when they pass tier 0 here
    (a tier 0 FAIL is a finding already), and for tier 2 only those that touch
    an ESP or ask for --no-nvram or --removable.  Their lines go on RUN/queue.txt,
    or with --to in FILE (written anew), for bs2 to split over its hosts."""
    gen, dump = load_source(a.source)
    rd = run_dir(a.run)
    picked, seed, tried = [], a.start, 0
    while len(picked) < a.n and tried < a.n * 40:
        batch = []
        for s_ in range(seed, seed + max(20, a.n)):
            c = G.generate(a.source, gen, dump, s_, caps=caps_of())
            if a.tier == 2 and not C.touches_esp(c, dump):
                continue
            batch.append((C.name_of(c), c))
        seed += max(20, a.n)
        tried += max(20, a.n)
        if not batch:
            continue
        res = tier0_cases(a.source, gen, dump, batch, a.run + "-t0")
        for (name, c), (_, v, _) in zip(batch, res):
            if v == "PASS" and len(picked) < a.n:
                p = f"{rd}/cases/{name}.case"
                C.write(p, dict(c, name=name))
                picked.append(p)
    with open(a.to or f"{rd}/queue.txt", "w" if a.to else "a") as f:
        for p in picked:
            f.write(f"{a.tier} {p}\n")
    print(json.dumps({"enqueued": len(picked), "tier": a.tier, "source": a.source, "next_seed": seed}))


def unrowed(rd, tier, path, rc, err):
    """After a queue's case: when it exited RC (not 0) and wrote no row of its own to
    RD/tierTIER.jsonl (cmp-run.sh refused its --reserve, "can never fit here", or the case
    died before its verdict), a HARNESS row naming that to RD/tierTIER-queue.jsonl, as m
    (tierTIER.jsonl is root's), so bs2 status and t2 batch count it instead of it vanishing.
    Returns the row, or None."""
    if not rc:
        return None
    try:
        c = C.read(path)
        name, src = c.get("name") or C.name_of(c), C.source_name(c)
    except Exception:
        name, src = os.path.basename(path)[:-len(".case")] if path.endswith(".case") else os.path.basename(path), "?"
    try:
        with open(f"{rd}/tier{tier}.jsonl") as f:
            for line in f:
                try:
                    if json.loads(line).get("case") == name:
                        return None
                except ValueError:
                    continue
    except OSError:
        pass
    tail = [x for x in (err or "").strip().splitlines() if x.strip()][-3:]
    row = {"case": name, "source": src, "tier": int(tier), "verdict": "HARNESS",
           "check": f"the queue's cmp-run.sh exited {rc} with no row from the case",
           "why": tail or [f"exit {rc}"], "attempt": 0, "t": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
    try:
        with open(f"{rd}/tier{tier}-queue.jsonl", "a") as f:
            f.write(json.dumps(row) + "\n")
    except OSError as e:
        print(f"bs2-host queue: {name}: exit {rc}, no row, and {rd}/tier{tier}-queue.jsonl: {e}", file=sys.stderr)
    print(f"bs2-host queue: {name}: exit {rc} with no row: {'; '.join(tail)}", file=sys.stderr)
    return row


def cmd_lane(a):
    """CMD (a cmp-run.sh with a tier1 of CASE) holding this host's SSD lane when CASE is an
    SSD case here, taken before CMD's reservation, waiting (ssd_token); its fd passed on, so
    the lane is held while CMD runs even if this process dies; BS2_SSD_HELD=1 tells the
    tier1.  A RAM case: CMD as it is.  Exits with CMD's status."""
    cmd = a.command[1:] if a.command[:1] == ["--"] else a.command
    if not cmd:
        die("lane CASE -- CMD...")
    tok = ssd_token() if case_scratch(a.case) == "ssd" else None
    env = dict(os.environ)
    if case_scratch(a.case) == "ssd":
        if tok is None:
            die(f"the SSD lane's lock {ROOT}/ssd.lock couldn't be taken", 1)
        env.update(BS2_SSD_HELD="1", WEAR_SCRATCH="ssd")
    r = subprocess.run(cmd, env=env, pass_fds=(tok.fileno(),) if tok else ())
    sys.exit(r.returncode)


SSD_POLL_S = 30   # a queue worker's wait while only SSD cases are left and the lane is busy


def cmd_queue(a):
    """SLOTS workers taking the run's queue.txt in order (a flock'd list of the lines
    taken), each case under its own cmp-run.sh reservation, as m; RUN/stop stops new
    starts.  An SSD case (case_scratch) waits for this host's SSD lane (ssd_token: one at a
    time) without holding a slot: the workers take the RAM cases after it meanwhile.  A
    worker a port: SLOTS of PORTS at most (2943-2948: 2949 is a by-hand tier 1's)."""
    import fcntl
    rd = run_dir(a.run)
    lo, hi = (int(x) for x in a.ports.split("-"))
    ports = list(range(lo, hi + 1))
    if not 1 <= a.slots <= len(ports):
        die(f"queue: --slots {a.slots}: 1 to {len(ports)}, a port each of {a.ports}")
    ports = ports[: a.slots]

    def take():
        """(the next job, the SSD token it holds or None); (None, None) when the queue is
        done or stopped.  Taken lines are in queue.taken (an index each), queue.next their
        count (bs2 status reads it; an older queue's first queue.next lines count as taken).
        While only SSD cases are left and the lane is busy, it waits for it."""
        while True:
            with open(f"{rd}/queue.next", "a+") as f:
                fcntl.flock(f, fcntl.LOCK_EX)
                f.seek(0)
                n = int(f.read().strip() or 0)
                try:
                    with open(f"{rd}/queue.txt") as q:
                        lines = [l.split() for l in q if l.strip()]
                except OSError:
                    lines = []
                try:
                    with open(f"{rd}/queue.taken") as t:
                        taken = {int(x) for x in t.read().split()}
                except (OSError, ValueError):
                    taken = set(range(n))
                if len(taken) >= len(lines) or os.path.exists(f"{rd}/stop"):
                    return None, None
                i, tok = pick(lines, taken, lambda p: case_scratch(p) == "ssd", lambda: ssd_token(wait=False))
                if i is not None:
                    taken.add(i)
                    with open(f"{rd}/queue.taken.new", "w") as t:   # (a torn queue.taken would rerun every case)
                        t.write(" ".join(str(x) for x in sorted(taken)) + "\n")
                    os.replace(f"{rd}/queue.taken.new", f"{rd}/queue.taken")
                    f.seek(0)
                    f.truncate()
                    f.write(str(len(taken)))
                    return lines[i], tok
            time.sleep(SSD_POLL_S)

    def worker(port):
        try:
            work(port)
        except Exception as e:   # (a worker's death is said, never silent)
            print(f"bs2-host queue: the worker on port {port} stopped: {type(e).__name__}: {e}", file=sys.stderr)

    def work(port):
        while True:
            job, tok = take()
            if not job:
                return
            try:
                tier, path = job[:2]
                # (In the RAM disk, or on /bkoscratch for a source over this host's RAM disk: reserve_words.)
                res, where = reserve_words(path, a.disk, a.mem)
                env = dict(os.environ, WEAR_TAG=f"bs2:{a.run}:{os.path.basename(path)}")
                if where == "ssd":
                    env.update(WEAR_SCRATCH="ssd", BS2_SSD_HELD="1" if tok else "")
                r = subprocess.run([f"{WORK}/cmp-run.sh"] + res + ["sudo", "-E", os.path.join(HERE, "bs2-host"), "tier1", path,
                                    "--tier", tier, "--run", a.run, "--port", str(port), "--scratch", where],
                                   env=env, cwd=WORK, pass_fds=(tok.fileno(),) if tok else (),
                                   stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True,
                                   errors="replace")
                unrowed(rd, tier, path, r.returncode, r.stderr)
            finally:
                if tok:
                    tok.close()

    import threading
    ts = [threading.Thread(target=worker, args=(p,)) for p in ports]
    for t in ts:
        t.start()
        time.sleep(20)
    for t in ts:
        t.join()
    print("queue done")


def main():
    p = argparse.ArgumentParser(prog="bs2-host")
    s = p.add_subparsers(dest="cmd", required=True)
    x = s.add_parser("source")
    x.add_argument("source")
