#!/usr/bin/env python3
"""BackShot2 on a KVM test host (docs/design/backshot2.md): what testvm/backshot2/bs2
runs over SSH.  Run from a private copy (~/backotter-work/bs2-wt/testvm/backshot2),
never the shared ~/backotter-work/testvm.

  bs2-host source SOURCE                 (root) the source's dump and tools, once per generation
  bs2-host tier0 SOURCE N [--from SEED] [--run RUN] [--keep-passes K]
                                         N new cases from SOURCE, through tier 0
  bs2-host tier0-cases CASE... [--run RUN]   given cases, through tier 0
  bs2-host tier1 CASE --tier 1|2 [--run RUN] [--port P]
                                         (root, under cmp-run.sh --reserve) one case through ht1.sh
  bs2-host gen SOURCE SEED              print the case SEED gives (no run)
  bs2-host caps                          what the bko-holt under test supports (--new-uuids)

Paths (ROOT=/bkoscratch/backshot2, BS2_ROOT overrides):
  ROOT/sources/SOURCE/  gen (the generation), src.json (its live dump: holds
                        identifiers, never leaves the host), tools/ (a copy of
                        its root, for tier 0's dry runs)
  ROOT/runs/RUN/        tier0.jsonl and tier1.jsonl (a line per case), cases/
                        (each case run, as a .case file), logs/
  ROOT/bin/             the bko-holt and planner under test (BS2_HOLT, BS2_PLANNER override)
Work goes in /mnt/bko-ram/backshot2/ (RAM), deleted on a pass.
"""

import argparse
import glob
import hashlib
import json
import os
import shutil
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
from bs2lib import case as C, dumpx, generate as G, ledger as L, tier0 as T0  # noqa: E402

ROOT = os.environ.get("BS2_ROOT", "/bkoscratch/backshot2")
RAM = os.environ.get("BS2_RAM", "/mnt/bko-ram/backshot2")
TESTVM = os.path.dirname(HERE)
WORK = os.path.expanduser("~m/backotter-work") if os.path.isdir(os.path.expanduser("~m/backotter-work")) else os.path.expanduser("~/backotter-work")
VMS = f"{WORK}/vms"


def die(msg, code=2):
    print(f"bs2-host: {msg}", file=sys.stderr)
    sys.exit(code)


def sh(cmd, **kw):
    return subprocess.run(cmd, check=True, **kw)


# ---- sources -----------------------------------------------------------------------

def generation(source):
    """gen:HEX from the guest's image-state, else img:HEX of its image (cached by size, mtime and inode)."""
    if source.startswith("run:"):
        return source
    d = f"{VMS}/{source}"
    try:
        with open(f"{d}/image-state") as f:
            return "gen:" + json.load(f)["generation"]
    except (OSError, ValueError, KeyError):
        pass
    img = f"{d}/{source}.qcow2"
    st = os.stat(img)
    stamp = f"{st.st_size}:{st.st_mtime_ns}:{st.st_ino}"
    cache = f"{ROOT}/sources/{source}/imgsum"
    try:
        with open(cache) as f:
            s, h = f.read().split()
            if s == stamp:
                return "img:" + h
    except (OSError, ValueError):
        pass
    h = hashlib.sha256()
    with open(img, "rb") as f:
        for b in iter(lambda: f.read(1 << 22), b""):
            h.update(b)
    os.makedirs(os.path.dirname(cache), exist_ok=True)
    with open(cache, "w") as f:
        f.write(f"{stamp} {h.hexdigest()}\n")
    return "img:" + h.hexdigest()


def source_dir(source):
    return f"{ROOT}/sources/{source.replace(':', '-')}"


def source_ready(source):
    d = source_dir(source)
    try:
        with open(f"{d}/gen") as f:
            gen = f.read().strip()
    except OSError:
        return None
    if not os.path.exists(f"{d}/src.json"):
        return None
    if not source.startswith("run:") and gen != generation(source):
        return None
    return gen


def holt_bin():
    return os.environ.get("BS2_HOLT") or f"{ROOT}/bin/bko-holt"


def cmd_source(a):
    """The source's live dump and a copy of its root (its tools), once per generation."""
    src = a.source
    if os.geteuid() != 0:
        die("source: run as root (sudo -E)")
    if src.startswith("run:"):
        die("a BackShot1 run's source is copied in by bs2 on the Mac (layout.json and the run's tools)")
    gen = generation(src)
    if source_ready(src) == gen and os.path.isdir(f"{source_dir(src)}/tools/usr") and not a.force:
        print(f"{src}: ready at {gen[:16]}")
        return
    d = source_dir(src)
    # (Readable by m, who runs the queue and the shrinker: a test guest's
    # dump stays on the host, never the Mac or the repository.)
    os.makedirs(d, mode=0o755, exist_ok=True)
    w = f"{RAM}/source-{src}"
    shutil.rmtree(w, ignore_errors=True)
    os.makedirs(w)
    img = f"{VMS}/{src}/{src}.qcow2"
    ov = f"{w}/src.qcow2"
    sh(["qemu-img", "create", "-q", "-f", "qcow2", "-b", img, "-F", "qcow2", ov])
    opts = []
    try:
        with open(f"{VMS}/{src}/vm-run-options") as f:
            opts = f.read().split()
    except OSError:
        pass
    port = str(a.port)
    env = dict(os.environ, SSH_PORT=port, TMPDIR=w)
    log = open(f"{w}/serial.vm-run", "w")
    vm = subprocess.Popen([f"{TESTVM}/vm-run", "--serial-log", f"{w}/serial.log"] + opts + [ov], env=env,
                          stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
    key = f"{VMS}/{src}/id_ed25519"
    ssh = ["ssh", "-q", "-i", key, "-p", port, "-o", "StrictHostKeyChecking=no", "-o", "UserKnownHostsFile=/dev/null",
           "-o", "ConnectTimeout=5", "root@127.0.0.1"]
    try:
        for _ in range(72):
            if subprocess.run(["timeout", "10"] + ssh + ["true"], capture_output=True).returncode == 0:
                break
            time.sleep(5)
        else:
            die(f"{src} didn't answer SSH (see {w}/serial.log)", 1)
        sh(["scp", "-q", "-i", key, "-P", port, "-o", "StrictHostKeyChecking=no", "-o", "UserKnownHostsFile=/dev/null",
            holt_bin(), "root@127.0.0.1:/root/bko-holt"])
        r = subprocess.run(["timeout", "300"] + ssh + ["/root/bko-holt dump; rc=$?; rm -f /root/bko-holt; exit $rc"], capture_output=True, text=True)
        if r.returncode:
            die(f"dump on {src}: {r.stderr[-500:]}", 1)
        json.loads(r.stdout)
        with open(f"{d}/src.json.part", "w") as f:
            f.write(r.stdout)
        os.replace(f"{d}/src.json.part", f"{d}/src.json")
        subprocess.run(["timeout", "20"] + ssh + ["poweroff"], capture_output=True)
        try:
            vm.wait(120)
        except subprocess.TimeoutExpired:
            vm.terminate()
            vm.wait(30)
    finally:
        if vm.poll() is None:
            vm.terminate()
    # The tools: the guest's root, copied out of a read-only mount of the overlay.
    mp = f"{w}/mnt"
    os.makedirs(mp)
    key_args = []
    for kf in ("luks-keyfile", "luks-passphrase", "console-passphrase"):
        if os.path.exists(f"{VMS}/{src}/{kf}"):
            key_args = ["--key", f"{VMS}/{src}/{kf}"]
            break
    sh([f"{TESTVM}/vm-mount", "--ro"] + key_args + [ov, mp], env=env, stdout=subprocess.DEVNULL)
    try:
        tools = f"{d}/tools"
        shutil.rmtree(tools, ignore_errors=True)
        sh(["rsync", "-a", "--exclude=/boot", "--exclude=/lib/modules", "--exclude=/lib/firmware", "--exclude=/usr/share/doc",
            "--exclude=/usr/share/man", "--exclude=/var/cache", "--exclude=/home", "--exclude=/root", "--exclude=/srv",
            f"{mp}/", f"{tools}/"])
    finally:
        subprocess.run([f"{TESTVM}/vm-umount", mp], env=env, stdout=subprocess.DEVNULL)
    with open(f"{d}/gen", "w") as f:
        f.write(gen + "\n")
    shutil.rmtree(w, ignore_errors=True)
    print(f"{src}: dumped and its tools copied, at {gen[:16]}")


def load_source(source):
    gen = source_ready(source)
    if not gen:
        die(f"{source} isn't prepared at its current generation: sudo -E bs2-host source {source}")
    return gen, dumpx.load(f"{source_dir(source)}/src.json")


# ---- tier 0 ------------------------------------------------------------------------

def planner():
    p = os.environ.get("BS2_PLANNER") or f"{ROOT}/bin/bs2_plan"
    if not os.access(p, os.X_OK):
        die(f"no planner at {p} (bs2-host build)")
    return p


def caps_of():
    try:
        with open(f"{ROOT}/bin/caps.json") as f:
            return json.load(f)
    except OSError:
        return {}


def run_dir(run):
    d = f"{ROOT}/runs/{run}"
    os.makedirs(f"{d}/cases", exist_ok=True)
    return d


def tier0_cases(source, gen, dump, cases, run, keep_passes=0):
    """CASES: [(name, case)].  Runs them, writes the run's rows and the cases that didn't pass."""
    rd = run_dir(run)
    w = f"{RAM}/t0-{run}-{source}-{os.getpid()}"
    os.makedirs(w, exist_ok=True)
    tools = f"{source_dir(source)}/tools"
    tools = tools if os.path.isdir(f"{tools}/usr") and os.geteuid() == 0 else None
    t0 = time.time()
    results, plans = T0.run(dump, cases, w, planner(), tools, caps_of())
    wall = time.time() - t0
    counts = {}
    kept = 0
    with open(f"{rd}/tier0.jsonl", "a") as f:
        for (name, case), (_, verdict, why) in zip(cases, results):
            counts[verdict] = counts.get(verdict, 0) + 1
            f.write(json.dumps({"case": name, "hash": C.case_hash(case), "source": source, "gen": gen, "tier": 0,
                                "verdict": verdict, "why": why[:5], "t": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}) + "\n")
            if verdict != "PASS" or kept < keep_passes:
                kept += verdict == "PASS"
                C.write(f"{rd}/cases/{name}.case", dict(case, name=name))
                if verdict != "PASS":
                    with open(f"{rd}/cases/{name}.tier0.txt", "w") as g:
                        g.write("\n".join(why) + "\n\n" + plans.get(name, {}).get("out", "") + plans.get(name, {}).get("err", ""))
    L.write_rows(run, source, gen, [(n, c, v, w_) for (n, c), (_, v, w_) in zip(cases, results)], tier=0, wall=wall, bins=bins())
    shutil.rmtree(w, ignore_errors=True)
    print(json.dumps({"source": source, "cases": len(cases), "counts": counts, "wall_s": round(wall, 1), "dry_runs": bool(tools)}))
    return results


def bins():
    out = {}
    for name, p in (("linux/bko-holt", holt_bin()), ("bs2_plan", os.environ.get("BS2_PLANNER") or f"{ROOT}/bin/bs2_plan"),
                    ("linux/rustic-bko", f"{WORK}/bko-bin/linux/rustic-bko")):
        try:
            with open(p, "rb") as f:
                out[name] = "sha256:" + hashlib.sha256(f.read()).hexdigest()
        except OSError:
            out[name] = "missing"
    return out


def cmd_tier0(a):
    gen, dump = load_source(a.source)
    stats = G.Stats()
    cases = []
    for seed in range(a.start, a.start + a.n):
        c = G.generate(a.source, gen, dump, seed, caps=caps_of(), stats=stats)
        cases.append((C.name_of(c), c))
    tier0_cases(a.source, gen, dump, cases, a.run, a.keep_passes)
    print(json.dumps({"generator": {"tried": stats.tried, "kept": stats.kept,
                                    "discarded": dict(sorted(stats.discarded.items(), key=lambda x: -x[1])[:12])}}))


def cmd_tier0_cases(a):
    groups = {}
    for p in a.cases:
        c = C.read(p)
        groups.setdefault(C.source_name(c), []).append((c.get("name") or C.name_of(c), c))
    for src, cs in groups.items():
        gen, dump = load_source(src)
        tier0_cases(src, gen, dump, cs, a.run)


def cmd_gen(a):
    gen, dump = load_source(a.source)
    c = G.generate(a.source, gen, dump, a.seed, caps=caps_of())
    c["name"] = C.name_of(c)
    sys.stdout.write(C.text(c))


def cmd_caps(a):
    """Whether the bko-holt under test plans --new-uuids (it refused, "isn't built yet", until it does)."""
    gen, dump = load_source(a.source)
    w = f"{RAM}/caps-{os.getpid()}"
    os.makedirs(w, exist_ok=True)
    c = {"source": a.source, "edits": [], "load_options": ["--new-uuids"]}
    res, plans = T0.run(dump, [("caps", c)], w, planner(), None, {})
    caps = {"new_uuids": res[0][1] == "PASS", "probe": res[0][2][:2]}
    with open(f"{ROOT}/bin/caps.json", "w") as f:
        json.dump(caps, f)
    shutil.rmtree(w, ignore_errors=True)
    print(json.dumps(caps))


# ---- tier 1 and 2: ht1.sh's hooks (ht1-bs2.sh) -------------------------------------

def q(x):
    import shlex
    return shlex.quote(str(x))


def cmd_apply(a):
    """The drifted layout from a fresh dump, and ht1-bs2.sh's settings as shell."""
    from bs2lib import sweep
    c = C.read(a.case)
    src = dumpx.load(a.src)
    drifted = C.replay(c, src)
    with open(a.out, "w") as f:
        json.dump(drifted, f, indent=1)
    targets = C.targets(c, drifted)
    order = [dk["name"] for dk in dumpx.disks(drifted)]
    ex = sweep.expected(c)
    flags, o, i = [], list(c.get("load_options") or []), 0
    while i < len(o):
        if o[i] == "--snapshot":
            i += 2
            continue
        flags.append(o[i])
        i += 1
    judge = ["--expect"]
    delta = targets[order[0]] - dumpx.disk(drifted, order[0])["size_bytes"]
    if ex["fit"] is not None:
        judge += ["--fit", str(delta), "--fit-pct", str(ex["fit"])]
    elif delta > 0:
        judge += ["--grow", str(delta)]
    elif delta < 0:
        die("a smaller target without --fit-largest", 1)
    if ex["new_uuids"]:
        judge.append("--new-uuids")
    if ex["removable"]:
        judge.append("--removable")
    if a.tier == 2:
        judge.append("--nvram-kept")
    snaps = c.get("snapshots") or {}
    print(f"BS2_EDITS={len(c.get('edits') or [])}")
    print("BS2_TARGETS=(" + " ".join(q(targets[n]) for n in order) + ")")
    print("BS2_FLAGS=(" + " ".join(q(x) for x in flags) + ")")
    print(f"BS2_SNAPS={snaps.get('count', 1)} BS2_RESTORE={snaps.get('restore', 0) if snaps else 0}")
    print(f"BS2_CONTENT={1 if c.get('content') else 0}")
    print("BS2_JUDGE=(" + " ".join(q(x) for x in judge) + ")")
    print("BS2_FSJUDGE=(" + (" --new-uuids" if ex["new_uuids"] else "") + ")")


def _content_fs(root):
    r = subprocess.run(["findmnt", "-n", "-o", "FSTYPE", "--target", root], capture_output=True, text=True)
    return r.stdout.strip() or "ext4"


def cmd_plant(a):
    from bs2lib import content as CT
    c = C.read(a.case)
    # The long symlink is sized for the filesystem restored onto as well
    # (ext4's limit is its block size, which an ext4_geometry may shrink).
    lim = CT.symlink_max(dumpx.load(a.layout)) if a.layout else None
    entries = CT.plan(c["content"], _content_fs(a.root), symlink_max=lim)
    fails = CT.plant(a.root, entries)
    for i, why in fails:
        print(f"could not plant entry {i}: {why}")
    b, n = CT.sizes(entries)
    print(f"{len(entries)} entries ({n} inodes, ~{b >> 20} MiB) under {CT.DIR}, {len(fails)} not made")
    sys.exit(1 if fails else 0)


def cmd_deep(a):
    from bs2lib import content as CT
    if a.what == "record":
        rec = CT.deep_record(a.root)
        with open(a.file, "w") as f:
            json.dump(rec, f)
        print(f"{len(rec)} entries, the longest path {max((len(k) // 2 for k in rec), default=0)} bytes")
        return
    with open(a.file) as f:
        before = json.load(f)
    after = CT.deep_record(a.root)
    diff = CT.deep_compare(before, after)
    for l in diff[:20]:
        print(l)
    print(f"{len(diff)} differences in {len(before)} entries, the longest path {max((len(k) // 2 for k in before), default=0)} bytes")
    sys.exit(1 if diff or not before else 0)


def cmd_change(a):
    from bs2lib import content as CT
    c = C.read(a.case)
    CT.change(a.root, c.get("content") or {"seed": c.get("seed", 0)}, a.round)


# ---- tier 1 and 2 ------------------------------------------------------------------

def cmd_tier1(a):
    from bs2lib import tier1 as T1
    c = C.read(a.case)
    name = c.get("name") or C.name_of(c)
    src = C.source_name(c)
    gen, dump = load_source(src)
    rc = T1.run(c, name, src, gen, dump, a.tier, a.run, a.port, HERE, TESTVM, ROOT, holt_bin(), bins())
    sys.exit(rc)


# ---- shrinking ---------------------------------------------------------------------------

def t0_check(why):
    """A tier 0 failure's check, without its numbers: what a shrink must keep failing."""
    import re
    w = why[0] if why else ""
    w = re.sub(r"(layout|made) [^;,]*", r"\1 X", w)
    w = re.sub(r"\b(vd|sd|nvme)[a-z0-9]+", "DEV", w)
    w = re.sub(r"\d+", "N", w)
    return w[:90]


def cmd_shrink(a):
    """CASE (failing at TIER) down to the smallest case failing the same way;
    saved as ROOT/fails/fail-NNN-NAME.case with the check and an excerpt."""
    from bs2lib import shrink as S, tier1 as T1
    c = C.read(a.case)
    src = C.source_name(c)
    gen, dump = load_source(src)
    name0 = c.get("name") or C.name_of(c)
    work_run = f"shrink-{name0}"
    os.environ["BS2_NO_LEDGER"] = "1"

    def run(case):
        nm = C.name_of(case)
        if a.tier == 0:
            res = tier0_cases(src, gen, dump, [(nm, case)], work_run)
            v, why = res[0][1], res[0][2]
            return v, (t0_check(why) if v == "FAIL" else None), why
        p = f"{run_dir(work_run)}/cases/{nm}.case"
        C.write(p, dict(case, name=nm))
        r = subprocess.run([f"{WORK}/cmp-run.sh", "--reserve", "2", "3", "sudo", "-E", "BS2_NO_LEDGER=1", os.path.join(HERE, "bs2-host"), "tier1", p,
                            "--tier", str(a.tier), "--run", work_run, "--port", str(a.port)], cwd=WORK, capture_output=True, text=True)
        try:
            line = json.loads([l for l in r.stdout.splitlines() if l.startswith("{")][-1])
        except (IndexError, ValueError):
            return "HARNESS", None, [r.stdout[-300:] + r.stderr[-300:]]
        return line["verdict"], line.get("check"), line.get("why") or []

    v, check, why = run(c)
    if v != "FAIL":
        die(f"{name0} doesn't fail at tier {a.tier} now ({v}: {why[:1]})", 1)
    print(f"{name0}: fails at tier {a.tier}: {check}")

    def still(case):
        v2, ch2, _ = run(case)
        return v2 == "FAIL" and ch2 == check

    sh_ = S.Shrinker(dump, still, budget=a.budget)
    best = sh_.shrink(c)
    v, check2, why = run(best)
    os.makedirs(f"{ROOT}/fails", exist_ok=True)
    n = len(glob.glob(f"{ROOT}/fails/fail-*.case")) + 1
    short = "".join(ch if ch.isalnum() else "-" for ch in (a.short or check.split(":")[0]).lower())[:32].strip("-")
    out = f"{ROOT}/fails/fail-{n:03d}-{short}.case"
    best = dict(best, name=f"fail-{n:03d}-{short}", failed={"tier": a.tier, "check": check, "excerpt": [str(x)[:300] for x in why[:3]]},
                **{"from": name0})
    best["source"] = c["source"]
    C.write(out, best)
    print(json.dumps({"saved": out, "edits": len(best["edits"]), "options": best.get("load_options"), "runs": sh_.runs, "check": check}))


# ---- the queue ------------------------------------------------------------------------

def cmd_enqueue(a):
    """Cases for tier T: drawn from SEED on, kept when they pass tier 0 here
    (a tier 0 FAIL is a finding already), and for tier 2 only those that touch
    an ESP or ask for --no-nvram or --removable."""
    gen, dump = load_source(a.source)
    rd = run_dir(a.run)
    picked, seed, tried = [], a.start, 0
    while len(picked) < a.n and tried < a.n * 40:
        batch = []
        for s_ in range(seed, seed + max(20, a.n)):
            c = G.generate(a.source, gen, dump, s_, caps=caps_of())
            if a.tier == 2 and not C.touches_esp(c, dump):
                continue
            batch.append((C.name_of(c), c))
        seed += max(20, a.n)
        tried += max(20, a.n)
        if not batch:
            continue
        res = tier0_cases(a.source, gen, dump, batch, a.run + "-t0")
        for (name, c), (_, v, _) in zip(batch, res):
            if v == "PASS" and len(picked) < a.n:
                p = f"{rd}/cases/{name}.case"
                C.write(p, dict(c, name=name))
                picked.append(p)
    with open(f"{rd}/queue.txt", "a") as f:
        for p in picked:
            f.write(f"{a.tier} {p}\n")
    print(json.dumps({"enqueued": len(picked), "tier": a.tier, "source": a.source, "next_seed": seed}))


def cmd_queue(a):
    """SLOTS workers taking the run's queue.txt in order (a flock'd counter), each case
    under its own cmp-run.sh reservation, as m; RUN/stop stops new starts."""
    import fcntl
    rd = run_dir(a.run)
    lo, hi = (int(x) for x in a.ports.split("-"))
    ports = list(range(lo, hi + 1))[: a.slots]

    def take():
        with open(f"{rd}/queue.next", "a+") as f:
            fcntl.flock(f, fcntl.LOCK_EX)
            f.seek(0)
            n = int(f.read().strip() or 0)
            try:
                with open(f"{rd}/queue.txt") as q:
                    lines = [l.split() for l in q if l.strip()]
            except OSError:
                lines = []
            if n >= len(lines) or os.path.exists(f"{rd}/stop"):
                return None
            f.seek(0)
            f.truncate()
            f.write(str(n + 1))
            return lines[n]

    def worker(port):
        while True:
            job = take()
            if not job:
                return
            tier, path = job
            subprocess.run([f"{WORK}/cmp-run.sh", "--reserve", a.disk, a.mem, "sudo", "-E", os.path.join(HERE, "bs2-host"), "tier1", path,
                            "--tier", tier, "--run", a.run, "--port", str(port)],
                           env=dict(os.environ, WEAR_TAG=f"bs2:{a.run}:{os.path.basename(path)}"), cwd=WORK,
