#!/usr/bin/env python3
"""BackShot2 on a KVM test host (docs/design/backshot2.md): what testvm/backshot2/bs2
runs over SSH.  Run from a private copy (~/backotter-work/bs2-wt/testvm/backshot2),
never the shared ~/backotter-work/testvm.

  bs2-host source SOURCE [--force]       (root) the source prepared for its cases, once per generation
                                         (ht1.sh's source and backup phases, BS2_PREPARE) and its tools
  bs2-host prepared SOURCE --holt FILE --tier T [--rustic-sha SHA]
                                         (ht1-bs2.sh) what a case may take from the preparation, as shell
  bs2-host rescuer-key --image IMG --memory M --rfw=... --extra=...
                                         (ht1-bs2.sh) the key of the rescuer's saved state
  bs2-host tier0 SOURCE N [--from SEED] [--run RUN] [--keep-passes K]
                                         N new cases from SOURCE, through tier 0
  bs2-host tier0-cases CASE... [--run RUN]   given cases, through tier 0
  bs2-host tier1 CASE --tier 1|2 [--run RUN] [--port P]
                                         (root, under cmp-run.sh --reserve) one case through ht1.sh
  bs2-host enqueue SOURCE N --tier 1|2 --run RUN [--from SEED] [--to FILE]
                                         (root) N cases that pass tier 0, for the queue (RUN/queue.txt,
                                         or FILE: bs2 splits them over its hosts)
  bs2-host queue RUN [--slots N]         (as m) N workers (1-6, ports 2943-2948) taking RUN/queue.txt
  bs2-host leftovers [SET] [--run RUN] [--port P] [--from N] [--release] [--plan]
                                         (as m) the leftovers set: its steps in order on one disk
  bs2-host gen SOURCE SEED              print the case SEED gives (no run)
  bs2-host caps                          what the bko-holt under test supports (--new-uuids)

Paths (ROOT=/bkoscratch/backshot2, BS2_ROOT overrides):
  ROOT/sources/SOURCE/  gen (the generation), src.json (its live dump: holds
                        identifiers, never leaves the host), tools/ (a copy of
                        its root, for tier 0's dry runs), prep (a symlink to the
                        current preps/NAME: what tier 1 and 2's cases reuse,
                        bs2lib/reuse.py, with its prep.json; the 3 newest kept)
  ROOT/rescuer-state/HASH/  the rescuer's saved state (ht1-bs2.sh makes it in a
                        case's rebuild, once per rescuer, firmware, QEMU and host)
  ROOT/runs/RUN/        tier0.jsonl and tier1.jsonl (a line per case), cases/
                        (each case run, as a .case file), logs/
  ROOT/bin/             the bko-holt and planner under test (BS2_HOLT, BS2_PLANNER override)
Work goes in /mnt/bko-ram/backshot2/ (RAM), deleted on a pass.
"""

import argparse
import glob
import hashlib
import json
import os
import shutil
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
from bs2lib import case as C, dumpx, generate as G, ledger as L, tier0 as T0  # noqa: E402

ROOT = os.environ.get("BS2_ROOT", "/bkoscratch/backshot2")
RAM = os.environ.get("BS2_RAM", "/mnt/bko-ram/backshot2")
TESTVM = os.path.dirname(HERE)
WORK = os.path.expanduser("~m/backotter-work") if os.path.isdir(os.path.expanduser("~m/backotter-work")) else os.path.expanduser("~/backotter-work")
VMS = os.environ.get("BS2_VMS") or f"{WORK}/vms"   # (BS2_VMS: tests)


def die(msg, code=2):
    print(f"bs2-host: {msg}", file=sys.stderr)
    sys.exit(code)


def sh(cmd, **kw):
    return subprocess.run(cmd, check=True, **kw)


# ---- sources -----------------------------------------------------------------------

def generation(source):
    """gen:HEX from the guest's image-state, else img:HEX of its image (cached by size, mtime and inode)."""
    if source.startswith("run:"):
        return source
    d = f"{VMS}/{source}"
    try:
        with open(f"{d}/image-state") as f:
            g = json.load(f)["generation"]
        if g:   # (a store copy's image-state may have "generation": null: its image's sum, then)
            return "gen:" + g
    except (OSError, ValueError, KeyError, TypeError):
        pass
    img = f"{d}/{source}.qcow2"
    st = os.stat(img)
    stamp = f"{st.st_size}:{st.st_mtime_ns}:{st.st_ino}"
    cache = f"{ROOT}/sources/{source}/imgsum"
    try:
        with open(cache) as f:
            s, h = f.read().split()
            if s == stamp:
                return "img:" + h
    except (OSError, ValueError):
        pass
    h = hashlib.sha256()
    with open(img, "rb") as f:
        for b in iter(lambda: f.read(1 << 22), b""):
            h.update(b)
    os.makedirs(os.path.dirname(cache), exist_ok=True)
    with open(cache, "w") as f:
        f.write(f"{stamp} {h.hexdigest()}\n")
    return "img:" + h.hexdigest()


def source_dir(source):
    return f"{ROOT}/sources/{source.replace(':', '-')}"


def source_ready(source):
    d = source_dir(source)
    try:
        with open(f"{d}/gen") as f:
            gen = f.read().strip()
    except OSError:
        return None
    if not os.path.exists(f"{d}/src.json"):
        return None
    if not source.startswith("run:") and gen != generation(source):
        return None
    return gen


def holt_bin():
    return os.environ.get("BS2_HOLT") or f"{ROOT}/bin/bko-holt"


def prep_dir(source):
    """The source's current preparation (ROOT/sources/SOURCE/prep, a symlink into preps/), or None."""
    p = f"{source_dir(source)}/prep"
    return os.path.realpath(p) if os.path.isdir(p) else None


def prep_reasons(source, holt_file, tier=1):
    """(its dir, its prep.json, [why the current preparation can't stand in for a
    case's source phase now]: [] when it can)."""
    from bs2lib import reuse as RU
    d = prep_dir(source)
    saved = RU.load_prep(d) if d else None
    try:
        gen = generation(source)
    except OSError as e:
        return d, saved, [f"no generation of {source}: {e}"]
    now = RU.fields_now(TESTVM, VMS, source, gen, RU.sha256_file(holt_file))
    return d, saved, RU.source_stale(saved, now, tier, d)


def prepare_with_ht1(src, port, d, gen):
    """ht1.sh's own source and backup phases on SRC, as a case runs them (HT_VARIANT=bs2,
    BS2_PREPARE=1: no case, no edits), on /bkoscratch in d/preps/NAME (HT_RAM=0,
    HT_CLEAN=0: kept as it ends); then what cases don't need goes, prep.json is written
    and d/prep points at it.  Returns its directory; dies when the run didn't pass."""
    from bs2lib import reuse as RU
    name = time.strftime("p-%Y%m%d-%H%M%S-") + str(os.getpid())
    k = f"{d}/preps/{name}"
    os.makedirs(f"{d}/preps", mode=0o755, exist_ok=True)
    env = dict(os.environ, HT_VARIANT="bs2", BS2_PREPARE="1", BS2_NAME=name, BS2_TIER="1", BS2_HOST=os.path.join(HERE, "bs2-host"),
               HT_RAM="0", HT_CLEAN="0", HT_RECORDS=d, HT_WORK=f"{RAM}/prep", HT_HOLT=holt_bin(), HT_PORT=str(port))
    for v in ("BS2_CASE", "BS2_CHAIN_IN", "BS2_CHAIN_OUT", "HT_KEEP", "HT_QUICK", "HT_THROUGH", "HT_FAIL_AT", "HT_SOURCE_PREP",
              "HT_RESCUER", "HT_RESCUER_IMG", "HT_RESERVE_PID", "HT_HOLT_BIN"):
        env.pop(v, None)
    log = f"{d}/preps/{name}.log"
    with open(log, "w") as f:
        r = subprocess.run([f"{TESTVM}/holttest1d/ht1.sh", src, "preps", "source", "backup"], env=env,
                           stdin=subprocess.DEVNULL, stdout=f, stderr=subprocess.STDOUT)
    try:
        with open(f"{k}/report.txt") as f:
            rep = f.read()
    except OSError:
        rep = ""
    if r.returncode or not rep.rstrip().endswith("RESULT: PASS"):
        fails = [l for l in rep.splitlines() if l.startswith("FAIL ")][:3]
        die(f"preparing {src}: ht1.sh exit {r.returncode}: {'; '.join(fails) or 'no report'} (see {k} and {log})", 1)
    # (A RESULT: PASS for phases that never ran or ended is no preparation: bs2lib/tier1.py.)
    from bs2lib import tier1 as T1
    gap = T1.phase_gaps(rep, T1.read_or(f"{k}/logs/phases.tsv"), T1.read_or(log))
    if gap:
        die(f"preparing {src}: ht1.sh said RESULT: PASS, but {gap} (see {k} and {log})", 1)
    # What the cases take: the overlays, dumps/, logs/, the report, the backup and its records.
    rustic = ""
    with open(f"{k}/logs/manifest.txt") as f:
        for line in f:
            w = line.split()
            if len(w) >= 3 and w[0] == "rustic-bko":
                rustic = w[2]
    holt = RU.sha256_file(f"{k}/share/bko-holt")
    os.makedirs(f"{k}/backup")
    for x in ("repo", "repo-password"):
        os.replace(f"{k}/share/{x}", f"{k}/backup/{x}")
    for x in ("share", "tmp", ".ht"):
        shutil.rmtree(f"{k}/{x}", ignore_errors=True)
    if os.path.exists(f"{k}/rustic-bko"):
        os.remove(f"{k}/rustic-bko")
    saved = RU.fields_now(TESTVM, VMS, src, gen, holt)
    saved.update(name=name, made=time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                 backup={"snapshot_path": f"/mnt/ht1-src-{name}", "rustic": rustic})
    with open(f"{k}/prep.json", "w") as f:
        json.dump(saved, f, indent=1)
    subprocess.run(["chmod", "-R", "a+rX", k])
    tmp = f"{d}/prep.new"
    if os.path.lexists(tmp):
        os.remove(tmp)
    os.symlink(f"preps/{name}", tmp)
    os.replace(tmp, f"{d}/prep")
    # The 3 newest stay: a case that began on the one before still reads its files.
    old = sorted(x for x in os.listdir(f"{d}/preps") if x.startswith("p-") and os.path.isdir(f"{d}/preps/{x}"))[:-3]
    for x in old:
        shutil.rmtree(f"{d}/preps/{x}", ignore_errors=True)
        if os.path.exists(f"{d}/preps/{x}.log"):
            os.remove(f"{d}/preps/{x}.log")
    return k


def cmd_source(a):
    """The source prepared for its cases, and its dump and tools for tier 0, once per
    generation (and again when bko-holt or what made the preparation changed)."""
    import fcntl
    src = a.source
    if os.geteuid() != 0:
        die("source: run as root (sudo -E)")
    if src.startswith("run:"):
        die("a BackShot1 run's source is copied in by bs2 on the Mac (layout.json and the run's tools)")
    d = source_dir(src)
    # (Readable by m, who runs the queue and the shrinker: a test guest's
    # dump stays on the host, never the Mac or the repository.)
    os.makedirs(d, mode=0o755, exist_ok=True)
    with open(f"{d}/.prep.lock", "a") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)   # (one preparation of a source at a time; the second finds it ready)
        gen = generation(src)
        _, _, why = prep_reasons(src, holt_bin())
        tools_ok = os.path.isdir(f"{d}/tools/usr") and source_ready(src) == gen
        if not a.force and tools_ok and not why:
            print(f"{src}: ready at {gen[:16]}")
            return
        k = prepare_with_ht1(src, a.port, d, gen) if why or a.force else prep_dir(src)
        with open(f"{k}/dumps/src.json") as f:
            dump = f.read()
        json.loads(dump)
        with open(f"{d}/src.json.part", "w") as f:
            f.write(dump)
        os.replace(f"{d}/src.json.part", f"{d}/src.json")
        if not tools_ok or a.force:
            copy_tools(src, k, d)
        with open(f"{d}/gen", "w") as f:
            f.write(gen + "\n")
        print(f"{src}: {'prepared anew' if why or a.force else 'preparation kept'} ({os.path.basename(k)}"
              f"{': ' + '; '.join(why[:2]) if why else ''}){', its tools copied' if not tools_ok or a.force else ''}, at {gen[:16]}")


def copy_tools(src, k, d):
    """The tools: the guest's root, copied out of a read-only mount of the preparation's overlay."""
    w = f"{RAM}/source-{src}"
    shutil.rmtree(w, ignore_errors=True)
    os.makedirs(w)
    env = dict(os.environ, TMPDIR=w)
    mp = f"{w}/mnt"
    os.makedirs(mp)
    from bs2lib import reuse as RU
    _, imgs = RU.vm_options(VMS, src)
    extra = []
    for i in range(1, len(imgs)):
        extra += ["--disk", f"{k}/src-{i}.qcow2"]
    key_args = []
    for kf in ("console-passphrase", "zfs-passphrase", "luks-passphrase", "luks-keyfile"):
        if os.path.exists(f"{VMS}/{src}/{kf}"):
            key_args = ["--key", f"{VMS}/{src}/{kf}"]
            break
    sh([f"{TESTVM}/vm-mount", "--ro"] + extra + key_args + [f"{k}/src-0.qcow2", mp], env=env, stdout=subprocess.DEVNULL)
    try:
        tools = f"{d}/tools"
        shutil.rmtree(tools, ignore_errors=True)
        sh(["rsync", "-a", "--exclude=/boot", "--exclude=/lib/modules", "--exclude=/lib/firmware", "--exclude=/usr/share/doc",
            "--exclude=/usr/share/man", "--exclude=/var/cache", "--exclude=/home", "--exclude=/root", "--exclude=/srv",
            f"{mp}/", f"{tools}/"])
    finally:
        subprocess.run([f"{TESTVM}/vm-umount", mp], env=env, stdout=subprocess.DEVNULL)
        shutil.rmtree(w, ignore_errors=True)


def cmd_prepared(a):
    """What ht1-bs2.sh's case may take from its source's preparation, as shell
    assignments (BS2_PREP_DIR, BS2_PREP_NAME, BS2_PREP_SNAP; BS2_PREP_BACKUP_WHY when its
    backup can't serve).  Exit 1, with BS2_PREP_WHY, when the preparation can't stand in
    for the case's source phase."""
    from bs2lib import reuse as RU
    d, saved, why = prep_reasons(a.source, a.holt, a.tier)
    if why:
        print(RU.shell_assign("BS2_PREP_WHY", "; ".join(why[:3]) + (f" (+{len(why) - 3} more)" if len(why) > 3 else "")))
        sys.exit(1)
    bwhy = RU.backup_stale(saved, a.rustic_sha, d) if a.rustic_sha else ["the case named no rustic-bko"]
    print(RU.shell_assign("BS2_PREP_DIR", d))
    print(RU.shell_assign("BS2_PREP_NAME", saved.get("name", os.path.basename(d))))
    print(RU.shell_assign("BS2_PREP_SNAP", "" if bwhy else saved["backup"]["snapshot_path"]))
    print(RU.shell_assign("BS2_PREP_BACKUP_WHY", "; ".join(bwhy[:2])))


def cmd_rescuer_key(a):
    """The saved rescuer's key: a line "HASH KIND", then the key text (bs2lib/reuse.py)."""
    from bs2lib import reuse as RU
    f = RU.rescuer_fields_now(TESTVM, a.image, a.rfw.split(), a.memory, a.extra.strip())
    text = RU.rescuer_key(f)
    sys.stdout.write(f"{RU.key_hash(text)} {RU.rescuer_kind(f)}\n{text}")


def load_source(source):
    gen = source_ready(source)
    if not gen:
        die(f"{source} isn't prepared at its current generation: sudo -E bs2-host source {source}")
    return gen, dumpx.load(f"{source_dir(source)}/src.json")


# ---- tier 0 ------------------------------------------------------------------------

def planner():
    p = os.environ.get("BS2_PLANNER") or f"{ROOT}/bin/bs2_plan"
    if not os.access(p, os.X_OK):
        die(f"no planner at {p} (bs2-host build)")
    return p


def caps_of():
    try:
        with open(f"{ROOT}/bin/caps.json") as f:
            return json.load(f)
    except OSError:
        return {}


def run_dir(run):
    d = f"{ROOT}/runs/{run}"
    os.makedirs(f"{d}/cases", exist_ok=True)
    return d


def tier0_cases(source, gen, dump, cases, run, keep_passes=0):
    """CASES: [(name, case)].  Runs them, writes the run's rows and the cases that didn't pass."""
    rd = run_dir(run)
    w = f"{RAM}/t0-{run}-{source}-{os.getpid()}"
    os.makedirs(w, exist_ok=True)
    tools = f"{source_dir(source)}/tools"
    tools = tools if os.path.isdir(f"{tools}/usr") and os.geteuid() == 0 else None
    t0 = time.time()
    results, plans = T0.run(dump, cases, w, planner(), tools, caps_of())
    wall = time.time() - t0
    counts = {}
    kept = 0
    with open(f"{rd}/tier0.jsonl", "a") as f:
        for (name, case), (_, verdict, why) in zip(cases, results):
            counts[verdict] = counts.get(verdict, 0) + 1
            f.write(json.dumps({"case": name, "hash": C.case_hash(case), "source": source, "gen": gen, "tier": 0,
                                "verdict": verdict, "why": why[:5], "t": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}) + "\n")
            if verdict != "PASS" or kept < keep_passes:
                kept += verdict == "PASS"
                C.write(f"{rd}/cases/{name}.case", dict(case, name=name))
                if verdict != "PASS":
                    with open(f"{rd}/cases/{name}.tier0.txt", "w") as g:
                        g.write("\n".join(why) + "\n\n" + plans.get(name, {}).get("out", "") + plans.get(name, {}).get("err", ""))
    L.write_rows(run, source, gen, [(n, c, v, w_) for (n, c), (_, v, w_) in zip(cases, results)], tier=0, wall=wall, bins=bins())
    shutil.rmtree(w, ignore_errors=True)
    print(json.dumps({"source": source, "cases": len(cases), "counts": counts, "wall_s": round(wall, 1), "dry_runs": bool(tools)}))
    return results


def bins():
    out = {}
    for name, p in (("linux/bko-holt", holt_bin()), ("bs2_plan", os.environ.get("BS2_PLANNER") or f"{ROOT}/bin/bs2_plan"),
                    ("linux/rustic-bko", f"{WORK}/bko-bin/linux/rustic-bko")):
        try:
            with open(p, "rb") as f:
                out[name] = "sha256:" + hashlib.sha256(f.read()).hexdigest()
        except OSError:
            out[name] = "missing"
    return out


def cmd_tier0(a):
    gen, dump = load_source(a.source)
    stats = G.Stats()
    cases = []
    for seed in range(a.start, a.start + a.n):
        c = G.generate(a.source, gen, dump, seed, caps=caps_of(), stats=stats)
        cases.append((C.name_of(c), c))
    tier0_cases(a.source, gen, dump, cases, a.run, a.keep_passes)
    print(json.dumps({"generator": {"tried": stats.tried, "kept": stats.kept,
                                    "discarded": dict(sorted(stats.discarded.items(), key=lambda x: -x[1])[:12])}}))


def cmd_tier0_cases(a):
    groups = {}
    for p in a.cases:
        c = C.read(p)
        groups.setdefault(C.source_name(c), []).append((c.get("name") or C.name_of(c), c))
    for src, cs in groups.items():
        gen, dump = load_source(src)
        tier0_cases(src, gen, dump, cs, a.run)


def cmd_gen(a):
    gen, dump = load_source(a.source)
    c = G.generate(a.source, gen, dump, a.seed, caps=caps_of())
    c["name"] = C.name_of(c)
    sys.stdout.write(C.text(c))


def cmd_caps(a):
    """Whether the bko-holt under test plans --new-uuids (it refused, "isn't built yet", until it does)."""
    gen, dump = load_source(a.source)
    w = f"{RAM}/caps-{os.getpid()}"
    os.makedirs(w, exist_ok=True)
    c = {"source": a.source, "edits": [], "load_options": ["--new-uuids"]}
    res, plans = T0.run(dump, [("caps", c)], w, planner(), None, {})
    caps = {"new_uuids": res[0][1] == "PASS", "probe": res[0][2][:2]}
    with open(f"{ROOT}/bin/caps.json", "w") as f:
        json.dump(caps, f)
    shutil.rmtree(w, ignore_errors=True)
    print(json.dumps(caps))


# ---- tier 1 and 2: ht1.sh's hooks (ht1-bs2.sh) -------------------------------------

def q(x):
    import shlex
    return shlex.quote(str(x))


def cmd_apply(a):
    """The drifted layout from a fresh dump, and ht1-bs2.sh's settings as shell."""
    from bs2lib import sweep
    c = C.read(a.case)
    src = dumpx.load(a.src)
    drifted = C.replay(c, src)
    with open(a.out, "w") as f:
        json.dump(drifted, f, indent=1)
    targets = C.targets(c, drifted)
    order = [dk["name"] for dk in dumpx.disks(drifted)]
    ex = sweep.expected(c)
    flags, o, i = [], list(c.get("load_options") or []), 0
    while i < len(o):
        if o[i] == "--snapshot":
            i += 2
            continue
        flags.append(o[i])
        i += 1
    judge = ["--expect"]
    delta = targets[order[0]] - dumpx.disk(drifted, order[0])["size_bytes"]
    if ex["fit"] is not None:
        judge += ["--fit", str(delta), "--fit-pct", str(ex["fit"])]
    elif delta > 0:
        judge += ["--grow", str(delta)]
    elif delta < 0:
        die("a smaller target without --fit-largest", 1)
    if ex["new_uuids"]:
        judge.append("--new-uuids")
    if ex["removable"]:
        judge.append("--removable")
    if a.tier == 2:
        judge.append("--nvram-kept")
    snaps = c.get("snapshots") or {}
    print(f"BS2_EDITS={len(c.get('edits') or [])}")
    print("BS2_TARGETS=(" + " ".join(q(targets[n]) for n in order) + ")")
    print("BS2_FLAGS=(" + " ".join(q(x) for x in flags) + ")")
    print(f"BS2_SNAPS={snaps.get('count', 1)} BS2_RESTORE={snaps.get('restore', 0) if snaps else 0}")
    print(f"BS2_CONTENT={1 if c.get('content') else 0}")
    # Whether the case's backup is the prepared one's tree (bs2lib/reuse.py: no content, one snapshot).
    from bs2lib import reuse as RU
    print(f"BS2_SHARE_BACKUP={1 if RU.backup_shareable(c)[0] else 0}")
    print("BS2_JUDGE=(" + " ".join(q(x) for x in judge) + ")")
    print("BS2_FSJUDGE=(" + (" --new-uuids" if ex["new_uuids"] else "") + ")")
    # The leftovers set's: the stale layer to seed, and each partition's type.
    from bs2lib import leftovers as LO
    sd = c.get("layer_seed")
    print("BS2_SEED=(" + (" ".join(q(sd[k]) for k in ("kind", "start_lba", "sectors")) if sd else "") + ")")
    print("BS2_EXPECT=(" + " ".join(q(f"{n}:{t}") for n, t in sorted(LO.expected_types(drifted).items())) + ")")


def _content_fs(root):
    r = subprocess.run(["findmnt", "-n", "-o", "FSTYPE", "--target", root], capture_output=True, text=True)
    return r.stdout.strip() or "ext4"


def cmd_plant(a):
    from bs2lib import content as CT
    c = C.read(a.case)
    # The long symlink must fit the source's filesystem, planted here, and
    # the one restored onto (ext4's limit is its block size less one, which
    # an ext4_geometry may shrink): the tighter of the two.
    fs = _content_fs(a.root)
    at = a.root + CT.DIR
    while not os.path.isdir(at) and at != a.root:
        at = os.path.dirname(at)
    lim = CT.tightest(CT.fs_symlink_max(fs, os.statvfs(at).f_bsize),
                      CT.symlink_max(dumpx.load(a.layout)) if a.layout else None)
    entries = CT.plan(c["content"], fs, symlink_max=lim)
    fails = CT.plant(a.root, entries)
    for i, why in fails:
        print(f"could not plant entry {i}: {why}")
    b, n = CT.sizes(entries)
    print(f"{len(entries)} entries ({n} inodes, ~{b >> 20} MiB) under {CT.DIR}, {len(fails)} not made")
    sys.exit(1 if fails else 0)


def cmd_deep(a):
    from bs2lib import content as CT
    if a.what == "record":
        rec = CT.deep_record(a.root)
        with open(a.file, "w") as f:
            json.dump(rec, f)
        print(f"{len(rec)} entries, the longest path {max((len(k) // 2 for k in rec), default=0)} bytes")
        return
    # compare: exit 0 agrees, 1 differs, 3 the case plants no deep tree
    # (nothing to compare), 4 the source's record lacks what was planted;
    # ht1-bs2.sh's bs2_after_dst_record gives each its own check.
    if not a.case:
        die("deep compare needs --case: whether there is a deep tree to compare is the case's content's plan")
    planned = CT.deep_planned(C.read(a.case).get("content"))
    with open(a.file) as f:
        before = json.load(f)
    after = CT.deep_record(a.root) if planned else {}
    verdict, lines = CT.deep_verdict(planned, before, after)
    for l in lines[:20]:
        print(l)
    longest = max((len(k) // 2 for k in before), default=0)
    if verdict == "none":
        print(f"the case's content plants no deep tree ({len(before)} entries recorded): nothing to compare")
    elif verdict == "missing":
        print(f"{len(lines)} of {len(planned)} planned entries not in the source's record of {len(before)} entries, the longest path {longest} bytes")
    else:
        print(f"{len(lines)} differences in {len(before)} entries, the longest path {longest} bytes")
    sys.exit({"agrees": 0, "differs": 1, "none": 3, "missing": 4}[verdict])


