def tier0_cases(source, gen, dump, cases, run, keep_passes=0):
    """CASES: [(name, case)].  Runs them, writes the run's rows and the cases that didn't pass."""
    rd = run_dir(run)
    w = f"{RAM}/t0-{run}-{source}-{os.getpid()}"
    os.makedirs(w, exist_ok=True)
    d = source_dir(source)
    tools, lk = None, None
    if not tools_wanted(dump):
        pass   # (its family's tier 0 is the plan alone: T0.run)
    elif source.startswith("run:"):   # (a BackShot1 run's tools: copied in by bs2 with its layout)
        tools = f"{d}/tools" if os.path.isdir(f"{d}/tools/usr") and os.geteuid() == 0 else None
    elif os.geteuid() != 0:
        # (As m, chroot can't run: the plan and invariants alone, each row saying "no dry runs";
        # the leftovers set's own tier 0, before its VMs, is m's.)
        print(f"bs2-host: {source}: tier 0 as {os.geteuid()}, not root: no dry runs (the plan and its invariants only)",
              file=sys.stderr)
    else:
        for _ in range(3):   # (copied here when they aren't: ensure_tools(); held shared while they run)
            ensure_tools(source)
            lk = tools_lock(d, False)
            if tools_fresh(source, gen):
                tools = f"{d}/tools"
                break
            lk.close()
            lk = None
        else:
            die(f"{source}: its tools here aren't its generation {gen[:16]}'s after copying them (did vms/{source} change?)", 1)
    t0 = time.time()
    try:
        results, plans = T0.run(dump, cases, w, planner(), tools, caps_of())
    finally:
        if lk:
            lk.close()
    wall = time.time() - t0
    counts = {}
    kept = 0
    with open(f"{rd}/tier0.jsonl", "a") as f:
        for (name, case), (_, verdict, why) in zip(cases, results):
            counts[verdict] = counts.get(verdict, 0) + 1
            f.write(json.dumps({"case": name, "hash": C.case_hash(case), "source": source, "gen": gen, "tier": 0,
                                "verdict": verdict, "why": why[:5], "t": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}) + "\n")
            if verdict != "PASS" or kept < keep_passes:
                kept += verdict == "PASS"
                C.write(f"{rd}/cases/{name}.case", dict(case, name=name))
                if verdict != "PASS":
                    with open(f"{rd}/cases/{name}.tier0.txt", "w") as g:
                        g.write("\n".join(why) + "\n\n" + plans.get(name, {}).get("out", "") + plans.get(name, {}).get("err", ""))
    L.write_rows(run, source, gen, [(n, c, v, w_) for (n, c), (_, v, w_) in zip(cases, results)], tier=0, wall=wall, bins=bins())
    shutil.rmtree(w, ignore_errors=True)
    print(json.dumps({"source": source, "cases": len(cases), "counts": counts, "wall_s": round(wall, 1), "dry_runs": bool(tools)}))
    return results


