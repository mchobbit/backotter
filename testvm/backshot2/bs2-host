# ---- preparations nothing uses any more ---------------------------------------------------

def qcow2_backing(path):
    """The backing file named in the qcow2 header of PATH, or None (no backing, not a qcow2)."""
    import struct
    try:
        with open(path, "rb") as f:
            h = f.read(20)
            if len(h) < 20 or h[:4] != b"QFI\xfb":
                return None
            off, n = struct.unpack(">QI", h[8:20])
            if not off or not n or n > 4096:
                return None
            f.seek(off)
            return f.read(n).decode("utf-8", "replace")
    except OSError:
        return None


def prep_refs(scan_dirs=None, proc="/proc"):
    """The paths live work holds now, real: every open file and cwd of every process
    (PROC), and every qcow2's backing file under SCAN_DIRS (default: the RAM disk's work,
    and /bkoscratch's: ROOT less sources/ and rescuer-state/), as a case's overlay on a
    preparation names it between its VMs (ht1-bs2.sh's bs2_source_take)."""
    out = set()
    try:
        pids = [p for p in os.listdir(proc) if p.isdigit()]
    except OSError:
        pids = []
    for p in pids:
        for link in [f"{proc}/{p}/cwd"] + [f"{proc}/{p}/fd/{x}" for x in _listdir(f"{proc}/{p}/fd")]:
            try:
                t = os.readlink(link)
            except OSError:
                continue
            if t.startswith("/"):
                out.add(t.split(" (deleted)")[0])
    for top in scan_dirs if scan_dirs is not None else (RAM, ROOT):
        for dp, dns, fns in os.walk(top):
            if dp == top and top == ROOT:
                dns[:] = [x for x in dns if x not in ("sources", "rescuer-state")]
            try:
                dev = os.stat(dp).st_dev
            except OSError:
                continue
            if dp == top:
                top_dev = dev
            elif dev != top_dev:   # (never into a mount: a tier 0's chroot binds /proc, /dev and the tools)
                dns[:] = []
                continue
            for fn in fns:
                if fn.endswith(".qcow2"):
                    b = qcow2_backing(f"{dp}/{fn}")
                    if b:
                        out.add(os.path.realpath(os.path.join(dp, b)))
    return out


def _listdir(p):
    try:
        return os.listdir(p)
    except OSError:
        return []


def prune_preps(d, refs=None):
    """D's preparations (preps/p-*) that nothing uses any more, removed with their logs: every
    one but the current (D/prep) that no live work refers to (prep_refs(): a running
    process's open file or cwd in it, or a case's overlay backed by its disk).  A case that
    began on an older one (bs2-host prepared named it) keeps it while it runs; the next
    preparation of the source removes it.  Returns [(name, bytes)] removed."""
    cur = os.path.realpath(f"{d}/prep") if os.path.isdir(f"{d}/prep") else None
    old = [x for x in sorted(_listdir(f"{d}/preps")) if x.startswith("p-") and os.path.isdir(f"{d}/preps/{x}")
           and os.path.realpath(f"{d}/preps/{x}") != cur]
    if not old:
        return []
    refs = prep_refs() if refs is None else refs
    out = []
    for x in old:
        p = os.path.realpath(f"{d}/preps/{x}")
        if any(r == p or r.startswith(p + "/") for r in refs):
            continue
        n = du_bytes(p)
        shutil.rmtree(p, ignore_errors=True)
        if os.path.exists(f"{d}/preps/{x}.log"):
            os.remove(f"{d}/preps/{x}.log")
        out.append((x, n))
    return out


def pruned_words(pruned):
    """", N older preparations removed (G GiB)" for PRUNED (prune_preps()'s), or ""."""
    return f", {len(pruned)} older preparations removed ({sum(b for _, b in pruned) / 2**30:.1f} GiB)" if pruned else ""


def cmd_room(a):
    """What /bkoscratch has for SOURCES here, as one line of JSON (bs2's space preflight,
    bs2lib/space.py): its free bytes, and for each source whether its current preparation
    can serve its cases now (prep_ok: bs2-host source would keep it), that one's bytes,
    the bytes of the older ones nothing uses (old_bytes: the next bs2-host source removes
    them), whether its tools are current (tools_fresh) and their bytes.  As root (it reads
    root's files and /proc); changes nothing but the size it records for tools copied
    before TOOLS_VERSION 2 (tools.json, version 1)."""
    os.makedirs(ROOT, exist_ok=True)
    st = os.statvfs(ROOT)
    refs = prep_refs()
    out = {"free": st.f_bavail * st.f_frsize, "size": st.f_blocks * st.f_frsize, "sources": {}}
    for s in a.sources:
        d = source_dir(s)
        e = {}
        if not os.path.isdir(f"{d}/preps") and not os.path.isdir(f"{d}/tools"):
            # (Nothing here yet: no generation worked out, which may hash its whole image.)
            out["sources"][s] = {"prep_ok": False, "prep_bytes": 0, "old_bytes": 0, "tools_fresh": False, "tools_bytes": 0}
            continue
        try:
            gen = generation(s)
        except OSError as x:
            e["error"] = f"no generation: {x}"
            out["sources"][s] = e
            continue
        k, _, why = prep_reasons(s, holt_bin())
        e["prep_ok"] = bool(k) and source_ready(s) == gen and not why
        e["prep_bytes"] = du_bytes(k) if k else 0
        old = [x for x in _listdir(f"{d}/preps") if x.startswith("p-") and os.path.isdir(f"{d}/preps/{x}")
               and os.path.realpath(f"{d}/preps/{x}") != k]
        e["old_bytes"] = sum(du_bytes(f"{d}/preps/{x}") for x in old
                             if not any(r == os.path.realpath(f"{d}/preps/{x}") or
                                        r.startswith(os.path.realpath(f"{d}/preps/{x}") + "/") for r in refs))
        e["tools_fresh"] = tools_fresh(s, gen)
        m = tools_meta(d)
        if os.path.isdir(f"{d}/tools"):
            if not m or m.get("bytes") is None:
                m = {"gen": None, "version": 1, "bytes": du_bytes(f"{d}/tools")}
                try:
                    with open(f"{d}/tools.json", "w") as f:
                        json.dump(m, f)
                except OSError:
                    pass
            e["tools_bytes"] = m["bytes"]
        else:
            e["tools_bytes"] = 0
        out["sources"][s] = e
    print(json.dumps(out))


