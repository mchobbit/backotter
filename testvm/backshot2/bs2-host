# ---- the leftovers set (bs2lib/leftovers.py) ----------------------------------------

def leftovers_cases(name):
    from bs2lib import leftovers as LO
    dumps, gens = {}, {}
    for s_ in LO.sources(name):
        gens[s_], dumps[s_] = load_source(s_)
    return LO.generate(name, dumps, gens), dumps, gens


def cmd_leftovers(a):
    """The set's steps in order on one disk (each step's restored disk is the
    next step's target, in RAM), each a tier 1 under its own reservation, as
    m.  Stops at the first step that doesn't pass: the steps after it would
    start on a disk the set didn't mean.  The rows go to RUN/leftovers.jsonl."""
    from bs2lib import leftovers as LO
    cases, dumps, gens = leftovers_cases(a.set)
    os.environ["BS2_NO_LEDGER"] = "1"   # (not the generator's draws: its own rows, leftovers.jsonl)
    rd = run_dir(a.run)
    for c in cases:
        C.write(f"{rd}/cases/{c['name']}.case", c)
        al = c["chain"].get("aligned")
        print(f"{c['chain']['step']}/{c['chain']['of']} {c['name']}: {c['note']}" +
              (f"; vda{al['partition']} starts at sector {al['sector']}, on the {al['from']}'s {al['on']}" if al else ""))
    # Tier 0 first: a plan load refuses or gets wrong stops the set before a VM starts.
    for c in cases:
        src = C.source_name(c)
        res = tier0_cases(src, gens[src], dumps[src], [(c["name"], c)], a.run + "-t0")
        if res[0][1] != "PASS":
            die(f"{c['name']}: tier 0 {res[0][1]}: {res[0][2][:2]}", 1)
    if a.plan:
        print(f"{len(cases)} steps, ~{len(cases) * 3} min at tier 1, one after another")
        return
    chain = f"{RAM}/leftovers-{a.run}"
    os.makedirs(chain, exist_ok=True)
    prev = f"{chain}/{cases[a.start - 2]['chain']['id']}.qcow2" if a.start > 1 else ""
    if prev and not os.path.exists(prev):
        die(f"--from {a.start}: no {prev} (the step before's disk)")
    stop = None
    for c in cases[a.start - 1:]:
        out = f"{chain}/{c['chain']['id']}.qcow2"
        p = f"{rd}/cases/{c['name']}.case"
        env = dict(os.environ, BS2_CHAIN_IN=prev, BS2_CHAIN_OUT=out, BS2_RELEASE="1" if a.release else "0",
                   WEAR_TAG=f"bs2:{a.run}:{c['chain']['id']}")
        r = subprocess.run([f"{WORK}/cmp-run.sh", "--reserve", a.disk, a.mem, "sudo", "-E", os.path.join(HERE, "bs2-host"), "tier1", p,
                            "--tier", "1", "--run", a.run, "--port", str(a.port)], cwd=WORK, env=env, capture_output=True, text=True)
        try:
            line = json.loads([l for l in r.stdout.splitlines() if l.startswith("{")][-1])
        except (IndexError, ValueError):
            line = {"verdict": "HARNESS", "check": "no result", "why": [r.stdout[-300:] + r.stderr[-300:]]}
        notes = []
        try:
            with open(f"{line.get('dir')}/report.txt") as f:
                notes = [l.rstrip() for l in f if l.startswith(("note: leftovers", "FAIL leftovers", "PASS leftovers"))]
        except (OSError, TypeError):
            pass
        row = {"set": a.set, "release": a.release, "step": c["chain"]["step"], "id": c["chain"]["id"], "case": c["name"], "verdict": line["verdict"],
               "check": line.get("check"), "why": line.get("why"), "aligned": c["chain"].get("aligned"), "seed": c.get("layer_seed"),
               "leftovers": notes, "dir": line.get("dir"), "holt": holt_bin(), "bins": bins(),
               "t": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
        with open(f"{rd}/leftovers.jsonl", "a") as f:
            f.write(json.dumps(row) + "\n")
        print(f"{c['chain']['id']}: {line['verdict']}{' (' + str(line.get('check')) + ')' if line['verdict'] != 'PASS' else ''}")
        for n in notes:
            print(f"   {n}")
        if line["verdict"] != "PASS" or not os.path.exists(out):
            # (The step's input disk stays, for --from: rerun from this step.)
            stop = c["chain"]["step"], c["chain"]["id"]
            break
        if prev and not a.keep:
            os.remove(prev)
        prev = out
    if not stop and prev and not a.keep:
        os.remove(prev)
    if stop:
        print(f"stopped at {stop[1]}: the steps after it would start on a disk the set didn't mean (rerun it: --run {a.run} --from {stop[0]})")
        sys.exit(1)
    print("leftovers: every step passed")


# ---- shrinking ---------------------------------------------------------------------------

def t0_check(why):
    """A tier 0 failure's check, without its numbers: what a shrink must keep failing."""
    import re
    w = why[0] if why else ""
    w = re.sub(r"(layout|made) [^;,]*", r"\1 X", w)
    w = re.sub(r"\b(vd|sd|nvme)[a-z0-9]+", "DEV", w)
    w = re.sub(r"\d+", "N", w)
    return w[:90]


def cmd_shrink(a):
    """CASE (failing at TIER) down to the smallest case failing the same way;
    saved as ROOT/fails/fail-NNN-NAME.case with the check and an excerpt."""
    from bs2lib import shrink as S, tier1 as T1
    c = C.read(a.case)
    src = C.source_name(c)
    gen, dump = load_source(src)
    name0 = c.get("name") or C.name_of(c)
    work_run = f"shrink-{name0}"
    os.environ["BS2_NO_LEDGER"] = "1"

    def run(case):
        nm = C.name_of(case)
        if a.tier == 0:
            res = tier0_cases(src, gen, dump, [(nm, case)], work_run)
            v, why = res[0][1], res[0][2]
            return v, (t0_check(why) if v == "FAIL" else None), why
        p = f"{run_dir(work_run)}/cases/{nm}.case"
        C.write(p, dict(case, name=nm))
        r = subprocess.run([f"{WORK}/cmp-run.sh", "--reserve", "2", "3", "sudo", "-E", "BS2_NO_LEDGER=1", os.path.join(HERE, "bs2-host"), "tier1", p,
                            "--tier", str(a.tier), "--run", work_run, "--port", str(a.port)], cwd=WORK, capture_output=True, text=True)
        try:
            line = json.loads([l for l in r.stdout.splitlines() if l.startswith("{")][-1])
        except (IndexError, ValueError):
            return "HARNESS", None, [r.stdout[-300:] + r.stderr[-300:]]
        return line["verdict"], line.get("check"), line.get("why") or []

    v, check, why = run(c)
    if v != "FAIL":
        die(f"{name0} doesn't fail at tier {a.tier} now ({v}: {why[:1]})", 1)
    print(f"{name0}: fails at tier {a.tier}: {check}")

    def still(case):
        v2, ch2, _ = run(case)
        return v2 == "FAIL" and ch2 == check

    sh_ = S.Shrinker(dump, still, budget=a.budget)
    best = sh_.shrink(c)
    v, check2, why = run(best)
    os.makedirs(f"{ROOT}/fails", exist_ok=True)
    n = len(glob.glob(f"{ROOT}/fails/fail-*.case")) + 1
    short = "".join(ch if ch.isalnum() else "-" for ch in (a.short or check.split(":")[0]).lower())[:32].strip("-")
    out = f"{ROOT}/fails/fail-{n:03d}-{short}.case"
    best = dict(best, name=f"fail-{n:03d}-{short}", failed={"tier": a.tier, "check": check, "excerpt": [str(x)[:300] for x in why[:3]]},
                **{"from": name0})
    best["source"] = c["source"]
    C.write(out, best)
    print(json.dumps({"saved": out, "edits": len(best["edits"]), "options": best.get("load_options"), "runs": sh_.runs, "check": check}))


# ---- the queue ------------------------------------------------------------------------

def cmd_enqueue(a):
    """Cases for tier T: drawn from SEED on, kept when they pass tier 0 here
    (a tier 0 FAIL is a finding already), and for tier 2 only those that touch
    an ESP or ask for --no-nvram or --removable.  Their lines go on RUN/queue.txt,
    or with --to in FILE (written anew), for bs2 to split over its hosts."""
    gen, dump = load_source(a.source)
    rd = run_dir(a.run)
    picked, seed, tried = [], a.start, 0
    while len(picked) < a.n and tried < a.n * 40:
        batch = []
        for s_ in range(seed, seed + max(20, a.n)):
            c = G.generate(a.source, gen, dump, s_, caps=caps_of())
            if a.tier == 2 and not C.touches_esp(c, dump):
                continue
            batch.append((C.name_of(c), c))
        seed += max(20, a.n)
        tried += max(20, a.n)
        if not batch:
            continue
        res = tier0_cases(a.source, gen, dump, batch, a.run + "-t0")
        for (name, c), (_, v, _) in zip(batch, res):
            if v == "PASS" and len(picked) < a.n:
                p = f"{rd}/cases/{name}.case"
                C.write(p, dict(c, name=name))
                picked.append(p)
    with open(a.to or f"{rd}/queue.txt", "w" if a.to else "a") as f:
        for p in picked:
            f.write(f"{a.tier} {p}\n")
    print(json.dumps({"enqueued": len(picked), "tier": a.tier, "source": a.source, "next_seed": seed}))


def cmd_queue(a):
    """SLOTS workers taking the run's queue.txt in order (a flock'd counter), each case
    under its own cmp-run.sh reservation, as m; RUN/stop stops new starts.  A worker
    a port: SLOTS of PORTS at most (2943-2948: 2949 is a by-hand tier 1's)."""
    import fcntl
    rd = run_dir(a.run)
    lo, hi = (int(x) for x in a.ports.split("-"))
    ports = list(range(lo, hi + 1))
    if not 1 <= a.slots <= len(ports):
        die(f"queue: --slots {a.slots}: 1 to {len(ports)}, a port each of {a.ports}")
    ports = ports[: a.slots]

    def take():
        with open(f"{rd}/queue.next", "a+") as f:
            fcntl.flock(f, fcntl.LOCK_EX)
            f.seek(0)
            n = int(f.read().strip() or 0)
            try:
                with open(f"{rd}/queue.txt") as q:
                    lines = [l.split() for l in q if l.strip()]
            except OSError:
                lines = []
            if n >= len(lines) or os.path.exists(f"{rd}/stop"):
                return None
            f.seek(0)
            f.truncate()
            f.write(str(n + 1))
            return lines[n]

    def worker(port):
        while True:
            job = take()
            if not job:
                return
            tier, path = job
            subprocess.run([f"{WORK}/cmp-run.sh", "--reserve", a.disk, a.mem, "sudo", "-E", os.path.join(HERE, "bs2-host"), "tier1", path,
                            "--tier", tier, "--run", a.run, "--port", str(port)],
                           env=dict(os.environ, WEAR_TAG=f"bs2:{a.run}:{os.path.basename(path)}"), cwd=WORK,
                           stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    import threading
    ts = [threading.Thread(target=worker, args=(p,)) for p in ports]
    for t in ts:
        t.start()
        time.sleep(20)
    for t in ts:
        t.join()
    print("queue done")


