# bsdinstall script for a BackOtter HardenedBSD test guest; see bsdinstall(8),
# SCRIPTING.  make-hardenedbsd.sh fills in the placeholders and puts this on
# the install media as /etc/installerconfig.  HardenedBSD's bsdinstall is
# FreeBSD's, so this is freebsd/installerconfig for media that carry the
# base system as tarballs only (no pkgbase).
#
# Everything up to the "#!" line is the preamble, sourced by the installer
# itself (on the install media).

if [ @ROOT_FS@ = zfs ]; then
	# GPT with a BIOS boot partition, 2 GB swap, pool "zroot" on the rest.
	export ZFSBOOT_DISKS=vtbd0
	export ZFSBOOT_VDEV_TYPE=stripe
	export ZFSBOOT_PARTITION_SCHEME=GPT
	export ZFSBOOT_BOOT_TYPE=BIOS
	export ZFSBOOT_SWAP_SIZE=2g
	export ZFSBOOT_CONFIRM_LAYOUT=0
else
	# The installer adds the BIOS boot partition itself.
	PARTITIONS="vtbd0 GPT { 2G freebsd-swap, auto freebsd-ufs / }"
fi
# The installer runs its steps as "bsdinstall STEP" in the shell that sources
# this preamble, so this function stands in for the command.
bsdinstall() {
	case $1 in
	mount)
		# UFS: TRIM on, so that the blocks it frees go back to the disk
		# image (vm-run --discard) as they are freed; trim.sh can't trim
		# UFS, and tunefs can't change it once mounted, as it is for the
		# post-install.
		for p in $(gpart show -p vtbd0 | awk '$4 == "freebsd-ufs" { print $3 }'); do
			tunefs -t enable /dev/$p || return
		done
		command bsdinstall "$@" ;;
	umount)
		# ZFS: the step ends with "umount -F FSTAB -a" over the installer's
		# fstab entries with a mount point.  On a ZFS root there are none,
		# umount fails with "fstab reading failure", and that fails the
		# whole install (FreeBSD 15.1's, which HardenedBSD 15-STABLE's
		# shares).  The pool is exported cleanly afterwards anyway, so
		# ignore that one step's result.
		if [ @ROOT_FS@ = zfs ]; then
			command bsdinstall "$@" || f_dprintf "BackOtter: ignoring the umount step's failure"
		else
			command bsdinstall "$@"
		fi ;;
	*)
		command bsdinstall "$@" ;;
	esac
}
export nonInteractive=YES
DISTRIBUTIONS="kernel.txz base.txz"

#!/bin/sh
# Post-install: runs inside the new system, chrooted.
set -e

sysrc hostname=@HOSTNAME@ ifconfig_vtnet0=DHCP sshd_enable=YES

echo '@ROOT_PASSWORD_HASH@' | pw usermod root -H 0
mkdir -p -m 700 /root/.ssh
echo '@AUTHORIZED_KEY@' >/root/.ssh/authorized_keys
chmod 600 /root/.ssh/authorized_keys
# sshd refuses root by default; the first setting in the file wins.
printf '%s\n' '' '# BackOtter test guest' 'PermitRootLogin prohibit-password' >>/etc/ssh/sshd_config

# Loader and kernel on the serial console as well as the screen, so vm-run's
# terminal (and --serial-log) shows the boot and a login prompt.
cat >>/boot/loader.conf <<'EOF'
boot_multicons="YES"
console="comconsole,vidconsole"
autoboot_delay="3"
EOF
