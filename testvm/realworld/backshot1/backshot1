#!/usr/bin/env bash
# BackShot1: a bare-metal backup and restore of the Thinkpad, driven over SSH.
# Run from the controlling machine; README.md has the whole procedure.
#
#   backshot1 stage TOOLS_DIR     put the scripts, tools and keys on the backup drive
#   backshot1 adopt               run bs1-adopt on the machine, over the old login
#   backshot1 preflight           check everything phase1 needs; changes nothing
#   backshot1 phase1              back up the running system; prints RUN=...
#   backshot1 list                the backups on the drive, and how each last restored
#   backshot1 find-rescue         find the booted rescue stick; prints its address
#   backshot1 plan NAME           on the stick: read the backup, plan the restore
#   backshot1 phase2 NAME         on the stick: WIPE the internal disk, restore
#   backshot1 reboot              on the stick: boot the restored system
#   backshot1 verify NAME         on the restored system: check it
#
# Hands-free (README.md, "The hands-free cycle"):
#
#   backshot1 stick-on            give the firmware a boot entry for the stick
#   backshot1 to-stick            reboot the installed system onto the stick, once
#   backshot1 wait-host           wait for the restored system to answer
#   backshot1 cycle NAME COUNT --erase-serial SERIAL
#                                 COUNT restores of NAME, unattended: WIPES the disk
#   backshot1 stick-off           remove the stick's boot entry again
#
# NAME is a run, or a distro for its newest backup: ubuntu-26.10, debian-13.

set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
# shellcheck disable=SC1091
. "$here/thinkpad.conf"

HOST=${BS1_HOST:-thinkpad.local}
MACS=(00:e0:4c:68:23:c3 c8:a3:62:50:99:10 84:a9:38:9f:66:52)      # USB Ethernet adapters, the onboard port
STATE=${BS1_STATE:-${TMPDIR:-/tmp}/backshot1-state}
mkdir -p "$STATE"
KEYS=${BS1_KEYS:-$HOME/.ssh/backshot1}
[[ -s $KEYS/id_ed25519 && -s $KEYS/known_hosts ]] || die_nokeys=1
# Every install and the stick present one pinned host key (make-keys, bs1-adopt).
OPTS=(-o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=30
      -i "$KEYS/id_ed25519" -o IdentitiesOnly=yes
      -o HostKeyAlias=bs1-thinkpad -o UserKnownHostsFile="$KEYS/known_hosts" -o StrictHostKeyChecking=yes)

die() { echo "backshot1: $*" >&2; exit 1; }
[[ -z ${die_nokeys:-} ]] || die "no keys in $KEYS: run make-keys"
# Before bs1-adopt the machine knows only the old login.
old_login_if_new() {
    ssh "${OPTS[@]}" "root@$HOST" true 2>/dev/null || OPTS=(-o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=30)
}
on_host() { ssh "${OPTS[@]}" "root@$HOST" "$@"; }
on_rescue() {
    [[ -s $STATE/rescue-ip ]] || die "run find-rescue first"
    ssh "${OPTS[@]}" "backotter@$(cat "$STATE/rescue-ip")" "$@"
}

# Prints the drive's mount point on the machine, mounting it if nothing has.
DRIVE="d=\$(findmnt -nro TARGET -S LABEL=$BACKUP_LABEL | head -n 1); if [ -z \"\$d\" ]; then mkdir -p /mnt/bs1-backup; mount LABEL=$BACKUP_LABEL /mnt/bs1-backup || exit 1; d=/mnt/bs1-backup; fi"

# run_on_drive SCRIPT ARGS...: on the installed system or the stick, whichever is up.
run_on_drive() {
    local script=$1
    shift
    local cmd="$DRIVE; exec bash \"\$d/backshot1/$script\" $*"
    if on_host true 2>/dev/null; then on_host "$cmd"; else on_rescue "sudo -n bash -c '$cmd'"; fi
}
resolve_run() { run_on_drive bs1-list --resolve "$1" || die "can't choose a backup for \"$1\""; }

# The firmware's boot entry for the stick, on the installed system or the
# stick itself.  An entry naming the stick's EFI partition, not the firmware's
# "USB HDD", which can pick the backup drive and fall through to the disk.
STICK_ENTRY='
label="BackShot stick"
entry() { efibootmgr | sed -n "s/^Boot\([0-9A-Fa-f]\{4\}\).*$label.*/\1/p" | head -n 1; }
'
# Run a script (stdin) as root on whichever is up.
as_root() { if on_host true </dev/null 2>/dev/null; then on_host 'bash -s'; else on_rescue 'sudo -n bash -s'; fi; }

stick_on() {
    as_root <<EOF
set -euo pipefail
$STICK_ENTRY
disk=\$(lsblk -lnpo NAME,LABEL,PKNAME | awk '\$2 == "BACKOTTER" { print \$3; exit }')
[[ -n \$disk ]] || { echo "no stick with a BACKOTTER partition is plugged in" >&2; exit 1; }
[[ \$(blkid -s TYPE -o value "\${disk}2") == vfat ]] || { echo "\${disk}2 isn't the stick's EFI partition" >&2; exit 1; }
n=\$(entry)
if [[ -z \$n ]]; then
    efibootmgr -q -C -d "\$disk" -p 2 -L "\$label" -l '\\EFI\\BOOT\\BOOTX64.EFI'
    n=\$(entry)
fi
[[ -n \$n ]] || { echo "the firmware didn't keep the stick's boot entry" >&2; exit 1; }
mode=/sys/class/firmware-attributes/thinklmi/attributes/BootMode/current_value
if [[ -r \$mode && \$(<"\$mode") != Diagnostics ]]; then
    echo "warning: BootMode is \$(<"\$mode"): the firmware can skip the stick; it needs Diagnostics" >&2
fi
echo "stick: Boot\$n"
EOF
}

# wait_for WHAT SECONDS COMMAND...: retry until COMMAND succeeds.
wait_for() {
    local what=$1 limit=$2 end; shift 2
    end=$(( $(date +%s) + limit ))
    until "$@" 2>/dev/null; do
        [[ $(date +%s) -lt $end ]] || die "$what didn't answer within $limit seconds"
        sleep 10
    done
}
host_up() { on_host true; }
rescue_up() { "$0" find-rescue >/dev/null; }

case ${1:-} in
stage)
    tools=${2:?usage: backshot1 stage TOOLS_DIR}
    for b in bko-holt rustic-bko; do [[ -x $tools/$b ]] || die "no $tools/$b"; done
    old_login_if_new
    d=$(on_host "$DRIVE; echo \"\$d\"")
    on_host "mkdir -p '$d/backshot1/bin' '$d/backshot1/runs' '$d/backshot1/keys'; chmod 700 '$d/backshot1/keys'"
    scp -q "${OPTS[@]}" "$here"/bs1-{common,backup,restore,verify,manifest,adopt,list} "root@$HOST:$d/backshot1/"
    scp -q "${OPTS[@]}" "$here/thinkpad.conf" "root@$HOST:$d/backshot1/bs1.conf"
    scp -q "${OPTS[@]}" "$tools/bko-holt" "$tools/rustic-bko" "root@$HOST:$d/backshot1/bin/"
    scp -q "${OPTS[@]}" "$KEYS/id_ed25519.pub" "root@$HOST:$d/backshot1/keys/authorized_keys"
    scp -q "${OPTS[@]}" "$KEYS/ssh_host_ed25519_key" "$KEYS/ssh_host_ed25519_key.pub" "root@$HOST:$d/backshot1/keys/"
    on_host "chmod 755 '$d'/backshot1/bs1-* '$d'/backshot1/bin/*; chmod 600 '$d'/backshot1/keys/ssh_host_ed25519_key; '$d/backshot1/bin/bko-holt' --version; '$d/backshot1/bin/rustic-bko' --version; ls -la '$d/backshot1'"
    ;;
adopt)
    old_login_if_new
    on_host "$DRIVE; exec bash \"\$d/backshot1/bs1-adopt\""
    ;;
phase1)
    on_host "$DRIVE; exec bash \"\$d/backshot1/bs1-backup\""
    ;;
preflight)
    on_host "$DRIVE; exec bash \"\$d/backshot1/bs1-backup\" --preflight"
    ;;
find-rescue)
    command -v arp >/dev/null || die "needs arp"
    prefix=$(on_host 'ip -4 -o addr show scope global | awk "{print \$4; exit}"' 2>/dev/null | cut -d. -f1-3 || true)
    prefix=${prefix:-${BS1_PREFIX:-192.168.68}}
    for i in $(seq 1 254); do ping -c 1 -W 700 -t 1 "$prefix.$i" >/dev/null 2>&1 & done
    wait
    ips=
    for m in "${MACS[@]}"; do
        # macOS's arp prints 00:e0:... as 0:e0:...
        short=$(sed -E 's/(^|:)0([0-9a-f])/\1\2/g' <<<"$m")
        ips+=" $(arp -an | awk -v m="$m" -v s=" $short " 'index($0, m) || index($0, s) { gsub(/[()]/, "", $2); print $2 }' | tr '\n' ' ')"
    done
    [[ -n ${ips// /} ]] || die "no answer from the laptop's wired adapters on $prefix.0/24"
    # A MAC can have stale addresses in the ARP cache; only the stick passes this.
    for ip in $ips; do
        echo "$ip" >"$STATE/rescue-ip"
        on_rescue 'sudo -n true && test -f /cdrom/.disk/backotter.json && hostname' 2>/dev/null || continue
        on_rescue "lsblk -dno SERIAL | grep -qx $INTERNAL_SERIAL" || die "$ip doesn't have disk $INTERNAL_SERIAL"
        echo "RESCUE=$ip"
        exit 0
    done
    die "none of these is an unlocked rescue stick:$ips"
    ;;
list)
    run_on_drive bs1-list
    ;;
plan)
    run=$(resolve_run "${2:?usage: backshot1 plan NAME}")
    echo "backup: $run"
    run_on_drive bs1-restore --erase-serial "$INTERNAL_SERIAL" --plan-only "$run"
    ;;
phase2)
    run=$(resolve_run "${2:?usage: backshot1 phase2 NAME}")
    echo "backup: $run"
    # Detached: a dropped connection must not stop a restore halfway.
    run_on_drive bs1-restore --erase-serial "$INTERNAL_SERIAL" --detach "$run"
    status=
    until [[ -n $status ]]; do
        sleep 20
        status=$(on_rescue 'sudo -n cat /run/backotter/restore.exit' 2>/dev/null || true)
    done
    on_rescue 'sudo -n tail -n 30 /run/backotter/restore.out'
    exit "$status"
    ;;
reboot)
    on_rescue 'sudo -n systemctl reboot' || true
    ;;
stick-on)
    stick_on
    ;;
stick-off)
    as_root <<EOF
set -euo pipefail
$STICK_ENTRY
n=\$(entry)
if [[ -n \$n ]]; then efibootmgr -q -b "\$n" -B; echo "removed Boot\$n"; else echo "no stick entry"; fi
efibootmgr | grep -E '^BootOrder'
EOF
    ;;
to-stick)
    # BootNext: the firmware's own one-shot; it clears it at that boot.
    on_host 'bash -s' <<EOF || true
set -euo pipefail
$STICK_ENTRY
n=\$(entry)
[[ -n \$n ]] || { echo "no stick entry: backshot1 stick-on" >&2; exit 1; }
efibootmgr -q --bootnext "\$n"
sync
systemctl reboot
EOF
    sleep 30
    wait_for "the stick" 420 rescue_up
    "$0" find-rescue
    ;;
wait-host)
    sleep 30
    wait_for "the restored system" 420 host_up
    on_host 'hostname; . /etc/os-release; echo "$PRETTY_NAME"; efibootmgr | head -n 1'
    ;;
cycle)
    run=${2:?usage: backshot1 cycle NAME COUNT --erase-serial SERIAL}
    count=${3:?usage: backshot1 cycle NAME COUNT --erase-serial SERIAL}
    [[ ${4:-} == --erase-serial && ${5:-} == "$INTERNAL_SERIAL" ]] ||
        die "cycle wipes the internal disk: name it, --erase-serial $INTERNAL_SERIAL"
    [[ $count =~ ^[1-9][0-9]*$ ]] || die "COUNT must be a positive number"
    "$0" stick-on
    for ((i = 1; i <= count; i++)); do
        echo "=== cycle $i of $count: $run"
        "$0" to-stick
        "$0" plan "$run"
        "$0" phase2 "$run"
        "$0" reboot
        "$0" wait-host
        "$0" verify "$run"
    done
    echo "=== $count cycles passed; to remove the stick's boot entry: backshot1 stick-off"
    ;;
verify)
    run=$(resolve_run "${2:?usage: backshot1 verify NAME}")
    echo "backup: $run"
    on_host "$DRIVE; exec bash \"\$d/backshot1/bs1-verify\" '$run'"
    ;;
*)
    sed -n '2,26p' "$0"
    exit 2
    ;;
esac
