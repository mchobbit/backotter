#!/bin/sh
# BackShot1: make a fresh install on the Thinkpad ready.  Once per install, as
# root, on the machine, from the backup drive:
#
#   sudo sh /PATH/TO/mybig512/backshot1/bs1-adopt
#
# Sets the hostname, lets the controller's key log in as root, and installs the
# fixed host key, so the controller sees one identity on every install and on the
# stick.  Installs sshd, an mDNS responder and what the BackShot1 scripts use, if
# the system lacks them, under whichever init system it has.

# apk-tools 3 (Chimera's) asks before it changes anything when it has a tty;
# --no-interactive stops that, and apk 2 may not know it.  Plain sh, for below.
apk_add() {
    if apk --version 2>/dev/null | grep -q '^apk-tools 3'; then apk --no-interactive add "$@"; else apk add "$@"; fi
}

# Alpine and Chimera come without bash, so this much has to be plain sh
# (Chimera's is FreeBSD's).
if [ -z "${BASH_VERSION:-}" ]; then
    command -v bash >/dev/null || apk_add bash || { echo "bs1-adopt: this needs bash" >&2; exit 2; }
    exec bash "$0" "$@"
fi

set -euo pipefail

here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
# shellcheck disable=SC1091
. "$here/bs1.conf"
keys=$here/keys

[[ $EUID -eq 0 ]] || { echo "bs1-adopt: run it as root" >&2; exit 2; }
for f in authorized_keys ssh_host_ed25519_key ssh_host_ed25519_key.pub; do
    [[ -s $keys/$f ]] || { echo "bs1-adopt: no $keys/$f" >&2; exit 2; }
done

distro=$(. /etc/os-release; echo "${ID:-}")

init=$(cat /proc/1/comm)
case $init in
    systemd | dinit | runit) ;;
    s6-svscan) init=s6 ;;
    *) if command -v rc-service >/dev/null; then init=openrc; else init=sysv; fi ;;
esac
echo "== $distro, under $init"

# Artix packages each service's init script apart, per init system.
with_script() { if [[ $distro == artix ]]; then echo "$1 $1-$init"; else echo "$1"; fi; }

pkg_install() {     # pkg_install DEBIAN FEDORA SUSE ARCH ALPINE VOID AERYNOS CHIMERA GENTOO, each one or more names
    # An ostree system's /usr is its image's, read-only: nothing is installed
    # here.  Everything this installs is something BackShot1 needs, so it
    # stops and names it (Fedora's names: Bazzite, Silverblue and Kinoite
    # are Fedora's), and leaves layering it, and the reboot, to the person.
    # Kinoite 44 has it all (docs/design/bazzite.md, B1).
    if [[ -e /run/ostree-booted ]]; then
        echo "bs1-adopt: this image-mode (ostree) system lacks $2, and its /usr is read-only." >&2
        echo "bs1-adopt: layer it with \"rpm-ostree install $2\", reboot, and run bs1-adopt again." >&2
        return 1
    fi
    # Gentoo first, by os-release: dpkg, rpm or apk may be emerged there as
    # tools.  Binary packages from its binhost, as the install has them;
    # --noreplace leaves one already installed alone, --ask=n stops an
    # EMERGE_DEFAULT_OPTS --ask from waiting for an answer.
    # shellcheck disable=SC2086
    if [[ $distro == gentoo ]]; then emerge --ask=n --getbinpkg --noreplace $9
    elif command -v apt-get >/dev/null; then
        export DEBIAN_FRONTEND=noninteractive
        apt-get install -y $1 || { apt-get update && apt-get install -y $1; }
    elif command -v dnf >/dev/null; then dnf install -y $2
    elif command -v zypper >/dev/null; then zypper --non-interactive install $3
    elif command -v pacman >/dev/null; then pacman -Sy --noconfirm --needed $4
    # Chimera has apk too, with its own names.
    elif [[ $distro == chimera ]]; then apk_add $8
    elif command -v apk >/dev/null; then apk_add $5
    elif command -v xbps-install >/dev/null; then xbps_add $6
    elif command -v moss >/dev/null; then moss -y pkg add $7
    else echo "bs1-adopt: no package manager I know; install $1 by hand" >&2; return 1
    fi
}

# Void is rolling and refuses a partial update: on an install older than its
# repo, "avahi dbus" pulls a new dbus-libs that "breaks installed pkg
# dbus-x11", and the transaction aborts.  Then xbps first (it must update
# itself before anything else), the whole system, and the packages.
xbps_add() {
    xbps-install -Sy "$@" && return 0
    echo "bs1-adopt: xbps refused a partial update; updating the whole system first" >&2
    xbps-install -Syu xbps && xbps-install -yu && xbps-install -y "$@"
}

start_runit() {     # start_runit NAME: a service just linked in takes runsvdir a few seconds to notice
    local dir=/etc/sv live=/var/service i
    if [[ -d /etc/runit/sv ]]; then dir=/etc/runit/sv live=/run/runit/service; fi   # Artix
    [[ -d $dir/$1 ]] || return 2
    [[ -e $live/$1 ]] || ln -s "$dir/$1" "$live/"
    for i in $(seq 20); do
        sv restart "$1" && return 0
        sleep 1
    done
    return 1
}

# dinit_pid NAME: the PID of NAME's process, if dinit has one and it runs.
dinit_pid() {
    local pid
    pid=$(dinitctl status "$1" 2>/dev/null | awk '$1 == "Process" && $2 == "ID:" { print $3; exit }') || true
    [[ $pid =~ ^[0-9]+$ && -d /proc/$pid ]] && echo "$pid"
}

start_service() {   # start_service NAME...: the first name this system knows
    local s rc i pid
    [[ $init != systemd ]] || systemctl daemon-reload
    for s in "$@"; do
        case $init in
        systemd)
            systemctl cat "$s.service" >/dev/null 2>&1 || continue
            systemctl enable "$s.service" >/dev/null 2>&1 || true
            systemctl restart "$s.service" && return 0
            ;;
        openrc)
            [[ -e /etc/init.d/$s ]] || continue
            rc-update add "$s" default >/dev/null 2>&1 || true
            rc-service "$s" restart && return 0
            ;;
        sysv)
            [[ -e /etc/init.d/$s ]] || continue
            update-rc.d "$s" defaults >/dev/null 2>&1 || true
            service "$s" restart && return 0
            ;;
        runit)
            rc=0
            start_runit "$s" || rc=$?
            [[ $rc -eq 2 ]] && continue
            [[ $rc -eq 0 ]] && return 0
            ;;
        dinit)
            # Chimera's services are in /usr/lib/dinit.d, Artix's in /etc.
            [[ -e /etc/dinit.d/$s || -e /usr/lib/dinit.d/$s ]] || continue
            dinitctl enable "$s" >/dev/null 2>&1 || true
            # start returns once a process service is launched, so it says
            # nothing of one that dies at once, and with smooth-recovery (as
            # Chimera's avahi-daemon has) is-started says STARTED while dinit
            # restarts a dead one.  Up means one live process, the same one
            # 3 s later (not a restarted one).
            for i in 1 2 3 4 5; do
                dinitctl restart "$s" >/dev/null 2>&1 || dinitctl start "$s" >/dev/null 2>&1 || true
                sleep 3
                pid=$(dinit_pid "$s") || continue
                sleep 3
                [[ $(dinit_pid "$s") == "$pid" ]] && return 0
            done
            ;;
        s6)
            [[ -d /etc/s6/sv/$s-srv ]] || continue
            s6 repository sync
            s6 set enable "$s"
            s6 set commit
            s6 live install
            s6 live start "$s"
            s6-svc -r "/run/service/$s-srv" && { sleep 2; return 0; }
            ;;
        esac
    done
    echo "bs1-adopt: couldn't start any of: $*" >&2
    return 1
}

running() { grep -Eqx "$1" /proc/[0-9]*/comm 2>/dev/null; }

set_hostname() {
    if [[ $init == systemd ]] && command -v hostnamectl >/dev/null; then
        hostnamectl set-hostname "$SOURCE_HOST"
        return
    fi
    echo "$SOURCE_HOST" >/etc/hostname
    echo "$SOURCE_HOST" >/proc/sys/kernel/hostname
    # OpenRC's own place for it, on Artix.
    if [[ -f /etc/conf.d/hostname ]]; then sed -i "s/^hostname=.*/hostname=\"$SOURCE_HOST\"/" /etc/conf.d/hostname; fi
}

install_tools() {
    command -v sshd >/dev/null || [[ -x /usr/sbin/sshd ]] ||
        pkg_install openssh-server openssh-server openssh "$(with_script openssh)" openssh openssh openssh-server openssh net-misc/openssh
    # BusyBox's df, umount and blkid lack options the scripts use, and it has no
    # findmnt, lsblk or sfdisk.  Alpine's names; Chimera has no BusyBox, and
    # an apk on Gentoo is a tool, not its package manager.
    if [[ $distro != chimera && $distro != gentoo ]] && command -v apk >/dev/null; then apk_add coreutils findmnt lsblk blkid sfdisk mount umount util-linux-misc; fi
    # Chimera's python package gives the python3 command; it has no python3 package.
    command -v python3 >/dev/null || pkg_install python3 python3 python3 python python3 python3 python python dev-lang/python
    if ! command -v findmnt >/dev/null || ! command -v lsblk >/dev/null; then
        pkg_install util-linux util-linux util-linux util-linux util-linux-misc util-linux util-linux util-linux sys-apps/util-linux
    fi
    # bs1-to-stick's BootNext needs it, and a Chimera install with systemd-boot
    # (bootctl) can lack it, as can a Gentoo one (it is no part of @system).
    # The other systems' rehearsals all had it; NixOS gets it from adopt_nixos.
    if [[ -d /sys/firmware/efi ]] && ! command -v efibootmgr >/dev/null; then
        case $distro in
            chimera) apk_add efibootmgr ;;
            gentoo) emerge --ask=n --getbinpkg --noreplace sys-boot/efibootmgr ;;
        esac
    fi
}

allow_root_key_login() {
    local conf=/etc/ssh/sshd_config
    # AerynOS keeps the file itself in /usr, and reads /etc/ssh/sshd_config.d.
    if [[ ! -e $conf ]] || grep -qE '^[[:space:]]*Include[[:space:]]+/etc/ssh/sshd_config\.d/' "$conf"; then
        mkdir -p /etc/ssh/sshd_config.d
        echo 'PermitRootLogin prohibit-password' >/etc/ssh/sshd_config.d/00-backshot1.conf
    elif ! grep -q 'BackShot1' "$conf"; then
        # sshd keeps the first value it reads.  Not sed -i '1i': GNU's alone
        # takes that, and FreeBSD's (Chimera's) -i wants a suffix.  Written
        # back into the file itself, so its mode, owner and label stay.
        # Three commands, not an && list, so set -e stops at a failing one.
        { printf '# BackShot1\nPermitRootLogin prohibit-password\n'; cat "$conf"; } >"$conf.bs1"
        cat "$conf.bs1" >"$conf"
        rm -f "$conf.bs1"
    fi
}

start_mdns() {
    command -v avahi-daemon >/dev/null ||
        pkg_install avahi-daemon avahi avahi "$(with_script avahi)" "avahi dbus" "avahi dbus" avahi avahi "net-dns/avahi sys-apps/dbus"
    if [[ $init == s6 ]]; then
        s6 repository sync
        s6 set enable dbus
    elif ! running 'dbus-(daemon|broker.*)'; then
        start_service dbus
    fi
    # A running dbus-daemon needn't read the policy avahi's install just added
    # (Chimera's doesn't), and without it avahi-daemon may not own its name.
    if running 'dbus-(daemon|broker.*)' && command -v dbus-send >/dev/null; then
        dbus-send --system --print-reply --dest=org.freedesktop.DBus / org.freedesktop.DBus.ReloadConfig >/dev/null || true
    fi
    start_service avahi-daemon
}

# An active firewall must let ssh and the mDNS answers through: EndeavourOS's
# firewalld zone allows only ssh and DHCPv6, so $SOURCE_HOST.local never
# resolved; openSUSE's doesn't allow ssh.  NixOS's avahi module opens its own.
open_firewall() {
    local z
    if command -v firewall-cmd >/dev/null && firewall-cmd --state >/dev/null 2>&1; then
        # --get-active-zones: "public (default)", then indented "interfaces: ..."
        for z in $( { firewall-cmd --get-default-zone; firewall-cmd --get-active-zones | awk '!/^[[:space:]]/ { print $1 }'; } | sort -u); do
            firewall-cmd -q --permanent --zone="$z" --add-service=ssh --add-service=mdns
            echo "firewalld: ssh and mdns allowed in zone $z"
        done
        firewall-cmd -q --reload
    fi
    if command -v ufw >/dev/null && ufw status 2>/dev/null | grep -q '^Status: active'; then
        ufw allow 22/tcp >/dev/null && ufw allow 5353/udp >/dev/null && echo "ufw: 22/tcp and 5353/udp allowed"
    fi
}

# NixOS builds /etc from its configuration, so all of that goes in there.
adopt_nixos() {
    local conf=/etc/nixos/configuration.nix module=/etc/nixos/backshot1.nix line lines=
    if [[ -e /etc/nixos/flake.nix ]]; then
        echo "bs1-adopt: this system is built from a flake; add BackShot1's settings to it by hand" >&2
        return 1
    fi
    while read -r line; do lines+="\"$line\" "; done <"$keys/authorized_keys"
    cat >"$module" <<EOF
# Written by BackShot1's bs1-adopt.
{ lib, pkgs, ... }:
{
  networking.hostName = lib.mkForce "$SOURCE_HOST";
  services.openssh.enable = true;
  services.openssh.settings.PermitRootLogin = lib.mkForce "prohibit-password";
  users.users.root.openssh.authorizedKeys.keys = [ $lines];
  services.avahi = { enable = true; publish = { enable = true; addresses = true; }; };
  environment.systemPackages = [ pkgs.python3 pkgs.efibootmgr ];
}
EOF
    if ! grep -q 'backshot1\.nix' "$conf"; then
        # nixos-generate-config puts the [ on the line after "imports =", with
        # a comment after it; spaces, newlines and # comments may come between.
        # -z reads the whole file as one line, and s/// changes the first list.
        # NixOS has GNU sed.
        sed -z -E -i 's/imports([[:space:]]|#[^\n]*)*=([[:space:]]|#[^\n]*)*\[/& .\/backshot1.nix/' "$conf"
        grep -q 'backshot1\.nix' "$conf" || { echo "bs1-adopt: no imports list in $conf to add $module to" >&2; return 1; }
    fi
    nixos-rebuild switch
}

if [[ ! -e /etc/NIXOS ]]; then
    echo "== hostname: $SOURCE_HOST"
    set_hostname
    echo "== what's missing"
    install_tools
fi

echo "== root's authorized_keys"
install -d -m 700 /root/.ssh
touch /root/.ssh/authorized_keys
chmod 600 /root/.ssh/authorized_keys
while read -r line; do
    grep -qxF "$line" /root/.ssh/authorized_keys || echo "$line" >>/root/.ssh/authorized_keys
done <"$keys/authorized_keys"

echo "== the fixed host key"
rm -f /etc/ssh/ssh_host_rsa_key* /etc/ssh/ssh_host_ecdsa_key* /etc/ssh/ssh_host_dsa_key*
install -m 600 "$keys/ssh_host_ed25519_key" /etc/ssh/ssh_host_ed25519_key
install -m 644 "$keys/ssh_host_ed25519_key.pub" /etc/ssh/ssh_host_ed25519_key.pub
if command -v restorecon >/dev/null; then restorecon -R /root/.ssh /etc/ssh; fi

if [[ -e /etc/NIXOS ]]; then
    echo "== NixOS: $SOURCE_HOST, sshd, mDNS, Python and efibootmgr, in its configuration"
    adopt_nixos
    systemctl restart sshd.service
else
    allow_root_key_login
    "$(command -v sshd || echo /usr/sbin/sshd)" -t
    start_service ssh sshd
    echo "== mDNS, for $SOURCE_HOST.local"
    start_mdns
    echo "== the firewall, if one is on"
    open_firewall
fi

ssh-keygen -l -f /etc/ssh/ssh_host_ed25519_key.pub
echo "bs1-adopt: done.  Tell Claude: \"Let's run BackShot1.\""
