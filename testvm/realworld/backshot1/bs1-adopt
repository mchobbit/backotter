#!/bin/sh
# BackShot1: make a fresh install on the Thinkpad ready.  Once per install, as
# root, on the machine, from the backup drive:
#
#   sudo sh /PATH/TO/mybig512/backshot1/bs1-adopt
#
# Sets the hostname, lets the controller's key log in as root, and installs the
# fixed host key, so the controller sees one identity on every install and on the
# stick.  Installs sshd, an mDNS responder and what the BackShot1 scripts use, if
# the system lacks them, under whichever init system it has.
#
# Then, on an install with LUKS, sets its initramfs to unlock with the
# passphrase in keys/disk-passphrase on this drive, falling back to the prompt
# when the drive isn't there (bs1-luks; TESTBED ONLY).  BS1_LUKS=no skips that;
#
#   sudo sh /PATH/TO/mybig512/backshot1/bs1-adopt --luks-off
#
# undoes it, and does nothing else.
#
# First of all it stops the testbed from ever suspending or hibernating, by a
# sleep.conf drop-in of BackShot1's own (no_sleep, below), under systemd or
# elogind;
#
#   sudo sh /PATH/TO/mybig512/backshot1/bs1-adopt --sleep-on
#
# removes it, and does nothing else.

# apk-tools 3 (Chimera's) asks before it changes anything when it has a tty;
# --no-interactive stops that, and apk 2 may not know it.  Plain sh, for below.
apk_add() {
    if apk --version 2>/dev/null | grep -q '^apk-tools 3'; then apk --no-interactive add "$@"; else apk add "$@"; fi
}

# Alpine and Chimera come without bash, so this much has to be plain sh
# (Chimera's is FreeBSD's).
if [ -z "${BASH_VERSION:-}" ]; then
    command -v bash >/dev/null || apk_add bash || { echo "bs1-adopt: this needs bash" >&2; exit 2; }
    exec bash "$0" "$@"
fi

set -euo pipefail

here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
# shellcheck disable=SC1091
. "$here/bs1.conf"
keys=$here/keys
# Slackware's service scripts, and the trees on this drive it is installed
# from (slk_install, below).
RC_D=/etc/rc.d
SLK_CACHE=$here/../slackware-cache
SLK_PKGS=/var/lib/pkgtools/packages

# This testbed never sleeps.  GNOME's idle auto-suspend (15 min after the
# last input, at GDM too) suspended the Thinkpad during a phase 1, and the
# controller's SSH timed out (Fedora 45, 2026-11-20); KDE's powerdevil,
# Xfce's power manager and logind's IdleAction all suspend through logind,
# which refuses what sleep.conf disallows, and reads it again at every
# request.  bs1-backup and bs1-verify hold an inhibitor while they run
# (hold_awake in bs1-common); this covers the time between the steps, the
# restored system's first boot (the backup carries the drop-in, and the
# restore brings it back) and adopt's own updates, as it's written first.
# BackShot1's by its name, and by its first line.
SLEEP_DROPINS="/etc/systemd/sleep.conf.d/90-backshot1.conf /etc/elogind/sleep.conf.d/90-backshot1.conf"
SLEEP_HEAD="# BackShot1 (bs1-adopt): this testbed never sleeps"
no_sleep() {
    local sd=${SLEEP_DROPINS%% *} el=${SLEEP_DROPINS##* } f content
    if [[ $init == systemd ]]; then f=$sd
    elif [[ -d ${el%/sleep.conf.d/*} ]]; then f=$el
    else
        echo "no logind (systemd's or elogind's) here: nothing set; a desktop's own power manager could still suspend the machine"
        return 0
    fi
    content="$SLEEP_HEAD, so that no idle desktop suspends it under a
# backup or a check.  bs1-adopt --sleep-on removes this file.
[Sleep]
AllowSuspend=no
AllowHibernation=no
AllowSuspendThenHibernate=no
AllowHybridSleep=no"
    if [[ -f $f && $(cat "$f") == "$content" ]]; then echo "unchanged: $f"; return 0; fi
    if mkdir -p "${f%/*}" && printf '%s\n' "$content" >"$f"; then
        echo "wrote $f"
    else
        echo "bs1-adopt: couldn't write $f: an idle desktop could suspend the machine" >&2
    fi
}
sleep_on() {
    local f found=0
    for f in $SLEEP_DROPINS; do
        [[ -f $f ]] || continue
        if [[ $(head -n 1 "$f") != "$SLEEP_HEAD"* ]]; then
            echo "bs1-adopt: $f isn't BackShot1's; left there" >&2
            continue
        fi
        rm -f "$f" || return 1
        rmdir "${f%/*}" 2>/dev/null || true
        echo "removed $f: the machine may sleep again"
        found=1
    done
    [[ $found -eq 1 ]] || echo "nothing to remove: no drop-in of BackShot1's"
}

[[ $EUID -eq 0 ]] || { echo "bs1-adopt: run it as root" >&2; exit 2; }
case ${1:-} in
"") ;;
--sleep-on)
    sleep_on || exit 1
    exit 0
    ;;
--luks-off)
    # shellcheck disable=SC1091
    . "$here/bs1-common"
    # shellcheck disable=SC1091
    . "$here/bs1-luks"
    # In an || list, so set -e leaves its checks to it.
    luks_off || exit 1
    exit 0
    ;;
*) echo "usage: bs1-adopt [--luks-off | --sleep-on]" >&2; exit 2 ;;
esac
for f in authorized_keys ssh_host_ed25519_key ssh_host_ed25519_key.pub; do
    [[ -s $keys/$f ]] || { echo "bs1-adopt: no $keys/$f" >&2; exit 2; }
done

distro=$(. /etc/os-release; echo "${ID:-}")

# init_system COMM: the init system, by PID 1's name and the distro.
# Slackware's PID 1 is sysvinit's, but its services aren't in /etc/init.d
# (a link to an empty rc.d/init.d): rc.M, rc.inet2 and the rest start each
# /etc/rc.d/rc.NAME that is executable, and there is no update-rc.d or
# service.
init_system() {
    case $1 in
    systemd | dinit | runit) echo "$1" ;;
    s6-svscan) echo s6 ;;
    *)
        if [[ $distro == slackware ]]; then echo rc.d
        elif command -v rc-service >/dev/null; then echo openrc
        else echo sysv
        fi
        ;;
    esac
}
init=$(init_system "$(cat /proc/1/comm)")
echo "== $distro, under $init"
echo "== sleep: never, on this testbed"
no_sleep

# Artix packages each service's init script apart, per init system.
with_script() { if [[ $distro == artix ]]; then echo "$1 $1-$init"; else echo "$1"; fi; }

pkg_install() {     # pkg_install DEBIAN FEDORA SUSE ARCH ALPINE VOID AERYNOS CHIMERA GENTOO SOLUS SLACKWARE, each one or more names
    # An ostree system's /usr is its image's, read-only: nothing is installed
    # here.  Everything this installs is something BackShot1 needs, so it
    # stops and names it (Fedora's names: Bazzite, Silverblue and Kinoite
    # are Fedora's), and leaves layering it, and the reboot, to the person.
    # Kinoite 44 has it all (docs/design/bazzite.md, B1).
    if [[ -e /run/ostree-booted ]]; then
        echo "bs1-adopt: this image-mode (ostree) system lacks $2, and its /usr is read-only." >&2
        echo "bs1-adopt: layer it with \"rpm-ostree install $2\", reboot, and run bs1-adopt again." >&2
        return 1
    fi
    # Gentoo first, by os-release: dpkg, rpm or apk may be emerged there as
    # tools.  Binary packages from its binhost, as the install has them;
    # --noreplace leaves one already installed alone, --ask=n stops an
    # EMERGE_DEFAULT_OPTS --ask from waiting for an answer.
    # shellcheck disable=SC2086
    if [[ $distro == gentoo ]]; then emerge --ask=n --getbinpkg --noreplace $9
    elif [[ $distro == solus ]]; then eopkg_add ${10}
    # Slackware by os-release too: it ships rpm, as a tool.
    elif [[ $distro == slackware ]]; then slk_install ${11}
    elif command -v apt-get >/dev/null; then
        export DEBIAN_FRONTEND=noninteractive
        apt-get install -y $1 || { apt-get update && apt-get install -y $1; }
    elif command -v dnf >/dev/null; then dnf install -y $2
    elif command -v zypper >/dev/null; then zypper --non-interactive install $3
    elif command -v pacman >/dev/null; then pacman -Sy --noconfirm --needed $4
    # Chimera has apk too, with its own names.
    elif [[ $distro == chimera ]]; then apk_add $8
    elif command -v apk >/dev/null; then apk_add $5
    elif command -v xbps-install >/dev/null; then xbps_add $6
    elif command -v moss >/dev/null; then moss -y pkg add $7
    else echo "bs1-adopt: no package manager I know; install $1 by hand" >&2; return 1
    fi
}

# Void is rolling and refuses a partial update: on an install older than its
# repo, "avahi dbus" pulls a new dbus-libs that "breaks installed pkg
# dbus-x11", and the transaction aborts.  Then xbps first (it must update
# itself before anything else), the whole system, and the packages.
xbps_add() {
    xbps-install -Sy "$@" && return 0
    echo "bs1-adopt: xbps refused a partial update; updating the whole system first" >&2
    xbps-install -Syu xbps && xbps-install -yu && xbps-install -y "$@"
}

# Solus is a curated rolling release, and takes no partial update either
# (docs/design/solus.md, What S1 found): on an install older than its
# repository, eopkg can find a package or a newer dependency gone.  Then the
# repository's index, the whole system, and the packages.  eopkg runs
# usysconf after each transaction, which applies the presets again
# (solus_presets, below).
eopkg_add() {
    eopkg it -y "$@" && return 0
    echo "bs1-adopt: eopkg couldn't install $*; updating the index and the whole system first" >&2
    eopkg ur && eopkg up -y && eopkg it -y "$@"
}

# Solus's presets end with "disable *" (99-default.preset), and usysconf
# applies them again after every eopkg transaction, which turns an enabled
# sshd or avahi-daemon off again (S1's second build).  A preset of BackShot1's
# own, written before anything is installed, keeps them on.
solus_presets() {
    mkdir -p /etc/systemd/system-preset
    printf '%s\n' "# Written by BackShot1's bs1-adopt: usysconf's preset run keeps these on." \
        "enable sshd.service" "enable avahi-daemon.service" "enable avahi-daemon.socket" >/etc/systemd/system-preset/50-backshot1.preset
}

# eopkg's updates leave /var/lib/qol-assist/trigger, and
# qol-assist-migration.service (ConditionPathExists on it) runs `qol-assist
# migrate` at the next boot: usermod -aG input and groupmod, so etc/group and
# etc/gshadow change.  A backup taken before that reboot had it pending, and
# the restored system's first boot made those changes
# (solus-4.9-20261117-202222).  So they're made now, after the last eopkg
# transaction, and adopt leaves nothing pending.
solus_qol() {
    local trigger=/var/lib/qol-assist/trigger
    if [[ ! -e $trigger ]]; then
        echo "none pending"
        return 0
    fi
    "$(command -v qol-assist || echo /usr/sbin/qol-assist)" migrate ||
        { echo "bs1-adopt: qol-assist migrate failed" >&2; exit 1; }
    rm -f "$trigger"
    echo "qol-assist migrate ran; nothing is pending for the next boot"
}

# Slackware: installpkg, by name, from the tree on this backup drive that this
# system was installed from (slackware-bootstrap.sh's CACHE_DIR, SLK_CACHE:
# slackware64-15.0, or a pin of -current, current-DATE), never slackpkg.
# slackpkg's mirror is live slackware64-current (or 15.0's patches), and one
# package from there would unpin a system installed from a pin: every
# install and restore test of the -current Thinkpad runs on the pinned tree
# (README.md, "The pin").  The tree is the one whose packages are the ones
# installed here: each installed package it has (series of slackware64/ only,
# not patches/, extra/, pasture/ or testing/) must be at its version, arch
# and build, so a system that took any package from elsewhere (an upgrade
# from the live mirror, 15.0's patches) matches no tree, and adopt stops and
# names it.  Each file is held to the tree's CHECKSUMS.md5 (slackware-pin.sh
# and slackware-bootstrap.sh checked the tree's signatures when they fetched
# it).  installpkg resolves no dependencies, so each name list below has
# them.  A full install (series a, ap, d, l and n, as slackware-bootstrap.sh
# makes it) has everything BackShot1 needs, so this runs only on a smaller
# one.
slk_tree() {
    local t why
    for t in "$SLK_CACHE"/*/; do
        t=${t%/}
        [[ -s $t/CHECKSUMS.md5 ]] || continue
        if why=$(slk_mismatch "$t"); then
            echo "$t"
            return 0
        fi
        echo "bs1-adopt: not $t: $why" >&2
    done
    echo "bs1-adopt: no tree in $SLK_CACHE has this system's packages" >&2
    return 1
}
# slk_mismatch TREE: true if every installed package TREE has is at TREE's
# version, arch and build; else says the first that isn't, and false.
slk_mismatch() {
    (cd "$SLK_PKGS" && printf '%s\n' *) | awk -v sums="$1/CHECKSUMS.md5" '
        function name(p) { sub(/-[^-]*-[^-]*-[^-]*$/, "", p); return p }
        BEGIN {
            while ((getline l < sums) > 0) {
                k = split(l, f, " ")
                p = f[k]
                if (p !~ /^\.\/slackware64\/[^\/]+\/[^\/]+\.t[gxlb]z$/) continue
                sub(/.*\//, "", p)
                sub(/\.t[gxlb]z$/, "", p)
                tree[name(p)] = p
                any = 1
            }
            if (!any) { print "its CHECKSUMS.md5 lists no packages"; bad = 1; exit 1 }
        }
        name($0) in tree {
            same++
            if (tree[name($0)] != $0) { print "this system has " $0 ", the tree " tree[name($0)]; bad = 1; exit 1 }
        }
        END {
            if (bad) exit 1
            if (!same) { print "none of its packages is installed here"; exit 1 }
        }'
}
slk_install() {     # slk_install NAME...: those not installed, from the tree
    local tree n line sum path f missing=()
    for n in "$@"; do
        (cd "$SLK_PKGS" && printf '%s\n' *) | awk -v n="$n" '{ p = $0; sub(/-[^-]*-[^-]*-[^-]*$/, "", p) } p == n { f = 1 } END { exit !f }' ||
            missing+=("$n")
    done
    [[ ${#missing[@]} -gt 0 ]] || return 0
    tree=$(slk_tree) || { echo "bs1-adopt: install ${missing[*]} by hand (installpkg, from the tree this system came from; not slackpkg, if it is a pin)" >&2; return 1; }
    echo "bs1-adopt: installing ${missing[*]} from $tree"
    for n in "${missing[@]}"; do
        line=$(awk -v n="$n" '{ p = $NF; sub(/.*\//, "", p); sub(/-[^-]*-[^-]*-[^-]*\.t[gxlb]z$/, "", p) }
            p == n && $NF ~ /^\.\/slackware64\/[^\/]+\/[^\/]+\.t[gxlb]z$/ { print $1, $NF; exit }' "$tree/CHECKSUMS.md5")
        [[ -n $line ]] || { echo "bs1-adopt: $tree has no package $n" >&2; return 1; }
        read -r sum path <<<"$line"
        f=$tree/${path#./}
        [[ -f $f ]] || { echo "bs1-adopt: $tree lacks $path (a series it didn't fetch?)" >&2; return 1; }
        [[ $(md5sum <"$f" | awk '{ print $1 }') == "$sum" ]] || { echo "bs1-adopt: $f doesn't match $tree/CHECKSUMS.md5" >&2; return 1; }
        installpkg "$f" || return 1
    done
}

start_runit() {     # start_runit NAME: a service just linked in takes runsvdir a few seconds to notice
    local dir=/etc/sv live=/var/service i
    if [[ -d /etc/runit/sv ]]; then dir=/etc/runit/sv live=/run/runit/service; fi   # Artix
    [[ -d $dir/$1 ]] || return 2
    [[ -e $live/$1 ]] || ln -s "$dir/$1" "$live/"
    for i in $(seq 20); do
        sv restart "$1" && return 0
        sleep 1
    done
    return 1
}

# dinit_pid NAME: the PID of NAME's process, if dinit has one and it runs.
dinit_pid() {
    local pid
    pid=$(dinitctl status "$1" 2>/dev/null | awk '$1 == "Process" && $2 == "ID:" { print $3; exit }') || true
    [[ $pid =~ ^[0-9]+$ && -d /proc/$pid ]] && echo "$pid"
}

start_service() {   # start_service NAME...: the first name this system knows
    local s rc i pid
    [[ $init != systemd ]] || systemctl daemon-reload
    for s in "$@"; do
        case $init in
        systemd)
            systemctl cat "$s.service" >/dev/null 2>&1 || continue
            systemctl enable "$s.service" >/dev/null 2>&1 || true
            systemctl restart "$s.service" && return 0
            ;;
        openrc)
            [[ -e /etc/init.d/$s ]] || continue
            rc-update add "$s" default >/dev/null 2>&1 || true
            rc-service "$s" restart && return 0
            ;;
        sysv)
            [[ -e /etc/init.d/$s ]] || continue
            update-rc.d "$s" defaults >/dev/null 2>&1 || true
            service "$s" restart && return 0
            ;;
        runit)
            rc=0
            start_runit "$s" || rc=$?
            [[ $rc -eq 2 ]] && continue
            [[ $rc -eq 0 ]] && return 0
            ;;
        dinit)
            # Chimera's services are in /usr/lib/dinit.d, Artix's in /etc.
            [[ -e /etc/dinit.d/$s || -e /usr/lib/dinit.d/$s ]] || continue
            dinitctl enable "$s" >/dev/null 2>&1 || true
            # start returns once a process service is launched, so it says
            # nothing of one that dies at once, and with smooth-recovery (as
            # Chimera's avahi-daemon has) is-started says STARTED while dinit
            # restarts a dead one.  Up means one live process, the same one
            # 3 s later (not a restarted one).
            for i in 1 2 3 4 5; do
                dinitctl restart "$s" >/dev/null 2>&1 || dinitctl start "$s" >/dev/null 2>&1 || true
                sleep 3
                pid=$(dinit_pid "$s") || continue
                sleep 3
                [[ $(dinit_pid "$s") == "$pid" ]] && return 0
            done
            ;;
        rc.d)
            # Executable, so that rc.M (rc.inet2, for sshd) starts it at boot.
            # rc.sshd restart stops only the listener, so the sessions stay,
            # and fails when none runs: then start.
            [[ -e $RC_D/rc.$s ]] || continue
            chmod 755 "$RC_D/rc.$s"
            "$RC_D/rc.$s" restart || "$RC_D/rc.$s" start || continue
            return 0
            ;;
        s6)
            [[ -d /etc/s6/sv/$s-srv ]] || continue
            s6 repository sync
            s6 set enable "$s"
            s6 set commit
            s6 live install
            s6 live start "$s"
            s6-svc -r "/run/service/$s-srv" && { sleep 2; return 0; }
            ;;
        esac
    done
    echo "bs1-adopt: couldn't start any of: $*" >&2
    return 1
}

running() { grep -Eqx "$1" /proc/[0-9]*/comm 2>/dev/null; }

set_hostname() {
    if [[ $init == systemd ]] && command -v hostnamectl >/dev/null; then
        hostnamectl set-hostname "$SOURCE_HOST"
        return
    fi
    if [[ $distro == slackware ]]; then
        slk_hostname
        return
    fi
    echo "$SOURCE_HOST" >/etc/hostname
    echo "$SOURCE_HOST" >/proc/sys/kernel/hostname
    # OpenRC's own place for it, on Artix.
    if [[ -f /etc/conf.d/hostname ]]; then sed -i "s/^hostname=.*/hostname=\"$SOURCE_HOST\"/" /etc/conf.d/hostname; fi
}

# Slackware's rc.M sets the host name from /etc/HOSTNAME, a fully qualified
# one (thinkpad.localdomain), and that is what the kernel then has;
# bs1-common's this_host reads it up to the first dot.  The domain stays
# what it was (setup's netconfig, or slackware-bootstrap.sh's localdomain),
# and the name goes into /etc/hosts if it isn't there, as netconfig puts it.
# /etc/hostname is a link to HOSTNAME on -current; a file of its own gets
# the short name, as elsewhere.
slk_hostname() {
    local old dom=localdomain fqdn
    old=$(head -n 1 /etc/HOSTNAME 2>/dev/null) || old=
    [[ $old != *.* ]] || dom=${old#*.}
    fqdn=$SOURCE_HOST.$dom
    [[ $old == "$fqdn" ]] || echo "$fqdn" >/etc/HOSTNAME
    [[ -L /etc/hostname || $(cat /etc/hostname 2>/dev/null) == "$SOURCE_HOST" ]] || echo "$SOURCE_HOST" >/etc/hostname
    echo "$fqdn" >/proc/sys/kernel/hostname
    if ! awk -v n="$fqdn" '!/^[[:space:]]*#/ { for (i = 2; i <= NF; i++) if ($i == n) f = 1 } END { exit !f }' /etc/hosts 2>/dev/null; then
        printf '127.0.0.1\t\t%s %s\n' "$fqdn" "$SOURCE_HOST" >>/etc/hosts
    fi
    echo "/etc/HOSTNAME: $fqdn"
}

install_tools() {
    command -v sshd >/dev/null || [[ -x /usr/sbin/sshd ]] ||
        pkg_install openssh-server openssh-server openssh "$(with_script openssh)" openssh openssh openssh-server openssh net-misc/openssh openssh-server openssh
    # BusyBox's df, umount and blkid lack options the scripts use, and it has no
    # findmnt, lsblk or sfdisk.  Alpine's names; Chimera has no BusyBox, and
    # an apk on Gentoo is a tool, not its package manager.
    if [[ $distro != chimera && $distro != gentoo ]] && command -v apk >/dev/null; then apk_add coreutils findmnt lsblk blkid sfdisk mount umount util-linux-misc; fi
    # Alpine's kernel doesn't load xfs by itself when BusyBox mount asks for
    # it: the drive's mount (backshot1's DRIVE, bs1-to-stick, the restored
    # system's verify) needs it loaded, so load it now and at every boot.
    if [[ $distro == alpine ]]; then
        modprobe xfs
        grep -qx xfs /etc/modules 2>/dev/null || echo xfs >>/etc/modules
    fi
    # Chimera's python package gives the python3 command; it has no python3 package.
    command -v python3 >/dev/null || pkg_install python3 python3 python3 python python3 python3 python python dev-lang/python python3 python3
    if ! command -v findmnt >/dev/null || ! command -v lsblk >/dev/null; then
        pkg_install util-linux util-linux util-linux util-linux util-linux-misc util-linux util-linux util-linux sys-apps/util-linux util-linux util-linux
    fi
    # bs1-to-stick's BootNext needs it, and a Chimera install with systemd-boot
    # (bootctl) can lack it, as can a Gentoo one (it is no part of @system).
    # AerynOS packages none: there bs1-to-stick writes the same entry through
    # efivarfs by bs1-efi, and bs1-backup's baseline lists them by it.
    # The other systems' rehearsals all had it; NixOS gets it from adopt_nixos.
    # PikaOS's installer leaves it (rEFInd's refind-mkdefault uses it), but
    # it isn't held by anything there: apt's, if it was removed.  Solus's
    # clr-boot-manager writes NVRAM through libefivar and needs none.
    if [[ -d /sys/firmware/efi ]] && ! command -v efibootmgr >/dev/null; then
        case $distro in
            alpine|chimera) apk_add efibootmgr ;;
            gentoo) emerge --ask=n --getbinpkg --noreplace sys-boot/efibootmgr ;;
            pika) DEBIAN_FRONTEND=noninteractive apt-get install -y efibootmgr ;;
            solus) eopkg_add efibootmgr ;;
            slackware) slk_install efibootmgr efivar popt ;;
        esac
    fi
    # Solus 4.9 ships without diffutils (no cmp or diff; comm is coreutils').
    # bs1-verify no longer needs them (same_as), but the first Thinkpad run's
    # verify did (solus-4.9-20261117-202222), and comparing by hand wants them.
    if [[ $distro == solus ]] && ! command -v cmp >/dev/null; then eopkg_add diffutils; fi
}

allow_root_key_login() {
    local conf=/etc/ssh/sshd_config
    # AerynOS keeps the file itself in /usr, and reads /etc/ssh/sshd_config.d.
    if [[ ! -e $conf ]] || grep -qE '^[[:space:]]*Include[[:space:]]+/etc/ssh/sshd_config\.d/' "$conf"; then
        mkdir -p /etc/ssh/sshd_config.d
        echo 'PermitRootLogin prohibit-password' >/etc/ssh/sshd_config.d/00-backshot1.conf
    elif ! grep -q 'BackShot1' "$conf"; then
        # sshd keeps the first value it reads.  Not sed -i '1i': GNU's alone
        # takes that, and FreeBSD's (Chimera's) -i wants a suffix.  Written
        # back into the file itself, so its mode, owner and label stay.
        # Three commands, not an && list, so set -e stops at a failing one.
        { printf '# BackShot1\nPermitRootLogin prohibit-password\n'; cat "$conf"; } >"$conf.bs1"
        cat "$conf.bs1" >"$conf"
        rm -f "$conf.bs1"
    fi
}

start_mdns() {
    command -v avahi-daemon >/dev/null || [[ -x /usr/sbin/avahi-daemon ]] ||
        pkg_install avahi-daemon avahi avahi "$(with_script avahi)" "avahi dbus" "avahi dbus" avahi avahi "net-dns/avahi sys-apps/dbus" avahi \
            "avahi libdaemon nss-mdns dbus"
    [[ $distro != slackware ]] || slk_mdns
    if [[ $init == s6 ]]; then
        s6 repository sync
        s6 set enable dbus
    elif ! running 'dbus-(daemon|broker.*)'; then
        # Slackware's is rc.messagebus.
        start_service dbus messagebus
    fi
    # A running dbus-daemon needn't read the policy avahi's install just added
    # (Chimera's doesn't), and without it avahi-daemon may not own its name.
    if running 'dbus-(daemon|broker.*)' && command -v dbus-send >/dev/null; then
        dbus-send --system --print-reply --dest=org.freedesktop.DBus / org.freedesktop.DBus.ReloadConfig >/dev/null || true
    fi
    start_service avahi-daemon avahidaemon
}

# What -current's avahi and nss-mdns need besides (slackware-bootstrap.sh
# checks the same of a fresh install): the avahi user and group (in
# aaa_base's /etc/passwd since avahi joined series l, UID and GID 214, as
# Slackware's UID list has them), D-Bus started at boot (rc.M starts
# rc.messagebus, then rc.avahidaemon, if executable), and nsswitch.conf
# asking mdns4_minimal, as nss-mdns ships it.  15.0 has no avahi.
slk_mdns() {
    if ! grep -q '^avahi:' /etc/group; then groupadd -g 214 avahi; fi
    if ! grep -q '^avahi:' /etc/passwd; then useradd -u 214 -g avahi -d /dev/null -s /bin/false -c 'User for avahi' avahi; fi
    [[ ! -e $RC_D/rc.messagebus ]] || chmod 755 "$RC_D/rc.messagebus"
    # Written back into the file itself, as allow_root_key_login does.
    local ns=/etc/nsswitch.conf
    if [[ -e $ns ]] && ! grep -qE '^hosts:.*[[:space:]]mdns4_minimal([[:space:]]|$)' "$ns"; then
        awk '/^hosts:/ { $0 = "hosts:          files mdns4_minimal [NOTFOUND=return] dns mdns4" } { print }' "$ns" >"$ns.bs1"
        cat "$ns.bs1" >"$ns"
        rm -f "$ns.bs1"
        echo "nsswitch.conf: $(grep '^hosts:' "$ns")"
    fi
}

# An active firewall must let ssh and the mDNS answers through: EndeavourOS's
# firewalld zone allows only ssh and DHCPv6, so $SOURCE_HOST.local never
# resolved; openSUSE's doesn't allow ssh.  NixOS's avahi module opens its own.
open_firewall() {
    local z
    if command -v firewall-cmd >/dev/null && firewall-cmd --state >/dev/null 2>&1; then
        # --get-active-zones: "public (default)", then indented "interfaces: ..."
        for z in $( { firewall-cmd --get-default-zone; firewall-cmd --get-active-zones | awk '!/^[[:space:]]/ { print $1 }'; } | sort -u); do
            firewall-cmd -q --permanent --zone="$z" --add-service=ssh --add-service=mdns
            echo "firewalld: ssh and mdns allowed in zone $z"
        done
        firewall-cmd -q --reload
    fi
    if command -v ufw >/dev/null && ufw status 2>/dev/null | grep -q '^Status: active'; then
        ufw allow 22/tcp >/dev/null && ufw allow 5353/udp >/dev/null && echo "ufw: 22/tcp and 5353/udp allowed"
    fi
}

# NixOS builds /etc from its configuration, so all of that goes in there.
# On a LUKS install the LUKS step (bs1-luks, family N) then writes
# backshot1-luks.nix, which this module imports while it exists, and
# rebuilds again if that changed anything.
adopt_nixos() {
    local conf=/etc/nixos/configuration.nix module=/etc/nixos/backshot1.nix line lines=
    if [[ -e /etc/nixos/flake.nix ]]; then
        echo "bs1-adopt: this system is built from a flake; add BackShot1's settings to it by hand" >&2
        return 1
    fi
    while read -r line; do lines+="\"$line\" "; done <"$keys/authorized_keys"
    cat >"$module" <<EOF
# Written by BackShot1's bs1-adopt.
{ lib, pkgs, ... }:
{
  # bs1-luks's unlocking from the backup drive (family N), while bs1-adopt
  # has it on: bs1-adopt --luks-off removes the file.
  imports = builtins.filter builtins.pathExists [ ./backshot1-luks.nix ];
  networking.hostName = lib.mkForce "$SOURCE_HOST";
  services.openssh.enable = true;
  services.openssh.settings.PermitRootLogin = lib.mkForce "prohibit-password";
  users.users.root.openssh.authorizedKeys.keys = [ $lines];
  services.avahi = { enable = true; publish = { enable = true; addresses = true; }; };
  environment.systemPackages = [ pkgs.python3 pkgs.efibootmgr ];
}
EOF
    if ! grep -q 'backshot1\.nix' "$conf"; then
        # nixos-generate-config puts the [ on the line after "imports =", with
        # a comment after it; spaces, newlines and # comments may come between.
        # -z reads the whole file as one line, and s/// changes the first list.
        # NixOS has GNU sed.
        sed -z -E -i 's/imports([[:space:]]|#[^\n]*)*=([[:space:]]|#[^\n]*)*\[/& .\/backshot1.nix/' "$conf"
        grep -q 'backshot1\.nix' "$conf" || { echo "bs1-adopt: no imports list in $conf to add $module to" >&2; return 1; }
    fi
    nixos-rebuild switch || return
    # switch writes /etc/hostname but leaves the running kernel's name alone,
    # so until a reboot hostname still says nixos and avahi publishes
    # nixos.local, and BackShot1's preflight stops.  Set it now, as
    # set_hostname does, and have avahi publish the new name.
    echo "$SOURCE_HOST" >/proc/sys/kernel/hostname
    if systemctl -q is-active avahi-daemon.service; then systemctl restart avahi-daemon.service; fi
}

# Guix System builds /etc, sshd_config and the system profile from its
# configuration too (docs/design/guix.md, GX8).  A configuration file is one
# operating-system expression, with no imports list to add to, so this writes
# /etc/backshot1/system.scm, which loads /etc/config.scm and adds BackShot1's
# settings to what it returns: the hostname, openssh (root by key only, the
# drive's keys), avahi, and python, efibootmgr and btrfs-progs.  An openssh or
# avahi service in /etc/config.scm gives way to these.  Then it reconfigures
# from that file; a reconfigure from /etc/config.scm alone takes them away
# again.  --allow-downgrades: after a `guix pull`, 1.5.0's own commit is not
# an ancestor of the pulled one (What GX1-GX5 found).
adopt_guix() {
    local conf=/etc/config.scm sys=/etc/backshot1/system.scm keys_scm= line
    [[ -s $conf ]] || { echo "bs1-adopt: no $conf: write this system's configuration there" >&2; return 1; }
    # The keys as one Scheme string: backslashes and quotes escaped, \n between.
    while read -r line; do
        [[ -n $line ]] || continue
        line=${line//\\/\\\\}
        keys_scm+="${line//\"/\\\"}\\n"
    done <"$keys/authorized_keys"
    install -d -m 755 /etc/backshot1
    cat >"$sys" <<EOF
;; Written by BackShot1's bs1-adopt: $conf plus what BackShot1 needs.
;;   guix system reconfigure --allow-downgrades $sys
(use-modules (gnu) (srfi srfi-1))
(use-service-modules avahi ssh)

(define %base (load "$conf"))

(operating-system
  (inherit %base)
  (host-name "$SOURCE_HOST")
  (packages (delete-duplicates
              (append (map specification->package
                           '("python" "efibootmgr" "btrfs-progs"))
                      (operating-system-packages %base))
              eq?))
  (services
    (append (list (service openssh-service-type
                    (openssh-configuration
                      (permit-root-login 'prohibit-password)
                      (password-authentication? #f)
                      (authorized-keys
                        \`(("root" ,(plain-file "backshot1-root.pub" "$keys_scm"))))))
                  (service avahi-service-type))
            (remove (lambda (s)
                      (memq (service-kind s) (list openssh-service-type avahi-service-type)))
                    (operating-system-user-services %base)))))
EOF
    guix system reconfigure --allow-downgrades "$sys"
}

if [[ $distro == guix ]]; then
    :   # adopt_guix, below: the hostname and the tools are in the configuration
elif [[ ! -e /etc/NIXOS ]]; then
    echo "== hostname: $SOURCE_HOST"
    set_hostname
    if [[ $distro == solus ]]; then
        echo "== Solus: a preset that keeps sshd and avahi-daemon enabled"
        solus_presets
    fi
    echo "== what's missing"
    install_tools
fi

echo "== root's authorized_keys"
install -d -m 700 /root/.ssh
touch /root/.ssh/authorized_keys
chmod 600 /root/.ssh/authorized_keys
while read -r line; do
    grep -qxF "$line" /root/.ssh/authorized_keys || echo "$line" >>/root/.ssh/authorized_keys
done <"$keys/authorized_keys"

echo "== the fixed host key"
rm -f /etc/ssh/ssh_host_rsa_key* /etc/ssh/ssh_host_ecdsa_key* /etc/ssh/ssh_host_dsa_key*
install -m 600 "$keys/ssh_host_ed25519_key" /etc/ssh/ssh_host_ed25519_key
install -m 644 "$keys/ssh_host_ed25519_key.pub" /etc/ssh/ssh_host_ed25519_key.pub
if command -v restorecon >/dev/null; then restorecon -R /root/.ssh /etc/ssh; fi

if [[ -e /etc/NIXOS ]]; then
    echo "== NixOS: $SOURCE_HOST, sshd, mDNS, Python and efibootmgr, in its configuration"
    adopt_nixos
    systemctl restart sshd.service
elif [[ $distro == guix ]]; then
    echo "== Guix System: $SOURCE_HOST, sshd, mDNS, Python, efibootmgr and btrfs-progs, in /etc/backshot1/system.scm"
    adopt_guix
    # A reconfigure starts the services that are new and leaves running ones
    # alone: sshd takes the host key and its new configuration at a restart
    # (the sessions it has open stay).
    herd restart ssh-daemon
    herd start avahi-daemon
else
    allow_root_key_login
    # sshd -t, and sshd itself, stop without its privilege separation
    # directory, which only the service's own start makes on Debian and Ubuntu.
    mkdir -p /run/sshd
    "$(command -v sshd || echo /usr/sbin/sshd)" -t
    start_service ssh sshd
    echo "== mDNS, for $SOURCE_HOST.local"
    start_mdns
    echo "== the firewall, if one is on"
    open_firewall
fi
# After start_mdns, whose avahi install is the last eopkg transaction.
if [[ $distro == solus ]]; then
    echo "== Solus: qol-assist's migrations, pending for the next boot"
    solus_qol
fi

echo "== LUKS: unlocking from the backup drive"
# bs1-common's PATH, LC_ALL and internal_disk; bs1-luks's step.  set -e
# doesn't reach into a function called with ||: it checks for itself.
# shellcheck disable=SC1091
. "$here/bs1-common"
# shellcheck disable=SC1091
. "$here/bs1-luks"
luks_adopt || exit 1

ssh-keygen -l -f /etc/ssh/ssh_host_ed25519_key.pub
echo "bs1-adopt: done.  Tell Claude: \"Let's run BackShot1.\""
