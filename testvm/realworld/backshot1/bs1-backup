#!/bin/bash
# BackShot1, phase 1: back up the running system.  As root, on the machine.
#
# Writes runs/DISTRO-STAMP/ on the backup drive, beside this script: the layout, a
# manifest, the repository and its password, run.log, and PHASE1_OK once the
# backup has passed `check --read-data`.  Changes nothing on the internal disk.
#
# The snapshot is of a read-only bind tree of every real filesystem mounted from
# the internal disk, through whatever stack of LUKS, LVM, md, btrfs or ZFS it is
# on.  So /proc, /sys, /run and the backup drive aren't in it and no exclusions
# are needed.  There's no filesystem snapshot: files that change while this
# runs are caught at different moments, as they are for anyone backing up a live
# system.  btrfs subvolumes and ZFS datasets that aren't mounted aren't backed up.
#
# On ostree (docs/design/bazzite.md) the tree is fstab's, from the layout's
# storage.backup_sources: the physical root (/sysroot) at /, /var/home at /home.
# It also stops if a deployment is staged or pending, or a btrfs subvolume
# isn't in the tree; holds the updaters off for this boot; records the
# deployments in the baseline; and fails if they or /boot/loader moved while
# it ran.

# shellcheck disable=SC1091
. "$(dirname "$(readlink -f "$0")")/bs1-common"

trap drop_tree EXIT
trap 'die "interrupted"' INT TERM HUP

step "preflight"
[[ $(this_host) == "$SOURCE_HOST" ]] || die "this is $(this_host), not $SOURCE_HOST"
disk=$(internal_disk) || die "no single disk has serial $INTERNAL_SERIAL"
on_disk "$(root_source)" "$disk" || die "$(root_mount) isn't on $disk"
# An ESP on an automount appears only when something looks at it.
ls /boot/efi /efi /boot >/dev/null 2>&1
check_coverage "$disk"
drive=$(backup_disk "$disk") || die "LABEL=$BACKUP_LABEL isn't a USB drive apart from $disk"
for b in bko-holt rustic-bko; do [[ -x $BIN/$b ]] || die "no $BIN/$b"; done
"$BIN/bko-holt" dump --help 2>&1 | grep -q -- --only-disk || die "this bko-holt has no --only-disk"
# The deployments and where /boot/loader points, now; again after the backup.
ostree_moved() { ostree admin status; readlink /boot/loader; }
# bs1-ostree's refusals for LAYOUT, or why it couldn't tell, and false;
# true only if it exits 0 with nothing to say.  Its exit status counts, not
# only what it printed, so a crash is never a pass.
ostree_preflight() {
    local problems rc
    problems=$(python3 "$HERE/bs1-ostree" preflight "$1")
    rc=$?
    [[ $rc -eq 0 && -z $problems ]] && return 0
    if [[ $rc -eq 1 && -n $problems ]]; then echo "$problems"; else echo "bs1-ostree preflight failed (exit $rc)${problems:+: $problems}"; fi
    return 1
}
if is_ostree; then
    for u in $UPDATERS; do
        ! systemctl is-active -q "$u.service" || die "$u.service is running: an update may be under way; wait for it to finish"
    done
fi

if [[ ${1:-} == --preflight ]]; then
    say "internal: $disk (serial $INTERNAL_SERIAL), backup drive: $drive"
    tmp=$(mktemp)
    # dump refuses a system it doesn't support: a Bazzite that moved to 45 stops here.
    "$BIN/bko-holt" dump --only-disk "$disk" >"$tmp" || { rm -f "$tmp"; die "bko-holt dump failed"; }
    if is_ostree; then
        why=$(ostree_preflight "$tmp") || { rm -f "$tmp"; die "$why"; }
        for u in $UPDATERS; do
            ! systemctl is-active -q "$u.timer" || say "$u.timer is active: phase1 stops it for this boot"
        done
    fi
    say "would back up (path in the backup, from):"
    internal_mounts "$disk" "$tmp" | awk -F'\t' '{ print "  " $1 "  <-  " $2 " (" $3 ")" }'
    rm -f "$tmp"
    say "PREFLIGHT OK: nothing was changed"
    exit 0
fi

RUN=$RUNS/$(distro_name)-$(date -u +%Y%m%d-%H%M%S)
mkdir -p "$RUN/baseline" || die "can't make $RUN"
LOG=$RUN/run.log
: >"$LOG"
say "internal: $disk (serial $INTERNAL_SERIAL), backup drive: $drive, run: $RUN"
. /etc/os-release 2>/dev/null && say "system: ${PRETTY_NAME:-unknown}, kernel $(uname -r)"
run "$BIN/bko-holt" --version
run "$BIN/rustic-bko" --version
run sha256sum "$BIN/bko-holt" "$BIN/rustic-bko"
run lsblk -o NAME,SIZE,TYPE,TRAN,FSTYPE,LABEL,MOUNTPOINTS
if is_ostree; then
    for u in $UPDATERS; do
        if systemctl is-active -q "$u.timer"; then must systemctl stop "$u.timer"; say "stopped $u.timer for this boot"; fi
    done
    ostree_moved >"$RUN/baseline/ostree-before.txt" 2>&1
fi

# Before the tree is mounted, so the layout doesn't list its binds.
step "the layout"
"$BIN/bko-holt" dump --only-disk "$disk" >"$RUN/layout.json" 2>>"$LOG" || die "bko-holt dump failed"
say "layout.json: $(wc -c <"$RUN/layout.json") bytes"
grep -q "\"$drive\"" "$RUN/layout.json" && die "the layout mentions the backup drive"
keys=$(layout_keys "$RUN/layout.json" "$HERE/keys/disk-passphrase") || die "can't read the layout"
if [[ -n $keys ]]; then
    [[ -s $HERE/keys/disk-passphrase ]] ||
        die "encrypted volumes need the passphrase in $HERE/keys/disk-passphrase: $keys"
    say "encrypted: someone has to type the passphrase at the restored system's first boot"
    touch "$RUN/NEEDS_PASSPHRASE_AT_BOOT"
fi
if is_ostree; then
    why=$(ostree_preflight "$RUN/layout.json") || die "$why"
fi

need=$(space_in_use "$disk" "$RUN/layout.json")
# df -Pk, not GNU's -B1 --output, which FreeBSD's df (Chimera's) lacks.
free=$(df -Pk "$RUN" | awk 'NR == 2 { print $4 }')
free=$((${free:-0} * 1024))
say "in use: $((need / 1048576)) MiB; free on the drive: $((free / 1048576)) MiB"
[[ $free -gt $need ]] || die "the backup drive hasn't enough room"

step "the tree to back up"
make_tree "$disk" "$RUN/layout.json"
run findmnt -R "$TREE"

step "the baseline"
B=$RUN/baseline
package_list >"$B/packages.txt"
efibootmgr -v >"$B/efibootmgr.txt" 2>&1
lsblk -o NAME,SIZE,TYPE,TRAN,FSTYPE,LABEL,UUID,PARTUUID,MOUNTPOINTS,MODEL,SERIAL >"$B/lsblk.txt" 2>&1
sfdisk -d "/dev/$disk" >"$B/sfdisk.txt" 2>&1
cp /etc/fstab "$B/fstab" 2>/dev/null
swap_names >"$B/swap-names.txt"
lvmid_record >"$B/lvmid.txt" 2>&1
grep -q '^EMBED ' "$B/lvmid.txt" && say "GRUB embeds an lvmid: $(awk '$1 == "EMBED" { print $2 " " $3 }' "$B/lvmid.txt" | tr '\n' ' ')"
failed_units >"$B/failed-units.txt"
must python3 "$HERE/bs1-manifest" "$TREE" "$B/manifest.tsv"
if is_ostree; then
    python3 "$HERE/bs1-ostree" record "$TREE" >"$B/deployments.txt" || die "can't record the deployments"
    python3 "$HERE/bs1-ostree" links "$TREE" >"$B/links.txt" || die "can't count the hard links"
    python3 "$HERE/bs1-ostree" space "$TREE" >"$B/space.txt" || die "can't measure the btrfs filesystems"
    say "deployments: $(grep -c '^deployment ' "$B/deployments.txt"), booted $(sed -n 's/^booted //p' "$B/deployments.txt")"
    run cat "$B/links.txt"
fi

step "backing up"
pw=$RUN/repo-password
(umask 077; head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' >"$pw") || die "can't write the password"
rustic_in "$RUN"
must "${RUSTIC[@]}" init
must "${RUSTIC[@]}" backup --set-atime yes --as-path "$SNAP" "$TREE"
must "${RUSTIC[@]}" snapshots
if is_ostree; then
    ostree_moved >"$RUN/baseline/ostree-after.txt" 2>&1
    cmp -s "$RUN/baseline/ostree-before.txt" "$RUN/baseline/ostree-after.txt" ||
        die "the deployments or /boot/loader moved during the backup: $(diff "$RUN/baseline/ostree-before.txt" "$RUN/baseline/ostree-after.txt" | grep '^[<>]' | head -n 4 | tr '\n' ' ')"
    say "the deployments and /boot/loader didn't move during the backup"
fi

step "checking the backup (reading all of its data)"
must "${RUSTIC[@]}" check --read-data

sha256sum "$RUN/layout.json" | cut -d' ' -f1 >"$RUN/PHASE1_OK"
sync
say "PHASE 1 OK: $RUN"
echo "RUN=$(basename "$RUN")"
