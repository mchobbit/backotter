#!/bin/bash
# BackShot1, phase 1: back up the running system.  As root, on the machine.
#
# Writes runs/DISTRO-STAMP/ on the backup drive, beside this script: the layout, a
# manifest, the repository and its password, run.log, and PHASE1_OK once the
# backup has passed `check --read-data`.  Changes nothing on the internal disk.
#
# The snapshot is of a read-only bind tree of every real filesystem mounted from
# the internal disk, through whatever stack of LUKS, LVM, md, btrfs or ZFS it is
# on.  So /proc, /sys, /run and the backup drive aren't in it and no exclusions
# are needed.  There's no filesystem snapshot: files that change while this
# runs are caught at different moments, as they are for anyone backing up a live
# system.  btrfs subvolumes and ZFS datasets that aren't mounted aren't backed up.
#
# On ostree (docs/design/bazzite.md) the tree is fstab's, from the layout's
# storage.backup_sources: the physical root (/sysroot) at /, /var/home at /home.
# It also stops if a deployment is staged or pending, or a btrfs subvolume
# isn't in the tree; holds the updaters off for this boot; records the
# deployments in the baseline; and fails if they or /boot/loader moved while
# it ran.
#
# On ABRoot (Vanilla OS: docs/design/vanillaos.md) the tree is the layout's
# six-path one: / (the present root, raw: its image's /etc, whose changes are
# in /var/lib/abroot/etc/LABEL), /boot, /boot/efi, /var, and the init LV at
# /boot/init and the other root at /part-future, which nothing mounts: phase 1
# mounts those two read-only under RO_MOUNTS as the layout's mount hints say.
# It stops if an ABRoot operation is running, an upgrade waits for a reboot
# (the master grub.cfg boots another root than the running one), or the
# layout isn't the two-root thin one load restores (bs1-abroot preflight);
# holds vanilla-updates off for this boot; records both roots in the baseline
# (abroot.txt); and fails if the master grub.cfg, grub.cfg.future or the lock
# moved while it ran.
#
# On Proxmox VE with proxmox-boot-tool (docs/design/proxmox.md) the ESPs in
# /etc/kernel/proxmox-boot-uuids are mounted by nothing and aren't backed up:
# the coverage check names them, and the dump's boot.proxmox_boot must list
# the same ones, since the restore makes them again from /boot.  /etc/pve is
# pmxcfs's FUSE view of /var/lib/pve-cluster/config.db, which is backed up
# with /; the tree's binds don't cross into it, nor into /var/lib/lxcfs.  It
# fails if pmxcfs checkpointed config.db while rustic read it.
#
# On TrueNAS (docs/design/truenas.md) the ESP on the boot-pool disk is
# mounted by nothing and isn't backed up either: the coverage check names
# it, and the dump's boot.truenas must list it with its volume ID, of
# TrueNAS 25.10, holding only what the restore's grub-install writes again
# (truenas_check).  A ZFS dataset mounted twice (.system/cores) is in the
# tree once, as in the dump.  On every system but ABRoot and ostree, a
# source the dump lists that nothing mounts (an inactive boot environment)
# stops it: the tree wouldn't hold it.  It fails if the middleware wrote
# its config database, /data/freenas-v1.db, while rustic read it, whose rows
# it records in baseline/truenas-db.txt for bs1-verify.  And on TrueNAS
# bs1-adopt's settings must be in that database, and this a later boot than
# adopt's last change to it (truenas_adopted).
#
# Encrypted volumes: both the preflight and phase 1 check that the drive's
# keys/disk-passphrase opens each one, and say how they unlock at boot,
# UNLOCK=drive, own, attended or none (unlock_mode in bs1-common; drive
# needs this boot to have been opened by the drive's key, so one reboot
# after bs1-adopt).  Phase 1 writes it to baseline/unlock.txt, which
# bs1-verify checks the restored boot against, and NEEDS_PASSPHRASE_AT_BOOT
# for an attended run.
#
# The preflight and phase 1 hold a sleep, idle and lid-switch inhibitor
# while they run (hold_awake in bs1-common): an idle desktop suspended a
# phase 1 once.

# shellcheck disable=SC1091
. "$(dirname "$(readlink -f "$0")")/bs1-common"

trap drop_tree EXIT
trap 'die "interrupted"' INT TERM HUP
hold_awake "bs1-backup${1:+ $1}: a suspend would cut the controller's SSH"

step "preflight"
[[ $(this_host) == "$SOURCE_HOST" ]] || die "this is $(this_host), not $SOURCE_HOST"
disk=$(internal_disk) || die "no single disk has serial $INTERNAL_SERIAL"
on_disk "$(root_source)" "$disk" || die "$(root_mount) isn't on $disk"
# An ESP on an automount appears only when something looks at it.
ls /boot/efi /efi /boot >/dev/null 2>&1
# Solus's ESP, out of fstab, at /boot by clr-boot-manager mount-boot, for the
# coverage check, the dump and the tree (bs1-common).
esp=$(mount_cbm_esp "$disk") || die "Solus's ESP: $esp"
[[ -z $esp ]] || say "$esp"
# ABRoot's other root and init LV are mounted by nothing: checked once the
# dump has named them (its backup_sources' mount hints), below.
is_abroot || check_coverage "$disk"
drive=$(backup_disk "$disk") || die "LABEL=$BACKUP_LABEL isn't a USB drive apart from $disk"
for b in bko-holt rustic-bko; do [[ -x $BIN/$b ]] || die "no $BIN/$b"; done
"$BIN/bko-holt" dump --help 2>&1 | grep -q -- --only-disk || die "this bko-holt has no --only-disk"
# The deployments and where /boot/loader points, now; again after the backup.
ostree_moved() { ostree admin status; readlink /boot/loader; }
# bs1-ostree's refusals for LAYOUT, or why it couldn't tell, and false;
# true only if it exits 0 with nothing to say.  Its exit status counts, not
# only what it printed, so a crash is never a pass.
ostree_preflight() {
    local problems rc
    problems=$(python3 "$HERE/bs1-ostree" preflight "$1")
    rc=$?
    [[ $rc -eq 0 && -z $problems ]] && return 0
    if [[ $rc -eq 1 && -n $problems ]]; then echo "$problems"; else echo "bs1-ostree preflight failed (exit $rc)${problems:+: $problems}"; fi
    return 1
}
# The same for ABRoot (docs/design/vanillaos.md): bs1-abroot's refusals.
abroot_preflight() {
    local problems rc
    problems=$(python3 "$HERE/bs1-abroot" preflight "$1")
    rc=$?
    [[ $rc -eq 0 && -z $problems ]] && return 0
    if [[ $rc -eq 1 && -n $problems ]]; then echo "$problems"; else echo "bs1-abroot preflight failed (exit $rc)${problems:+: $problems}"; fi
    return 1
}
# The master grub.cfg and grub.cfg.future, which only an upgrade or a
# rollback writes, and ABRoot's lock, now; again after the backup.
abroot_moved() { python3 "$HERE/bs1-abroot" state; }
if is_ostree || is_abroot; then
    for u in $UPDATERS; do
        ! systemctl is-active -q "$u.service" || die "$u.service is running: an update may be under way; wait for it to finish"
    done
fi
# unlock_check LAYOUT: unlock_mode's lines, after checking the drive's key
# against every LUKS volume and the record's initramfs generator against
# the dump's (not for family N: bko-holt's dump names no generator on
# NixOS); false with the reason if one fails.
unlock_check() {
    local key=$HERE/keys/disk-passphrase gen dumped
    if [[ -n $(luks_devices "$disk") ]]; then
        [[ -s $key ]] || { echo "encrypted volumes need the passphrase in $key"; return 1; }
        luks_key_test "$disk" "$key" || return 1
    fi
    gen=$(luks_rec generator) || gen=
    if [[ -n $gen && $(luks_rec family) =~ ^[SDEBP]$ ]]; then
        dumped=$(python3 -c 'import json, sys; print(((json.load(open(sys.argv[1])).get("boot") or {}).get("initramfs") or {}).get("generator") or "")' "$1")
        [[ $dumped == "$gen" ]] || { echo "$LUKS_REC was written for $gen's initramfs, but bko-holt dump says ${dumped:-none}: bs1-adopt again"; return 1; }
    fi
    # Family Z (ZFSBootMenu): the drive's key against each ZFS encryption
    # root that asks, and the dump must see ZFSBootMenu too.
    if [[ $(luks_rec family) == Z ]]; then
        [[ -s $key ]] || { echo "encrypted volumes need the passphrase in $key"; return 1; }
        # shellcheck disable=SC2046
        zfs_key_test "$key" $(layout_zfs_passphrase "$1") || return 1
        python3 -c 'import json, sys; sys.exit(0 if isinstance((json.load(open(sys.argv[1])).get("boot") or {}).get("zfsbootmenu"), dict) else 1)' "$1" ||
            { echo "$LUKS_REC is for ZFSBootMenu (family Z), but bko-holt dump finds none: bs1-adopt again"; return 1; }
    fi
    unlock_mode "$disk" "$1"
}
# proxmox_check LAYOUT: on a proxmox-boot-tool system, the dump's
# boot.proxmox_boot must list the ESPs PROXMOX_ESPS does, in its order, or
# load wouldn't make them again (the coverage check passed them over).  Says
# which, or why not and false; nothing elsewhere.
proxmox_check() {
    [[ -r $PROXMOX_ESPS ]] || return 0
    python3 - "$1" "$PROXMOX_ESPS" <<'PY'
import json, sys
pb = (json.load(open(sys.argv[1])).get("boot") or {}).get("proxmox_boot") or {}
want = [l.strip() for l in open(sys.argv[2]) if l.strip() and not l.strip().startswith("#")]
got = pb.get("uuids") or []
if [u.upper() for u in got] != [u.upper() for u in want]:
    print(f"{sys.argv[2]} lists {' '.join(want) or 'nothing'}, but bko-holt dump's boot.proxmox_boot has {' '.join(got) or 'none'}: this bko-holt wouldn't make proxmox-boot-tool's ESPs again")
    sys.exit(1)
modes = " ".join(f"{e.get('uuid')} ({e.get('device')}, {e.get('mode')})" for e in pb.get("esps") or [])
print(f"proxmox-boot-tool's ESPs, not in the backup, which the restore formats and proxmox-boot-tool init and refresh make again: {modes}")
PY
}
# truenas_check LAYOUT: on TrueNAS (is_truenas), the dump must be of
# TrueNAS 25.10 (os.product), the one release bko-holt load restores, and
# its boot.truenas.esps must list each of the disk's ESPs (truenas_esps:
# the coverage check passed over the unmounted ones) with the same volume
# ID, or load wouldn't make them again.  Each must hold nothing but what
# that remake writes, grub-install's EFI/debian (shim, MokManager, the
# fallback, GRUB and its grub.cfg stub) and the copy of GRUB at
# EFI/boot/bootx64.efi, as the dump read it, or the rest would be lost.
# Says which, or why not and false; nothing elsewhere.
truenas_check() {
    local esps
    is_truenas || return 0
    esps=$(truenas_esps "$disk")
    # shellcheck disable=SC2086
    python3 - "$1" $esps <<'PY'
import fnmatch, json, sys
d = json.load(open(sys.argv[1]))
tn = (d.get("boot") or {}).get("truenas")
if not isinstance(tn, dict):
    print("this is TrueNAS (/etc/version, midclt), but bko-holt dump has no boot.truenas: this bko-holt wouldn't make its ESPs again")
    sys.exit(1)
product = (d.get("os") or {}).get("product") or ""
release = product[len("TrueNAS "):] if product.startswith("TrueNAS ") else ""
if not (release == "25.10" or release.startswith("25.10.")):
    print(f"bko-holt dump says this is {product or 'no TrueNAS release'}, and bko-holt load restores TrueNAS 25.10 only")
    sys.exit(1)
listed = {e.get("device"): e for e in tn.get("esps") or [] if isinstance(e, dict)}
read = {e.get("device"): e.get("contents") for e in (d.get("boot") or {}).get("esps") or [] if isinstance(e, dict)}
# What load's truenas arm writes on each ESP (load/truenas.rs), in any case.
remade = ["efi/debian/shimx64.efi", "efi/debian/grubx64.efi", "efi/debian/mmx64.efi", "efi/debian/fbx64.efi",
          "efi/debian/bootx64.csv", "efi/debian/grub.cfg", "efi/boot/bootx64.efi"]
args, bad, ok = sys.argv[2:], [], []
for dev, uuid in zip(args[::2], args[1::2]):
    name = dev.removeprefix("/dev/")
    uuid = "" if uuid == "-" else uuid
    e = listed.get(name)
    if e is None:
        bad.append(f"{dev} isn't in its boot.truenas.esps")
        continue
    if (e.get("uuid") or "").upper() != uuid.upper():
        bad.append(f"{dev}'s volume ID is {uuid or 'none'}, but boot.truenas.esps says {e.get('uuid') or 'none'}")
        continue
    files = (read.get(name) or {}).get("files") if isinstance(read.get(name), dict) else None
    if e.get("read") is not True or not isinstance(files, list):
        bad.append(f"bko-holt dump couldn't read {dev}, so nothing says the remade ESP would hold all it holds")
        continue
    kept = [f.get("path") or "?" for f in files if not any(fnmatch.fnmatch((f.get("path") or "").lower(), p) for p in remade)]
    if kept:
        bad.append(f"{dev} holds {' '.join(kept[:5])}{' ...' if len(kept) > 5 else ''}, which the restore's grub-install wouldn't write again")
        continue
    ok.append(f"{dev} ({uuid or 'no volume ID'}, {len(files)} files)")
if bad:
    print("TrueNAS's ESPs aren't backed up, and this bko-holt wouldn't make them again: " + "; ".join(bad))
    sys.exit(1)
if ok:
    print(f"TrueNAS {release}'s ESPs, not in the backup, which the restore formats with their volume IDs and its grub-install makes again: {' '.join(ok)}")
PY
}
# truenas_adopted: on TrueNAS, bs1-adopt's settings must be in the
# middleware's database, which writes /etc from it at every boot (bs1-adopt,
# truenas_hostname and the rest): the hostname, the fixed ed25519 host key
# (services_ssh, base64), ssh.service started at boot and mDNS announced.  And
# this boot must be a later one than the one adopt last changed them in
# (TRUENAS_STAMP), so that the baseline is what a boot makes of the
# database, as the restored system's first boot is, and the settings are
# seen to stay.  Says why not, and false; nothing elsewhere.
truenas_adopted() {
    local boot stamp t rc
    is_truenas || return 0
    [[ -s $TRUENAS_STAMP ]] || { echo "this is TrueNAS, and bs1-adopt hasn't put BackShot1's settings in its middleware's database ($TRUENAS_STAMP): run bs1-adopt, then reboot"; return 1; }
    boot=$(cat "$BOOT_ID")
    stamp=$(sed -n 's/^boot_id=//p' "$TRUENAS_STAMP")
    [[ $stamp != "$boot" ]] || { echo "bs1-adopt changed TrueNAS's configuration in this boot: reboot first (systemctl reboot), so that /etc is what the middleware makes of it at a boot"; return 1; }
    t=$(mktemp -d) || return 1
    if ! midclt call network.configuration.config >"$t/net" || ! midclt call datastore.config services.ssh >"$t/ssh" ||
        ! midclt call service.query '[["service", "=", "ssh"]]' '{"get": true}' >"$t/svc"; then
        rm -rf "$t"
        echo "midclt couldn't read the middleware's configuration"
        return 1
    fi
    python3 - "$t" "$SOURCE_HOST" "$HERE/keys/ssh_host_ed25519_key.pub" <<'PY'
import base64, binascii, json, sys
t, host, pub = sys.argv[1:]
net, ssh, svc = (json.load(open(f"{t}/{x}")) for x in ("net", "ssh", "svc"))
bad = []
if net.get("hostname") != host:
    bad.append(f"its hostname is {net.get('hostname')!r}, not {host!r}")
if (net.get("service_announcement") or {}).get("mdns") is not True:
    bad.append("it doesn't announce mDNS")
try:
    have = base64.b64decode(ssh.get("ssh_host_ed25519_key_pub") or "", validate=True)
except (binascii.Error, ValueError):
    have = b""
if have != open(pub, "rb").read():
    bad.append(f"its ed25519 host key isn't {pub}'s")
if svc.get("enable") is not True:
    bad.append("it doesn't start ssh at boot")
if bad:
    print("TrueNAS's middleware would undo bs1-adopt at the next boot: " + "; ".join(bad) + ": run bs1-adopt, then reboot")
    sys.exit(1)
PY
    rc=$?
    rm -rf "$t"
    return "$rc"
}
# unhinted_check LAYOUT: the dump's backup_sources that nothing mounts
# ("from": null: inactive ZFS boot environments, TrueNAS's or ZFSBootMenu's)
# have to be in the tree, but only ABRoot's are mounted for it (mount_hints):
# elsewhere the backup wouldn't hold them, and load would make them empty.
# So it stops, naming them; ABRoot passes.
unhinted_check() {
    if is_abroot || is_ostree; then return 0; fi
    python3 - "$1" <<'PY'
import json, sys
left = [s.get("path") or "?" for s in json.load(open(sys.argv[1]))["storage"].get("backup_sources") or [] if s.get("from") is None]
if left:
    print(f"bko-holt dump lists sources nothing mounts, which this BackShot1 doesn't mount for the backup, so they'd come back empty: {' '.join(left)}")
    sys.exit(1)
PY
}
# pmxcfs keeps /etc/pve in an sqlite database in WAL mode, which rustic reads
# live.  While the main file doesn't change, no checkpoint wrote to it, and
# whatever of the WAL rustic read is a prefix sqlite can open; if it changed,
# the two copies may not agree, and a restored pve-cluster that can't open
# them leaves /etc/pve empty, and root's authorized_keys with it.
PVE_DB=/var/lib/pve-cluster/config.db
pve_db_moved() { stat -c '%i %y %s' "$PVE_DB"; }
# TrueNAS's middleware keeps its whole configuration (and, with
# /data/pwenc_secret, the key to its encrypted fields) in this SQLite
# database, which rustic reads live.  If it was written while rustic read
# it, the copy may be torn, and a restored middleware that can't open it
# comes back unconfigured: phase 1 fails then.  Its -wal and -journal too,
# if it has them (TRUENAS_DB is bs1-common's).
truenas_db_moved() { local f; for f in "$TRUENAS_DB" "$TRUENAS_DB-wal" "$TRUENAS_DB-journal"; do [[ ! -e $f ]] || stat -c '%n %i %y %s' "$f"; done; }

if [[ ${1:-} == --preflight ]]; then
    say "internal: $disk (serial $INTERNAL_SERIAL), backup drive: $drive"
    tmp=$(mktemp)
    # dump refuses a system it doesn't support: a Bazzite that moved to 45 stops here.
    "$BIN/bko-holt" dump --only-disk "$disk" >"$tmp" || { rm -f "$tmp"; die "bko-holt dump failed"; }
    why=$(proxmox_check "$tmp") || { rm -f "$tmp"; die "$why"; }
    [[ -z $why ]] || say "$why"
    why=$(truenas_check "$tmp") || { rm -f "$tmp"; die "$why"; }
    [[ -z $why ]] || say "$why"
    why=$(truenas_adopted) || { rm -f "$tmp"; die "$why"; }
    if is_truenas; then
        python3 "$HERE/bs1-manifest" --db-dump "$TRUENAS_DB" "$tmp.db" || { rm -f "$tmp" "$tmp.db"; die "can't read the rows of $TRUENAS_DB"; }
        say "TrueNAS: bs1-adopt's settings are in the middleware's database, and this is a later boot; phase 1 records its $(grep -c '^row' "$tmp.db") rows for bs1-verify"
        rm -f "$tmp.db"
    fi
    why=$(unhinted_check "$tmp") || { rm -f "$tmp"; die "$why"; }
    if is_ostree; then
        why=$(ostree_preflight "$tmp") || { rm -f "$tmp"; die "$why"; }
        for u in $UPDATERS; do
            ! systemctl is-active -q "$u.timer" || say "$u.timer is active: phase1 stops it for this boot"
        done
    fi
    if is_abroot; then
        why=$(abroot_preflight "$tmp") || { rm -f "$tmp"; die "$why"; }
        (check_coverage "$disk" "$tmp") || { rm -f "$tmp"; exit 1; }
        for u in $UPDATERS; do
            ! systemctl is-active -q "$u.timer" || say "$u.timer is active: phase1 stops it for this boot"
        done
        say "phase 1 mounts these read-only under $RO_MOUNTS, as the layout's mount hints say: $(python3 -c 'import json, sys; print(" ".join(s["path"] for s in json.load(open(sys.argv[1]))["storage"].get("backup_sources") or [] if s.get("from") is None))' "$tmp")"
    fi
    say "would back up (path in the backup, from):"
    internal_mounts "$disk" "$tmp" | awk -F'\t' '{ print "  " $1 "  <-  " $2 " (" $3 ")" }'
    unlock=$(unlock_check "$tmp") || { rm -f "$tmp"; die "$unlock"; }
    rm -f "$tmp"
    say "unlocking at boot: $(head -n 1 <<<"$unlock")"
    tail -n +2 <<<"$unlock"
    echo "UNLOCK=${unlock%%:*}"
    say "PREFLIGHT OK: nothing was changed"
    exit 0
fi

RUN=$RUNS/$(distro_name)-$(date -u +%Y%m%d-%H%M%S)
mkdir -p "$RUN/baseline" || die "can't make $RUN"
LOG=$RUN/run.log
: >"$LOG"
say "internal: $disk (serial $INTERNAL_SERIAL), backup drive: $drive, run: $RUN"
. /etc/os-release 2>/dev/null && say "system: ${PRETTY_NAME:-unknown}, kernel $(uname -r)"
run "$BIN/bko-holt" --version
run "$BIN/rustic-bko" --version
run sha256sum "$BIN/bko-holt" "$BIN/rustic-bko"
run lsblk -o NAME,SIZE,TYPE,TRAN,FSTYPE,LABEL,MOUNTPOINTS
if is_ostree; then
    for u in $UPDATERS; do
        if systemctl is-active -q "$u.timer"; then must systemctl stop "$u.timer"; say "stopped $u.timer for this boot"; fi
    done
    ostree_moved >"$RUN/baseline/ostree-before.txt" 2>&1
fi
if is_abroot; then
    for u in $UPDATERS; do
        if systemctl is-active -q "$u.timer"; then must systemctl stop "$u.timer"; say "stopped $u.timer for this boot"; fi
    done
    abroot_moved >"$RUN/baseline/abroot-before.txt" 2>&1
fi
hold_snapshotters

# Before the tree is mounted, so the layout doesn't list its binds.
step "the layout"
"$BIN/bko-holt" dump --only-disk "$disk" >"$RUN/layout.json" 2>>"$LOG" || die "bko-holt dump failed"
say "layout.json: $(wc -c <"$RUN/layout.json") bytes"
grep -q "\"$drive\"" "$RUN/layout.json" && die "the layout mentions the backup drive"
why=$(proxmox_check "$RUN/layout.json") || die "$why"
[[ -z $why ]] || say "$why"
why=$(truenas_check "$RUN/layout.json") || die "$why"
[[ -z $why ]] || say "$why"
why=$(truenas_adopted) || die "$why"
why=$(unhinted_check "$RUN/layout.json") || die "$why"
keys=$(layout_keys "$RUN/layout.json" "$HERE/keys/disk-passphrase") || die "can't read the layout"
if [[ -n $keys ]]; then
    [[ -s $HERE/keys/disk-passphrase ]] ||
        die "encrypted volumes need the passphrase in $HERE/keys/disk-passphrase: $keys"
fi
unlock=$(unlock_check "$RUN/layout.json") || die "$unlock"
printf '%s\n' "$unlock" >"$RUN/baseline/unlock.txt"
say "unlocking at boot: $(head -n 1 <<<"$unlock")"
tail -n +2 <<<"$unlock" | tee -a "$LOG"
if [[ ${unlock%%:*} == attended ]]; then
    say "encrypted: someone has to type the passphrase at the restored system's first boot"
    touch "$RUN/NEEDS_PASSPHRASE_AT_BOOT"
fi
if is_ostree; then
    why=$(ostree_preflight "$RUN/layout.json") || die "$why"
fi
if is_abroot; then
    why=$(abroot_preflight "$RUN/layout.json") || die "$why"
    # The other root and the init LV, read-only, for the room count and the
    # tree; then nothing on the disk may be left unmounted.
    step "ABRoot's unmounted filesystems, read-only"
    mount_hints "$disk" "$RUN/layout.json"
    findmnt -rno TARGET,SOURCE,FSTYPE,OPTIONS | grep -F "$RO_MOUNTS/" | tee -a "$LOG"
    check_coverage "$disk"
fi

need=$(space_in_use "$disk" "$RUN/layout.json")
# df -Pk, not GNU's -B1 --output, which FreeBSD's df (Chimera's) lacks.
free=$(df -Pk "$RUN" | awk 'NR == 2 { print $4 }')
free=$((${free:-0} * 1024))
say "in use: $((need / 1048576)) MiB; free on the drive: $((free / 1048576)) MiB"
[[ $free -gt $need ]] || die "the backup drive hasn't enough room"

step "the tree to back up"
make_tree "$disk" "$RUN/layout.json"
run findmnt -R "$TREE"

step "the baseline"
B=$RUN/baseline
package_list >"$B/packages.txt"
# AerynOS has no efibootmgr: bs1-efi reads the same entries from efivarfs.
if command -v efibootmgr >/dev/null || [[ ! -d /sys/firmware/efi ]]; then
    efibootmgr -v >"$B/efibootmgr.txt" 2>&1
else
    python3 "$HERE/bs1-efi" list >"$B/efibootmgr.txt" 2>&1
fi
lsblk -o NAME,SIZE,TYPE,TRAN,FSTYPE,LABEL,UUID,PARTUUID,MOUNTPOINTS,MODEL,SERIAL >"$B/lsblk.txt" 2>&1
sfdisk -d "/dev/$disk" >"$B/sfdisk.txt" 2>&1
cp /etc/fstab "$B/fstab" 2>/dev/null
swap_names >"$B/swap-names.txt"
lvmid_record >"$B/lvmid.txt" 2>&1
grep -q '^EMBED ' "$B/lvmid.txt" && say "GRUB embeds an lvmid: $(awk '$1 == "EMBED" { print $2 " " $3 }' "$B/lvmid.txt" | tr '\n' ' ')"
failed_units >"$B/failed-units.txt"
must python3 "$HERE/bs1-manifest" "$TREE" "$B/manifest.tsv"
if is_ostree; then
    python3 "$HERE/bs1-ostree" record "$TREE" >"$B/deployments.txt" || die "can't record the deployments"
    python3 "$HERE/bs1-ostree" links "$TREE" >"$B/links.txt" || die "can't count the hard links"
    python3 "$HERE/bs1-ostree" space "$TREE" >"$B/space.txt" || die "can't measure the btrfs filesystems"
    say "deployments: $(grep -c '^deployment ' "$B/deployments.txt"), booted $(sed -n 's/^booted //p' "$B/deployments.txt")"
    run cat "$B/links.txt"
fi
if is_abroot; then
    python3 "$HERE/bs1-abroot" record "$RUN/layout.json" "$TREE" >"$B/abroot.txt" || die "can't record the two roots"
    say "ABRoot: present $(sed -n 's/^present //p' "$B/abroot.txt"), the master grub.cfg's default $(sed -n 's/^default //p' "$B/abroot.txt")"
fi

step "backing up"
pw=$RUN/repo-password
(umask 077; head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' >"$pw") || die "can't write the password"
rustic_in "$RUN"
must "${RUSTIC[@]}" init
[[ -f $PVE_DB ]] && pve_db_moved >"$RUN/baseline/pve-db-before.txt" 2>&1
is_truenas && [[ -f $TRUENAS_DB ]] && truenas_db_moved >"$RUN/baseline/truenas-db-before.txt" 2>&1
# Its rows, for bs1-verify's truenas_db_same: what the backup holds, if the
# file doesn't move until the backup is done (below).
if [[ -s $RUN/baseline/truenas-db-before.txt ]]; then
    python3 "$HERE/bs1-manifest" --db-dump "$TRUENAS_DB" "$RUN/baseline/truenas-db.txt" || die "can't read the rows of $TRUENAS_DB"
    say "the middleware's database: $(grep -c '^row' "$RUN/baseline/truenas-db.txt") rows in baseline/truenas-db.txt"
fi
must "${RUSTIC[@]}" backup --set-atime yes --as-path "$SNAP" "$TREE"
must "${RUSTIC[@]}" snapshots
if [[ -f $PVE_DB ]]; then
    pve_db_moved >"$RUN/baseline/pve-db-after.txt" 2>&1
    cmp -s "$RUN/baseline/pve-db-before.txt" "$RUN/baseline/pve-db-after.txt" ||
        die "pmxcfs checkpointed $PVE_DB during the backup, so its copy and the WAL's may not agree: run phase1 again"
    say "pmxcfs didn't checkpoint $PVE_DB during the backup: its copy and the WAL's agree"
fi
if [[ -s $RUN/baseline/truenas-db-before.txt ]]; then
    truenas_db_moved >"$RUN/baseline/truenas-db-after.txt" 2>&1
    cmp -s "$RUN/baseline/truenas-db-before.txt" "$RUN/baseline/truenas-db-after.txt" ||
        die "the middleware wrote $TRUENAS_DB during the backup, so its copy may be torn: run phase1 again"
    say "the middleware didn't write $TRUENAS_DB during the backup"
fi
if is_ostree; then
    ostree_moved >"$RUN/baseline/ostree-after.txt" 2>&1
    cmp -s "$RUN/baseline/ostree-before.txt" "$RUN/baseline/ostree-after.txt" ||
        die "the deployments or /boot/loader moved during the backup: $(diff "$RUN/baseline/ostree-before.txt" "$RUN/baseline/ostree-after.txt" | grep '^[<>]' | head -n 4 | tr '\n' ' ')"
    say "the deployments and /boot/loader didn't move during the backup"
fi
if is_abroot; then
    abroot_moved >"$RUN/baseline/abroot-after.txt" 2>&1
    cmp -s "$RUN/baseline/abroot-before.txt" "$RUN/baseline/abroot-after.txt" ||
        die "the master grub.cfg, grub.cfg.future or ABRoot's lock moved during the backup: $(diff "$RUN/baseline/abroot-before.txt" "$RUN/baseline/abroot-after.txt" | grep '^[<>]' | head -n 4 | tr '\n' ' ')"
    say "the master grub.cfg and grub.cfg.future didn't move during the backup, and no ABRoot operation ran"
fi

step "checking the backup (reading all of its data)"
must "${RUSTIC[@]}" check --read-data

sha256sum "$RUN/layout.json" | cut -d' ' -f1 >"$RUN/PHASE1_OK"
sync
say "PHASE 1 OK: $RUN"
echo "UNLOCK=${unlock%%:*}"
echo "RUN=$(basename "$RUN")"
