# BackShot1: what bs1-backup, bs1-restore and bs1-verify share.  Sourced.
#
# bs1.conf, beside this file, names the machine: SOURCE_HOST, INTERNAL_SERIAL,
# BACKUP_LABEL.  Everything acts on the disk with that serial, never a /dev name.

set -uo pipefail
# Then NixOS's two, and Guix System's three: neither has any of the others.
export LC_ALL=C PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/run/current-system/sw/bin:/run/wrappers/bin:/run/current-system/profile/sbin:/run/current-system/profile/bin:/run/privileged/bin
# Our Python must leave no __pycache__ behind: on a fresh install (Debian 13)
# the firmware check's imports were the first, and the manifest counted the
# .pyc files they wrote into the restored system as added.
export PYTHONDONTWRITEBYTECODE=1

HERE=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck disable=SC1091
. "$HERE/bs1.conf" || { echo "no bs1.conf in $HERE" >&2; exit 2; }
BIN=$HERE/bin
RUNS=$HERE/runs
# The read-only tree is mounted at TREE and backed up as SNAP (rustic-bko's
# --as-path), which is what the snapshot is named by: latest:/mnt/bs1-src.  Not
# one path, because on ostree /mnt is a link to var/mnt, and rustic-bko names a
# source by its canonical path (docs/design/bazzite.md, B5).
TREE=/run/bs1-src
SNAP=/mnt/bs1-src
LOG=/dev/null STEP=starting

say() { printf '%s %s\n' "$(date -u +%H:%M:%S)" "$*" | tee -a "$LOG"; }
step() { STEP=$1; sync; printf '\n' | tee -a "$LOG"; say "==== $STEP"; }
die() { say "STOPPED during \"$STEP\": $*"; exit 1; }

run() {
    say "\$ $*"
    local t0=$SECONDS rc
    "$@" 2>&1 | tee -a "$LOG"
    rc=${PIPESTATUS[0]}
    say "  exit $rc after $((SECONDS - t0)) s"
    return "$rc"
}
must() { run "$@" || die "this failed: $*"; }

[[ $EUID -eq 0 ]] || { echo "$0: run it as root" >&2; exit 2; }

# Artix has no hostname command.
this_host() { cat /proc/sys/kernel/hostname; }

# The one disk with INTERNAL_SERIAL, by name.
internal_disk() {
    local found d
    found=$(lsblk -dnro NAME,SERIAL | awk -v s="$INTERNAL_SERIAL" '$2 == s { print $1 }')
    # lsblk gets some disks' serials from udev, which Alpine doesn't run.
    if [[ -z $found ]]; then
        for d in /sys/block/*; do
            [[ $(cat "$d/serial" "$d/device/serial" 2>/dev/null | tr -d ' \n') == "$INTERNAL_SERIAL" ]] && found+=${d##*/}$'\n'
        done
        found=${found%$'\n'}
    fi
    [[ -n $found && $(wc -l <<<"$found") -eq 1 ]] || return 1
    echo "$found"
}

disk_of() { lsblk -no PKNAME "$1" | head -n 1; }

# The backup drive's own disk, checked: on USB, and not the internal disk.
backup_disk() {
    local dev disk
    dev=$(blkid -L "$BACKUP_LABEL") || return 1
    disk=$(disk_of "$dev")
    [[ -n $disk && $disk != "$1" && $(lsblk -dno TRAN "/dev/$disk") == usb ]] || return 1
    echo "$disk"
}

REAL_FS='ext2|ext3|ext4|xfs|btrfs|vfat|f2fs|jfs|nilfs2|bcachefs|zfs'
ESP_TYPE=c12a7328-f81f-11d2-ba4b-00a0c93ec93b

# An ostree system (Bazzite, Silverblue, Kinoite): its / is a composefs
# overlay, and the physical root, fstab's /, is at /sysroot
# (docs/design/bazzite.md).
is_ostree() { [[ -e /run/ostree-booted ]]; }
root_mount() { if is_ostree; then echo /sysroot; else echo /; fi; }
root_source() { findmnt -nro SOURCE "$(root_mount)"; }
# The updaters an ostree system may have: uupd is Bazzite's (ublue's), the
# others Fedora's own.  bs1-backup and bs1-verify hold them off for the boot
# they run in; the person disables them for longer (README.md).
UPDATERS="uupd rpm-ostreed-automatic bootc-fetch-apply-updates"

# Snapper's timers make and delete snapshots, and on CachyOS each run also
# has limine-snapper-sync rewrite /boot/limine.conf and copy kernels into
# /boot/<machine-id>/limine_history: snapper-cleanup.timer fires 10 min after
# boot, which landed in the middle of a phase 1 (2026-11-13).  bs1-backup and
# bs1-verify hold them for the boot they run in, on any system that has them.
# PikaOS's booster-reassert.timer (every 4 h) likewise rewrites
# /usr/sbin/update-initramfs and, with no booster.img-* in /boot, remakes the
# initramfs (docs/design/pikaos.md, P8).  AnduinOS's Disk Snapshots
# Manager runs its scheduler hourly (System snapshots every 24 h, Home every
# 2 h, and their pruning) and 2 min after each boot (docs/design/anduinos.md,
# A7); its apt hook fires only when dpkg runs, which BackShot1 never does.
SNAPSHOTTERS="snapper-timeline snapper-cleanup booster-reassert anduinos-btrfs-snapshots-manager-scheduler"
hold_snapshotters() {
    local u
    command -v systemctl >/dev/null || return 0
    for u in $SNAPSHOTTERS; do
        if systemctl is-active -q "$u.timer"; then systemctl stop "$u.timer"; say "stopped $u.timer for this boot"; fi
        # A run already under way finishes first.
        while systemctl is-active -q "$u.service"; do sleep 1; done
    done
}

# on_disk SOURCE DISK: does this mount's source rest on DISK, through any stack
# of partitions, md, LUKS and LVM, or a ZFS pool?
on_disk() {
    local src=${1%%\[*} disk=$2 v
    if [[ $src == /dev/* ]]; then
        lsblk -snlo NAME "$src" 2>/dev/null | awk -v d="$disk" '$1 == d { f = 1 } END { exit !f }'
        return
    fi
    command -v zpool >/dev/null || return 1
    for v in $(zpool list -vHPL "${src%%/*}" 2>/dev/null | awk '$1 ~ /^\// { print $1 }'); do
        lsblk -snlo NAME "$v" 2>/dev/null | awk -v d="$disk" '$1 == d { f = 1 } END { exit !f }' && return 0
    done
    return 1
}

# The real filesystems mounted from DISK, parents first: PATH<tab>FROM<tab>FSTYPE,
# PATH where the tree has it, FROM where the running system mounts it.  They
# are one path but on ostree, where LAYOUT (bko-holt dump's) is read: its
# storage.backup_sources lays them out as fstab mounts them, / from /sysroot
# and /home from /var/home, leaving out the /etc and stateroot var binds.
internal_mounts() {
    local disk=$1 layout=${2:-} target src fs root
    if is_ostree; then
        [[ -s $layout ]] || { echo "internal_mounts: on ostree the tree is read from a layout, and there is none" >&2; return 1; }
        python3 - "$layout" <<'PY' | while IFS=$'\t' read -r target root fs src; do
import json, sys
for s in json.load(open(sys.argv[1]))["storage"].get("backup_sources") or []:
    # A source the running system doesn't mount (ABRoot's init LV and other
    # root) has no "from", only the read-only "mount" a backup makes there:
    # BackShot1 doesn't make it yet.
    if s.get("from") is None:
        sys.exit(f"internal_mounts: backup_sources' {s['path']} isn't mounted (from null; its mount hint: {s.get('mount')}), which BackShot1 doesn't mount yet")
    print("\t".join([s["path"], s["from"], s["fstype"], s.get("source") or "-"]))
PY
            [[ $fs =~ ^($REAL_FS)$ ]] || continue
            on_disk "$src" "$disk" || continue
            printf '%s\t%s\t%s\n' "$target" "$root" "$fs"
        done | LC_ALL=C sort
        return
    fi
    findmnt -rno TARGET,SOURCE,FSTYPE,FSROOT | while read -r target src fs root; do
        [[ $fs =~ ^($REAL_FS)$ ]] || continue
        # A bind mount shows a subdirectory; a btrfs subvolume does too, and counts.
        [[ $fs == btrfs || $fs == zfs || $root == / ]] || continue
        on_disk "$src" "$disk" || continue
        target=$(printf '%b' "$target")
        printf '%s\t%s\t%s\n' "$target" "$target" "$fs"
    done | LC_ALL=C sort
}

# What the tree's filesystems hold, in bytes, each filesystem counted once:
# three mounts of one btrfs are one filesystem.  df -Pk, not GNU's -B1
# --output, which FreeBSD's df (Chimera's) lacks: POSIX's columns, in KiB.
space_in_use() {
    local from fs kib
    kib=$(internal_mounts "$@" | while IFS=$'\t' read -r _ from fs; do
        df -Pk "$from" | awk 'NR == 2 { print $1, $3 }'
    done | awk '{ sub(/\[.*/, "", $1) } !seen[$1]++ { n += $2 } END { print n + 0 }') || return
    echo $((kib * 1024))
}

# Stops if DISK holds a filesystem the running system hasn't mounted: it would be
# erased without being in the backup.
check_coverage() {
    local mounted name fs
    mounted=$(findmnt -rno SOURCE | sed 's/\[.*//')
    while read -r name fs; do
        [[ ${fs:-} =~ ^($REAL_FS)$ ]] || continue
        grep -qxF "$name" <<<"$mounted" || die "$name ($fs) isn't mounted, so it wouldn't be backed up"
    done < <(lsblk -lnpo NAME,FSTYPE "/dev/$1")
}

# The read-only tree of DISK's filesystems at $TREE.  Binds of each one alone, so
# /proc, /sys, /run and the backup drive aren't in it.  LAYOUT: internal_mounts'.
make_tree() {
    local path from dst list
    findmnt -rn "$TREE" >/dev/null && die "$TREE is already mounted"
    list=$(internal_mounts "$@") || die "can't tell which filesystems to back up"
    mkdir -p "$TREE"
    while IFS=$'\t' read -r path from _; do
        [[ -n $path ]] || continue
        dst=$TREE${path%/}
        must mount --bind "$from" "$dst"
        must mount -o remount,bind,ro "$dst"
    done <<<"$list"
    findmnt -rn "$TREE" >/dev/null || die "nothing on $1 is mounted"
}

drop_tree() {
    if findmnt -rn "$TREE" >/dev/null; then umount --recursive "$TREE"; fi
    sync
}

# This system's name for its backup's folder: ubuntu-26.10, debian-13, arch.
distro_name() {
    local f name=linux
    for f in /etc/os-release /usr/lib/os-release; do
        [[ -r $f ]] || continue
        name=$(. "$f"; echo "${ID:-linux}${VERSION_ID:+-$VERSION_ID}")
        break
    done
    printf '%s' "$name" | tr -c 'A-Za-z0-9._-' '_'
}

package_list() {
    # Gentoo first: Portage keeps no list but its database's directories, and
    # dpkg or rpm may be emerged there as tools.  CATEGORY/PF, one a line.
    if [[ -e /etc/gentoo-release ]]; then (cd /var/db/pkg && printf '%s\n' */*)
    elif command -v dpkg-query >/dev/null; then dpkg-query -W -f '${Package}\t${Version}\n'
    elif command -v rpm >/dev/null; then rpm -qa
    elif command -v pacman >/dev/null; then pacman -Q
    elif command -v apk >/dev/null; then apk info -v
    elif command -v xbps-query >/dev/null; then xbps-query -l
    elif command -v moss >/dev/null; then moss pkg list --installed
    elif command -v nix-store >/dev/null; then nix-store -qR /run/current-system
    # Guix System: the system generation's whole closure, as NixOS's.
    elif [[ -d /gnu/store ]] && command -v guix >/dev/null; then guix gc --requisites /run/current-system
    else echo "no package manager known"
    fi 2>/dev/null | LC_ALL=C sort
}

# GRUB's core image names its prefix by (lvmid/VG-UUID/LV-UUID) when
# /boot/grub is on an LV (Gentoo's, docs/design/gentoo.md), and bko-holt's
# grub-install puts the restored LV's in.  One EMBED line per id per EFI
# binary on a mounted vfat filesystem (not the tree's binds), then GRUBLV:
# lvmid/VG-UUID/LV-UUID and VG/LV of the LV holding /boot/grub, or "-".
# HoltTest1's ht1.sh checks the same.
lvmid_record() {
    local m f id d l
    findmnt -rn -t vfat -o TARGET | while read -r m; do
        m=$(printf '%b' "$m")
        [[ $m == "$TREE" || $m == "$TREE"/* ]] && continue
        find "$m" -xdev -type f -iname '*.efi'
    done | LC_ALL=C sort -u | while read -r f; do
        for id in $(grep -a -o 'lvmid/[0-9A-Za-z-]*/[0-9A-Za-z-]*' "$f" | LC_ALL=C sort -u); do echo "EMBED $f $id"; done
    done
    d=$(findmnt -n -o SOURCE --target /boot/grub 2>/dev/null)
    l=
    if [[ -n $d ]] && command -v lvs >/dev/null; then
        l=$(lvs --noheadings -o vg_uuid,lv_uuid,vg_name,lv_name "$d" 2>/dev/null | awk 'NF == 4 { print "lvmid/" $1 "/" $2 " " $3 "/" $4 }')
    fi
    echo "GRUBLV ${l:--}"
}

# lvmid_ok RECORD: lvmid_record's lines name an LV for /boot/grub, and every
# id an EFI binary embeds is that LV's.
lvmid_ok() {
    local want
    cat "$1"
    want=$(awk '$1 == "GRUBLV" { print $2 }' "$1")
    grep -q '^EMBED ' "$1" && [[ -n $want && $want != - ]] &&
        ! awk -v w="$want" '$1 == "EMBED" && $3 != w { bad = 1 } END { exit !bad }' "$1"
}

# swap_names [raw]: the swaps in use, a device-mapper one by its /dev/mapper
# name, since dm-N's number can change from one boot to the next (Alpine's
# LVM on LUKS); raw: dm-N as the kernel names it, as baselines before this have.
swap_names() {
    local n d
    swapon --show=NAME --noheadings 2>/dev/null | { grep -v zram || true; } | while read -r n; do
        d=/sys/block/${n#/dev/}/dm/name
        if [[ ${1:-} != raw && $n == /dev/dm-* && -r $d ]]; then echo "/dev/mapper/$(cat "$d")"; else echo "$n"; fi
    done | LC_ALL=C sort
}

failed_units() {
    if command -v systemctl >/dev/null; then
        systemctl --failed --no-legend --no-pager --plain 2>/dev/null | awk '{ print $1 }' | LC_ALL=C sort
    elif command -v herd >/dev/null; then
        # Shepherd (Guix System): herd status lists them under Failed:, one
        # " X NAME" a line, as HoltTest1's ht1.sh reads it.
        herd status 2>/dev/null | awk '/^[A-Z][^:]*:$/ { sec = $0; next } sec == "Failed:" { print $2 }' | LC_ALL=C sort
    fi
}

# layout_keys LAYOUT PASSPHRASE_FILE: load's --key-file values, one a line: every
# LUKS volume, every ZFS encryption root that asks for a passphrase, and every
# GELI provider that does (docs/design/geli.md), by its partition's name
# (vtbd0p3; load also takes gpt/LABEL or the provider less .eli).  A GELI
# provider unlocked by key files alone ("keyfile") isn't listed: load makes it
# from the source's key files, not this passphrase.  Key slot 1 isn't either
# (NAME:1): load says so in the plan when the source used it.
layout_keys() {
    python3 - "$1" "$2" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
s = d["storage"]
names = {e["name"] for e in (s.get("crypttab") or [])}
for dm in s.get("dm_devices") or []:
    if (dm.get("dm") or {}).get("target") == "crypt":
        names.add(dm["dm"]["dm_name"])
for ds in ((s.get("zfs") or {}).get("tools") or {}).get("datasets") or []:
    if ds.get("encryptionroot") == ds.get("name") and ds.get("keyformat") == "passphrase":
        names.add(ds["name"])
for disk in s.get("disks") or []:
    for x in [disk] + (disk.get("partitions") or []):
        c = x.get("content") if isinstance(x.get("content"), dict) else {}
        g = x.get("geli") if isinstance(x.get("geli"), dict) else None
        if g is None and c.get("type") != "geli":
            continue
        g = g or c
        if g.get("onetime") or (g.get("keyed_by") or "passphrase") == "keyfile":
            continue
        names.add(x["name"])
for n in sorted(names):
    print(f"{n}={sys.argv[2]}")
PY
}

layout_is_uefi() {
    python3 -c 'import json, sys; sys.exit(0 if json.load(open(sys.argv[1])).get("firmware", {}).get("mode") == "uefi" else 1)' "$1"
}

rustic_in() {       # rustic_in RUN_DIR: sets RUSTIC for that run's repository
    RUSTIC=("$BIN/rustic-bko" -r "$1/repo" --password-file "$1/repo-password" --no-progress --no-cache)
}

# Unlocking from the backup drive (bs1-luks, bs1-unlock-key,
# docs/design/bs1-luks-unattended.md): the record bs1-adopt writes, in the
# installed system and so in the backup, and what the initramfs leaves.
LUKS_REC=/etc/backshot1/luks-unlock
UNLOCK_MARK=/run/backshot1-unlock

# luks_rec FIELD: a value from the record, or false without one.
luks_rec() {
    [[ -r $LUKS_REC ]] || return 1
    (
        # shellcheck disable=SC2034
        family='' generator='' label='' path='' fstype='' wait='' volumes='' own='' reason=''
        # shellcheck disable=SC1090
        . "$LUKS_REC"
        printf '%s' "${!1:-}"
    )
}

# luks_devices DISK: the LUKS devices on DISK, by path.
luks_devices() {
    local dev
    lsblk -lnpo NAME "/dev/$1" | while read -r dev; do
        [[ $(blkid -o value -s TYPE "$dev" 2>/dev/null) == crypto_LUKS ]] && echo "$dev"
    done
    return 0
}

# luks_names DISK: the open mapping of each LUKS device on DISK (not a
# plain dm-crypt swap's, which has no passphrase).
luks_names() {
    local dev
    for dev in $(luks_devices "$1"); do
        lsblk -lno NAME,TYPE "$dev" | awk '$2 == "crypt" { print $1; exit }'
    done | LC_ALL=C sort -u
}

# unlock_how NAME HOW: how this boot opened the volume the record names, HOW
# being the record's S, D or E: drive (the backup drive's key), typed, or
# fetched (E: the key was copied, but couldn't be tested).
unlock_how() {
    local name=$1 j
    case $2 in
    S)
        # systemd-cryptsetup-generator mounts the key's device at
        # /run/systemd/cryptsetup/keydev-NAME; the initrd's journal is this boot's.
        j=$(journalctl -b -o cat --no-pager 2>/dev/null | grep -F "/run/systemd/cryptsetup/keydev-$name")
        if grep -Ei "keydev-$name/.*(fail|missing|incorrect)" <<<"$j" >/dev/null; then echo typed
        elif grep -E "^Mounted .*/run/systemd/cryptsetup/keydev-$name([ .]|$)" <<<"$j" >/dev/null; then echo drive
        else echo typed
        fi
        ;;
    D | E)
        if [[ -r $UNLOCK_MARK ]]; then
            awk -v n="$name" '$1 == n { h = $2 } END { print (h == "" ? "typed" : h) }' "$UNLOCK_MARK"
        else
            echo typed
        fi
        ;;
    *) echo unknown ;;
    esac
}

# layout_zfs_passphrase LAYOUT: the ZFS encryption roots that ask.
layout_zfs_passphrase() {
    python3 - "$1" <<'PY'
import json, sys
s = json.load(open(sys.argv[1]))["storage"]
for ds in ((s.get("zfs") or {}).get("tools") or {}).get("datasets") or []:
    if ds.get("encryptionroot") == ds.get("name") and ds.get("keyformat") == "passphrase":
        print(ds["name"])
PY
}

# unlock_mode DISK [LAYOUT]: how this system's encrypted volumes unlock at
# boot.  The first line is "MODE: why", MODE one of
#   drive     every typed LUKS volume was opened at this boot by the drive's key
#   own       every LUKS volume opens with no one typing, by itself
#   attended  someone types a passphrase at boot
#   none      nothing encrypted
# then a line for each LUKS volume: "  NAME HOW".
unlock_mode() {
    local disk=$1 layout=${2:-} names n v how fam vols own mode=own why='' lines='' zfs=''
    names=$(luks_names "$disk")
    [[ -z $layout ]] || zfs=$(layout_zfs_passphrase "$layout" | tr '\n' ' ')
    if [[ -z $names && -z $zfs ]]; then echo "none: nothing on $disk is encrypted"; return 0; fi
    if [[ -n $zfs ]]; then echo "attended: ZFS native encryption asks for ${zfs% }"; return 0; fi
    if ! fam=$(luks_rec family); then
        echo "attended: not set up to unlock from the drive (no $LUKS_REC: bs1-adopt)"
        for n in $names; do echo "  $n typed"; done
        return 0
    fi
    if [[ $fam == A ]]; then
        echo "attended: $(luks_rec reason)"
        for n in $names; do echo "  $n typed"; done
        return 0
    fi
    vols=" $(luks_rec volumes) " own=" $(luks_rec own) "
    for n in $names; do
        if [[ $own == *" $n:"* ]]; then lines+="  $n own"$'\n'; continue; fi
        v=$(tr ' ' '\n' <<<"$vols" | awk -F: -v n="$n" '$1 == n { print $3; exit }')
        if [[ -z $v ]]; then
            mode=attended why="$n isn't in $LUKS_REC: bs1-adopt again"
            lines+="  $n typed"$'\n'
            continue
        fi
        how=$(unlock_how "$n" "$v")
        lines+="  $n $how"$'\n'
        if [[ $how == drive ]]; then
            [[ $mode == attended ]] || mode=drive
        else
            mode=attended why="$n was $how at this boot, not opened by the drive's key: reboot once with the drive plugged in since bs1-adopt (family $fam)"
        fi
    done
    case $mode in
    drive) why="the backup drive's key opened every typed LUKS volume at this boot (family $fam)" ;;
    own) why="every LUKS volume opens with no one typing" ;;
    esac
    echo "$mode: $why"
    printf '%s' "$lines"
}

# luks_key_test DISK KEY: KEY opens every LUKS volume on DISK; else says which not.
luks_key_test() {
    local dev bad=0
    for dev in $(luks_devices "$1"); do
        cryptsetup open --test-passphrase --key-file "$2" "$dev" >/dev/null 2>&1 || { echo "the drive's key doesn't open $dev"; bad=1; }
    done
    return $bad
}
