# shellcheck shell=bash
# BackShot1: bs1-adopt's LUKS step.  Sourced by bs1-adopt, after bs1-common,
# whose `here` (its own directory, on the drive) and `init` it reads.
# shellcheck disable=SC2154
#
# Sets this install's initramfs to read the passphrase from the backup drive
# (keys/disk-passphrase beside bs1-adopt, on LABEL=$BACKUP_LABEL) and unlock
# its typed LUKS volumes with it; without the drive, or with a key that
# doesn't fit, the usual prompt follows after LUKS_WAIT seconds.  It's in the
# installed system, so in the backup, and the restored system unlocks itself
# too: bko-holt load's boot stage remakes the initramfs from these files.
# docs/design/bs1-luks-unattended.md.
#
# TESTBED ONLY, like the fixed host key: whoever has the drive and the laptop
# together can read the disk.  Never on a release image or a machine outside
# the testbed.  `bs1-adopt --luks-off` puts it all back; BS1_LUKS=no skips it.
#
# How, by what opens the volume:
#   S  systemd in the initramfs (dracut with its systemd module; mkinitcpio's
#      sd-encrypt), and any volume the booted system opens under systemd:
#      crypttab's key field PATH:LABEL=LABEL, option keyfile-timeout=WAITs.
#      On mkinitcpio's unified kernel images, rd.luks.name/uuid/options in
#      the command line mkinitcpio bakes into them (/etc/kernel/cmdline,
#      /etc/cmdline.d/*.conf) become crypttab.initramfs's lines, and are
#      taken out of those files, in the same remake.
#   D  initramfs-tools' cryptroot: keyscript=/usr/local/lib/backshot1/unlock-key
#      (bs1-unlock-key), the key field left as it was (none).
#   E  mkinitcpio's busybox encrypt: the bs1key hook, before encrypt, writes
#      /crypto_keyfile.bin (bs1-unlock-key --to).
#   N  NixOS: /etc/nixos/backshot1-luks.nix (backshot1.nix imports it while
#      it exists), by boot.initrd.luks.devices: systemd stage 1 gets keyFile
#      PATH:LABEL=LABEL and keyFileTimeout; scripted stage 1 preOpenCommands
#      that copy the key off the drive, keyFile, fallbackToPassword.  Then
#      nixos-rebuild switch.
#   B  AerynOS: systemd in the initramfs that came prebuilt with the kernel,
#      which reads no crypttab of this system's, and a command line blsforme
#      writes into every boot entry from /etc/kernel/cmdline.d.  Each volume
#      the initramfs opens gets rd.luks.uuid=UUID, rd.luks.key=UUID=PATH:
#      LABEL=LABEL and rd.luks.options=UUID=OPTIONS in 90-backshot1-luks.cmdline
#      there, OPTIONS the ones in force (from the other cmdline.d files) and
#      keyfile-timeout=WAITs; then moss boot sync, and the ESP's entries are
#      checked.  A volume the booted system opens is S's.
#   A  attended: anything else (non-systemd dracut, mkinitfs, ostree).
#      Nothing changes; the record says why.
# A volume that already unlocks with no one typing (a key file of its own,
# TPM2, FIDO2) is left alone and recorded as own.
#
# Everything it writes starts with "# BackShot1" (but B's cmdline.d file,
# which is command line alone, and BackShot1's by its name); each file it
# changes is saved once in /etc/backshot1/orig/ (by its path, / as %), each it
# adds is listed in /etc/backshot1/made.  A run that changes nothing remakes
# nothing.

LUKS_DIR=/etc/backshot1
LUKS_ORIG=$LUKS_DIR/orig
LUKS_MADE=$LUKS_DIR/made
UNLOCK_KEY=/usr/local/lib/backshot1/unlock-key
LUKS_WAIT=${BS1_LUKS_WAIT:-30}
# What reading a key from an ext4 USB drive takes, where the initramfs
# doesn't add it by itself.
LUKS_MODULES="usb_storage uas sd_mod xhci_pci ext4"
# Family B: blsforme's command-line snippets, in the order it adds them,
# BackShot1's own, and where boot entries are.
LK_BLS_DIRS="/usr/lib/kernel/cmdline.d /etc/kernel/cmdline.d"
LK_BLS_FILE=/etc/kernel/cmdline.d/90-backshot1-luks.cmdline
LK_BLS_ESP="/efi /boot /boot/efi"
LK_CMDLINE=/proc/cmdline
# Where crypttab, sd-encrypt's crypttab.initramfs, mkinitcpio's drop-ins and
# the remade images are (the unit tests' fake root moves them).
LK_CRYPTTAB=/etc/crypttab
LK_CRYPTTAB_INI=/etc/crypttab.initramfs
LK_MKI_CONF_D=/etc/mkinitcpio.conf.d
LK_IMG_DIRS="/boot /efi /boot/efi"
# Family S on mkinitcpio's unified kernel images: its presets, the files it
# bakes the command line from (the first of LK_UKI_FILES, then every *.conf
# under LK_UKI_DROPIN; the first is the one adopt may rewrite), and the EFI
# variable systemd-stub sets when it booted this kernel.
LK_UKI_PRESETS=/etc/mkinitcpio.d
LK_UKI_FILES="/etc/kernel/cmdline /usr/lib/kernel/cmdline"
LK_UKI_DROPIN=/etc/cmdline.d
LK_STUB_INFO=/sys/firmware/efi/efivars/StubInfo-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f

lk_say() { echo "luks: $*"; }
lk_err() { echo "bs1-adopt: $*" >&2; }

# Shell-quotes for the record, which sh and bash read with `.`.
lk_q() { local s=${1//\'/\'\\\'\'}; printf "'%s'" "$s"; }

lk_orig_name() { local p=${1//\//%}; echo "$LUKS_ORIG/$p"; }

# lk_save FILE: keeps FILE's original once, or notes that adopt made it.
lk_save() {
    local o
    o=$(lk_orig_name "$1")
    mkdir -p "$LUKS_ORIG" || return 1
    [[ -e $o ]] && return 0
    grep -qxF "$1" "$LUKS_MADE" 2>/dev/null && return 0
    if [[ -e $1 ]]; then cp -p "$1" "$o"; else echo "$1" >>"$LUKS_MADE"; fi
}

# lk_put FILE MODE CONTENT: writes CONTENT to FILE (and a final newline)
# unless it's there already; MODE is a new file's.  LK_CHANGED counts the
# files changed.
LK_CHANGED=0
LK_EARLY_S=
LK_BLS_VOLS=()
LK_UKI=no
LK_UKI_XLATE=no
lk_put() {
    local file=$1 mode=$2 content=$3 new=no
    if [[ -f $file ]] && [[ $(cat "$file") == "$content" ]]; then return 0; fi
    lk_save "$file" || return 1
    mkdir -p "$(dirname "$file")" || return 1
    [[ -e $file ]] || new=yes
    # Into the file itself when it exists, so its mode, owner and label stay.
    printf '%s\n' "$content" >"$file" || return 1
    [[ $new == no ]] || chmod "$mode" "$file"
    LK_CHANGED=$((LK_CHANGED + 1))
    lk_say "wrote $file"
}

# The initramfs generator, in the order holt's initramfs_json (and so the
# restore's boot stage) picks it.
lk_generator() {
    if [[ -e /run/ostree-booted ]] || compgen -G '/usr/lib/kernel/*.initrd' >/dev/null; then echo prebuilt
    # NixOS builds its initrd with the system (bko-holt's dump names none).
    elif [[ -e /etc/NIXOS ]]; then echo nixos
    elif command -v mkinitcpio >/dev/null; then echo mkinitcpio
    elif command -v dracut >/dev/null; then echo dracut
    elif command -v update-initramfs >/dev/null; then echo initramfs-tools
    elif command -v mkinitfs >/dev/null; then echo mkinitfs
    else echo none
    fi
}

# The initramfs remade as bko-holt load's boot stage does (initramfs() and
# gentoo_initramfs() in holt/src/load/commands.rs).
lk_remake() {
    local k n=0
    case $1 in
    mkinitcpio) mkinitcpio -P ;;
    dracut)
        if [[ -e /etc/gentoo-release ]]; then
            for k in /boot/initramfs-*.img; do
                [[ -f $k ]] || continue
                k=${k#/boot/initramfs-}; k=${k%.img}
                [[ -d /lib/modules/$k ]] || continue
                dracut --force "/boot/initramfs-$k.img" "$k" || return 1
                n=$((n + 1))
            done
            [[ $n -gt 0 ]]
        elif command -v dracut-rebuild >/dev/null; then dracut-rebuild
        else
            for k in /lib/modules/*; do
                [[ -d $k/kernel ]] || continue
                dracut --force --kver "${k##*/}" || return 1
                n=$((n + 1))
            done
            [[ $n -gt 0 ]]
        fi
        ;;
    initramfs-tools) update-initramfs -u -k all ;;
    # AerynOS (family B): the initramfs comes with the kernel; blsforme
    # writes the boot entries, the command line from cmdline.d with them.
    prebuilt) [[ ! -e /run/ostree-booted ]] && command -v moss >/dev/null && moss boot sync ;;
    # As adopt_nixos in bs1-adopt.  (bko-holt's restore runs nothing on a
    # NixOS UEFI system: it boots the initrd the backed-up ESP has.)
    nixos) nixos-rebuild switch ;;
    *) return 1 ;;
    esac
}

# The images written since STAMP: initramfs* and initrd* in /boot, /efi and
# the ESP (Limine's copies under /boot/MACHINE-ID too), and unified images.
lk_images() {
    local d
    for d in $LK_IMG_DIRS; do
        [[ -d $d ]] || continue
        find "$d" -maxdepth 5 -xdev -type f -newer "$1" \( -name 'initramfs*' -o -name 'initrd*' -o -path '*/EFI/Linux/*.efi' \) \
            ! -name '*.old' ! -name '*.bak' 2>/dev/null
    done | while read -r d; do readlink -f "$d"; done | LC_ALL=C sort -u
}

# lk_list GENERATOR IMAGE: the image's paths, one a line, no leading ./
lk_list() {
    case $1 in
    mkinitcpio) lsinitcpio "$2" ;;
    dracut) lsinitrd "$2" | sed -E 's/ -> .*//; s/.* //' ;;
    initramfs-tools) lsinitramfs "$2" ;;
    esac 2>/dev/null | sed 's|^\./||'
}

# lk_crypttab_in GENERATOR IMAGE: the image's /etc/crypttab.
lk_crypttab_in() {
    local tmp rc=0
    case $1 in
    dracut) lsinitrd -f etc/crypttab "$2" 2>/dev/null ;;
    mkinitcpio)
        tmp=$(mktemp -d) || return 1
        (cd "$tmp" && lsinitcpio -x "$2" >/dev/null 2>&1) && cat "$tmp/etc/crypttab" 2>/dev/null || rc=1
        rm -rf "$tmp"
        return $rc
        ;;
    esac
}

# The running kernel's image, for what the current one has in it.
lk_current_image() {
    local k f mid
    k=$(uname -r)
    mid=$(cat /etc/machine-id 2>/dev/null)
    for f in "/boot/initramfs-$k.img" "/boot/initrd.img-$k" "/boot/initrd-$k" \
             "/efi/$mid/$k/initrd" "/boot/efi/$mid/$k/initrd" "/boot/$mid/$k/initrd"; do
        [[ -f $f ]] && { echo "$f"; return 0; }
    done
    return 1
}

# lk_luks_volumes DISK: "DEV UUID NAME" for each LUKS device on DISK, NAME its
# open mapping or -.
lk_luks_volumes() {
    local dev name
    lsblk -lnpo NAME "/dev/$1" | while read -r dev; do
        [[ $(blkid -o value -s TYPE "$dev" 2>/dev/null) == crypto_LUKS ]] || continue
        name=$(lsblk -lno NAME,TYPE "$dev" | awk '$2 == "crypt" { print $1; exit }')
        echo "$dev $(blkid -o value -s UUID "$dev") ${name:--}"
    done
}

# lk_early NAME: does the initramfs open it?  It's under /, /usr or a swap
# device (resume).
lk_early() {
    local src
    for src in $(findmnt -nro SOURCE /) $(findmnt -nro SOURCE /usr 2>/dev/null) $(swapon --show=NAME --noheadings 2>/dev/null); do
        src=${src%%\[*}
        [[ $src == /dev/* ]] || continue
        lsblk -snlo NAME "$src" 2>/dev/null | grep -xF "$1" >/dev/null && return 0
    done
    return 1
}

# lk_resolve SPEC: a crypttab or command line device spec as a device path.
lk_resolve() {
    local s=$1
    case $s in
    UUID=*) s=/dev/disk/by-uuid/${s#UUID=} ;;
    PARTUUID=*) s=/dev/disk/by-partuuid/${s#PARTUUID=} ;;
    LABEL=*) s=/dev/disk/by-label/${s#LABEL=} ;;
    PARTLABEL=*) s=/dev/disk/by-partlabel/${s#PARTLABEL=} ;;
    esac
    readlink -f "$s" 2>/dev/null
}

# lk_tab_line FILE NAME DEV UUID: crypttab FILE's line for the volume (by its
# name, its UUID or its device), as "KEY OPTIONS", or false.
lk_tab_line() {
    local file=$1 name=$2 dev=$3 uuid=$4 n d k o
    [[ -f $file ]] || return 1
    while read -r n d k o; do
        [[ -z $n || $n == \#* ]] && continue
        if [[ $n == "$name" || $d == "UUID=$uuid" || $d == "/dev/disk/by-uuid/$uuid" || $(lk_resolve "$d") == "$(readlink -f "$dev")" ]]; then
            echo "${k:-none} ${o:--}"
            return 0
        fi
    done <"$file"
    return 1
}

# lk_tab_edit FILE EDITS...: FILE's text with each EDIT applied, EDIT being
# NAME|HOW|UUID|ADD|FIX[|OPTIONS]: HOW S puts the drive's key and
# keyfile-timeout in (and drops keyfile-offset, -size and -erase, which would
# misread it), D keyscript=; ADD 1 appends a line when there's none for NAME;
# FIX 1 names the device UUID=, for the command line's rd.luks.uuid= or
# rd.luks.name= to find the line by; OPTIONS, when given, are the options to
# start from instead of the line's (the command line's rd.luks.options=, which
# were in force; "," for none).  Edited lines are tab-separated, so a second
# run reproduces them exactly.
lk_tab_edit() {
    local file=$1; shift
    { [[ -f $file ]] && cat "$file"; true; } | awk -v edits="$*" -v key="$LK_KEYSPEC" -v wait="$LUKS_WAIT" -v ks="$UNLOCK_KEY" '
        BEGIN { n = split(edits, e, " "); for (i = 1; i <= n; i++) { split(e[i], f, "|"); how[f[1]] = f[2]; uuid[f[1]] = f[3]; add[f[1]] = f[4]; fixdev[f[1]] = f[5]; ov[f[1]] = f[6] } }
        function fix(name, dev, k, o,    a, m, i, out) {
            if (ov[name] != "") o = ov[name]
            m = split(o == "-" ? "" : o, a, ",")
            out = ""
            for (i = 1; i <= m; i++) {
                if (a[i] == "") continue
                if (how[name] == "S" && a[i] ~ /^(keyfile-timeout=|keyfile-offset=|keyfile-size=|keyfile-erase(=|$))/) continue
                if (how[name] == "D" && a[i] ~ /^keyscript=/) continue
                out = out (out == "" ? "" : ",") a[i]
            }
            if (how[name] == "S") { k = key; out = out (out == "" ? "" : ",") "keyfile-timeout=" wait "s"; if (dev !~ /^(UUID=|\/dev\/disk\/by-uuid\/)/ && fixdev[name] == 1) dev = "UUID=" uuid[name] }
            if (how[name] == "D") out = out (out == "" ? "" : ",") "keyscript=" ks
            return name "\t" dev "\t" k "\t" out
        }
        /^[[:space:]]*(#|$)/ { print; next }
        $1 in how { seen[$1] = 1; print fix($1, $2, NF >= 3 ? $3 : "none", NF >= 4 ? $4 : ""); next }
        { print }
        END { for (nm in how) if (!(nm in seen) && add[nm] == 1) print fix(nm, "UUID=" uuid[nm], "none", "") }'
}

# The mkinitcpio HOOKS and FILES, read as mkinitcpio reads its configuration.
lk_mkinitcpio_conf() {
    (
        set +eu
        # shellcheck disable=SC1091
        . /etc/mkinitcpio.conf
        for f in /etc/mkinitcpio.conf.d/*.conf; do
            # shellcheck disable=SC1090
            [[ -e $f ]] && . "$f"
        done
        # shellcheck disable=SC2153
        echo "HOOKS ${HOOKS[*]}"
        # shellcheck disable=SC2153
        echo "FILES ${FILES[*]}"
    )
}

# Does dracut put systemd in the initramfs?  The running kernel's image
# says; without one, systemd as init and no omit of it.
lk_dracut_systemd() {
    local img
    if img=$(lk_current_image); then
        lsinitrd -m "$img" 2>/dev/null | grep -x systemd >/dev/null
        return
    fi
    [[ $init == systemd ]] || return 1
    ! cat /etc/dracut.conf /etc/dracut.conf.d/*.conf /usr/lib/dracut/dracut.conf.d/*.conf 2>/dev/null |
        grep -E '^[^#]*omit_dracutmodules.*systemd' >/dev/null
}

# lk_modules [EXTRA...]: the modules of LUKS_MODULES and EXTRA this kernel
# has, as a module or built in, each once.
lk_modules() {
    local m seen=' '
    for m in $LUKS_MODULES "$@"; do
        [[ -n $m && $seen != *" $m "* ]] || continue
        seen+="$m "
        modinfo "$m" >/dev/null 2>&1 && printf '%s ' "$m"
    done
}

# Family B: blsforme (AerynOS's moss boot sync) and systemd in the initramfs.
lk_blsforme() { command -v moss >/dev/null && [[ $init == systemd ]]; }

# lk_bls_args: the command line the cmdline.d files other than BackShot1's
# give blsforme, in its order, one argument a line (a # line skipped).
lk_bls_args() {
    local d f
    for d in $LK_BLS_DIRS; do
        for f in "$d"/*.cmdline; do
            [[ -f $f && $f != "$LK_BLS_FILE" ]] || continue
            grep -v '^[[:space:]]*#' "$f"
        done
    done | tr -s '[:space:]' '\n' | sed '/^$/d'
}

# lk_bls_eff UUID: what the arguments on stdin (one a line) give the volume,
# as the initramfs's systemd-cryptsetup-generator reads them: the last of
# each wins, and a volume's own key and options over the ones for every
# volume (rd.luks.key=PATH, rd.luks.options=OPTIONS).  "KEY OPTIONS", each
# - for none.
lk_bls_eff() {
    awk -v u="$1" '
        function val(a,    v) { v = a; sub(/^[^=]*=/, "", v); return v }
        /^(rd\.)?luks\.key=/ {
            v = val($0)
            if (index(v, u "=") == 1) { k = substr(v, length(u) + 2); hk = 1 }
            else if (v !~ /^[A-Za-z0-9-]+=/) { dk = v; hdk = 1 }
            next
        }
        /^(rd\.)?luks\.options=/ {
            v = val($0)
            if (index(v, u "=") == 1) { o = substr(v, length(u) + 2); ho = 1 }
            else if (v !~ /^[0-9a-fA-F-]+=/) { dopt = v; hdo = 1 }
            next
        }
        END {
            if (!hk && hdk) { k = dk; hk = 1 }
            if (!ho && hdo) { o = dopt; ho = 1 }
            print (hk && k != "" ? k : "-"), (ho && o != "" ? o : "-")
        }'
}

# lk_bls_opts OPTIONS: OPTIONS (- for none), each once, without a
# keyfile-timeout, then keyfile-timeout=WAITs: the volume's options merged
# with BackShot1's, for one rd.luks.options= that leaves nothing out.
lk_bls_opts() {
    awk -v o="$1" -v w="$LUKS_WAIT" 'BEGIN {
        n = split(o == "-" ? "" : o, a, ",")
        out = ""
        for (i = 1; i <= n; i++) {
            if (a[i] == "" || a[i] ~ /^keyfile-timeout=/ || seen[a[i]]++) continue
            out = out a[i] ","
        }
        print out "keyfile-timeout=" w "s"
    }'
}

# lk_bls_text UUID|OPTIONS...: BackShot1's cmdline.d line, OPTIONS each
# volume's in force (lk_bls_eff's, - for none).  rd.luks.uuid too, though
# blsforme names the root's itself: the generator opens only volumes named.
lk_bls_text() {
    local v u out=()
    for v in "$@"; do
        u=${v%%|*}
        out+=("rd.luks.uuid=$u" "rd.luks.key=$u=$LK_KEYSPEC" "rd.luks.options=$u=$(lk_bls_opts "${v#*|}")")
    done
    printf '%s' "${out[*]}"
}

# lk_bls_entries_ok DIRS UUID|OPTIONS...: every boot entry in DIRS (a
# space-separated list of loader/entries directories) names each volume and
# gives it the drive's key and BackShot1's options, as the last of each.
lk_bls_entries_ok() {
    local dirs=$1 d e n=0 bad=0 v u args eff want ebad
    shift
    while read -r e; do
        [[ -n $e ]] || continue
        n=$((n + 1)) ebad=0
        args=$(awk '$1 == "options" { $1 = ""; print }' "$e" | tr -s '[:space:]' '\n' | sed '/^$/d')
        for v in "$@"; do
            u=${v%%|*}
            want="$LK_KEYSPEC $(lk_bls_opts "${v#*|}")"
            eff=$(lk_bls_eff "$u" <<<"$args")
            [[ $eff == "$want" ]] || { lk_err "$e gives $u key and options \"$eff\", not \"$want\""; ebad=1; }
            grep -Eqx "rd\.luks\.(uuid=(luks-)?$u|name=$u=.+)" <<<"$args" || { lk_err "$e has no rd.luks.uuid=$u: the initramfs wouldn't open it"; ebad=1; }
        done
        [[ $ebad -eq 0 ]] && lk_say "  $e: ok"
        [[ $ebad -eq 0 ]] || bad=1
    done < <(for d in $dirs; do compgen -G "$d/*.conf"; done | LC_ALL=C sort -u)
    [[ $n -gt 0 ]] || { lk_err "no boot entry (loader/entries/*.conf) to check in ${dirs:-no directory}"; return 1; }
    [[ $bad -eq 0 ]]
}

# lk_bls_check UUID|OPTIONS...: lk_bls_entries_ok over the entries moss boot
# sync wrote: in /efi, /boot or /boot/efi, or else on the internal disk's
# ESP or XBOOTLDR partition, mounted read-only for the check.
lk_bls_check() {
    local d p mnt dirs='' tmp=() rc=0
    for d in $LK_BLS_ESP; do
        compgen -G "$d/loader/entries/*.conf" >/dev/null && dirs+=" $d/loader/entries"
    done
    if [[ -z $dirs ]]; then
        while read -r p; do
            mnt=$(findmnt -no TARGET "$p" 2>/dev/null | head -n 1)
            if [[ -z $mnt ]]; then
                mnt=$(mktemp -d) || continue
                if mount -o ro "$p" "$mnt"; then tmp+=("$mnt"); else rmdir "$mnt"; continue; fi
            fi
            dirs+=" $mnt/loader/entries"
        done < <(lsblk -lnpo NAME,PARTTYPE "/dev/$LK_DISK" 2>/dev/null |
            awk 'tolower($2) == "c12a7328-f81f-11d2-ba4b-00a0c93ec93b" || tolower($2) == "bc13c2ff-59e6-4262-a352-b275fd6f7172" { print $1 }')
    fi
    lk_bls_entries_ok "${dirs# }" "$@" || rc=1
    for mnt in "${tmp[@]}"; do umount "$mnt" && rmdir "$mnt"; done
    return $rc
}

# Family S on mkinitcpio's unified kernel images (UKIs).  Each image carries
# its command line in its .cmdline section, made by mkinitcpio -P from
# /etc/kernel/cmdline (else /usr/lib/kernel/cmdline) and every *.conf under
# /etc/cmdline.d, their # lines left out, newlines made spaces (build_uki).
# rd.luks.options= there overrides crypttab's options, so the drive's
# keyfile-timeout would be lost; such tokens are moved into
# crypttab.initramfs and out of the file, and the next mkinitcpio -P bakes
# both into the same images.  The running /proc/cmdline keeps the old tokens
# until the next boot, so what's decided here is from the files.

# lk_uki_presets: "UKI OWN": yes when a preset in LK_UKI_PRESETS builds a
# unified image (NAME_uki), and OWN yes when one of those gives it a command
# line of its own (NAME_cmdline, ALL_cmdline, --cmdline or --no-cmdline in
# NAME_options), which adopt doesn't rewrite.  Read as mkinitcpio reads
# them: each preset sourced, by itself.
lk_uki_presets() {
    local f r uki=no own=no
    for f in "$LK_UKI_PRESETS"/*.preset; do
        [[ -f $f ]] || continue
        r=$(
            set +eu
            # shellcheck disable=SC1090
            . "$f" >/dev/null 2>&1
            u=no o=no
            for p in "${PRESETS[@]}"; do
                v=${p}_uki c=${p}_cmdline a="${p}_options[*]"
                [[ -n ${!v:-} ]] || continue
                u=yes
                [[ -n ${!c:-}${ALL_cmdline:-} || " ${!a:-} " == *" --cmdline"* || " ${!a:-} " == *" --no-cmdline "* ]] && o=yes
            done
            echo "$u $o"
        )
        [[ $r == yes* ]] && uki=yes
        [[ $r == *" yes" ]] && own=yes
    done
    echo "$uki $own"
}

# lk_uki_files: the files mkinitcpio bakes the command line from, in its
# order; none when it would take /proc/cmdline.
lk_uki_files() {
    local f
    for f in $LK_UKI_FILES; do
        [[ -f $f ]] && { echo "$f"; break; }
    done
    [[ ! -d $LK_UKI_DROPIN ]] || find "$LK_UKI_DROPIN" -xtype f -name '*.conf' 2>/dev/null | LC_ALL=C sort -V
}

# lk_uki_text FILE...: the command line those files make, one argument a line.
lk_uki_text() {
    [[ $# -gt 0 ]] || return 0
    grep -ha -- '^[^#]' "$@" 2>/dev/null | tr -s '[:space:]' '\n' | sed '/^$/d'
}

# The arguments systemd-cryptsetup-generator reads, rd. or not.
LK_LUKS_ARG='^(rd\.)?luks(\.[a-z]+)?='

# lk_uki_stray FILE...: the rd.luks/luks arguments on the running command
# line that neither the files nor adopt's copies of them (orig/, the files
# as they were before adopt took them out) give: the boot loader's.
lk_uki_stray() {
    local f o have
    have=$(
        lk_uki_text "$@"
        for f in "$@"; do
            o=$(lk_orig_name "$f")
            [[ -f $o ]] && lk_uki_text "$o"
        done
    )
    tr -s '[:space:]' '\n' <"$LK_CMDLINE" | grep -E "$LK_LUKS_ARG" | while read -r f; do
        grep -qxF -- "$f" <<<"$have" || echo "$f"
    done | paste -s -d ' ' -
}

LK_UUID_RE='[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}'

# lk_uki_map INI NAME:UUID...: the rd.luks arguments on stdin (one a line,
# the files' command line) as crypttab lines for the volumes NAME:UUID (each
# opened early, with a typed passphrase).  "vol NAME UUID OPTIONS" for each
# volume the command line names or gives options, OPTIONS the ones it puts
# in force ("," none, - the crypttab line's own); "bad WHY" for anything that
# can't be moved into crypttab as it is.
lk_uki_map() {
    local ini=$1 v t rest u n k o allow=no
    shift
    local -A vname=() named=() vopt=() vkey=()
    local gopt='' hasg=no
    for v in "$@"; do vname[${v#*:}]=${v%%:*}; done
    while read -r t; do
        [[ -n $t ]] || continue
        case ${t#rd.} in
        luks.name=*)
            rest=${t#*luks.name=} u=${rest%%=*} n=${rest#*=}
            if [[ -z ${vname[$u]:-} ]]; then echo "bad $t: $u isn't a LUKS volume here that opens early with a typed passphrase"; continue; fi
            [[ $n == "${vname[$u]}" ]] || { echo "bad $t: the volume is open as ${vname[$u]}, not $n"; continue; }
            named[$u]=1 allow=yes
            ;;
        luks.uuid=*)
            u=${t#*luks.uuid=} u=${u#luks-}
            if [[ -z ${vname[$u]:-} ]]; then echo "bad $t: $u isn't a LUKS volume here that opens early with a typed passphrase"; continue; fi
            named[$u]=1 allow=yes
            ;;
        luks.options=*)
            rest=${t#*luks.options=}
            if [[ $rest =~ ^($LK_UUID_RE)=(.*)$ ]]; then
                u=${BASH_REMATCH[1]} o=${BASH_REMATCH[2]}
                if [[ -z ${vname[$u]:-} ]]; then echo "bad $t: $u isn't a LUKS volume here that opens early with a typed passphrase"; continue; fi
                vopt[$u]=$o
            else
                o=$rest gopt=$rest hasg=yes
            fi
            [[ ,$o, =~ ,(tpm2-device|fido2-device|pkcs11-uri)= ]] && echo "bad $t: a token opens it (TPM2, FIDO2 or PKCS#11)"
            ;;
        luks.key=*)
            rest=${t#*luks.key=} k=$rest
            if [[ $rest =~ ^($LK_UUID_RE)=(.*)$ ]]; then u=${BASH_REMATCH[1]} k=${BASH_REMATCH[2]}; vkey[$u]=$k; fi
            [[ $k == "$LK_KEYSPEC" ]] || echo "bad $t: a key of its own"
            ;;
        *) echo "bad $t: only rd.luks.name, rd.luks.uuid and rd.luks.options are moved into crypttab" ;;
        esac
    done
    # Once the command line names no volume, the initramfs opens every line
    # of crypttab.initramfs, not only those it named.
    if [[ $allow == yes && -f $ini ]]; then
        while read -r n t _; do
            [[ -z $n || $n == \#* ]] && continue
            for u in "${!named[@]}"; do
                if [[ $t == "UUID=$u" || $t == "/dev/disk/by-uuid/$u" ]] && [[ $n != "${vname[$u]}" ]]; then
                    echo "bad $ini has $u as $n, but it's open as ${vname[$u]}"
                fi
                [[ $n == "${vname[$u]}" || $t == "UUID=$u" || $t == "/dev/disk/by-uuid/$u" ]] && continue 2
            done
            echo "bad $ini's $n isn't named on the command line, and would open in the initramfs once nothing is"
        done <"$ini"
    fi
    for u in "${!vname[@]}"; do
        [[ -n ${named[$u]:-}${vopt[$u]+x}${vkey[$u]:-} ]] || continue
        if [[ ${vopt[$u]+x} ]]; then o=${vopt[$u]:-,}
        # The generator gives options for every volume only to one crypttab
        # doesn't list.
        elif [[ $hasg == yes ]] && ! lk_tab_line "$ini" "${vname[$u]}" "/dev/disk/by-uuid/$u" "$u" >/dev/null; then o=${gopt:-,}
        else o=-
        fi
        echo "vol ${vname[$u]} $u $o"
    done
}

# lk_uki_drop FILE: FILE's text without its rd.luks/luks arguments, all
# else byte for byte (# lines too; a word's separator goes with it, or the
# next one's for a line's first word).
lk_uki_drop() {
    awk '
        /^#/ { print; next }
        {
            s = $0; out = ""; lead = ""; first = 1; nw = 0
            while (match(s, /[^ \t]+/)) {
                sep = substr(s, 1, RSTART - 1); w = substr(s, RSTART, RLENGTH); s = substr(s, RSTART + RLENGTH)
                if (++nw == 1) lead = sep
                if (w ~ /^(rd\.)?luks(\.[a-z]+)?=/) continue
                out = out (first ? lead : sep) w
                first = 0
            }
            print out (first ? "" : s)
        }' "$1"
}

# lk_uki_newfile FILE OUT: lk_uki_drop's text in OUT, without a final
# newline when FILE has none.
lk_uki_newfile() {
    lk_uki_drop "$1" >"$2" || return 1
    if [[ -s $1 && $(tail -c 1 "$1" | od -An -tx1 | tr -d ' \n') != 0a ]]; then truncate -s -1 "$2"; fi
}

# lk_put_file FILE NEW: FILE made NEW's bytes, unless they are already.
lk_put_file() {
    cmp -s "$1" "$2" && return 0
    lk_save "$1" || return 1
    cat "$2" >"$1" || return 1
    LK_CHANGED=$((LK_CHANGED + 1))
    lk_say "wrote $1 (its rd.luks arguments taken out, the rest as it was)"
}

# lk_u32 FILE OFFSET / lk_u16: little-endian integers from FILE (od reads
# the host's order; BackShot1's hosts are x86-64 and arm64).
lk_u32() { od -An -tu4 -j "$2" -N4 "$1" | tr -d ' \n'; }
lk_u16() { od -An -tu2 -j "$2" -N2 "$1" | tr -d ' \n'; }

# lk_pe_section FILE NAME: the bytes of the PE image's section NAME (a
# unified image's .cmdline, say), NULs dropped; false when there's none.
lk_pe_section() {
    local f=$1 want=$2 pe n opt off i name vsize size ptr len
    [[ $(head -c 2 "$f" 2>/dev/null) == MZ ]] || return 1
    pe=$(lk_u32 "$f" 60)
    [[ $(od -An -c -j "$pe" -N4 "$f" | tr -d ' \n') == 'PE\0\0' ]] || return 1
    n=$(lk_u16 "$f" $((pe + 6))) opt=$(lk_u16 "$f" $((pe + 20)))
    off=$((pe + 24 + opt))
    for ((i = 0; i < n; i++, off += 40)); do
        name=$(head -c $((off + 8)) "$f" | tail -c 8 | tr -d '\0')
        [[ $name == "$want" ]] || continue
        vsize=$(lk_u32 "$f" $((off + 8))) size=$(lk_u32 "$f" $((off + 16))) ptr=$(lk_u32 "$f" $((off + 20)))
        len=$size
        [[ $vsize -gt 0 && $vsize -lt $size ]] && len=$vsize
        tail -c +$((ptr + 1)) "$f" | head -c "$len" | tr -d '\0'
        return 0
    done
    return 1
}

# luks_adopt: the step itself.  False, having changed nothing, if it can't.
luks_adopt() {
    local disk key mnt src lbl rel fstype gen family='' reason='' cmdline vols dev uuid name line k o how
    local vol_list=() own_list=() edits_tab=() edits_ini=() edits_bls=() unhandled=() early hooks='' files='' cd cdname fix re f
    local xl_vols=() xl_files=() xl_dir='' xl_kind xl_rest xl_o i e n
    if [[ ${BS1_LUKS:-yes} == no ]]; then lk_say "skipped (BS1_LUKS=no)"; return 0; fi
    disk=$(internal_disk) || { lk_err "no single disk has serial $INTERNAL_SERIAL"; return 1; }
    LK_DISK=$disk
    vols=$(lk_luks_volumes "$disk")
    if [[ -z $vols ]]; then
        lk_say "no LUKS volume on $disk: nothing to do"
        [[ ! -e $LUKS_REC ]] || lk_say "($LUKS_REC is from before; bs1-adopt --luks-off removes it)"
        return 0
    fi
    [[ -s $here/bs1-unlock-key ]] || { lk_err "no $here/bs1-unlock-key: stage the scripts again"; return 1; }
    key=$here/keys/disk-passphrase
    [[ -s $key ]] || { lk_err "LUKS volumes need the passphrase in $key (printf '%s' PASSPHRASE, no final newline)"; return 1; }
    # systemd-cryptsetup warns of a key file anyone can read.
    chmod 600 "$key" 2>/dev/null || true

    # Where the key is: this script's drive, by its label.
    if ! mnt=$(findmnt -no TARGET --target "$here") || ! src=$(findmnt -no SOURCE --target "$here"); then
        lk_err "can't tell which drive $here is on"
        return 1
    fi
    lbl=$(blkid -o value -s LABEL "$src" 2>/dev/null)
    [[ $lbl == "$BACKUP_LABEL" ]] || { lk_err "run bs1-adopt from the backup drive, LABEL=$BACKUP_LABEL (this is ${lbl:-unlabelled} $src)"; return 1; }
    [[ $BACKUP_LABEL =~ ^[A-Za-z0-9._-]+$ ]] || { lk_err "the backup drive's label $BACKUP_LABEL has characters crypttab and the initramfs can't take"; return 1; }
    rel=${here#"$mnt"}
    LK_PATH=${rel%/}/keys/disk-passphrase
    [[ $LK_PATH =~ ^/[A-Za-z0-9._/-]+$ ]] || { lk_err "the key's path on the drive, $LK_PATH, has characters crypttab can't take"; return 1; }
    fstype=$(findmnt -no FSTYPE --target "$here")
    LK_KEYSPEC=$LK_PATH:LABEL=$BACKUP_LABEL

    # The key first, before anything changes.
    while read -r dev uuid name; do
        if ! cryptsetup open --test-passphrase --key-file "$key" "$dev" >/dev/null 2>&1; then
            lk_err "the drive's key ($key) doesn't open $dev ($name): is it the passphrase, with no final newline?"
            return 1
        fi
    done <<<"$vols"
    lk_say "the drive's key opens every LUKS volume on $disk"
    if [[ -e /etc/NIXOS && ! -e /run/ostree-booted ]]; then
        lk_nixos "$vols" "$fstype"
        return
    fi

    gen=$(lk_generator)
    cmdline=$(cat "$LK_CMDLINE")
    if [[ -e /run/ostree-booted ]]; then family=A reason="ostree (bko-holt load refuses LUKS there)"
    # Vanilla OS: /sbin/init is ABRoot's wrapper, whose hook
    # /usr/share/init.d/090-abroot-unlock-var.sh asks for /var's passphrase
    # through Plymouth (abroot unlock-var) before systemd starts; its
    # crypttab line finds the volume already open, and the initramfs never
    # sees it.  The hook is in the read-only root image, so nothing here
    # can hand it the drive's key (Thinkpad, 2026-11-17).
    elif is_abroot; then family=A reason="ABRoot: its init wrapper's abroot unlock-var asks for /var's passphrase through Plymouth before systemd, so neither the initramfs nor crypttab opens it"
    else
        case $gen in
        mkinitcpio)
            hooks=$(lk_mkinitcpio_conf | sed -n 's/^HOOKS //p')
            files=$(lk_mkinitcpio_conf | sed -n 's/^FILES //p')
            if [[ " $hooks " == *" sd-encrypt "* ]]; then family=S
            elif [[ " $hooks " == *" encrypt "* ]]; then family=E
            elif [[ $init == systemd ]]; then family=S
            else family=A reason="mkinitcpio without encrypt or sd-encrypt, and no systemd"
            fi
            ;;
        dracut)
            if lk_dracut_systemd; then family=S
            else family=A reason="dracut without its systemd module (rd.luks.key needs the command line)"
            fi
            ;;
        initramfs-tools) family=D ;;
        prebuilt)
            if lk_blsforme; then family=B
            else family=A reason="the initramfs is ${gen}'s"
            fi
            ;;
        *) family=A reason="the initramfs is ${gen}'s" ;;
        esac
    fi
    LK_TAB=$LK_CRYPTTAB LK_INI=$LK_CRYPTTAB
    [[ $gen == mkinitcpio && $family == S && " $hooks " == *" sd-encrypt "* ]] && LK_INI=$LK_CRYPTTAB_INI
    # S's command line for the next boot: /proc/cmdline, but on mkinitcpio's
    # unified images the one mkinitcpio -P will bake into them from its files
    # (and whatever the boot loader adds to it, which is on /proc/cmdline
    # too: lk_uki_stray).  The running command line still has what adopt
    # took out of the files, until the next boot.
    local scmd=$cmdline ukifiles=() uki=no ukiown=no stray='' ukiwhy='' over='(^|[[:space:]])(rd\.)?luks\.(options|key|crypttab)='
    if [[ $family == S && $gen == mkinitcpio ]]; then
        read -r uki ukiown < <(lk_uki_presets)
        if [[ $uki == yes ]]; then
            LK_UKI=yes
            mapfile -t ukifiles < <(lk_uki_files)
            if [[ $ukiown == yes ]]; then ukiwhy="a mkinitcpio preset gives its unified kernel images a command line of its own (NAME_cmdline, ALL_cmdline, or --cmdline in NAME_options), which bs1-adopt doesn't rewrite"
            elif [[ ${#ukifiles[@]} -eq 0 ]]; then ukiwhy="mkinitcpio bakes /proc/cmdline into its unified kernel images (there's no ${LK_UKI_FILES%% *} or $LK_UKI_DROPIN/*.conf)"
            else
                stray=$(lk_uki_stray "${ukifiles[@]}")
                scmd="$(lk_uki_text "${ukifiles[@]}" | paste -s -d ' ' -) $stray"
            fi
        fi
    fi
    if [[ $family == S && $scmd =~ $over ]]; then
        if [[ $LK_UKI == yes && -z $ukiwhy && -z $stray && $LK_INI == "$LK_CRYPTTAB_INI" ]]; then
            # Moved into crypttab.initramfs, per volume, below.
            LK_UKI_XLATE=yes
            [[ -e $LK_STUB_INFO ]] || family=A reason="rd.luks.options, rd.luks.key or rd.luks.crypttab in ${ukifiles[*]} would override crypttab, and this boot didn't come through a unified kernel image (no systemd-stub StubInfo EFI variable), so those files may not be the command line the boot loader passes"
        elif [[ $LK_UKI == yes && -n $stray ]]; then
            family=A reason="rd.luks.options, rd.luks.key or rd.luks.crypttab on the command line would override crypttab, and the boot loader adds $stray (its entry, not the files mkinitcpio bakes into its unified kernel images), which bs1-adopt doesn't rewrite"
        elif [[ -n $ukiwhy ]]; then
            family=A reason="rd.luks.options, rd.luks.key or rd.luks.crypttab on the command line would override crypttab, and $ukiwhy"
        else
            family=A reason="rd.luks.options, rd.luks.key or rd.luks.crypttab on the command line would override crypttab (the boot loader's entry or GRUB's: bs1-adopt rewrites only the command line mkinitcpio bakes into unified kernel images from ${LK_UKI_FILES%% *} or $LK_UKI_DROPIN)"
        fi
    fi

    local re_cryptkey='(^|[[:space:]])cryptkey(=|[[:space:]]|$)'
    # B: the command line blsforme will write, but BackShot1's own part.
    [[ $family != B ]] || LK_BLS_ARGS=$(lk_bls_args)
    # Each volume: own, or typed and how it's handled.  Any typed volume
    # that can't be makes the whole install attended (family A).
    while read -r dev uuid name; do
        if [[ $name == - ]]; then unhandled+=("$dev isn't open, so it isn't in the backup"); continue; fi
        early=no
        lk_early "$name" && early=yes
        # B: the initramfs opens what the command line names (blsforme
        # names the root's volume itself).
        re="(^|[[:space:]])rd\.luks\.(uuid=(luks-)?|name=)$uuid([[:space:]=]|\$)"
        [[ $family == B && $cmdline =~ $re ]] && early=yes
        if [[ $family:$early == B:yes ]]; then line=$(lk_bls_eff "$uuid" <<<"$LK_BLS_ARGS")
        elif [[ $early == yes ]]; then line=$(lk_tab_line "$LK_INI" "$name" "$dev" "$uuid")
        else line=$(lk_tab_line "$LK_TAB" "$name" "$dev" "$uuid")
        fi
        k=${line%% *} o=${line#* }
        # Own: a key file in crypttab (not ours), a token, or (busybox
        # encrypt, Alpine's mkinitfs) a key file built into the initramfs.
        if [[ -n $line && $k != none && $k != - && $k != "$LK_KEYSPEC" ]] ||
           [[ -n $line && ($o == *tpm2-device=* || $o == *fido2-device=* || $o == *pkcs11-uri=*) ]] ||
           { [[ $early == yes ]] && { [[ $cmdline =~ $re_cryptkey ]] || [[ " $files " == *" /crypto_keyfile.bin "* ]]; }; }; then
            own_list+=("$name:$uuid")
            continue
        fi
        how=
        case $family:$early in
        E:yes)
            # The command line's cryptdevice=DEV:NAME is encrypt's volume.
            cd=$(sed -n 's/.*\bcryptdevice=\([^ ]*\).*/\1/p' <<<"$cmdline")
            cdname=$(cut -d: -f2 <<<"$cd")
            if [[ -n $cd && $(lk_resolve "${cd%%:*}") == "$(readlink -f "$dev")" && $cdname == "$name" ]]; then how=E
            else unhandled+=("$name opens early but isn't the command line's cryptdevice= (${cd:-none})")
            fi
            ;;
        D:yes)
            if [[ -z $line ]]; then unhandled+=("$name has no line in /etc/crypttab for cryptroot")
            elif [[ $o == *keyscript=* && $o != *"keyscript=$UNLOCK_KEY"* ]]; then unhandled+=("$name has a keyscript of its own")
            else how=D
            fi
            ;;
        S:*) how=S ;;
        B:yes) how=B ;;
        A:*) unhandled+=("$reason") ;;
        *:no)
            # Opened by the booted system: systemd's crypttab takes the key form.
            if [[ $init == systemd ]]; then how=S; else unhandled+=("$name is opened after the initramfs, without systemd"); fi
            ;;
        esac
        [[ -n $how ]] || continue
        vol_list+=("$name:$uuid:$how")
        fix=0
        [[ $scmd == *"$uuid"* ]] && fix=1
        case $how:$early in
        S:yes) edits_ini+=("$name|S|$uuid|1|$fix"); LK_EARLY_S+=" $name"; xl_vols+=("$name:$uuid") ;;
        S:no) edits_tab+=("$name|S|$uuid|1|$fix") ;;
        D:*) edits_tab+=("$name|D|$uuid|0|0") ;;
        B:*) edits_bls+=("$uuid|$o") ;;
        esac
    done <<<"$vols"
    # S on unified images: the files' rd.luks arguments become each volume's
    # crypttab.initramfs line (its open name, UUID=, the options they put in
    # force), and come out of the files they're in, which must be ones adopt
    # may rewrite: /etc/kernel/cmdline or /etc/cmdline.d's, not a link.
    if [[ $LK_UKI_XLATE == yes && $family == S && ${#unhandled[@]} -eq 0 ]]; then
        while read -r xl_kind xl_rest; do
            case $xl_kind in
            bad) unhandled+=("$xl_rest") ;;
            vol)
                read -r n uuid xl_o <<<"$xl_rest"
                for i in "${!edits_ini[@]}"; do
                    e=${edits_ini[i]}
                    [[ ${e%%|*} == "$n" ]] || continue
                    e="${e%|*}|1"
                    [[ $xl_o == - ]] || e+="|$xl_o"
                    edits_ini[i]=$e
                done
                ;;
            esac
        done < <(lk_uki_text "${ukifiles[@]}" | grep -E "$LK_LUKS_ARG" | lk_uki_map "$LK_INI" "${xl_vols[@]}")
        for f in "${ukifiles[@]}"; do
            lk_uki_text "$f" | grep -E "$LK_LUKS_ARG" >/dev/null || continue
            if [[ -L $f || ($f != "${LK_UKI_FILES%% *}" && $f != "$LK_UKI_DROPIN"/*) ]]; then
                unhandled+=("rd.luks arguments in $f, which bs1-adopt doesn't rewrite (only ${LK_UKI_FILES%% *} and $LK_UKI_DROPIN/*.conf, not a link)")
            else
                xl_files+=("$f")
            fi
        done
        [[ ${#xl_files[@]} -gt 0 || ${#unhandled[@]} -gt 0 ]] || unhandled+=("rd.luks arguments on the command line, but in none of ${ukifiles[*]}")
    fi
    if [[ ${#unhandled[@]} -gt 0 ]]; then
        family=A reason=$(printf '%s\n' "${unhandled[@]}" | awk '!seen[$0]++' | paste -s -d ';' - | sed 's/;/; /g')
    elif [[ ${#vol_list[@]} -eq 0 ]]; then
        family=own
    fi

    mkdir -p "$LUKS_DIR"
    if [[ $family == A || $family == own ]]; then
        [[ $family == own ]] && reason="every LUKS volume unlocks with no one typing"
        lk_say "$family: $reason; nothing else changes"
        lk_put "$LUKS_REC" 644 "$(lk_record "$family" "$gen" "$fstype" "" "${own_list[*]}" "$reason")" || return 1
        return 0
    fi
    lk_say "family $family (initramfs: $gen): ${vol_list[*]}${own_list:+; own: ${own_list[*]}}"

    # The record first: D's and E's hooks copy it into the initramfs.
    lk_put "$LUKS_REC" 644 "$(lk_record "$family" "$gen" "$fstype" "${vol_list[*]}" "${own_list[*]}" "")" || return 1
    if [[ ${#edits_tab[@]} -gt 0 || ($LK_INI == "$LK_TAB" && ${#edits_ini[@]} -gt 0) ]]; then
        if [[ $LK_INI == "$LK_TAB" ]]; then
            lk_put "$LK_TAB" 644 "$(lk_tab_edit "$LK_TAB" "${edits_tab[@]}" "${edits_ini[@]}")" || return 1
        else
            lk_put "$LK_TAB" 644 "$(lk_tab_edit "$LK_TAB" "${edits_tab[@]}")" || return 1
        fi
    fi
    if [[ $LK_INI != "$LK_TAB" && ${#edits_ini[@]} -gt 0 ]]; then
        lk_put "$LK_INI" 600 "$(lk_tab_edit "$LK_INI" "${edits_ini[@]}")" || return 1
    fi
    # After crypttab.initramfs (a remake between the two would still find
    # the volume: crypttab's key, the old options), and before the one remake
    # that bakes both into the images.
    if [[ ${#xl_files[@]} -gt 0 ]]; then
        xl_dir=$(mktemp -d) || return 1
        for i in "${!xl_files[@]}"; do
            if ! lk_uki_newfile "${xl_files[i]}" "$xl_dir/$i" || ! lk_put_file "${xl_files[i]}" "$xl_dir/$i"; then
                rm -rf "$xl_dir"
                lk_err "couldn't rewrite ${xl_files[i]}; putting everything back"
                luks_off
                return 1
            fi
        done
        rm -rf "$xl_dir"
        lk_say "(/proc/cmdline keeps the rd.luks arguments until the next boot, which takes the images remade below)"
    fi
    LK_BLS_VOLS=("${edits_bls[@]}")
    if [[ ${#edits_bls[@]} -gt 0 ]]; then
        lk_put "$LK_BLS_FILE" 644 "$(lk_bls_text "${edits_bls[@]}")" || return 1
        # Another file's key (one written by hand) stays when --luks-off
        # takes this one away.
        for f in $(for re in $LK_BLS_DIRS; do compgen -G "$re/*.cmdline"; done); do
            [[ $f != "$LK_BLS_FILE" ]] && grep -qE '(^|[[:space:]])(rd\.)?luks\.key=' "$f" &&
                lk_say "$f has an rd.luks.key= of its own (warning: bs1-adopt --luks-off leaves it)"
        done
    fi
    # dracut puts crypttab in only when it's host-only; then by name.
    [[ $family:$gen == S:dracut ]] && grep -qsx 'install_items+=" /etc/crypttab "' /etc/dracut.conf.d/90-backshot1.conf &&
        LK_DRACUT_EXTRA='install_items+=" /etc/crypttab "'
    lk_files "$family" "$gen" "$fstype" || return 1

    if [[ $LK_CHANGED -eq 0 ]]; then
        # B: unless an earlier sync didn't take (the boot entries lack it).
        if [[ $family != B || ${#edits_bls[@]} -eq 0 ]] || lk_bls_check "${edits_bls[@]}" >/dev/null 2>&1; then
            lk_say "unchanged; the initramfs isn't remade"
            return 0
        fi
        lk_say "unchanged, but the boot entries lack the drive's key: moss boot sync again"
    fi
    lk_remake_checked "$family" "$gen" && return 0
    if [[ ${LK_TAB_MISSING:-0} == 1 && $family:$gen == S:dracut && -z ${LK_DRACUT_EXTRA:-} ]]; then
        lk_say "this dracut isn't host-only: crypttab goes in by name"
        LK_DRACUT_EXTRA='install_items+=" /etc/crypttab "'
        lk_files "$family" "$gen" "$fstype" && lk_remake_checked "$family" "$gen" && return 0
    fi
    lk_err "putting everything back"
    luks_off
    return 1
}

# lk_remake_checked FAMILY GENERATOR: the initramfs remade, and checked.
lk_remake_checked() {
    local stamp rc=0
    stamp=$(mktemp) || return 1
    # Past FAT's 2 s mtimes.
    sleep 2
    if [[ $1 == B ]]; then lk_say "writing the boot entries (moss boot sync)"; else lk_say "remaking the initramfs ($2)"; fi
    if ! lk_remake "$2"; then
        lk_err "remaking the initramfs failed"
        rc=1
    elif ! lk_check "$1" "$2" "$stamp"; then
        lk_err "the remade initramfs lacks what unlocking from the drive needs"
        rc=1
    fi
    rm -f "$stamp"
    [[ $rc -eq 0 ]] || return 1
    lk_say "done: reboot once with the drive plugged in, nothing typed, before the next backup (preflight wants a boot the drive unlocked)"
}

# lk_record FAMILY GENERATOR FSTYPE VOLUMES OWN REASON
lk_record() {
    cat <<EOF
# BackShot1 (bs1-adopt): this install's LUKS volumes unlock with the key on
# the backup drive.  TESTBED ONLY; bs1-adopt --luks-off undoes it.
family=$1
generator=$2
label=$BACKUP_LABEL
path=${LK_PATH:-}
fstype=$3
wait=$LUKS_WAIT
volumes=$(lk_q "$4")
own=$(lk_q "$5")
reason=$(lk_q "$6")
EOF
}

# lk_files FAMILY GENERATOR FSTYPE: the script, hooks and drop-ins.
lk_files() {
    local mods drivers
    # The drive's own file system too: LUKS_MODULES has only ext4, and an
    # initramfs without xfs (or vfat, exfat) can't mount a drive that is one
    # (Artix, encrypt, the drive on XFS).  dracut's filesystems+= adds it
    # there, so its add_drivers stays as it was and a rerun doesn't remake it.
    mods=$(lk_modules "${3:-}") drivers=$(lk_modules)
    case $1 in
    D | E) lk_put "$UNLOCK_KEY" 755 "$(cat "$here/bs1-unlock-key")" || return 1 ;;
    esac
    case $1:$2 in
    S:dracut)
        lk_put /etc/dracut.conf.d/90-backshot1.conf 644 "# BackShot1 (bs1-adopt): what reading the LUKS key from the backup drive takes.
# TESTBED ONLY; bs1-adopt --luks-off removes it.
add_drivers+=\" ${drivers% } \"
filesystems+=\" ${3:-ext4} \"${LK_DRACUT_EXTRA:+
$LK_DRACUT_EXTRA}" || return 1
        ;;
    S:mkinitcpio)
        local m q=
        for m in $mods; do q+="'$m?' "; done
        lk_put "$LK_MKI_CONF_D/zz-backshot1.conf" 644 "# BackShot1 (bs1-adopt): what reading the LUKS key from the backup drive takes.
# TESTBED ONLY; bs1-adopt --luks-off removes it.
MODULES+=(${q% })" || return 1
        ;;
    E:mkinitcpio)
        lk_put /etc/initcpio/install/bs1key 644 "#!/bin/bash
# BackShot1 (bs1-adopt): the LUKS key from the backup drive, for encrypt.
# TESTBED ONLY; bs1-adopt --luks-off removes it.
build() {
    local m
    for m in $mods; do add_module \"\$m?\"; done
    add_file $LUKS_REC
    add_file $UNLOCK_KEY $UNLOCK_KEY 755
    add_runscript
}
help() {
    echo 'BackShot1: writes /crypto_keyfile.bin from the backup drive, for encrypt (testbed only)'
}" || return 1
        lk_put /etc/initcpio/hooks/bs1key 644 "#!/usr/bin/ash
# BackShot1 (bs1-adopt): the LUKS key from the backup drive, for encrypt.
run_hook() {
    $UNLOCK_KEY --to /crypto_keyfile.bin
}" || return 1
        # After every other drop-in (Omarchy's omarchy_hooks.conf sets HOOKS).
        lk_put "$LK_MKI_CONF_D/zz-backshot1.conf" 644 "# BackShot1 (bs1-adopt): bs1key reads the LUKS key from the backup drive
# right before encrypt.  TESTBED ONLY; bs1-adopt --luks-off removes it.
_bs1=()
for _h in \"\${HOOKS[@]}\"; do
    [[ \$_h == bs1key ]] && continue
    [[ \$_h == encrypt ]] && _bs1+=(bs1key)
    _bs1+=(\"\$_h\")
done
HOOKS=(\"\${_bs1[@]}\")
unset _h _bs1" || return 1
        ;;
    D:initramfs-tools)
        lk_put /etc/initramfs-tools/hooks/backshot1 755 "#!/bin/sh
# BackShot1 (bs1-adopt): what the keyscript $UNLOCK_KEY reads, and the
# modules for the drive.  cryptroot's hook copies the keyscript itself.
# TESTBED ONLY; bs1-adopt --luks-off removes it.
PREREQ=\"\"
prereqs() { echo \"\$PREREQ\"; }
case \$1 in prereqs) prereqs; exit 0 ;; esac
. /usr/share/initramfs-tools/hook-functions
mkdir -p \"\$DESTDIR$LUKS_DIR\"
cp $LUKS_REC \"\$DESTDIR$LUKS_REC\"
for m in $mods; do manual_add_modules \"\$m\"; done" || return 1
        ;;
    esac
}

# lk_check FAMILY GENERATOR STAMP: every image remade since STAMP has what
# unlocking from the drive needs.
lk_check() {
    local family=$1 gen=$2 imgs img list tab n=0 bad=0 v want ukis=0
    LK_TAB_MISSING=0
    # B remakes no initramfs: its boot entries carry the key.
    if [[ $family == B ]]; then
        [[ ${#LK_BLS_VOLS[@]} -eq 0 ]] || lk_bls_check "${LK_BLS_VOLS[@]}"
        return
    fi
    imgs=$(lk_images "$3")
    [[ -n $imgs ]] || { lk_err "can't find the remade initramfs in /boot, /efi or the ESP"; return 1; }
    while read -r img; do
        if [[ $family == S && $img == */EFI/Linux/*.efi ]]; then
            ukis=$((ukis + 1))
            lk_uki_check "$img" || bad=1
        fi
        list=$(lk_list "$gen" "$img")
        if [[ -z $list ]]; then lk_say "  $img: can't list it, skipped"; continue; fi
        n=$((n + 1))
        want=()
        case $family:$gen in
        D:*) want=("${UNLOCK_KEY#/}" "${LUKS_REC#/}") ;;
        E:*) want=(hooks/bs1key "${UNLOCK_KEY#/}" "${LUKS_REC#/}") ;;
        esac
        for v in "${want[@]}"; do
            grep -qxF "$v" <<<"$list" || { lk_err "$img has no $v"; bad=1; }
        done
        if [[ $family == S && -n ${LK_EARLY_S:-} ]]; then
            [[ $gen != dracut ]] || lsinitrd -m "$img" 2>/dev/null | grep -x systemd >/dev/null ||
                { lk_err "$img has no systemd in it"; bad=1; }
            tab=$(lk_crypttab_in "$gen" "$img")
            for v in $LK_EARLY_S; do
                if ! awk -v n="$v" -v k="$LK_KEYSPEC" '$1 == n && $3 == k { f = 1 } END { exit !f }' <<<"$tab"; then
                    lk_err "$img's crypttab doesn't give $v the drive's key"
                    bad=1 LK_TAB_MISSING=1
                fi
            done
        fi
        grep -Eq '(^|/)usb-storage\.ko' <<<"$list" || grep -qs '/usb-storage\.ko' /lib/modules/*/modules.builtin ||
            lk_say "  $img: no usb-storage module in it (warning)"
        [[ $bad -eq 0 ]] && lk_say "  $img: ok"
    done <<<"$imgs"
    [[ $n -gt 0 ]] || { lk_err "couldn't list any remade initramfs"; return 1; }
    if [[ $family == S && $LK_UKI == yes && $ukis -eq 0 ]]; then
        lk_err "mkinitcpio's presets build unified kernel images, but none was remade in */EFI/Linux"
        bad=1
    fi
    [[ $bad -eq 0 ]]
}

# lk_uki_check IMAGE: the unified image's .cmdline overrides no crypttab
# line (no rd.luks.options, .key or .crypttab), and when adopt took the
# rd.luks arguments out of its files, names no volume either: it's the
# command line the files give now.
lk_uki_check() {
    local sec
    if ! sec=$(lk_pe_section "$1" .cmdline); then
        if [[ $LK_UKI == yes ]]; then lk_err "$1 has no .cmdline section adopt can read"; return 1; fi
        lk_say "  $1: no .cmdline section read (warning)"
        return 0
    fi
    if [[ $sec =~ (^|[[:space:]])((rd\.)?luks\.(options|key|crypttab)=[^[:space:]]*) ]]; then
        lk_err "$1's command line has ${BASH_REMATCH[2]}, which overrides crypttab"
        return 1
    fi
    if [[ $LK_UKI_XLATE == yes && $sec =~ (^|[[:space:]])((rd\.)?luks(\.[a-z]+)?=[^[:space:]]*) ]]; then
        lk_err "$1's command line still has ${BASH_REMATCH[2]}: it isn't the one the rewritten files give"
        return 1
    fi
    return 0
}

# Family N, NixOS (docs/design/bs1-luks-unattended.md, "Built"): the volumes
# are boot.initrd.luks.devices, read from the evaluated configuration as
# nixos-rebuild evaluates it (<nixpkgs/nixos>, <nixos-config>), and the unlock
# is a module of its own, which backshot1.nix (adopt_nixos) imports while it
# exists, so --luks-off is removing it and rebuilding.
LK_NIX_MODULE=/etc/nixos/backshot1-luks.nix
LK_NIX_IMPORTER=/etc/nixos/backshot1.nix
# Scripted stage 1's copy of the key: in luksroot.nix's ramfs, which it
# unmounts once the volumes are open.
LK_NIX_COPY=/crypt-ramfs/backshot1-key

# lk_nix_eval FUNCTION: FUNCTION applied to this system's evaluated config,
# as JSON.
lk_nix_eval() {
    nix-instantiate --eval --strict --json -E "let c = (import <nixpkgs/nixos> { }).config; in ($1) c"
}

# lk_nix_devices: "systemd yes|no", then "dev NAME DEVICE KEYFILE HW" for each
# of boot.initrd.luks.devices, KEYFILE - for none, HW hw when a token opens it
# (FIDO2, YubiKey, GPG card, clevis, TPM2 or PKCS#11 in crypttabExtraOpts).
lk_nix_devices() {
    lk_nix_eval 'c: {
        systemd = c.boot.initrd.systemd.enable;
        clevis = builtins.attrNames (c.boot.initrd.clevis.devices or { });
        devices = builtins.mapAttrs (n: d: {
            device = d.device;
            keyFile = d.keyFile;
            extra = d.crypttabExtraOpts or [ ];
            fido2 = (d.fido2.credentials or [ ]) ++ (if (d.fido2.credential or null) == null then [ ] else [ d.fido2.credential ]);
            yubikey = (d.yubikey or null) != null;
            gpg = (d.gpgCard or null) != null;
        }) c.boot.initrd.luks.devices;
    }' | python3 -c '
import json, sys
d = json.load(sys.stdin)
print("systemd", "yes" if d["systemd"] else "no")
for n, v in sorted(d["devices"].items()):
    hw = v["fido2"] or v["yubikey"] or v["gpg"] or n in d["clevis"] or any(
        o.split("=")[0] in ("tpm2-device", "fido2-device", "pkcs11-uri") for o in v["extra"])
    print("dev", n, v["device"], v["keyFile"] or "-", "hw" if hw else "-")
'
}

# lk_nix_module FSTYPE NAME:UUID...: the module's text.
lk_nix_module() {
    local fstype=$1 v opts vols='' t
    shift
    case $fstype in
    xfs) opts=ro,norecovery ;;
    ext2 | ext3 | ext4) opts=ro,noload ;;
    *) opts=ro ;;
    esac
    for v in "$@"; do vols+="    \"${v%%:*}\" = \"${v#*:}\";"$'\n'; done
    t=$(cat <<'NIX'
# BackShot1 (bs1-adopt): the LUKS volumes below unlock with the key on the
# backup drive, @PATH@ on LABEL=@LABEL@; without the drive, or
# with a key that doesn't fit, the prompt follows after @WAIT@ s.  TESTBED ONLY:
# whoever has the drive and the laptop can read the disk.  backshot1.nix
# imports this file while it exists; bs1-adopt --luks-off removes it and
# rebuilds.
{ config, lib, ... }:
let
  # Mapping name = LUKS UUID; each was typed when bs1-adopt wrote this.
  volumes = {
@VOLUMES@  };
  systemdStage1 = config.boot.initrd.systemd.enable;
  # Scripted stage 1: wait up to @WAIT@ s for the drive, mount it read-only
  # (@OPTS@: no log replayed onto it), copy the key into luksroot's ramfs,
  # unmount; once per batch of volumes.  /run/backshot1-unlock (moved into
  # the booted system's /run) says whether that key opens the volume (drive)
  # or the prompt follows (typed).
  fetch = name: uuid: ''
    # BackShot1: the LUKS key from the backup drive.
    if [ ! -e /crypt-ramfs/backshot1-tried ]; then
        : > /crypt-ramfs/backshot1-tried
        i=0
        while [ ! -e /dev/disk/by-label/@LABEL@ ] && [ "$i" -lt @WAIT@ ]; do
            if [ "$i" -eq 0 ]; then echo "BackShot1: waiting up to @WAIT@ s for the backup drive, LABEL=@LABEL@"; fi
            sleep 1
            i=$((i + 1))
        done
        if [ -e /dev/disk/by-label/@LABEL@ ]; then
            mkdir -p /backshot1-drive
            modprobe @FSTYPE@ 2>/dev/null
            if mount -t @FSTYPE@ -o @OPTS@ /dev/disk/by-label/@LABEL@ /backshot1-drive; then
                cp /backshot1-drive@PATH@ @COPY@
                umount /backshot1-drive
            fi
        fi
    fi
    if [ -s @COPY@ ] && cryptsetup open --test-passphrase --key-file=@COPY@ /dev/disk/by-uuid/${uuid}; then
        echo "${name} drive" >> /run/backshot1-unlock
    else
        echo "${name} typed" >> /run/backshot1-unlock
    fi
  '';
in
{
  boot.initrd.availableKernelModules = [ "usb_storage" "uas" "sd_mod" "xhci_pci" ];
  boot.initrd.supportedFilesystems = [ "@FSTYPE@" ];
  boot.initrd.luks.devices = lib.mapAttrs (name: uuid: lib.mkMerge [
    # systemd stage 1: systemd-cryptsetup-generator mounts the drive
    # read-only and reads the file; the password prompt follows when the
    # drive isn't there within keyFileTimeout or the key fails.
    (lib.mkIf systemdStage1 {
      keyFile = "@KEYSPEC@";
      keyFileTimeout = @WAIT@;
    })
    (lib.mkIf (!systemdStage1) {
      keyFile = "@COPY@";
      fallbackToPassword = true;
      preOpenCommands = fetch name uuid;
    })
  ]) volumes;
}
NIX
)
    t=${t//@VOLUMES@/"$vols"}
    t=${t//@PATH@/"$LK_PATH"}
    t=${t//@LABEL@/"$BACKUP_LABEL"}
    t=${t//@WAIT@/"$LUKS_WAIT"}
    t=${t//@OPTS@/"$opts"}
    t=${t//@FSTYPE@/"$fstype"}
    t=${t//@COPY@/"$LK_NIX_COPY"}
    t=${t//@KEYSPEC@/"$LK_KEYSPEC"}
    printf '%s' "$t"
}

# lk_nixos VOLS FSTYPE: luks_adopt's NixOS part, VOLS lk_luks_volumes's lines.
lk_nixos() {
    local vols=$1 fstype=$2 cfg sd dev uuid name line n d k hw found family=N reason='' want have
    local vol_list=() own_list=() unhandled=()
    [[ $LUKS_WAIT =~ ^[0-9]+$ ]] || { lk_err "BS1_LUKS_WAIT must be a number of seconds"; return 1; }
    [[ $fstype =~ ^[a-z0-9]+$ ]] || { lk_err "the backup drive's file system type, $fstype, isn't one stage 1 can mount"; return 1; }
    if ! cfg=$(lk_nix_devices); then
        lk_err "can't evaluate this system's configuration (nix-instantiate <nixpkgs/nixos>)"
        return 1
    fi
    sd=$(awk '$1 == "systemd" { print $2 }' <<<"$cfg")
    while read -r dev uuid name; do
        if [[ $name == - ]]; then unhandled+=("$dev isn't open, so it isn't in the backup"); continue; fi
        found=
        while read -r line n d k hw; do
            [[ $line == dev ]] || continue
            if [[ $n == "$name" || $(lk_resolve "$d") == "$(readlink -f "$dev")" ]]; then found=$n; break; fi
        done <<<"$cfg"
        if [[ -z $found ]]; then unhandled+=("$name isn't in boot.initrd.luks.devices (stage 1 doesn't open it)"); continue; fi
        if [[ $found != "$name" ]]; then unhandled+=("$name is $found in boot.initrd.luks.devices"); continue; fi
        # Own: a key file not ours, or a token.
        if [[ $hw == hw || ($k != - && $k != "$LK_KEYSPEC" && $k != "$LK_NIX_COPY") ]]; then
            own_list+=("$name:$uuid")
            continue
        fi
        [[ $name =~ ^[A-Za-z0-9._-]+$ ]] || { unhandled+=("$name has characters the module can't take"); continue; }
        vol_list+=("$name:$uuid:N")
    done <<<"$vols"
    if [[ ${#unhandled[@]} -gt 0 ]]; then
        family=A reason=$(printf '%s\n' "${unhandled[@]}" | awk '!seen[$0]++' | paste -s -d ';' - | sed 's/;/; /g')
    elif [[ ${#vol_list[@]} -eq 0 ]]; then
        family=own
    fi

    mkdir -p "$LUKS_DIR"
    if [[ $family == A || $family == own ]]; then
        [[ $family == own ]] && reason="every LUKS volume unlocks with no one typing"
        lk_say "$family: $reason; nothing else changes"
        lk_put "$LUKS_REC" 644 "$(lk_record "$family" nixos "$fstype" "" "${own_list[*]}" "$reason")" || return 1
        return 0
    fi
    grep -qF 'backshot1-luks.nix' "$LK_NIX_IMPORTER" 2>/dev/null ||
        { lk_err "$LK_NIX_IMPORTER doesn't import backshot1-luks.nix: run all of bs1-adopt, not its LUKS step alone"; return 1; }
    lk_say "family N (NixOS, $([[ $sd == yes ]] && echo systemd || echo scripted) stage 1): ${vol_list[*]}${own_list:+; own: ${own_list[*]}}"
    lk_put "$LUKS_REC" 644 "$(lk_record N nixos "$fstype" "${vol_list[*]}" "${own_list[*]}" "")" || return 1
    local mods=() v before=$LK_CHANGED
    for v in "${vol_list[@]}"; do mods+=("${v%:N}"); done
    lk_put "$LK_NIX_MODULE" 644 "$(lk_nix_module "$fstype" "${mods[@]}")" || return 1

    # Rebuilt when the module changed, or the running system's initrd isn't
    # the one this configuration makes (an earlier rebuild that failed).
    want=$(lk_nix_eval 'c: c.system.build.initialRamdisk.outPath' | tr -d '"') || want=
    have=$(dirname "$(readlink -f /run/current-system/initrd)")
    if [[ $LK_CHANGED -eq $before && -n $want && $want == "$have" ]]; then
        lk_say "unchanged; nothing is rebuilt"
        return 0
    fi
    lk_say "rebuilding this NixOS system (nixos-rebuild switch)"
    if lk_remake nixos && lk_nix_check "$sd" "${mods[@]}"; then
        lk_say "done: reboot once with the drive plugged in, nothing typed, before the next backup (preflight wants a boot the drive unlocked)"
        return 0
    fi
    lk_err "the rebuild failed, or its initrd lacks what unlocking from the drive needs; putting everything back"
    luks_off
    return 1
}

# lk_nix_check SYSTEMD NAME:UUID...: the system just switched to runs the
# initrd this configuration makes, systemd-boot's ESP has it, and that initrd
# unlocks each volume from the drive: its crypttab gives the key and the
# timeout (systemd stage 1), or its stage-1 script fetches the key and opens
# with it (scripted).
lk_nix_check() {
    local sd=$1 info initrd crypttab stage1 have v n d bad=0
    shift
    info=$(lk_nix_eval 'c: {
        initrd = c.system.build.initialRamdisk.outPath;
        crypttab = if c.boot.initrd.systemd.enable then toString c.boot.initrd.systemd.contents."/etc/crypttab".source else "";
        stage1 = if c.boot.initrd.systemd.enable then "" else c.system.build.bootStage1.outPath;
    }' | python3 -c 'import json, sys; d = json.load(sys.stdin); print(d["initrd"]); print(d["crypttab"] or "-"); print(d["stage1"] or "-")') ||
        { lk_err "can't evaluate the new configuration"; return 1; }
    { read -r initrd; read -r crypttab; read -r stage1; } <<<"$info"
    have=$(dirname "$(readlink -f /run/current-system/initrd)")
    [[ $have == "$initrd" ]] || { lk_err "the running system's initrd is $have, not the configuration's $initrd"; bad=1; }
    for d in /boot /efi /boot/efi; do
        compgen -G "$d/EFI/nixos/*-initrd.efi" >/dev/null || continue
        [[ -f $d/EFI/nixos/${initrd##*/}-initrd.efi ]] || { lk_err "$d/EFI/nixos has no ${initrd##*/}-initrd.efi: the boot loader doesn't have the new initrd"; bad=1; }
        break
    done
    for v in "$@"; do
        n=${v%%:*}
        if [[ $sd == yes ]]; then
            awk -v n="$n" -v k="$LK_KEYSPEC" -v t="keyfile-timeout=${LUKS_WAIT}s" '$1 == n && $3 == k && index("," $4 ",", "," t ",") { f = 1 } END { exit !f }' "$crypttab" 2>/dev/null ||
                { lk_err "the initrd's crypttab ($crypttab) doesn't give $n the drive's key"; bad=1; }
        else
            awk -v n="$n" -v k="--key-file=$LK_NIX_COPY" 'index($0, "luksOpen ") && index($0, " " n " ") && index($0, k) { o = 1 } index($0, "echo \"" n " drive\"") { m = 1 } END { exit !(o && m) }' "$stage1" 2>/dev/null ||
                { lk_err "the stage-1 script ($stage1) doesn't open $n with the drive's key"; bad=1; }
        fi
    done
    [[ $bad -eq 0 ]] && lk_say "  $initrd: ok"
    [[ $bad -eq 0 ]]
}

# luks_off: everything luks_adopt wrote, put back, and the initramfs remade.
luks_off() {
    local o f gen changed=0
    gen=$(lk_generator)
    if [[ -d $LUKS_ORIG ]]; then
        for o in "$LUKS_ORIG"/*; do
            [[ -e $o ]] || continue
            f=${o##*/}; f=${f//%//}
            cat "$o" >"$f" && rm -f "$o" && lk_say "put back $f" && changed=1
        done
    fi
    if [[ -f $LUKS_MADE ]]; then
        while read -r f; do
            [[ -n $f && -e $f ]] || continue
            rm -f "$f" || continue
            lk_say "removed $f"
            # The record alone (family A or own) changes no initramfs.
            [[ $f == "$LUKS_REC" ]] || changed=1
        done <"$LUKS_MADE"
    fi
    rm -rf "$LUKS_ORIG" "$LUKS_MADE" "$LUKS_REC"
    rmdir "$LUKS_DIR" "${UNLOCK_KEY%/*}" 2>/dev/null || true
    if [[ $changed -eq 1 ]]; then
        if [[ $gen == prebuilt ]]; then lk_say "writing the boot entries again (moss boot sync)"; else lk_say "remaking the initramfs ($gen)"; fi
        lk_remake "$gen" || { lk_err "remaking the initramfs failed: run it by hand before rebooting"; return 1; }
    else
        lk_say "nothing to put back"
    fi
}
