def present_same(a, b):
    """A SOLUS_PRESENT path's rows, before and after: both regular files."""
    return stat.S_ISREG(int(a[0], 8)) and stat.S_ISREG(int(b[0], 8))


def held_ok(label, p, old, new, present):
    """Whether a held (kept) path's difference is still all right: a changed
    one with the same type and bytes, or a SOLUS_PRESENT one still (or now,
    added at a boot) a regular file."""
    if label == "changed":
        return kept_same(old[p], new[p]) or (p in present and present_same(old[p], new[p]))
    return label == "added" and p in present and stat.S_ISREG(int(new[p][0], 8))


def solus_lacks(rows):
    """What a Solus baseline's rows lack of SOLUS_REQUIRED and SOLUS_GLOBS,
    as regular files."""
    files = {rel for rel, r in rows.items() if stat.S_ISREG(int(r[0], 8))}
    return [p for p in SOLUS_REQUIRED if p not in files] + [g for g in SOLUS_GLOBS if not fnmatch.filter(files, g)]


def kept(rel, extra=()):
    return any(fnmatch.fnmatch(rel, pat) for pat in (*KEPT, *extra))


def kept_same(a, b):
    """A KEPT path's rows, before and after: the same file type, and for a
    file the same size and content (or link target)."""
    ta, tb = stat.S_IFMT(int(a[0], 8)), stat.S_IFMT(int(b[0], 8))
    return ta == tb and (ta == stat.S_IFDIR or (a[3] == b[3] and a[5] == b[5]))

# ABRoot (Vanilla OS: docs/design/vanillaos.md): the tree is the present
# root, raw (its image's /etc), with the other root at part-future and the
# init LV (both roots' kernels) at boot/init; each root's /etc changes are an
# overlay upper, var/lib/abroot/etc/LABEL.  The manifest's first row names
# the present root ("/abroot-present", the root the master grub.cfg's
# default leads to: bs1-backup refuses a backup where that isn't the running
# one), and only that root's upper is matched against the lists as etc/ (a
# boot writes there: mount-sys rewrites its fstab, ABROOT_REMADE).  The other
# root's upper and work dir get no exceptions (nothing boots that root), nor
# do part-future and boot/init, which no list names.  The links Vanilla's /
# has into var (home, root, mnt) are matched as their names.  load
# regenerates nothing on ABRoot, so the master grub.cfg, grub.cfg.future,
# EFI/vanilla and EFI/BOOT are held to the baseline's bytes, as HoltTest1's
# judge.py ABROOT_KEPT holds them; grubenv, which GRUB writes at boot, isn't.
ABROOT_SOURCE = "usr/share/abroot/abroot.json"
ABROOT_PRESENT = "/abroot-present"
ABROOT_UPPERS = "var/lib/abroot/etc/"
ABROOT_KEPT = ["boot/grub/grub.cfg", "boot/grub/grub.cfg.future", "boot/efi/EFI/vanilla", "boot/efi/EFI/vanilla/*",
               "boot/efi/EFI/BOOT", "boot/efi/EFI/BOOT/*"]
# Vanilla OS's first-setup writes its (empty) command list again at every
# boot, the same bytes (Thinkpad vanilla-3.0-20261117-132713).
ABROOT_REMADE = ["etc/fstab", "etc/fstab.old", "etc/org.vanillaos.FirstSetup.commands"]
ABROOT_LINKS = (("var/home", "home"), ("var/root", "root"), ("var/mnt", "mnt"))
# A prefix no list's pattern matches: the other root's upper and work dir.
ABROOT_HELD = "//abroot-held/"


def abroot_present(root):
    """The label of the root ROOT's master grub.cfg boots by default (its
    `set default=N` entry's configfile, /LABEL/abroot.cfg, as bko-holt's
    abroot::parse_master reads it), "-" if it can't tell, None if ROOT isn't
    ABRoot."""
    if not os.path.isfile(os.path.join(root, ABROOT_SOURCE)):
        return None
    try:
        with open(os.path.join(root, "boot", "grub", "grub.cfg"), errors="replace") as f:
            lines = f.read().splitlines()
    except OSError:
        return "-"
    default, labels, inside = None, [], False
    for line in lines:
        s = line.strip()
        if s.startswith("#"):
            continue
        if s.startswith("menuentry "):
            labels.append(None)
            inside = True
            continue
        if s.startswith("}"):
            inside = False
            continue
        if not inside:
            if default is None and s.startswith("set default="):
                default = s[len("set default="):].strip().strip("\"'")
            continue
        if s.startswith("configfile "):
            parts = [x for x in re.sub(r"^\([^)]*\)", "", s[len("configfile "):].strip().strip("\"'")).split("/") if x]
            if len(parts) >= 2:
                labels[-1] = parts[0]
    try:
        return labels[int(default)] or "-"
    except (TypeError, ValueError, IndexError):
        return "-"


def abroot_logical(rel, present):
    """REL as the lists name it on ABRoot, PRESENT the present root's label
    (None: not ABRoot; "-": not known, so no upper is mapped or held)."""
    if not present:
        return rel
    for src, dst in ABROOT_LINKS:
        if rel == src or rel.startswith(src + "/"):
            return dst + rel[len(src):]
    if present == "-" or not rel.startswith(ABROOT_UPPERS):
        return rel
    label, sep, rest = rel[len(ABROOT_UPPERS):].partition("/")
    if label == present:
        return "etc/" + rest if sep else "etc"
    if label == present + "-work":
        return rel          # overlayfs's own, emptied at each mount: var/lib/*
    return ABROOT_HELD + rel


def logical(rel, ostree=None, abroot=None):
    return abroot_logical(ostree_paths.logical(rel, ostree), abroot)

# Expected only as added: BackShot1's own mountpoint.  The dispatcher's
# DRIVE mounts the backup drive with "mkdir -p /mnt/bs1-backup" when nothing
# has it mounted already, so a system with no /mnt at backup time (NixOS,
# whose udisks had the drive at /run/media/...: run
# nixos-26.05-20261113-095929) comes back with mnt added.  Where /mnt was
# there, the mkdir only moves its mtime, and a directory's mtime isn't
# compared (same()).  mnt/bs1-backup itself is in EXPECTED.  DRIVE's other
# mount point, /run/bs1-backup (a read-only root: Aeon, MicroOS), is on
# /run's tmpfs, so never in the tree.
ADDED = ["mnt",
         # abroot status (verify runs it) makes ABRoot's package lists, empty,
         # in the present root's /etc upper when they aren't there.
         "etc/abroot/packages.add", "etc/abroot/packages.remove"]

# After bko-holt load --reformat (bs1-restore --reformat,
# docs/design/reformat.md): what its boot stage rewrites for the new type;
# mke2fs's lost+found on a filesystem reformatted onto ext4; and a btrfs's
# snapshots, which the restore leaves out (their .snapshots/N directories
# stay).
REFORMAT_EXPECTED = [
    "etc/fstab", "etc/kernel/cmdline", "etc/cmdline.d/*", "etc/default/grub", "etc/default/limine",
    "etc/mkinitcpio.conf", "etc/mkinitcpio.conf.d/*", "etc/systemd/system/*.mount", "boot/refind_linux.conf",
    "lost+found", "*/lost+found", ".snapshots/*/snapshot/*", "*/.snapshots/*/snapshot/*",
]

# NixOS makes these again from its store at every boot.
NIXOS_EXPECTED = ["etc/.clean", "etc/group", "etc/passwd", "etc/shadow", "etc/subgid", "etc/subuid", "nix/var/nix/temproots/*", "nix/var/nix/db/*"]
# And these, so their mtimes are new, but they have to be the same otherwise.
NIXOS_REMADE = ["etc/*", "bin/sh", "usr/bin/env"]

# Guix System's activation, at every boot, as NixOS's: the account files
# from the configuration's accounts (keeping the hashes), and /etc's links
# into /etc/static (its generation's etc in the store) made again; the
# daemon's database and roots move as it runs (docs/design/guix.md, GX8).
# Guix mounts no tmpfs on /run or /var/run: the boot's
# runtime state (udev's database, the setuid and privileged program links,
# current-system, PID files) is on the root filesystem, so in the backup,
# and each boot writes it again; nscd's caches too (guix-20261114-114854).
GUIX_EXPECTED = ["etc/group", "etc/passwd", "etc/shadow", "etc/.pwd.lock", "var/guix/db/*", "var/guix/gcroots/*", "var/guix/temproots/*",
                 "run/*", "var/run/*", "var/db/nscd/*"]
GUIX_REMADE = ["etc/*", "bin/sh", "usr/bin/env"]

# A store system's lists, by what compare() finds in the baseline.
STORE_EXPECTED = {"nixos": NIXOS_EXPECTED, "guix": GUIX_EXPECTED}
STORE_REMADE = {"nixos": NIXOS_REMADE, "guix": GUIX_REMADE}


FS_IOC_GETFLAGS = 0x80086601
FS_NOCOMP_FL = 0x400


def digest(path, flags=False):
    """The file's sha256, and with FLAGS its inode flags too (as "0x..", or
    "-" where the filesystem has none)."""
    h = hashlib.sha256()
    with open(path, "rb") as f:
        fl = None
        if flags:
            try:
                fl = f"{int.from_bytes(fcntl.ioctl(f.fileno(), FS_IOC_GETFLAGS, bytes(8))[:4], 'little'):#x}"
            except OSError:
                fl = "-"
        while chunk := f.read(1 << 20):
            h.update(chunk)
    return h.hexdigest(), fl


def xattrs(path):
    """NAME=BASE64 for each extended attribute, in order; "-" if there are none."""
    try:
        names = sorted(os.listxattr(path, follow_symlinks=False))
        pairs = [f"{n}={base64.b64encode(os.getxattr(path, n, follow_symlinks=False)).decode()}" for n in names]
    except OSError as e:
        return f"unreadable:{e.errno}"
    return ",".join(pairs) or "-"


def write(root, out):
    st = os.lstat(root)
    seen = {(st.st_dev, st.st_ino): "."}
    # Each inode with several links is read once: an ostree repository's
    # objects are linked into every deployment.
    digests = {}
    with open(out, "w", encoding="utf-8", errors="surrogateescape") as f:
        ostree = ostree_paths.is_ostree(root)
        if ostree:
            f.write(f"{OSTREE_DEFAULT}\t{ostree_paths.default_deployment(root) or '-'}\n")
        present = abroot_present(root)
        if present:
            f.write(f"{ABROOT_PRESENT}\t{present}\n")
        for d, dirs, files in os.walk(root):
            again = []
            for name in dirs + files:
                p = os.path.join(d, name)
                rel = os.path.relpath(p, root)
                st = os.lstat(p)
                extra, links = "-", None
                under = ostree and (rel == "ostree" or rel.startswith("ostree/"))
                try:
                    if stat.S_ISDIR(st.st_mode):
                        first = seen.setdefault((st.st_dev, st.st_ino), rel)
                        if first != rel:
                            extra = f"alias:{first}"
                            again.append(name)
                    elif stat.S_ISLNK(st.st_mode):
                        extra = os.readlink(p)
                    elif stat.S_ISREG(st.st_mode):
                        key = (st.st_dev, st.st_ino)
                        extra, fl = digests.get(key, (None, None))
                        if extra is None or (under and fl is None):
                            extra, fl = digest(p, under)
                            if st.st_nlink > 1:
                                digests[key] = (extra, fl)
                        if under:
                            links = [str(st.st_nlink), fl]
                    elif stat.S_ISCHR(st.st_mode) or stat.S_ISBLK(st.st_mode):
                        extra = f"dev:{os.major(st.st_rdev)}:{os.minor(st.st_rdev)}"
                except OSError as e:
                    extra = f"unreadable:{e.errno}"
                if under and stat.S_ISREG(st.st_mode) and links is None:
                    links = [str(st.st_nlink), "-"]
                f.write("\t".join([rel, oct(st.st_mode), str(st.st_uid), str(st.st_gid), str(st.st_size), str(st.st_mtime_ns), extra, xattrs(p)] + (links or [])) + "\n")
            dirs[:] = [n for n in dirs if n not in again]


def read(path):
    """The rows, by path, and the ostree default deployment (None if not ostree)."""
    rows, default = {}, None
    with open(path, encoding="utf-8", errors="surrogateescape") as f:
        for line in f:
            rel, *rest = line.rstrip("\n").split("\t")
            if rel == OSTREE_DEFAULT:
                default = rest[0]
                continue
            if rel == ABROOT_PRESENT:
                continue
            # A socket belongs to the process that made it, and isn't backed up.
            if not stat.S_ISSOCK(int(rest[0], 8)):
                rows[rel] = rest
    if default is None and any(rel.startswith(ostree_paths.DEPLOY + "/") for rel in rows):
        # A manifest written before the row: from the tree's own links.
        links = {rel: r[5] for rel, r in rows.items() if stat.S_ISLNK(int(r[0], 8))}
        dirs = {rel for rel, r in rows.items() if stat.S_ISDIR(int(r[0], 8))}
        default = ostree_paths.default_from_rows(links, dirs) or "-"
    return rows, default


def read_present(path):
    """The manifest's ABRoot present root (its first rows), or None."""
    with open(path, encoding="utf-8", errors="surrogateescape") as f:
        for _, line in zip(range(2), f):
            rel, _, rest = line.rstrip("\n").partition("\t")
            if rel == ABROOT_PRESENT:
                return rest
    return None


def flags_same(a, b):
    """Inode flags, before and after: the same, or after only gained
    FS_NOCOMP_FL (btrfs marks data that didn't compress as it's written)."""
    if a == b:
        return True
    try:
        x, y = int(a, 16), int(b, 16)
    except ValueError:
        return False
    return (y & ~FS_NOCOMP_FL) == x and bool(y & FS_NOCOMP_FL)


def links_same(a, b, flags=True):
    """A regular file under ostree/: its link count and flags, where both
    rows have them (a baseline from before has neither)."""
    if len(a) < 9 or len(b) < 9:
        return True
    return a[7] == b[7] and (not flags or flags_same(a[8], b[8]))


def same(rel, a, b, store, ostree=None, abroot=None, remade_also=()):
    # A directory's size only says how big it has ever been, and its mtime
    # moves whenever something inside it does.
    if stat.S_ISDIR(int(a[0], 8)) and stat.S_ISDIR(int(b[0], 8)):
        return a[:3] == b[:3]
    remade = (REMADE + STORE_REMADE.get(store, []) + (ostree_paths.REMADE if ostree else []) + (ABROOT_REMADE if abroot else [])
              + list(remade_also))
    if any(fnmatch.fnmatch(logical(rel, ostree, abroot), pat) for pat in remade):
        # Written again by the running system, so its flags are its kernel's.
        return a[:4] + a[5:6] == b[:4] + b[5:6] and links_same(a, b, flags=False)
    return a[:6] == b[:6] and links_same(a, b)


def parse_xattrs(field):
    if field == "-" or field.startswith("unreadable:"):
        return {} if field == "-" else {field: ""}
    return dict(p.partition("=")[::2] for p in field.split(","))


def show(value):
    return repr(base64.b64decode(value)) if value else "(none)"


def xattr_diff(a, b):
    """What differs between two rows' extended attributes, for the report."""
    x, y = parse_xattrs(a[6]), parse_xattrs(b[6])
    return "; ".join(f"{k}: {show(x.get(k))} -> {show(y.get(k))}" for k in sorted(set(x) | set(y)) if x.get(k) != y.get(k))


def expected(rel, store, ostree=None, added=False, abroot=None):
    """Whether a difference at REL is one a boot or the restore makes.  STORE:
    "nixos" or "guix" for a store system, else None.  OSTREE:
    the default deployment (its etc is etc), or "-" (an ostree system's whose
    default couldn't be told: no mapping, but its lists).  ADDED: REL is
    new, so the ADDED lists apply too.  ABROOT: the present root's label
    (abroot_logical)."""
    pats = EXPECTED + STORE_EXPECTED.get(store, []) + (ostree_paths.EXPECTED if ostree else [])
    if added:
        pats = pats + ADDED + (ostree_paths.ADDED if ostree else [])
    return any(fnmatch.fnmatch(logical(rel, ostree, abroot), pat) for pat in pats)


SNAPSHOT = re.compile(r"(.*?)\.snapshots/([0-9]+)(?:/|$)")
# AnduinOS's Disk Snapshots Manager (not snapper): System snapshots under
# deployments/ID/root, Home ones under personal/snapshots/ID/home, and its
# records beside them.  Its scheduler (hourly, and 2 min after each boot)
# makes and prunes them, so, as snapper's, a snapshot only one side has is
# expected, and then so are the records' changes (docs/design/anduinos.md, A7).
DSM_ROOT = ".snapshots/anduinos-btrfs-snapshots-manager/"
DSM_SNAPSHOT = re.compile(r"(.*?)\.snapshots/anduinos-btrfs-snapshots-manager/(deployments/[^/]+|personal/snapshots/[^/]+)(?:/|$)")


def relabeled_boot(rel, a, b):
    """Whether REL's extended attributes differ only in its SELinux label, under
    /boot: load's boot stage runs setfiles on /boot, which gives each file the
    policy's label where the source's can be stale (an openSUSE update left
    its new kernel's files modules_object_t and usr_t); judge.py's
    BOOT_STAGE excuses it as well."""
    if not (rel == "boot" or rel.startswith("boot/")):
        return False
    x, y = parse_xattrs(a[6]), parse_xattrs(b[6])
    return {k for k in set(x) | set(y) if x.get(k) != y.get(k)} == {"security.selinux"}


def snapshot_of(rel):
    """The snapper or Disk Snapshots Manager snapshot REL is in or is, as
    (where its .snapshots is, number or the manager's KIND/ID), or None."""
    m = SNAPSHOT.match(rel) or DSM_SNAPSHOT.match(rel)
    return m.groups() if m else None


def snapshots(rows):
    """snapper's snapshots, as (where its .snapshots is, number), and the
    Disk Snapshots Manager's, as (where its .snapshots is, KIND/ID)."""
    return {m.groups() for rel in rows if (m := SNAPSHOT.fullmatch(rel + "/") or DSM_SNAPSHOT.fullmatch(rel + "/"))}


def dsm_record(rel):
    """Whether REL is the Disk Snapshots Manager's own, outside its snapshots."""
    i = rel.find(DSM_ROOT)
    return (i == 0 or (i > 0 and rel[i - 1] == "/")) and not DSM_SNAPSHOT.match(rel)


def unaliased(rows, aliases):
    """Without what's under a directory listed as another's alias: a baseline
    written before aliases has those rows, and they'd be the other's twice."""
    return {rel: r for rel, r in rows.items() if not any(rel.startswith(a + "/") for a in aliases)}


def without_btrfs_xattrs(row):
    """ROW with its btrfs.* extended attributes taken out: no other filesystem
    holds them, so they don't survive a reformat (rustic-bko warns)."""
    if len(row) <= 6 or row[6] == "-" or row[6].startswith("unreadable:"):
        return row
    kept = [p for p in row[6].split(",") if not p.startswith("btrfs.")]
    return row[:6] + [",".join(kept) or "-"] + row[7:]


def compare(old_path, new_path, reformatted=False):
    (old, odef), (new, ndef) = read(old_path), read(new_path)
    if reformatted:
        old = {p: without_btrfs_xattrs(r) for p, r in old.items()}
    aliases = sorted({rel for rows in (old, new) for rel, r in rows.items() if len(r) > 5 and r[5].startswith("alias:")})
    if aliases:
        old, new = unaliased(old, aliases), unaliased(new, aliases)
        print(f"aliases, compared once: {' '.join(aliases)}")
    store = "nixos" if "etc/NIXOS" in old else "guix" if "var/guix/profiles/system" in old else None
    if odef or ndef:
        print(f"ostree: default deployment {odef or '(none)'}, after {ndef or '(none)'}; its etc is matched as etc/")
        if odef != ndef:
            print("ostree: the default deployment moved")
    # A path both sides have takes the baseline's mapping; one side's, its own.
    mapping = {"missing": odef, "added": ndef, "changed": odef, "xattrs": odef}
    apre, apost = read_present(old_path), read_present(new_path)
    if apre or apost:
        print(f"ABRoot: present root {apre or '(none)'}, after {apost or '(none)'}; its /etc upper is matched as etc/, "
              "the other root's upper, the other root and the init LV get no exceptions")
        if apre != apost:
            print("ABRoot: the present root moved")
    amapping = {"missing": apre, "added": apost, "changed": apre, "xattrs": apre}
    missing = sorted(set(old) - set(new))
    added = sorted(set(new) - set(old))
    # A snapshot snapper or the Disk Snapshots Manager took after the backup,
    # or cleaned up since.
    def own(paths, other):
        theirs = snapshots(other)
        return {p for p in paths if (s := snapshot_of(p)) and s not in theirs}
    snapper = own(missing, new) | own(added, old)
    # The manager's records move with its snapshots, and only then.
    dsm_moved = any(DSM_SNAPSHOT.match(p) for p in snapper)
    if dsm_moved:
        print("Disk Snapshots Manager: a snapshot came or went since the backup, so its records' changes are expected")
        snapper |= {p for p in set(old) | set(new) if dsm_record(p)}
    held = ANDUINOS_KEPT if ANDUINOS_SOURCE in old else []
    if held:
        print(f"AnduinOS: {len(held)} MOK-signed loaders held to the baseline's bytes: {' '.join(p for p in held if p in old)}")
        missing_held = [p for p in held if p not in old]
        if missing_held:
            print(f"AnduinOS: the baseline lacks {' '.join(missing_held)}")
    solus = any(fnmatch.fnmatch(p, pat) for pat in SOLUS_SOURCE for p in old)
    lacks = solus_lacks(old) if solus else []
    present = SOLUS_PRESENT if solus else []
    if solus:
        held = held + SOLUS_KEPT
        n = sum(1 for p in old if any(fnmatch.fnmatch(p, pat) for pat in SOLUS_KEPT))
        print(f"Solus: its ESP at /boot held to the baseline's bytes: {n} paths of EFI/com.solus-project, EFI/BOOT, loader/ and solus-enroll-me.cer")
    qol = QOL_EXPECTED if QOL_TRIGGER in old else []
    if qol:
        print(f"Solus: qol-assist's migrations were pending at the backup ({QOL_TRIGGER}), so the first boot's are expected: "
              f"{' '.join(qol)}")
    if apre:
        held = held + ABROOT_KEPT
        n = sum(1 for p in old if any(fnmatch.fnmatch(p, pat) for pat in ABROOT_KEPT))
        print(f"ABRoot: {n} paths of the master grub.cfg, grub.cfg.future, EFI/vanilla and EFI/BOOT held to the baseline's bytes")
    pve = PROXMOX_REMADE if PROXMOX_SOURCE in old else []
    if pve:
        print(f"Proxmox VE: written again by a boot or the restore, so with new mtimes, but the same otherwise: {' '.join(p for p in pve if p in old)}")
    mx = [pat for src, pats in MX_REMADE.items() if src in old for pat in pats]
    if mx:
        print(f"MX Linux: written again at a boot or login, so with new mtimes, but the same otherwise: {' '.join(mx)}")
    slk = SLACKWARE_SOURCE in old
    slk_remade, slk_expected = (SLACKWARE_REMADE, SLACKWARE_EXPECTED) if slk else ([], [])
    if slk:
        slk_expected = slk_expected + [pat for src, pats in SLACKWARE_BY_WRITER.items() if src in old for pat in pats]
        print(f"Slackware: written again at every boot, so with new mtimes, but the same otherwise: {' '.join(slk_remade)}; "
              f"other bytes expected: {' '.join(slk_expected)}")
    changed = sorted(p for p in set(old) & set(new) if not same(p, old[p], new[p], store, odef, apre, pve + mx + slk_remade))
    both = [p for p in set(old) & set(new) if len(old[p]) > 6 and len(new[p]) > 6]
    relabeled = sorted(p for p in both if old[p][6] != new[p][6])
    if not both:
        print("xattrs: this baseline has none, so they weren't compared")
    bad = [f"Solus: the baseline lacks {p} (was its ESP mounted at /boot?)" for p in lacks]
    for label, paths in (("missing", missing), ("added", added), ("changed", changed), ("xattrs", relabeled)):
        unexpected = [p for p in paths if kept(p, held) and not held_ok(label, p, old, new, present)]
        unexpected += [p for p in paths if not kept(p, held) and not expected(p, store, mapping[label], label == "added", amapping[label]) and p not in snapper
                       and p not in qol
                       and not any(fnmatch.fnmatch(p, pat) for pat in slk_expected)
                       and not (reformatted and any(fnmatch.fnmatch(p, pat) for pat in REFORMAT_EXPECTED))
                       and not (label == "xattrs" and relabeled_boot(p, old[p], new[p]))]
        print(f"{label}: {len(paths)}, of which unexpected: {len(unexpected)}")
        bad += [f"{label}: {p}" + (f" ({xattr_diff(old[p], new[p])})" if label == "xattrs" else "") for p in unexpected]
    linked = sum(1 for p in set(old) & set(new) if len(old[p]) > 8 and len(new[p]) > 8)
    if linked:
        print(f"ostree: link counts and inode flags compared for {linked} regular files under ostree/")
    print(f"files compared: {len(old)}")
    for line in bad:
        print(line)
    return 1 if bad else 0


def main():
    a = sys.argv[1:]
    if len(a) in (3, 4) and a[0] == "--compare" and a[3:] in ([], ["--reformatted"]):
        return compare(a[1], a[2], reformatted=a[3:] == ["--reformatted"])
    if len(a) == 2:
        write(a[0], a[1])
        return 0
    sys.exit(__doc__)


if __name__ == "__main__":
    sys.exit(main())
