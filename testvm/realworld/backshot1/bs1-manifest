#!/usr/bin/env python3
"""BackShot1's file manifest.

bs1-manifest ROOT OUT.tsv            every file under ROOT, with a checksum
bs1-manifest --compare OLD NEW [--reformatted]
                                     differences; exit 1 if any isn't expected
                                     (--reformatted: after bs1-restore --reformat)

The comparison is between the system before its backup and after its restore and
first boot, so booting's own changes are expected, as are the files bko-holt
remakes on purpose (the initramfs, grub.cfg and the ESP's loader).

Each file's extended attributes are compared too: SELinux labels, capabilities,
POSIX ACLs and user.* attributes.  A baseline older than that has none, and
then only the rest is compared.

A directory met a second time (openSUSE's root subvolume, mounted at / and
seen again at .snapshots/N/snapshot under /.snapshots) is listed once, as an
alias, and not walked again.  snapper's own snapshots come and go with its
timers, so a snapshot only one side has is expected; the others are compared.

On ostree (ROOT is the physical root, with /boot, /home and /var as fstab
mounts them: docs/design/bazzite.md), the manifest's first row names the
default deployment ("/ostree-default", a path no file can have), and only
that deployment's etc/ is matched against the lists below as etc/; every
other deployment's etc must come back as it was.  ostree_paths.py (beside
this script on the backup drive, or testvm/ in the repository) has that rule
and what an ostree boot changes besides.  Regular files under ostree/ get two
more columns, their link count and inode flags, so a repository object that
came back unlinked from its deployments, or lost a flag, shows; a gained
FS_NOCOMP_FL alone is btrfs's own, set as the restore writes data that won't
compress (B5, B6).  A file with several links is read once.
"""

import base64
import fcntl
import fnmatch
import hashlib
import os
import re
import stat
import sys

_here = os.path.dirname(os.path.realpath(__file__))
sys.path[:0] = [_here, os.path.join(_here, "..", "..")]
import ostree_paths  # noqa: E402

OSTREE_DEFAULT = "/ostree-default"

# Paths a boot, the restore, or the time the backup took may change.  Anything
# else that differs is reported as unexpected.
EXPECTED = [
    "boot/initrd.img-*", "boot/initramfs-*", "boot/initrd-*", "boot/grub/*", "boot/grub2/*", "boot/loader/*",
    # Limine's config, remade by limine-mkinitcpio-hook when the restore runs mkinitcpio.
    "boot/limine.conf", "boot/limine.conf.old",
    # The initramfs that hook copies into the per-machine-id layout (/boot/<machine-id>/<kernel>/).
    "boot/*/*/initramfs",
    "boot/efi/*", "efi/*",
    "etc/cups/*", "etc/NetworkManager/system-connections/*", "etc/mtab", "etc/resolv.conf",
    "usr/lib/sysimage/rpm/rpmdb.sqlite-shm", "usr/lib/sysimage/rpm/rpmdb.sqlite-wal",
    "home/*/.cache/*", "home/*/.local/state/*", "home/*/.local/share/*", "home/*/.config/*",
    "home/*/.bash_history", "home/*/.lesshst", "home/*/.ssh/known_hosts",
    "home/*/.Xauthority", "home/*/.xsession-errors", "home/*/.xsession-errors.old",
    "root/.bash_history", "root/.cache/*", "root/.lesshst", "root/.ssh/known_hosts",
    "root/.config/*", "root/.local/state/*", "root/.local/share/*",
    "tmp/*", "var/tmp/*", "var/cache/*", "var/crash/*", "var/log/*", "var/spool/*", "var/backups/*",
    "var/lib/*", "var/db/dhcpcd/*", "var/snap/*", "swap.img", "swapfile", "swap/*", "mnt/bs1-backup",
    "etc/lvm/archive/*", "etc/lvm/backup/*", "etc/lvm/devices/*", "etc/selinux/*/active/*", ".autorelabel",
    # bs1-adopt removes these, and some systems make them again at boot.  Not the
    # ed25519 key: that one has to stay what it was.
    "etc/ssh/ssh_host_rsa_key*", "etc/ssh/ssh_host_ecdsa_key*", "etc/ssh/ssh_host_dsa_key*",
    # systemd's ConditionNeedsUpdate stamps: a restored /usr is newer than they are.
    "etc/.updated", "var/.updated",
    # Rewritten whenever the pool is imported.
    "etc/zfs/zpool.cache",
    # OVMF keeps its variables there, on the ESP, when it has no flash for them;
    # an ESP as /boot (chimera-uefi) puts it outside boot/efi.
    "boot/NvVars",
    # An ESP as /boot (Chimera's systemd-boot): the restore's bootctl install
    # puts the package's systemd-boot there, newer than the ESP's own when
    # the package was upgraded without a bootctl update.
    "boot/EFI/*",
]

# Rewritten at every boot, so with a new mtime, but they have to be the same
# otherwise.  machine-id: systemd writes it again from the kernel command
# line's systemd.machine_id= (EndeavourOS with systemd-boot); a different ID
# would orphan the ESP's /MACHINE-ID/ directory and loader entries.
# mimeinfo.cache: openSUSE rebuilds it at boot after the restore.
# entry-token: the restore's bootctl install writes it again (Chimera, with
# systemd-boot), and the ESP's entries are under that name.  OpenRC's
# save-keymaps and save-termencoding (Gentoo's boot runlevel) save the
# console's keymap and encoding in its libexec dir at every boot.
# ld.so.cache: ldconfig.service (ConditionNeedsUpdate=/etc) remakes it at the
# first boot after anything touched /usr since etc/.updated, as bs1-adopt's
# package install does (avahi on cachyos-zfs under bs1-qemu): the restored
# copy's first boot runs it, and it has to come out the same.
REMADE = ["etc/machine-id", "usr/share/applications/mimeinfo.cache", "etc/kernel/entry-token", "usr/libexec/rc/console/*", "etc/ld.so.cache"]

# Expected only as added: BackShot1's own mountpoint.  The dispatcher's
# DRIVE mounts the backup drive with "mkdir -p /mnt/bs1-backup" when nothing
# has it mounted already, so a system with no /mnt at backup time (NixOS,
# whose udisks had the drive at /run/media/...: run
# nixos-26.05-20261113-095929) comes back with mnt added.  Where /mnt was
# there, the mkdir only moves its mtime, and a directory's mtime isn't
# compared (same()).  mnt/bs1-backup itself is in EXPECTED.
ADDED = ["mnt"]

# After bko-holt load --reformat (bs1-restore --reformat,
# docs/design/reformat.md): what its boot stage rewrites for the new type;
# mke2fs's lost+found on a filesystem reformatted onto ext4; and a btrfs's
# snapshots, which the restore leaves out (their .snapshots/N directories
# stay).
REFORMAT_EXPECTED = [
    "etc/fstab", "etc/kernel/cmdline", "etc/cmdline.d/*", "etc/default/grub", "etc/default/limine",
    "etc/mkinitcpio.conf", "etc/mkinitcpio.conf.d/*", "etc/systemd/system/*.mount", "boot/refind_linux.conf",
    "lost+found", "*/lost+found", ".snapshots/*/snapshot/*", "*/.snapshots/*/snapshot/*",
]

# NixOS makes these again from its store at every boot.
NIXOS_EXPECTED = ["etc/.clean", "etc/group", "etc/passwd", "etc/shadow", "etc/subgid", "etc/subuid", "nix/var/nix/temproots/*", "nix/var/nix/db/*"]
# And these, so their mtimes are new, but they have to be the same otherwise.
NIXOS_REMADE = ["etc/*", "bin/sh", "usr/bin/env"]

# Guix System's activation, at every boot, as NixOS's: the account files
# from the configuration's accounts (keeping the hashes), and /etc's links
# into /etc/static (its generation's etc in the store) made again; the
# daemon's database and roots move as it runs (docs/design/guix.md, GX8).
# Guix mounts no tmpfs on /run or /var/run: the boot's
# runtime state (udev's database, the setuid and privileged program links,
# current-system, PID files) is on the root filesystem, so in the backup,
# and each boot writes it again; nscd's caches too (guix-20261114-114854).
GUIX_EXPECTED = ["etc/group", "etc/passwd", "etc/shadow", "etc/.pwd.lock", "var/guix/db/*", "var/guix/gcroots/*", "var/guix/temproots/*",
                 "run/*", "var/run/*", "var/db/nscd/*"]
GUIX_REMADE = ["etc/*", "bin/sh", "usr/bin/env"]

# A store system's lists, by what compare() finds in the baseline.
STORE_EXPECTED = {"nixos": NIXOS_EXPECTED, "guix": GUIX_EXPECTED}
STORE_REMADE = {"nixos": NIXOS_REMADE, "guix": GUIX_REMADE}


FS_IOC_GETFLAGS = 0x80086601
FS_NOCOMP_FL = 0x400


def digest(path, flags=False):
    """The file's sha256, and with FLAGS its inode flags too (as "0x..", or
    "-" where the filesystem has none)."""
    h = hashlib.sha256()
    with open(path, "rb") as f:
        fl = None
        if flags:
            try:
                fl = f"{int.from_bytes(fcntl.ioctl(f.fileno(), FS_IOC_GETFLAGS, bytes(8))[:4], 'little'):#x}"
            except OSError:
                fl = "-"
        while chunk := f.read(1 << 20):
            h.update(chunk)
    return h.hexdigest(), fl


def xattrs(path):
    """NAME=BASE64 for each extended attribute, in order; "-" if there are none."""
    try:
        names = sorted(os.listxattr(path, follow_symlinks=False))
        pairs = [f"{n}={base64.b64encode(os.getxattr(path, n, follow_symlinks=False)).decode()}" for n in names]
    except OSError as e:
        return f"unreadable:{e.errno}"
    return ",".join(pairs) or "-"


def write(root, out):
    st = os.lstat(root)
    seen = {(st.st_dev, st.st_ino): "."}
    # Each inode with several links is read once: an ostree repository's
    # objects are linked into every deployment.
    digests = {}
    with open(out, "w", encoding="utf-8", errors="surrogateescape") as f:
        ostree = ostree_paths.is_ostree(root)
        if ostree:
            f.write(f"{OSTREE_DEFAULT}\t{ostree_paths.default_deployment(root) or '-'}\n")
        for d, dirs, files in os.walk(root):
            again = []
            for name in dirs + files:
                p = os.path.join(d, name)
                rel = os.path.relpath(p, root)
                st = os.lstat(p)
                extra, links = "-", None
                under = ostree and (rel == "ostree" or rel.startswith("ostree/"))
                try:
                    if stat.S_ISDIR(st.st_mode):
                        first = seen.setdefault((st.st_dev, st.st_ino), rel)
                        if first != rel:
                            extra = f"alias:{first}"
                            again.append(name)
                    elif stat.S_ISLNK(st.st_mode):
                        extra = os.readlink(p)
                    elif stat.S_ISREG(st.st_mode):
                        key = (st.st_dev, st.st_ino)
                        extra, fl = digests.get(key, (None, None))
                        if extra is None or (under and fl is None):
                            extra, fl = digest(p, under)
                            if st.st_nlink > 1:
                                digests[key] = (extra, fl)
                        if under:
                            links = [str(st.st_nlink), fl]
                    elif stat.S_ISCHR(st.st_mode) or stat.S_ISBLK(st.st_mode):
                        extra = f"dev:{os.major(st.st_rdev)}:{os.minor(st.st_rdev)}"
                except OSError as e:
                    extra = f"unreadable:{e.errno}"
                if under and stat.S_ISREG(st.st_mode) and links is None:
                    links = [str(st.st_nlink), "-"]
                f.write("\t".join([rel, oct(st.st_mode), str(st.st_uid), str(st.st_gid), str(st.st_size), str(st.st_mtime_ns), extra, xattrs(p)] + (links or [])) + "\n")
            dirs[:] = [n for n in dirs if n not in again]


def read(path):
    """The rows, by path, and the ostree default deployment (None if not ostree)."""
    rows, default = {}, None
    with open(path, encoding="utf-8", errors="surrogateescape") as f:
        for line in f:
            rel, *rest = line.rstrip("\n").split("\t")
            if rel == OSTREE_DEFAULT:
                default = rest[0]
                continue
            # A socket belongs to the process that made it, and isn't backed up.
            if not stat.S_ISSOCK(int(rest[0], 8)):
                rows[rel] = rest
    if default is None and any(rel.startswith(ostree_paths.DEPLOY + "/") for rel in rows):
        # A manifest written before the row: from the tree's own links.
        links = {rel: r[5] for rel, r in rows.items() if stat.S_ISLNK(int(r[0], 8))}
        dirs = {rel for rel, r in rows.items() if stat.S_ISDIR(int(r[0], 8))}
        default = ostree_paths.default_from_rows(links, dirs) or "-"
    return rows, default


def flags_same(a, b):
    """Inode flags, before and after: the same, or after only gained
    FS_NOCOMP_FL (btrfs marks data that didn't compress as it's written)."""
    if a == b:
        return True
    try:
        x, y = int(a, 16), int(b, 16)
    except ValueError:
        return False
    return (y & ~FS_NOCOMP_FL) == x and bool(y & FS_NOCOMP_FL)


def links_same(a, b, flags=True):
    """A regular file under ostree/: its link count and flags, where both
    rows have them (a baseline from before has neither)."""
    if len(a) < 9 or len(b) < 9:
        return True
    return a[7] == b[7] and (not flags or flags_same(a[8], b[8]))


def same(rel, a, b, store, ostree=None):
    # A directory's size only says how big it has ever been, and its mtime
    # moves whenever something inside it does.
    if stat.S_ISDIR(int(a[0], 8)) and stat.S_ISDIR(int(b[0], 8)):
        return a[:3] == b[:3]
    remade = REMADE + STORE_REMADE.get(store, []) + (ostree_paths.REMADE if ostree else [])
    if any(fnmatch.fnmatch(ostree_paths.logical(rel, ostree), pat) for pat in remade):
        # Written again by the running system, so its flags are its kernel's.
        return a[:4] + a[5:6] == b[:4] + b[5:6] and links_same(a, b, flags=False)
    return a[:6] == b[:6] and links_same(a, b)


def parse_xattrs(field):
    if field == "-" or field.startswith("unreadable:"):
        return {} if field == "-" else {field: ""}
    return dict(p.partition("=")[::2] for p in field.split(","))


def show(value):
    return repr(base64.b64decode(value)) if value else "(none)"


def xattr_diff(a, b):
    """What differs between two rows' extended attributes, for the report."""
    x, y = parse_xattrs(a[6]), parse_xattrs(b[6])
    return "; ".join(f"{k}: {show(x.get(k))} -> {show(y.get(k))}" for k in sorted(set(x) | set(y)) if x.get(k) != y.get(k))


def expected(rel, store, ostree=None, added=False):
    """Whether a difference at REL is one a boot or the restore makes.  STORE:
    "nixos" or "guix" for a store system, else None.  OSTREE:
    the default deployment (its etc is etc), or "-" (an ostree system's whose
    default couldn't be told: no mapping, but its lists).  ADDED: REL is
    new, so the ADDED lists apply too."""
    pats = EXPECTED + STORE_EXPECTED.get(store, []) + (ostree_paths.EXPECTED if ostree else [])
    if added:
        pats = pats + ADDED + (ostree_paths.ADDED if ostree else [])
    return any(fnmatch.fnmatch(ostree_paths.logical(rel, ostree), pat) for pat in pats)


SNAPSHOT = re.compile(r"(.*?)\.snapshots/([0-9]+)(?:/|$)")


def snapshots(rows):
    """snapper's snapshots, as (where its .snapshots is, number)."""
    return {m.groups() for rel in rows if (m := SNAPSHOT.fullmatch(rel + "/"))}


def unaliased(rows, aliases):
    """Without what's under a directory listed as another's alias: a baseline
    written before aliases has those rows, and they'd be the other's twice."""
    return {rel: r for rel, r in rows.items() if not any(rel.startswith(a + "/") for a in aliases)}


def without_btrfs_xattrs(row):
    """ROW with its btrfs.* extended attributes taken out: no other filesystem
    holds them, so they don't survive a reformat (rustic-bko warns)."""
    if len(row) <= 6 or row[6] == "-" or row[6].startswith("unreadable:"):
        return row
    kept = [p for p in row[6].split(",") if not p.startswith("btrfs.")]
    return row[:6] + [",".join(kept) or "-"] + row[7:]


def compare(old_path, new_path, reformatted=False):
    (old, odef), (new, ndef) = read(old_path), read(new_path)
    if reformatted:
        old = {p: without_btrfs_xattrs(r) for p, r in old.items()}
    aliases = sorted({rel for rows in (old, new) for rel, r in rows.items() if len(r) > 5 and r[5].startswith("alias:")})
    if aliases:
        old, new = unaliased(old, aliases), unaliased(new, aliases)
        print(f"aliases, compared once: {' '.join(aliases)}")
    store = "nixos" if "etc/NIXOS" in old else "guix" if "var/guix/profiles/system" in old else None
    if odef or ndef:
        print(f"ostree: default deployment {odef or '(none)'}, after {ndef or '(none)'}; its etc is matched as etc/")
        if odef != ndef:
            print("ostree: the default deployment moved")
    # A path both sides have takes the baseline's mapping; one side's, its own.
    mapping = {"missing": odef, "added": ndef, "changed": odef, "xattrs": odef}
    missing = sorted(set(old) - set(new))
    added = sorted(set(new) - set(old))
    # A snapshot snapper took after the backup, or cleaned up since.
    def own(paths, other):
        theirs = snapshots(other)
        return {p for p in paths if (m := SNAPSHOT.match(p)) and m.groups() not in theirs}
    snapper = own(missing, new) | own(added, old)
    changed = sorted(p for p in set(old) & set(new) if not same(p, old[p], new[p], store, odef))
    both = [p for p in set(old) & set(new) if len(old[p]) > 6 and len(new[p]) > 6]
    relabeled = sorted(p for p in both if old[p][6] != new[p][6])
    if not both:
        print("xattrs: this baseline has none, so they weren't compared")
    bad = []
    for label, paths in (("missing", missing), ("added", added), ("changed", changed), ("xattrs", relabeled)):
        unexpected = [p for p in paths if not expected(p, store, mapping[label], label == "added") and p not in snapper
                      and not (reformatted and any(fnmatch.fnmatch(p, pat) for pat in REFORMAT_EXPECTED))]
        print(f"{label}: {len(paths)}, of which unexpected: {len(unexpected)}")
        bad += [f"{label}: {p}" + (f" ({xattr_diff(old[p], new[p])})" if label == "xattrs" else "") for p in unexpected]
    linked = sum(1 for p in set(old) & set(new) if len(old[p]) > 8 and len(new[p]) > 8)
    if linked:
        print(f"ostree: link counts and inode flags compared for {linked} regular files under ostree/")
    print(f"files compared: {len(old)}")
    for line in bad:
        print(line)
    return 1 if bad else 0


def main():
    a = sys.argv[1:]
    if len(a) in (3, 4) and a[0] == "--compare" and a[3:] in ([], ["--reformatted"]):
        return compare(a[1], a[2], reformatted=a[3:] == ["--reformatted"])
    if len(a) == 2:
        write(a[0], a[1])
        return 0
    sys.exit(__doc__)


if __name__ == "__main__":
    sys.exit(main())
