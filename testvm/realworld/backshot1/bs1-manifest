# Rewritten at every boot, so with a new mtime, but they have to be the same
# otherwise.  machine-id: systemd writes it again from the kernel command
# line's systemd.machine_id= (EndeavourOS with systemd-boot); a different ID
# would orphan the ESP's /MACHINE-ID/ directory and loader entries.
# mimeinfo.cache: openSUSE rebuilds it at boot after the restore.
# entry-token: the restore's bootctl install writes it again (Chimera, with
# systemd-boot), and the ESP's entries are under that name.  OpenRC's
# save-keymaps and save-termencoding (Gentoo's boot runlevel) save the
# console's keymap and encoding in its libexec dir at every boot: Gentoo's
# /usr/libexec/rc, Artix's /usr/lib/openrc (artix-20261118-105750).
# ld.so.cache: ldconfig.service (ConditionNeedsUpdate=/etc) remakes it at the
# first boot after anything touched /usr since etc/.updated, as bs1-adopt's
# package install does (avahi on cachyos-zfs under bs1-qemu): the restored
# copy's first boot runs it, and it has to come out the same.
# PikaOS's services write theirs at every start: tuned its profile files and
# modprobe.d entry, supergfxd its config and modprobe.d entry, and
# steam-repos-fix.service copies steamdeps into /usr/bin
# (pika-4-20261114-134728: 8 files, each only a new mtime).
# vmlinuz: Garuda's dracut-rebuild (dracut-install-garuda), which the
# restore's boot stage runs, copies each kernel to /boot again with dd
# (garuda-20261114-154812: only a new mtime; docs/design/garuda.md, GA7).
# The restore's update-initramfs -u -k all runs depmod, which writes each
# kernel's module indexes again, and on Pop!_OS kernelstub, which writes its
# configuration again: the same bytes, new mtimes (pop-24.04-20261120-021008:
# 11 files).  depmod's outputs by name, not modules.*, so modules.order and
# modules.builtin* from the package stay held; lib/modules for a /lib that
# isn't /usr's.
DEPMOD = ["modules.alias", "modules.alias.bin", "modules.builtin.alias.bin", "modules.builtin.bin", "modules.dep",
          "modules.dep.bin", "modules.devname", "modules.softdep", "modules.symbols", "modules.symbols.bin", "modules.weakdep"]
REMADE = ["etc/machine-id", "usr/share/applications/mimeinfo.cache", "etc/kernel/entry-token", "usr/libexec/rc/console/*", "usr/lib/openrc/console/*", "etc/ld.so.cache",
