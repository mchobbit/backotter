#!/bin/bash
# BackShot1: reboot into the rescue stick, once.  As root, on the running system.
#
# Makes a firmware boot entry for the stick's ESP, leaves it out of BootOrder, and
# points BootNext at it.  The firmware uses BootNext once and forgets it, so if the
# stick doesn't boot, the laptop comes back up as it was.  Nothing on the internal
# disk changes.  By efibootmgr, or without it (AerynOS packages none) by bs1-efi,
# through efivarfs, with the same bytes; BS1_EFI=efivarfs takes bs1-efi's way
# where efibootmgr is there too.  First, it stops unless the stick has the SSH
# keys that make it start sshd (check_stick_keys).  On FreeBSD, by base
# efibootmgr, behind bs1-lane's guard (bsd_to_stick, below).

# shellcheck disable=SC1091
. "$(dirname "$(readlink -f "$0")")/bs1-common"

LABEL="BKO rescue"

# The stick starts sshd only if its BACKOTTER partition lets a key in
# (stick/layer/usr/lib/backotter/key-access, which is silent without one).
# A reflashed stick has neither file, and booted it shows its menu with SSH
# off: the controller waited 7 min for nothing, twice (2026-11-21).  So both
# are checked before any boot variable changes: backotter/authorized_keys with
# a key line, as key-access reads it, and backotter/ssh_host_ed25519_key; and,
# where the drive has the ones bs1-adopt installs (backshot1/keys/, from
# `backshot1 stage`), that the controller's key is among them and the host
# key is the one the controller pins.
KEY_LINE='^(ssh-(ed25519|rsa)|ecdsa-sha2-[a-z0-9-]+|sk-[a-z0-9@.-]+) '
# Global, not local: the EXIT trap reads them after a die, and bash 3 (the
# Mac's, which runs the tests) has dropped a function's locals by then.
stick_kt='' stick_own=''
stick_cleanup() {
    [[ -n $stick_kt ]] || return 0
    # Never rm -r: $stick_kt/mnt may still be the stick.
    if [[ -n $stick_own ]]; then umount "$stick_kt/mnt" 2>/dev/null; rmdir "$stick_kt/mnt" 2>/dev/null; fi
    rm -f "$stick_kt/keys" "$stick_kt/want" "$stick_kt/host"
    rmdir "$stick_kt" 2>/dev/null
    stick_kt=''
}
check_stick_keys() {
    local kt cfg fix why=() pub m
    fix="on the Mac: stick/add-ssh-key.sh --host-key ~/.ssh/backshot1/ssh_host_ed25519_key /dev/<stick> ~/.ssh/backshot1/id_ed25519.pub (the stick, unmounted, as the Mac names it; here it's /dev/$disk), or copy id_ed25519.pub to BACKOTTER/backotter/authorized_keys and ssh_host_ed25519_key beside it"
    kt=$(mktemp -d) || die "can't make a temporary directory"
    stick_kt=$kt
    trap stick_cleanup EXIT
    # A desktop (udisks, /run/media/...) may have BACKOTTER mounted read-write
    # already, and Linux won't mount it read-only beside that: read it there.
    # findmnt -r writes a space as \x20.
    # FreeBSD: by mount -p, which writes a space as \040 (GhostBSD's desktop
    # may have it mounted).
    if [[ $OSTYPE == freebsd* ]]; then m=$(bsd_mount_of "$config")
    else m=$(findmnt -rno TARGET -S "$config" 2>/dev/null | head -n 1)
    fi
    if [[ -n $m ]]; then
        m=$(printf '%b' "$m")
        say "the stick's BACKOTTER ($config) is mounted at $m already: reading it there"
        cfg=$m/backotter
    else
        mkdir "$kt/mnt" || die "can't make a mount point in $kt"
        stick_own=1
        if [[ $OSTYPE == freebsd* ]]; then
            mount -t msdosfs -o ro,nosuid,noexec "$config" "$kt/mnt" || die "can't mount $config, the stick's BACKOTTER partition"
        else
            mount -t vfat -o ro,nosuid,nodev,noexec "$config" "$kt/mnt" || die "can't mount $config, the stick's BACKOTTER partition"
        fi
        cfg=$kt/mnt/backotter
    fi
    # FAT, perhaps edited on Windows: no carriage returns.
    tr -d '\r' 2>/dev/null <"$cfg/authorized_keys" | grep -E "$KEY_LINE" | cut -d' ' -f1,2 | sort -u >"$kt/keys"
    if [[ ! -s $kt/keys ]]; then
        why+=("no backotter/authorized_keys with a public key in it")
    elif [[ -s $HERE/keys/authorized_keys ]]; then
        tr -d '\r' <"$HERE/keys/authorized_keys" | grep -E "$KEY_LINE" | cut -d' ' -f1,2 | sort -u >"$kt/want"
        grep -qxFf "$kt/want" "$kt/keys" || why+=("backotter/authorized_keys hasn't the controller's key (the drive's backshot1/keys/authorized_keys)")
    else
        say "no backshot1/keys/authorized_keys on the drive: not checking that the stick lets the controller's key in"
    fi
    if ! grep -qs 'BEGIN OPENSSH PRIVATE KEY' "$cfg/ssh_host_ed25519_key"; then
        why+=("no backotter/ssh_host_ed25519_key holding an OpenSSH private key")
    elif [[ ! -s $HERE/keys/ssh_host_ed25519_key.pub ]]; then
        say "no backshot1/keys/ssh_host_ed25519_key.pub on the drive: not checking the stick's host key against the pinned one"
    elif ! command -v ssh-keygen >/dev/null; then
        say "no ssh-keygen here: not checking the stick's host key against the pinned one"
    else
        # ssh-keygen won't read a private key others may read, as FAT's are.
        (umask 077; tr -d '\r' <"$cfg/ssh_host_ed25519_key" >"$kt/host")
        pub=$(ssh-keygen -y -P '' -f "$kt/host" 2>/dev/null </dev/null | cut -d' ' -f1,2)
        if [[ -z $pub ]]; then
            why+=("backotter/ssh_host_ed25519_key isn't a key ssh-keygen can read")
        elif [[ $pub != "$(tr -d '\r' <"$HERE/keys/ssh_host_ed25519_key.pub" | cut -d' ' -f1,2)" ]]; then
            why+=("backotter/ssh_host_ed25519_key isn't the host key the controller pins (the drive's backshot1/keys/ssh_host_ed25519_key)")
        fi
    fi
    if [[ -n $stick_own ]]; then
        umount "$kt/mnt" || die "can't unmount $config"
        rmdir "$kt/mnt"
        stick_own=''
    fi
    stick_cleanup
    trap - EXIT
    if [[ ${#why[@]} -gt 0 ]]; then
        local w
        for w in "${why[@]}"; do say "the stick's BACKOTTER ($config): $w"; done
        die "the stick would boot with SSH off, so BootNext is left alone.  A reflashed stick needs its keys again: $fix"
    fi
    say "the stick's BACKOTTER ($config) has the SSH keys"
}

# FreeBSD (docs/design/freebsd-bs1.md): the same, by base efibootmgr, on the
# FreeBSD stick: BACKOTTER is /dev/msdosfs/BACKOTTER on a umass disk whose
# ident is STICK_SERIAL, and its ESP is MBR slice 1 (stick/freebsd/build.sh),
# found by slice, not by label.  Behind D3's guard (bs1-lane guard --lane).
# Every "BKO rescue" entry goes first (an older stick's, or the Linux
# lane's: the same NVRAM), then -a -c makes the new one, active (-c alone
# leaves it inactive), and BootOrder, which -c puts it at the head of, is
# set back as it was, so the entry is used by BootNext alone.
BSD_CONFIG=/dev/msdosfs/BACKOTTER

# bsd_mount_of DEV: where DEV (by any of its names: a label or the
# partition) is mounted, \040 for a space, or nothing.
bsd_mount_of() {
    local p src target _
    p=$(bsd_provider "$1")
    [[ -n $p ]] || return 0
    while read -r src target _; do
        [[ $src == /dev/* && $(bsd_provider "$src") == "$p" ]] || continue
        printf '%s\n' "$target"
        return 0
    done < <(bsd_mounts)
}

# FreeBSD's efibootmgr: "+Boot0004* FreeBSD" ("+" BootCurrent, "*" active),
# "BootOrder  : 0004, 0000", "BootNext : 0005".  An entry out of BootOrder
# (ours, once set up) comes after "Unreferenced Variables:" with its device
# path after the label: " Boot0009* BKO rescue HD(1,MBR,...)/File(...)".
bsd_entries() {
    efibootmgr | awk -v l="$LABEL" '
        match($0, /^[+ ]?Boot[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][* ] /) {
            d = substr($0, RSTART + RLENGTH); sub(/[ \t]+$/, "", d)
            if (d == l || index(d, l " ") == 1) print toupper(substr($0, RSTART + RLENGTH - 6, 4))
        }'
}
bsd_var() {
    efibootmgr | awk -v v="$1" '$0 ~ ("^" v " *:") { s = $0; sub(/^[^:]*:/, "", s); gsub(/[ \t]/, "", s); print toupper(s) }'
}

bsd_esp_mnt='' bsd_esp_own=''
bsd_esp_cleanup() {
    [[ -n $bsd_esp_own ]] || return 0
    umount "$bsd_esp_mnt" 2>/dev/null
    rmdir "$bsd_esp_mnt" 2>/dev/null
    bsd_esp_own=''
}

bsd_to_stick() {
    local internal esp found loader order n entry m ids
    [[ $(sysctl -n machdep.bootmethod 2>/dev/null) == UEFI ]] || die "this system wasn't booted by UEFI (machdep.bootmethod)"
    command -v efibootmgr >/dev/null || die "no efibootmgr here"
    efibootmgr >/dev/null 2>&1 || die "can't reach the firmware's variables (efibootmgr)"
    # D3: the internal disk, the lane drive and the stick, and nothing else.
    sh "$HERE/bs1-lane" guard --lane || die "bs1-lane's guard refused: BootNext is left alone"
    [[ -n ${STICK_SERIAL:-} ]] || die "bs1.conf has no STICK_SERIAL"

    # The stick is what holds the BACKOTTER configuration partition.
    config=$BSD_CONFIG
    [[ -e $config ]] || die "no stick here: nothing is labelled BACKOTTER ($config)"
    disk=$(disk_of "$config")
    if [[ -z $disk ]] || ! bsd_umass "$disk"; then die "BACKOTTER is on ${disk:-an unknown disk}, which isn't a USB disk"; fi
    ids=$(bsd_ident "$disk")
    [[ $ids == "$STICK_SERIAL" ]] || die "BACKOTTER is on $disk, whose ident ${ids:-(none)} isn't the stick's, $STICK_SERIAL"
    internal=$(internal_disk) || die "no single disk has serial $INTERNAL_SERIAL"
    [[ $disk != "$internal" ]] || die "the stick can't be the internal disk"
    check_stick_keys

    [[ $(bsd_scheme "$disk") == MBR ]] || die "$disk isn't sliced by MBR, as the FreeBSD stick is"
    esp=/dev/${disk}s1
    [[ $(fstyp "$esp" 2>/dev/null) == msdosfs ]] || die "$esp, the stick's slice 1, isn't FAT"
    # efibootmgr -l names the loader by its path in the mounted ESP.
    m=$(bsd_mount_of "$esp")
    if [[ -n $m ]]; then
        bsd_esp_mnt=$(printf '%b' "$m")
    else
        bsd_esp_mnt=$(mktemp -d) || die "can't make a temporary directory"
        bsd_esp_own=1
        trap bsd_esp_cleanup EXIT
        mount -t msdosfs -o ro "$esp" "$bsd_esp_mnt" || { bsd_esp_own=''; rmdir "$bsd_esp_mnt"; die "can't mount $esp"; }
    fi
    found=$(find "$bsd_esp_mnt" -maxdepth 3 -ipath "$bsd_esp_mnt/efi/boot/bootx64.efi" | head -n 1)
    [[ -n $found ]] || die "$esp has no EFI/BOOT/BOOTX64.EFI"
    loader=${found#"$bsd_esp_mnt"}

    order=$(bsd_var BootOrder)
    [[ -n $order ]] || die "the firmware has no BootOrder to put back after efibootmgr -c: nothing changed"
    # An older stick's entry names an ESP that's gone.
    for n in $(bsd_entries); do
        efibootmgr -B -b "$n" >/dev/null || die "can't delete Boot$n"
        order=$(tr ',' '\n' <<<"$order" | grep -vxF "$n" | paste -s -d , -)
    done
    [[ -n $order ]] || die "BootOrder had only $LABEL entries: none left to put back after efibootmgr -c"
    efibootmgr -a -c -l "$found" -L "$LABEL" >/dev/null || die "can't make a boot entry for $esp"
    bsd_esp_cleanup
    trap - EXIT
    entry=$(bsd_entries)
    [[ -n $entry && $entry != *$'\n'* ]] || die "the firmware didn't keep the new entry (Boot entries labelled $LABEL: ${entry:-none})"
    # -c put it first; the machine's own boot order stays as it was.
    efibootmgr -o "$order" >/dev/null || die "can't put BootOrder back ($order)"
    [[ $(bsd_var BootOrder) == "$order" ]] || die "BootOrder is $(bsd_var BootOrder), not $order as it was"
    efibootmgr -n -b "$entry" >/dev/null || die "can't set BootNext"
    n=$(bsd_var BootNext)
    [[ $n == "$entry" ]] || die "BootNext reads ${n:-nothing}, not $entry"
    efibootmgr | grep -E '^(BootNext|BootOrder)'
    efibootmgr -v | grep -A 2 -E "^[+ ]?Boot$entry"
    say "rebooting into the stick ($esp, ${loader//\//\\}), once"
    sync
    # After a moment, so the controller hears that this worked; daemon(8)
    # detaches it from the SSH session.
    daemon -f /bin/sh -c 'sleep 2; exec /sbin/shutdown -r now' </dev/null >/dev/null 2>&1
}
if [[ $OSTYPE == freebsd* ]]; then
    bsd_to_stick
    exit 0
fi

[[ -d /sys/firmware/efi ]] || die "this system wasn't booted by UEFI"
if [[ ${BS1_EFI:-} == efivarfs ]] || ! command -v efibootmgr >/dev/null; then via=efivarfs; else via=efibootmgr; fi
findmnt -rn /sys/firmware/efi/efivars >/dev/null || mount -t efivarfs efivarfs /sys/firmware/efi/efivars || die "can't reach the firmware's variables"

# The stick is what holds the BACKOTTER configuration partition.
config=$(blkid -L BACKOTTER) || die "no stick here: nothing is labelled BACKOTTER"
disk=$(disk_of "$config")
[[ -n $disk && $(lsblk -dno TRAN "/dev/$disk") == usb ]] || die "BACKOTTER is on $config, which isn't a USB disk"
internal=$(internal_disk) || die "no single disk has serial $INTERNAL_SERIAL"
[[ $disk != "$internal" ]] || die "the stick can't be the internal disk"

check_stick_keys

esp=$(lsblk -lnpo NAME,FSTYPE,LABEL "/dev/$disk" | awk '$2 == "vfat" && $3 == "ESP" { print $1; exit }')
[[ -n $esp ]] || die "/dev/$disk has no vfat partition labelled ESP"
part=$(cat "/sys/class/block/${esp##*/}/partition")

tmp=$(mktemp -d)
mount -o ro "$esp" "$tmp" || die "can't mount $esp"
found=$(find "$tmp" -maxdepth 3 -iname bootx64.efi | head -n 1)
umount "$tmp"
rmdir "$tmp"
[[ -n $found ]] || die "$esp has no BOOTX64.EFI"
loader=${found#"$tmp"}
loader=${loader//\//\\}

if [[ $via == efivarfs ]]; then
    # Deletes an older stick's entry, makes this one out of BootOrder at the
    # lowest free number, points BootNext at it, and reads each back.
    python3 "$HERE/bs1-efi" oneshot "$LABEL" "$esp" "$loader" || die "can't point BootNext at $esp through efivarfs"
    python3 "$HERE/bs1-efi" list | grep -E '^(BootNext|BootOrder)'
else
    # No {4}: Debian 12's mawk has no interval expressions, and would match nothing.
    HEX4='[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]'
    entries() { efibootmgr | awk -v l="$LABEL" "/^Boot$HEX4/"' && index($0, l) { print substr($1, 5, 4) }'; }

    # An older stick's entry names an ESP that's gone.
    for n in $(entries); do efibootmgr -q --bootnum "$n" --delete-bootnum || die "can't delete Boot$n"; done
    order=$(efibootmgr | awk '/^BootOrder/ { print $2 }')
    efibootmgr -q --create --disk "/dev/$disk" --part "$part" --label "$LABEL" --loader "$loader" || die "can't make a boot entry for $esp"
    # --create puts it first; the laptop's own boot order stays as it was, whatever follows.
    if [[ -n $order ]]; then efibootmgr -q --bootorder "$order" || die "can't put BootOrder back"; fi
    entry=$(entries | head -n 1)
    [[ -n $entry ]] || die "the firmware didn't keep the new entry"
    efibootmgr -q --bootnext "$entry" || die "can't set BootNext"
    efibootmgr | grep -E '^(BootNext|BootOrder)'
    efibootmgr | grep -E "^Boot$entry"
fi
say "rebooting into the stick ($esp, $loader), once"
# Ubuntu: unattended-upgrades.service holds the shutdown until a running
# unattended-upgrade finishes, and on a development release that run can
# spin for good ("Unattended-upgrade in progress" until the power button).
# The backup is taken; stop the run itself so the shutdown goes through.
if command -v systemctl >/dev/null 2>&1; then
    systemctl kill --signal=KILL apt-daily-upgrade.service apt-daily.service 2>/dev/null || true
fi
sync
# After a moment, so the controller hears that this worked.  -i: a desktop
# session's block inhibitor (GNOME's "user session inhibited") otherwise
# makes systemd 257+ refuse the reboot quietly.  Plain reboot where systemd
# isn't running.
(sleep 2; systemctl reboot -i || reboot) >/dev/null 2>&1 </dev/null &
