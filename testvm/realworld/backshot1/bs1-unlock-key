#!/bin/sh
# BackShot1: the LUKS key from the backup drive, at boot.  TESTBED ONLY: with
# the drive plugged in, anyone can unlock the disk (docs/design/bs1-luks-unattended.md).
#
# bs1-adopt installs it as /usr/local/lib/backshot1/unlock-key, and the
# initramfs carries it with /etc/backshot1/luks-unlock, the record it reads
# (label=, path=, fstype=, wait=, volumes="NAME:LUKS-UUID:HOW ...").  Two uses:
#
#   as a crypttab keyscript= (initramfs-tools: Debian, Ubuntu up to 25.04,
#   Chimera): prints the key for $CRYPTTAB_NAME on stdout.  The first try
#   ($CRYPTTAB_TRIED 0) waits up to wait= seconds for LABEL=label and reads
#   path= on it; every other case asks, as the volume did before, with
#   cryptsetup's askpass.  A wrong key costs one of crypttab's tries=.
#   On sysvinit, Debian's cryptdisks-early and cryptdisks init scripts run
#   it the same way for the volumes the booted system opens (MX Linux's
#   /home), from the root file system, with the booted system's own mount,
#   modprobe and udev's by-label links (libblkid's blkid -L should there be
#   none).  Where it took the place of Debian's decrypt_keyctl (MX Linux's
#   installer), a typed boot asks for each volume: decrypt_keyctl's one
#   passphrase kept for every volume is gone while BackShot1's is there.
#   Once a boot found no drive (or no key on it), the next volume asks at
#   once, without waiting again: /run, with its mark, carries over from the
#   initramfs to cryptdisks-early.
#
#   unlock-key --to FILE (mkinitcpio's bs1key hook, before encrypt): writes
#   the key to FILE (/crypto_keyfile.bin), which encrypt then tries before
#   it asks.  Only a key that opens the record's volume is left there.
#
#   unlock-key --zfs ENCROOT (family Z: ZFSBootMenu's load-key.d hook, which
#   bs1-luks makes from this file with the record's values set at its top,
#   BS1_UNLOCK_SET=1, since ZFSBootMenu's own initramfs has no
#   /etc/backshot1): loads the key of the ZFS encryption root ENCROOT with
#   `zfs load-key -L file://...` from the drive.  Always exits 0: without
#   the drive, or with a key that doesn't fit, ZFSBootMenu asks as before.
#   Once a boot found no drive, a second encryption root doesn't wait again.
#
#   unlock-key --booster-fifos, then --booster in the background (family P:
#   booster, PikaOS; the kernel runs BackShot1's booster-preinit first, by
#   rdinit=, which runs these with busybox, then execs booster's /init):
#   --booster-fifos makes a FIFO /backshot1-key.UUID for each of the
#   record's P volumes, the key file booster's rd.luks.key=UUID=PATH names;
#   --booster, once booster has mounted /run, waits up to wait= seconds for
#   the drive and writes its key into each FIFO, which booster is waiting
#   to read, then marks NAME drive; without the drive it writes nothing
#   (booster asks at once) and marks NAME typed.  A key that doesn't fit
#   shows in the kernel's log, where booster says so (bs1-common).
#
#   unlock-key --keystore, then --keystore-done (family S's Ubuntu ZFS
#   keystore, volume HOW K: BackShot1's dracut module's pre-mount hooks 85
#   and 95, either side of the zfs module's 90-zfs-load-key.sh, which opens
#   keystore-POOL with `systemd-cryptsetup attach` and no key file):
#   --keystore copies the drive's key to /run/cryptsetup-keys.d/NAME.key
#   for each of the record's K volumes, where systemd-cryptsetup looks
#   before it asks; --keystore-done marks NAME drive when the volume is open
#   and that key opens /dev/zvol/POOL/keystore (else typed: the prompt took
#   it; fetched when cryptsetup can't tell), and removes the key.  Both
#   always exit 0.
#
# Each use adds "NAME drive" or "NAME typed" to /run/backshot1-unlock,
# which the initramfs hands on to the booted system (family Z: ZFSBootMenu's
# boot-sel.d hook puts it on the booted kernel's command line, bs1.zbm=);
# bs1-verify reads the last line for each volume.  Plain POSIX sh: busybox
# or klibc's in the initramfs (bash in ZFSBootMenu's).  Messages go to
# stderr; a keyscript's stdout is the key.

# BS1_UNLOCK_ROOT: a directory standing in for /, for the unit tests only.
R=${BS1_UNLOCK_ROOT:-}
REC=$R/etc/backshot1/luks-unlock
if [ -z "${BS1_UNLOCK_SET:-}" ]; then
    label='' path='' fstype=ext4 wait=30 volumes=''
    # shellcheck disable=SC1090
    [ -r "$REC" ] && . "$REC"
fi
MARK=$R/run/backshot1-unlock
MNT=$R/run/backshot1-keydev
NODRIVE=$R/run/backshot1-nodrive
KEYS_D=$R/run/cryptsetup-keys.d

mark() { mkdir -p "${MARK%/*}" 2>/dev/null; echo "$1 $2" >>"$MARK"; }
# The drive's device is there (in a test, a file stands in for it).
present() { [ -b "$1" ] || { [ -n "$R" ] && [ -f "$1" ]; }; }

# fetch OUT: copies the key file from the drive to OUT; false if there's no
# drive within wait= seconds or no key on it.
fetch() {
    [ -n "$label" ] && [ -n "$path" ] || return 1
    dev=$R/dev/disk/by-label/$label
    if ! present "$dev"; then
        # The USB drivers first, where nothing loads them by itself.
        for m in xhci_pci ehci_pci usb_storage uas sd_mod; do modprobe -q "$m" >/dev/null 2>&1; done
        echo "BackShot1: waiting up to $wait s for the backup drive $label" >&2
        i=0
        while ! present "$dev" && [ "$i" -lt "$wait" ]; do
            sleep 1
            i=$((i + 1))
            # By libblkid too, should udev make no by-label link
            # (ZFSBootMenu; the booted system, for cryptdisks).  Not in
            # the unit tests' fake root, but for --zfs's.
            if { [ "$mode" = zfs ] || [ "$mode" = booster ] || [ -z "$R" ]; } && ! present "$dev"; then
                d=$(blkid -L "$label" 2>/dev/null) && [ -b "$d" ] && dev=$d
                # busybox's findfs: booster makes no by-label links, and
                # busybox's blkid has no -L.
                if ! present "$dev"; then
                    d=$(findfs "LABEL=$label" 2>/dev/null) && present "$d" && dev=$d
                fi
            fi
        done
    fi
    present "$dev" || { echo "BackShot1: no backup drive $label; asking instead" >&2; return 1; }
    for m in usb_storage uas sd_mod "$fstype"; do modprobe -q "$m" >/dev/null 2>&1; done
    # noload, norecovery: an unclean journal or log isn't replayed onto the drive.
    opts=ro
    case $fstype in ext3 | ext4) opts=ro,noload ;; xfs) opts=ro,norecovery ;; esac
    mkdir -p "$MNT" || return 1
    mount -t "$fstype" -o "$opts" "$dev" "$MNT" 2>/dev/null || { rmdir "$MNT" 2>/dev/null; echo "BackShot1: can't mount $dev" >&2; return 1; }
    rc=1
    if [ -s "$MNT$path" ] && cat "$MNT$path" >"$1"; then rc=0; fi
    umount "$MNT" 2>/dev/null
    rmdir "$MNT" 2>/dev/null
    [ $rc -eq 0 ] || echo "BackShot1: no key at $path on $label; asking instead" >&2
    return $rc
}

askpass() {
    for a in "$R/lib/cryptsetup/askpass" "$R/usr/lib/cryptsetup/askpass"; do
        [ -x "$a" ] && exec "$a" "$1"
    done
    echo "BackShot1: no askpass" >&2
    exit 1
}

umask 077
mode=keyscript
case ${1:-} in
--to) mode=to ;; --zfs) mode=zfs ;; --keystore) mode=keystore ;; --keystore-done) mode=keystore-done ;;
--booster-fifos) mode=booster-fifos ;; --booster) mode=booster ;;
esac

# Family P (booster, PikaOS): each P volume's key file, the FIFO
# BOOSTER_KEY.UUID that rd.luks.key=UUID=/backshot1-key.UUID names, in the
# initramfs's own root (booster wipes it before switching root).
BOOSTER_KEY=$R/backshot1-key
# give FROM FIFO: FROM's bytes through FIFO, once booster opens it to read
# (it does as soon as the volume appears); given up after GIVE_WAIT s, when
# it never does.
GIVE_WAIT=${BS1_GIVE_WAIT:-600}
give() {
    if command -v timeout >/dev/null 2>&1; then
        timeout "$GIVE_WAIT" sh -c 'exec cat "$1" >"$2"' sh "$1" "$2"
    else
        sh -c 'exec cat "$1" >"$2"' sh "$1" "$2"
    fi
}
p_volumes() {
    for v in $volumes; do
        [ "${v##*:}" = P ] || continue
        u=${v#*:}
        echo "${v%%:*} ${u%%:*}"
    done
}

if [ $mode = booster-fifos ]; then
    p_volumes | while read -r name uuid; do
        rm -f "$BOOSTER_KEY.$uuid"
        mkfifo -m 600 "$BOOSTER_KEY.$uuid" || echo "BackShot1: no $BOOSTER_KEY.$uuid; booster will ask for $name" >&2
    done
    exit 0
fi

if [ $mode = booster ]; then
    # booster's own /proc, /dev and /run first (it mounts them as it
    # starts): the marks go into the /run it moves into the booted system.
    i=0
    while ! grep -qs ' /run ' "$R/proc/mounts" && [ "$i" -lt 100 ]; do
        sleep 0.1 2>/dev/null || sleep 1
        i=$((i + 1))
    done
    tmp=$R/backshot1-key.tmp
    got=no
    fetch "$tmp" && got=yes
    p_volumes | {
    while read -r name uuid; do
        f=$BOOSTER_KEY.$uuid
        (
            if [ ! -p "$f" ]; then
                mark "$name" typed
            elif [ $got = yes ] && give "$tmp" "$f"; then
                # Booster tries it, and says so in the kernel's log if it
                # doesn't fit (bs1-common's unlock_how P).
                echo "<5>BackShot1: $name: the backup drive's key, handed to booster" >"$R/dev/kmsg" 2>/dev/null
                mark "$name" drive
            else
                # No key: an empty one, so booster asks at once.
                [ $got = yes ] || give /dev/null "$f"
                mark "$name" typed
            fi
            rm -f "$f"
        ) &
    done
    wait
    }
    rm -f "$tmp"
    exit 0
fi

if [ $mode = keystore ] || [ $mode = keystore-done ]; then
    ks=''
    for v in $volumes; do
        [ "${v##*:}" = K ] && ks="$ks ${v%%:*}"
    done
    [ -n "$ks" ] || exit 0
    if [ $mode = keystore ]; then
        tmp=$R/run/backshot1-key.$$
        if fetch "$tmp" && mkdir -p "$KEYS_D"; then
            for n in $ks; do
                cat "$tmp" >"$KEYS_D/$n.key" && echo "BackShot1: the backup drive's key is systemd-cryptsetup's for $n" >&2
            done
        else
            for n in $ks; do mark "$n" typed; done
        fi
        rm -f "$tmp"
        exit 0
    fi
    for n in $ks; do
        f=$KEYS_D/$n.key
        [ -f "$f" ] || continue
        if present "$R/dev/mapper/$n"; then
            # Exit 2 is "no key slot opened": the drive's key didn't fit, so
            # systemd-cryptsetup asked.
            cryptsetup open --test-passphrase --key-file "$f" "$R/dev/zvol/${n#keystore-}/keystore" >/dev/null 2>&1
            rc=$?
            if [ $rc -eq 0 ]; then
                mark "$n" drive
            elif [ $rc -eq 2 ]; then
                echo "BackShot1: the drive's key doesn't open $n; it was asked for" >&2
                mark "$n" typed
            else
                mark "$n" fetched
            fi
        else
            mark "$n" typed
        fi
        rm -f "$f"
    done
    rmdir "$KEYS_D" 2>/dev/null
    exit 0
fi

if [ $mode = zfs ]; then
    root=${2:-}
    [ -n "$root" ] || { echo "BackShot1: usage: unlock-key --zfs ENCROOT" >&2; exit 0; }
    # Loaded already (by another hook, or a key file): nothing to do.
    [ "$(zfs get -H -o value keystatus "$root" 2>/dev/null)" = available ] && exit 0
    tmp=$R/run/backshot1-key.$$
    if [ -e "$NODRIVE" ]; then
        mark "$root" typed
    elif fetch "$tmp"; then
        if zfs load-key -L "file://$tmp" "$root" >/dev/null 2>&1; then
            echo "BackShot1: $root unlocked with the backup drive's key" >&2
            mark "$root" drive
        else
            echo "BackShot1: the drive's key doesn't open $root; asking instead" >&2
            mark "$root" typed
        fi
    else
        : >"$NODRIVE"
        mark "$root" typed
    fi
    rm -f "$tmp"
    exit 0
fi

if [ $mode = to ]; then
    out=${2:?usage: unlock-key --to FILE}
    rm -f "$out"
    tmp=$R/run/backshot1-key.$$
    if fetch "$tmp"; then
        for v in $volumes; do
            name=${v%%:*} uuid=${v#*:}
            uuid=${uuid%%:*}
            [ "${v##*:}" = E ] || continue
            # Exit 2 is "no key slot opened": the key is wrong, so encrypt
            # gets no file and asks at once.  Any other failure leaves it to
            # encrypt to try.
            cryptsetup open --test-passphrase --key-file "$tmp" "/dev/disk/by-uuid/$uuid" >/dev/null 2>&1
            rc=$?
            if [ $rc -eq 0 ]; then
                cat "$tmp" >"$out" && mark "$name" drive
            elif [ $rc -eq 2 ]; then
                echo "BackShot1: the drive's key doesn't open $name; asking instead" >&2
                mark "$name" typed
            else
                cat "$tmp" >"$out" && mark "$name" fetched
            fi
            break
        done
    else
        for v in $volumes; do [ "${v##*:}" = E ] && mark "${v%%:*}" typed && break; done
    fi
    rm -f "$tmp"
    exit 0
fi

name=${CRYPTTAB_NAME:-unknown}
if [ "${CRYPTTAB_TRIED:-0}" = 0 ] && [ ! -e "$NODRIVE" ]; then
    tmp=$R/run/backshot1-key.$$
    if fetch "$tmp"; then
        cat "$tmp"
        rc=$?
        rm -f "$tmp"
        [ $rc -eq 0 ] && mark "$name" drive && exit 0
    else
        : >"$NODRIVE"
    fi
    rm -f "$tmp"
fi
mark "$name" typed
askpass "Please unlock disk $name: "
