#!/bin/bash
# BackShot1: did the restored system come back?  As root, on the restored system.
#
# Usage: bs1-verify RUN
#        bs1-verify --boot RUN     ostree: check the deployment this boot started
#        bs1-verify --unlock       how this boot opened the LUKS volumes: UNLOCK=...
#
# Checks the run's newest restore, which has to have succeeded: an older attempt's
# success says nothing about what's on the disk now.  Exit 0 only if every check
# passed.  Writes verify.log and RESULT beside that restore's logs.
#
# On ostree (docs/design/bazzite.md) it also holds the updaters off and fails
# if one ran since the boot, then compares the files, then the deployments
# with the baseline's deployments.txt: the booted one by checksum and serial,
# ostree admin status, the BLS entries, link counts, the deployment roots'
# flags, btrfs space, ostree fsck, bootupd and grubenv.  --boot, after the
# main check, checks a boot of the restored rollback (or of the default
# again) against the baseline's record of that deployment: its kargs,
# hostname and SELinux, and that the deployments haven't moved.  It writes
# boot-STAMP.log and a line in BOOTS.
#
# When the baseline's unlock.txt says drive, each LUKS volume it lists as
# opened by the backup drive's key must have been opened that way at this
# boot too, not typed (unlock_mode in bs1-common).  --unlock prints that
# alone, for the preflight and the rehearsal, with no run: exit 0 if the
# mode is drive, own or none.

# shellcheck disable=SC1091
. "$(dirname "$(readlink -f "$0")")/bs1-common"

if [[ ${1:-} == --unlock ]]; then
    disk=$(internal_disk) || { echo "no single disk has serial $INTERNAL_SERIAL" >&2; exit 2; }
    unlock=$(unlock_mode "$disk")
    printf '%s\n' "$unlock"
    echo "UNLOCK=${unlock%%:*}"
    [[ ${unlock%%:*} =~ ^(drive|own|none)$ ]]
    exit
fi
BOOT_CHECK=no
if [[ ${1:-} == --boot ]]; then BOOT_CHECK=yes; shift; fi
RUN=$RUNS/${1:?usage: bs1-verify [--boot] RUN}
ATTEMPT=$(ls -d "$RUN"/restores/*[0-9] 2>/dev/null | tail -n 1)
[[ -n $ATTEMPT && -f $ATTEMPT/RESTORED ]] || { echo "$RUN's newest restore (${ATTEMPT:-none}) didn't finish" >&2; exit 2; }
if [[ $BOOT_CHECK == yes ]]; then
    is_ostree || { echo "--boot is for an ostree system's deployments" >&2; exit 2; }
    [[ -s $ATTEMPT/RESULT ]] || { echo "bs1-verify $1 hasn't checked this restore yet" >&2; exit 2; }
    LOG=$ATTEMPT/boot-$(date -u +%Y%m%d-%H%M%S).log
else
    LOG=$ATTEMPT/verify.log
fi
: >"$LOG"
say "checking restore $(basename "$ATTEMPT") of $(basename "$RUN")"
fails=0
check() {       # check WHAT COMMAND...
    local what=$1; shift
    if "$@" >>"$LOG" 2>&1; then say "  ok    $what"; else say "  FAIL  $what"; fails=$((fails + 1)); fi
}
trap drop_tree EXIT

system_settled() {
    local s= i
    command -v systemctl >/dev/null || { echo no-systemd; return 0; }
    for i in $(seq 60); do
        s=$(systemctl is-system-running 2>/dev/null)
        [[ $s == running || $s == degraded ]] && { echo "$s"; return 0; }
        sleep 5
    done
    echo "${s:-unknown}"
    return 1
}
# The updaters stopped for this boot, then: did one run since it started?
hold_updates() {
    local u t
    for u in $UPDATERS; do
        for t in timer service; do
            if systemctl is-active -q "$u.$t"; then systemctl stop "$u.$t"; say "stopped $u.$t for this boot"; fi
        done
    done
}
updaters_quiet() {
    local u ran=
    for u in $UPDATERS; do ran+=$(journalctl -b -q --no-pager -u "$u.service" 2>/dev/null); done
    [[ -z $ran ]] || { echo "the journal since this boot:"; tail -n 20 <<<"$ran"; return 1; }
}
OSTREE_TOOL=$HERE/bs1-ostree
rpm_ostree_same() {
    diff <(grep '^rpm-ostree ' "$RUN/baseline/deployments.txt") <(python3 "$OSTREE_TOOL" rpm-ostree)
}
packages_same() { package_list | cmp - "$RUN/baseline/packages.txt"; }
swap_same() {
    local how=
    grep -qs '^/dev/dm-' "$RUN/baseline/swap-names.txt" && how=raw
    swap_names ${how:+"$how"} | cmp - "$RUN/baseline/swap-names.txt"
}
# From the firmware's variables themselves: AerynOS has no efibootmgr to ask.
booted_the_restored_esp() {
    local guids
    guids=$(lsblk -lno PARTUUID,PARTTYPE "/dev/$disk" | awk -v t="$ESP_TYPE" 'tolower($2) == t { print $1 }')
    [[ -n $guids ]] || return 1
    findmnt -rn /sys/firmware/efi/efivars >/dev/null || mount -t efivarfs efivarfs /sys/firmware/efi/efivars || return 1
    # shellcheck disable=SC2086
    python3 - $guids <<'PY'
import sys, uuid
root, guid = "/sys/firmware/efi/efivars", "8be4df61-93ca-11d2-aa0d-00e098032b8c"
# Each variable starts with four bytes of attributes.
current = int.from_bytes(open(f"{root}/BootCurrent-{guid}", "rb").read()[4:6], "little")
entry = open(f"{root}/Boot{current:04X}-{guid}", "rb").read()
start = 10
while entry[start:start + 2] != b"\0\0":
    start += 2
name = entry[10:start].decode("utf-16-le", "replace")
# The device path follows the description: is there a partition in it?
i, end, names_partition = start + 2, start + 2 + int.from_bytes(entry[8:10], "little"), False
while i + 4 <= end and entry[i] != 0x7f:
    names_partition |= entry[i] == 4 and entry[i + 1] == 1
    step = int.from_bytes(entry[i + 2:i + 4], "little")
    if step < 4:
        break
    i += step
print(f"BootCurrent: {current:04X} ({name}), the disk's ESP: {' '.join(sys.argv[1:])}, entry: {entry[4:].hex()}")
if any(uuid.UUID(g).bytes_le in entry for g in sys.argv[1:]):
    sys.exit(0)
# AerynOS installs its loader without a boot entry, so the firmware makes one for
# the whole disk and takes the removable-media path.  Which disk is checked apart.
sys.exit(1 if names_partition else 0)
PY
}

state=$(system_settled)
say "system state: $state"

if [[ $BOOT_CHECK == yes ]]; then
    step "this boot's deployment, against the baseline"
    disk=$(internal_disk) || { say "no single disk has serial $INTERNAL_SERIAL"; exit 1; }
    hold_updates
    check "no updater ran since this boot" updaters_quiet
    check "/sysroot is on the restored $disk" on_disk "$(root_source)" "$disk"
    python3 "$OSTREE_TOOL" boot-check "$RUN/baseline/deployments.txt" >"$LOG.check" 2>&1
    rc=$?
    tee -a "$LOG" <"$LOG.check"
    [[ $rc -eq 0 ]] || fails=$((fails + 1))
    which=$(sed -n '1s/^booted: the \([a-z]*\) deployment .*/\1/p' "$LOG.check")
    rm -f "$LOG.check"
    if [[ $fails -eq 0 ]]; then r=PASS; else r="FAIL: $fails checks"; fi
    echo "$(basename "$LOG" .log) ${which:-unknown}: $r" >>"$ATTEMPT/BOOTS"
    printf '\n' | tee -a "$LOG"
    say "BOOT: ${which:-unknown}: $r"
    [[ $fails -eq 0 ]]
    exit
fi

step "the checks"
disk=$(internal_disk) || { say "no single disk has serial $INTERNAL_SERIAL"; exit 1; }
# Mounts an ESP that's on an automount.
ls /boot/efi /efi /boot >/dev/null 2>&1
hold_snapshotters
if is_ostree; then
    # First, so nothing stages a deployment while the rest is compared.
    hold_updates
    check "no updater ran since this boot" updaters_quiet
    check "rpm-ostree's deployments are the baseline's: none staged or new" rpm_ostree_same
fi
check "hostname is $SOURCE_HOST" test "$(this_host)" == "$SOURCE_HOST"
check "$(root_mount) is on the restored $disk" on_disk "$(root_source)" "$disk"
check "this isn't the rescue stick" test ! -f /cdrom/.disk/backotter.json
check "the boot finished" test "$state" != unknown
failed_units >"$ATTEMPT/failed-units-after.txt"
new_failed=$(comm -13 "$RUN/baseline/failed-units.txt" "$ATTEMPT/failed-units-after.txt")
[[ -z $new_failed ]] || say "failed since the backup: $new_failed"
check "no unit fails that didn't before the backup" test -z "$new_failed"
check "the same swap is in use" swap_same
check "the restore's log is on the restored system" test -d /var/log/bko-holt
if [[ -d /sys/firmware/efi ]]; then
    check "firmware booted the restored ESP's entry" booted_the_restored_esp
fi
check "the package list is unchanged" packages_same
# bs1-restore --reformat: each filesystem it names is that type now.
reformatted=
if [[ -s $ATTEMPT/reformat ]]; then
    reformatted=--reformatted
    while IFS='=' read -r m ty; do
        check "$m is $ty now" test "$(findmnt -nro FSTYPE -M "$m")" = "$ty"
    done <"$ATTEMPT/reformat"
fi
# The baseline's volumes the drive's key opened: so must it now, at the
# restored system's boot, from its remade initramfs (a baseline older than
# this has no unlock.txt).
if [[ $(head -n 1 "$RUN/baseline/unlock.txt" 2>/dev/null) == drive:* ]]; then
    unlock_now=$(unlock_mode "$disk")
    printf '%s\n' "$unlock_now" >"$ATTEMPT/unlock-after.txt"
    while read -r name how; do
        [[ $how == drive ]] || continue
        check "LUKS $name was opened by the backup drive's key, not typed" grep -qx "  $name drive" "$ATTEMPT/unlock-after.txt"
    done < <(tail -n +2 "$RUN/baseline/unlock.txt")
fi
# Where GRUB names its LV by UUID, before or now: the restored LV's, in every
# EFI binary that embeds one (a baseline older than this has no lvmid.txt).
lvmid_record >"$ATTEMPT/lvmid-after.txt" 2>&1
if grep -qs '^EMBED ' "$ATTEMPT/lvmid-after.txt" "$RUN/baseline/lvmid.txt"; then
    check "GRUB's embedded lvmid is /boot/grub's restored LV, $(awk '$1 == "GRUBLV" { print $3 " " $2 }' "$ATTEMPT/lvmid-after.txt"), in $(grep -c '^EMBED ' "$ATTEMPT/lvmid-after.txt") EFI binaries" lvmid_ok "$ATTEMPT/lvmid-after.txt"
fi

step "the layout, as the restored system sees it"
check "bko-holt dump works" sh -c "'$BIN/bko-holt' dump --only-disk '$disk' >'$ATTEMPT/after.json'"

step "the files, against the manifest from before the backup"
# On ostree the tree is laid out from a dump: the restored system's own, else
# the backup's.
tree_layout=$ATTEMPT/after.json
python3 -c 'import json, sys; json.load(open(sys.argv[1]))' "$tree_layout" 2>/dev/null || tree_layout=$RUN/layout.json
make_tree "$disk" "$tree_layout"
must python3 "$HERE/bs1-manifest" "$TREE" "$ATTEMPT/manifest-after.tsv"
python3 "$HERE/bs1-manifest" --compare "$RUN/baseline/manifest.tsv" "$ATTEMPT/manifest-after.tsv" ${reformatted:+"$reformatted"} 2>&1 | tee "$ATTEMPT/compare.txt" | tee -a "$LOG" | tail -n 40
[[ ${PIPESTATUS[0]} -eq 0 ]] || { say "  FAIL  files differ outside what a boot changes (compare.txt)"; fails=$((fails + 1)); }

if is_ostree; then
    step "the deployments, against the baseline's"
    B=$RUN/baseline O=$ATTEMPT/ostree
    mkdir -p "$O"
    python3 "$OSTREE_TOOL" record "$TREE" >"$O/deployments.txt" 2>>"$LOG"
    python3 "$OSTREE_TOOL" links "$TREE" >"$O/links.txt" 2>>"$LOG"
    python3 "$OSTREE_TOOL" space "$TREE" >"$O/space.txt" 2>>"$LOG"
    same() { diff <(grep "^$1 " "$B/deployments.txt") <(grep "^$1 " "$O/deployments.txt"); }
    # One-sided: compression makes a good restore smaller; broken hard links
    # would make it about three times as big.
    space_within() {
        awk 'NR == FNR { b[$1] = $2; next }
             { seen[$1] = 1; printf "%s: %d bytes before, %d after\n", $1, b[$1], $2; if (!($1 in b) || $2 > b[$1] * 1.05) bad = 1 }
             END { for (u in b) if (!(u in seen)) { print u ": not in the tree"; bad = 1 }; exit bad }' "$B/space.txt" "$O/space.txt"
    }
    no_boot_counter() { ! grep '^grubenv boot_counter=' "$O/deployments.txt"; }
    at_latest() { grep -x 'bootupctl At latest version' "$O/deployments.txt"; }
    check "the booted deployment is the baseline's, checksum and serial: $(sed -n 's/^booted //p' "$O/deployments.txt")" same booted
    check "/ is a composefs overlay" test "$(findmnt -no FSTYPE,SOURCE /)" == "overlay composefs"
    check "SELinux is as before: $(sed -n 's/^selinux //p' "$O/deployments.txt")" same selinux
    check "ostree admin status is the baseline's: deployments, order, pins" same status
    check "the deployments and their hostnames are the baseline's" same deployment
    check "each BLS entry's options line is the baseline's" same entry
    check "/boot/loader is the baseline's: $(sed -n 's/^loader //p' "$O/deployments.txt")" same loader
    check "the kernel command line is the baseline's" same cmdline
    check "the regular files' link counts are the baseline's, per filesystem" diff "$B/links.txt" "$O/links.txt"
    check "the deployment roots' flags (lsattr -d) are the baseline's" same lsattr
    check "each btrfs filesystem uses at most 5% more than before" space_within
    check "ostree fsck passes (every object's checksum)" sh -c "ostree fsck >'$O/fsck.txt' 2>&1"
    check "rpm-ostree status works" rpm-ostree status
    check "bootupctl status says At latest version" at_latest
    check "bootupd-state.json is the baseline's" same bootupd-state
    check "grubenv has no boot_counter" no_boot_counter
fi

if [[ $fails -eq 0 ]]; then r=PASS; else r="FAIL: $fails checks"; fi
echo "$r" >"$ATTEMPT/RESULT"
printf '\n' | tee -a "$LOG"
say "RESULT: $r"
[[ $fails -eq 0 ]]
