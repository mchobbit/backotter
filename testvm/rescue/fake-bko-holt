#!/usr/bin/env python3
"""A fake bko-holt for bko-rescue's pty runs (rescue-tui.md, RT8): it
replays a scenario directory, and checks the key files it is handed.

The scenario is $FAKE_BKO_HOLT_SCENARIO, else scenarios/demo beside this
file.  Each subdirectory is one call, tried in name order; the first
whose `argv` matches answers:

    argv     the arguments after the program's name, one a line, each an
             fnmatch pattern (`sda3_crypt=*`); the whole argv must match
    stdout   written first, as it is (a plan --json, a status --json)
    events   streamed line by line to stdout, each flushed: one JSON
             object a line, as `load --json` writes them; `sleep SECS`
             waits, `delay SECS` sets the wait after each event (default
             0.05), and `#` lines are comments
    stderr   written after the events
    exit     the exit status (default 0)
    stdin    the call matches only when standard input holds these words:
             both read as recovery words are (split at white space and
             commas, lower case, numbers before them left out), and a word
             of 4 letters or more typed matches the file's word it begins
             (BIP39's words differ in their first 4 letters, so bko-holt
             completes it the same way; the file holds the words in full),
             so `recovery-words` (RT10p) answers by the words bko-rescue
             sends; standard input is read once, at most 1 KiB
    out      written, when the call answers, to the OUT its argv names
             (argv[1], as `recovery-words OUT` and `recovery-key-file
             OUT` take it, or `--output FILE`'s, as report-bug's): a new
             file (O_EXCL, 0600) in a directory of ours with mode 0700,
             as bko-holt writes it, else a failed check; then watched as
             a key file is (below)
    password the call matches only when the `--password-file` it is
             given holds exactly these bytes, so one scenario answers a
             right password and a wrong one (a later call without this
             file); the fake as rustic-bko (`fake-rustic-bko`) uses it

With $FAKE_BKO_HOLT_STATE naming a file, the calls of a whole run are
answered in order, as a recorded run (scenarios/rec-*) needs, where one
argv is asked again and the answer moved on (status after each stage, the
plan before each): the first matching call not answered yet in this run
answers, and is added to the file (one name a line); once every matching
call has, the last of them answers again.  Without it each call is
answered alone, the first match always.

The events are holt-json.md's `bko-holt-events`, the documents its
`bko-holt-plan`, `-status` and `-error`; holt_schema.py checks every
scenario against the same schema bko-holt's goldens pass (scenarios/README.md
says which are hand-written and which recorded).

Before it answers, it checks each `--key-file NAME=PATH` and
`--password-file PATH`: an absolute path to a regular file (not a
symlink), mode 0600, ours, in a directory that is ours with mode 0700, not
empty, at most 1 KiB, with no newline, and with its text nowhere in argv
or the environment: not a whole argument, the PATH of a NAME=PATH or a
whole environment value, nor, for a key of 8 bytes or more, inside one
(a short key is in many words by chance: "e" in "--key-file").

With BKO_HOLT_NO_COMMIT set to anything but empty or 0 (holt-json.md, J12),
`--commit` is refused as bko-holt refuses it: exit 2, bko-holt's line on
stderr and, under --json, a `bko-holt-error` document (code `no_commit`) on
stdout.  A failed check is exit 97 and a line on stderr; no call matching is
exit 98.

A `load` call's events are streamed with `start`'s pid made this process's
own, so bko-rescue's stop reaches the fake.  SIGTERM while they stream ends
them as bko-holt's stop does (holt-json.md, J7): a command running (a `cmd`
without `would` and its `cmd_done`) gets its `cmd_done` with status 130, the
archiver's under SIGINT, then `stopping` and `end` with `stopped` true, exit
5.  With $FAKE_BKO_HOLT_RUN_DIR naming a directory, it stands for bko-holt's
RUN_DIR: an api document's `run_dir` says it, and a `--commit` load holds
RUN_DIR/load.lock while it streams, `{"pid": N, "start": S}` (S /proc's
starttime, as bko-holt's on Linux), taken with O_EXCL and removed at its
end.

It then leaves a watcher behind that waits for this process to be gone
and checks each key file is removed within $FAKE_BKO_HOLT_REMOVE_SECS
(default 10).  Everything goes to $FAKE_BKO_HOLT_LOG, if set, a JSON
object a line: {"call", "argv", "keys": [{"path", "bytes", "sha256"}],
"checks": [...], "ok"} (and "stdin_sha256" when standard input was read;
an OUT written is among the keys, with "out": true), then {"removed":
PATH, "secs"} or {"left": PATH} for each key.  A key's text, the words
and an OUT's text are never written there, only their hashes.

Python's stdlib only.
"""

import fnmatch
import hashlib
import json
import os
import re
import signal
import stat
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
KEY_MAX = 1024
# The bko-holt whose protocol the fake speaks (its error documents' version).
VERSION = "0.2.6"
# A key at least this long is looked for inside values too.
INSIDE_MIN = 8


def holds(key, values):
    """Whether one of `values` is `key`, or has it inside when the key is
    long enough that it isn't there by chance."""
    for v in values:
        v = v.encode(errors="surrogateescape")
        if v == key or (len(key) >= INSIDE_MIN and key in v):
            return True
    return False


def log(obj):
    path = os.environ.get("FAKE_BKO_HOLT_LOG")
    if not path:
        return
    fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
    try:
        os.write(fd, (json.dumps(obj, sort_keys=True) + "\n").encode())
    finally:
        os.close(fd)


def key_paths(argv):
    """The files a key or password was handed on in."""
    out = []
    for i, a in enumerate(argv):
        for flag in ("--key-file", "--password-file"):
            v = None
            if a == flag and i + 1 < len(argv):
                v = argv[i + 1]
            elif a.startswith(flag + "="):
                v = a[len(flag) + 1:]
            if v is None:
                continue
            if flag == "--key-file":
                if "=" not in v:
                    out.append((flag, v, None))
                    continue
                v = v.split("=", 1)[1]
            out.append((flag, v, v))
    return out


def check_key(path, argv):
    """What's wrong with one key file, in words; [] when nothing is."""
    bad = []
    if not os.path.isabs(path):
        return ["%s: not an absolute path" % path]
    try:
        st = os.lstat(path)
    except OSError as e:
        return ["%s: %s" % (path, e.strerror)]
    if not stat.S_ISREG(st.st_mode):
        return ["%s: not a regular file (a symlink or other)" % path]
    if stat.S_IMODE(st.st_mode) != 0o600:
        bad.append("%s: mode %o, not 0600" % (path, stat.S_IMODE(st.st_mode)))
    if st.st_uid != os.geteuid():
        bad.append("%s: owned by uid %d, not us" % (path, st.st_uid))
    d = os.path.dirname(path)
    dst = os.lstat(d)
    if not stat.S_ISDIR(dst.st_mode):
        bad.append("%s: not a directory" % d)
    if stat.S_IMODE(dst.st_mode) != 0o700:
        bad.append("%s: mode %o, not 0700" % (d, stat.S_IMODE(dst.st_mode)))
    if dst.st_uid != os.geteuid():
        bad.append("%s: owned by uid %d, not us" % (d, dst.st_uid))
    with open(path, "rb") as f:
        b = f.read(KEY_MAX + 1)
    if not b:
        bad.append("%s: empty" % path)
    if len(b) > KEY_MAX:
        bad.append("%s: over %d bytes" % (path, KEY_MAX))
    if b"\n" in b or b"\r" in b:
        bad.append("%s: holds a newline" % path)
    if b:
        args = list(argv) + [a.split("=", 1)[1] for a in argv if "=" in a]
        if holds(b, args):
            bad.append("%s: its text is in argv" % path)
        if holds(b, os.environ.values()):
            bad.append("%s: its text is in the environment" % path)
    return bad, len(b), hashlib.sha256(b).hexdigest()


def watch(paths, pid):
    """In a child of our own, detached: wait for `pid` to be gone, then
    for each path to be removed."""
    if not paths or os.fork():
        return
    os.setsid()
    if os.fork():
        os._exit(0)
    null = os.open(os.devnull, os.O_RDWR)
    for fd in (0, 1, 2):
        os.dup2(null, fd)
    secs = float(os.environ.get("FAKE_BKO_HOLT_REMOVE_SECS", "10"))
    end = time.time() + 600
    while time.time() < end:
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            break
        except PermissionError:
            pass
        time.sleep(0.02)
    gone_at = time.time()
    left = list(paths)
    while left and time.time() < gone_at + secs:
        for p in list(left):
            if not os.path.lexists(p):
                log({"removed": p, "secs": round(time.time() - gone_at, 3)})
                left.remove(p)
        time.sleep(0.02)
    for p in left:
        log({"left": p})
    os._exit(0)


def no_commit():
    """BKO_HOLT_NO_COMMIT's value when it is in force, as bko-holt reads
    it: set, not empty and not 0 (a typo can't turn the lock off)."""
    v = os.environ.get("BKO_HOLT_NO_COMMIT")
    return v if v not in (None, "", "0") else None


def refuse_commit(value, argv):
    """bko-holt's refusal of --commit under the dry-run lock."""
    line = ("bko-holt load: BKO_HOLT_NO_COMMIT=%s is set (a dry run), so --commit is refused; "
            "nothing was written to any disk" % value)
    if any(a == "--json" or a.startswith("--json=") for a in argv):
        doc = {"format": "bko-holt-error", "schema": 1, "version": VERSION,
               "generated": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "dry_run": True,
               "exit": 2, "code": "no_commit", "text": line}
        sys.stdout.write(json.dumps(doc, separators=(",", ":")) + "\n")
        sys.stdout.flush()
    print(line, file=sys.stderr)
    return 2


def words(b):
    """Text as recovery words are read: split at white space and commas,
    lower case, numbers typed before the words ("1.", "2)") left out."""
    return [w for w in b.decode(errors="replace").replace(",", " ").lower().split()
            if not re.fullmatch(r"[0-9]+[.):]?", w)]


STDIN = []


def stdin_words():
    """Standard input's words, read once (at most 1 KiB, as bko-holt reads it)."""
    if not STDIN:
        try:
            STDIN.append(sys.stdin.buffer.read(1025) if not sys.stdin.isatty() else b"")
        except (OSError, ValueError):
            STDIN.append(b"")
    return words(STDIN[0])


def match(call_dir, argv):
    try:
        with open(os.path.join(call_dir, "argv")) as f:
            pats = [l.rstrip("\n") for l in f if l.rstrip("\n") != ""]
    except FileNotFoundError:
        return False
    if not (len(pats) == len(argv) and all(fnmatch.fnmatchcase(a, p) for a, p in zip(argv, pats))):
        return False
    pw = read(call_dir, "password")
    if pw is not None and given_password(argv) != pw:
        return False
    want = read(call_dir, "stdin")
    return want is None or same_words(words(want), stdin_words())


def given_password(argv):
    """The bytes of the --password-file argv names (at most 1 KiB), or
    None."""
    for flag, _, path in key_paths(argv):
        if flag == "--password-file" and path:
            try:
                with open(path, "rb") as f:
                    return f.read(KEY_MAX + 1)
            except OSError:
                return None
    return None


def same_words(want, typed):
    """Whether TYPED are the words WANT, each in full or its first 4 letters
    or more, as bko-holt's recovery.rs `lookup` takes them."""
    return len(want) == len(typed) and all(t == w or (len(t) >= 4 and w.startswith(t)) for w, t in zip(want, typed))


def check_out(path):
    """What's wrong with OUT, a new file of ours to write; [] when nothing."""
    if not os.path.isabs(path):
        return ["OUT %s: not an absolute path" % path]
    if os.path.lexists(path):
        return ["OUT %s: there already" % path]
    d = os.path.dirname(path)
    try:
        st = os.lstat(d)
    except OSError as e:
        return ["OUT %s: %s" % (d, e.strerror)]
    bad = []
    if not stat.S_ISDIR(st.st_mode):
        bad.append("OUT %s: not a directory" % d)
    elif stat.S_IMODE(st.st_mode) != 0o700:
        bad.append("OUT %s: mode %o, not 0700" % (d, stat.S_IMODE(st.st_mode)))
    if st.st_uid != os.geteuid():
        bad.append("OUT %s: owned by uid %d, not us" % (d, st.st_uid))
    return bad


def read(call_dir, name):
    try:
        with open(os.path.join(call_dir, name), "rb") as f:
            return f.read()
    except FileNotFoundError:
        return None


class Stopped(Exception):
    pass


def on_term(sig, frame):
    raise Stopped()


def starttime():
    """This process's start time as bko-holt's lock records it on Linux:
    /proc/self/stat's field 22."""
    try:
        with open("/proc/self/stat") as f:
            return f.read().rsplit(")", 1)[1].split()[19]
    except (OSError, IndexError):
        return None


def emit(obj_or_line):
    line = obj_or_line if isinstance(obj_or_line, str) else json.dumps(obj_or_line, separators=(",", ":"))
    sys.stdout.write(line + "\n")
    sys.stdout.flush()


def stream(events):
    """The events, a line at a time; a SIGTERM ends them as bko-holt's stop
    does.  The exit status when stopped, else None."""
    delay = 0.05
    pending = None      # (stage, n) of a command running: no cmd_done yet
    signal.signal(signal.SIGTERM, on_term)
    t0 = time.time()
    try:
        for raw in events.decode().splitlines():
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            w = line.split()
            if w[0] == "sleep":
                time.sleep(float(w[1]))
                continue
            if w[0] == "delay":
                delay = float(w[1])
                continue
            e = json.loads(line)          # a fixture's typo fails here, not in bko-rescue
            if e.get("event") == "start":
                e["pid"] = os.getpid()
                line = json.dumps(e, separators=(",", ":"))
            elif e.get("event") == "cmd":
                pending = None if e.get("would") else (e.get("stage"), e.get("n"))
            elif e.get("event") in ("cmd_done", "stage_done", "failed"):
                pending = None
            emit(line)
            time.sleep(delay)
    except Stopped:
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
        emit({"event": "stopping", "signal": "SIGTERM"})
        if pending is not None:
            emit({"event": "cmd_done", "stage": pending[0], "n": pending[1], "status": 130, "signal": None, "secs": 0.5})
        emit({"event": "end", "exit": 5, "stopped": True, "secs": round(time.time() - t0, 2)})
        return 5
    return None


def main():
    argv = sys.argv[1:]
    scen = os.environ.get("FAKE_BKO_HOLT_SCENARIO") or os.path.join(HERE, "scenarios", "demo")
    entry = {"argv": argv, "scenario": scen, "no_commit_env": os.environ.get("BKO_HOLT_NO_COMMIT")}
    checks, keys, watched = [], [], []
    for flag, given, path in key_paths(argv):
        if path is None:
            checks.append("%s %s: not NAME=PATH" % (flag, given))
            continue
        r = check_key(path, argv)
        if isinstance(r, list):
            checks.extend(r)
            continue
        bad, n, digest = r
        checks.extend(bad)
        keys.append({"path": path, "bytes": n, "sha256": digest})
        watched.append(path)
    if no_commit() is not None and "--commit" in argv:
        entry.update(call=None, checks=checks, keys=keys, ok=False, refused="--commit")
        log(entry)
        return refuse_commit(no_commit(), argv)
    entry.update(checks=checks, keys=keys)
    if checks:
        entry.update(call=None, ok=False)
        log(entry)
        for c in checks:
            print("fake-bko-holt: CHECK FAILED: %s" % c, file=sys.stderr)
        return 97
    calls = sorted(d for d in os.listdir(scen) if os.path.isdir(os.path.join(scen, d))) if os.path.isdir(scen) else []
    hits = [c for c in calls if match(os.path.join(scen, c), argv)]
    state = os.environ.get("FAKE_BKO_HOLT_STATE")
    if state and hits:
        try:
            with open(state) as f:
                done = {l.strip() for l in f}
        except FileNotFoundError:
            done = set()
        call = next((c for c in hits if c not in done), hits[-1])
        if call not in done:
            with open(state, "a") as f:
                f.write(call + "\n")
    else:
        call = hits[0] if hits else None
    entry.update(call=call, ok=call is not None)
    if call is None:
        log(entry)
        print("fake-bko-holt: no call in %s matches %r" % (scen, argv), file=sys.stderr)
        return 98
    d = os.path.join(scen, call)
    data = read(d, "out")
    if data is not None:
        target = argv[1] if len(argv) > 1 else ""
        if "--output" in argv[:-1]:
            target = argv[argv.index("--output") + 1]
        bad = check_out(target)
        if bad:
            entry.update(ok=False, checks=checks + bad)
            log(entry)
            for c in bad:
                print("fake-bko-holt: CHECK FAILED: %s" % c, file=sys.stderr)
            return 97
        fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        try:
            os.write(fd, data)
        finally:
            os.close(fd)
        keys.append({"path": target, "bytes": len(data), "sha256": hashlib.sha256(data).hexdigest(), "out": True})
        watched.append(target)
    if STDIN:
        entry["stdin_sha256"] = hashlib.sha256(STDIN[0]).hexdigest()
    entry.update(keys=keys)
    log(entry)
    watch(watched, os.getpid())
    run_dir = os.environ.get("FAKE_BKO_HOLT_RUN_DIR")
    out = read(d, "stdout")
    if out:
        if run_dir:
            try:
                doc = json.loads(out)
                if isinstance(doc, dict) and doc.get("format") == "bko-holt-api":
                    doc["run_dir"] = run_dir
                    out = (json.dumps(doc, separators=(",", ":")) + "\n").encode()
            except ValueError:
                pass
        sys.stdout.buffer.write(out)
        sys.stdout.flush()
    ev = read(d, "events")
    stopped = None
    if ev:
        lock = None
        if run_dir and "--commit" in argv:
            lock = os.path.join(run_dir, "load.lock")
            fd = os.open(lock, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            os.write(fd, json.dumps({"pid": os.getpid(), "start": starttime()}).encode())
            os.close(fd)
        try:
            stopped = stream(ev)
        finally:
            if lock:
                os.remove(lock)
    err = read(d, "stderr")
    if err:
        sys.stderr.buffer.write(err)
        sys.stderr.flush()
    if stopped is not None:
        return stopped
    code = read(d, "exit")
    return int(code.decode().strip()) if code else 0


if __name__ == "__main__":
    sys.exit(main())
