d0p1: FAT, as the source's\nnewfs_msdos -F 32 -I 0x7EE7170F -c 1 /dev/vtbd1p1\nzfs create -u -o mountpoint=none zroot/ROOT\nzfs create -u -o mountpoint=/ -o canmount=noauto zroot/ROOT/default\nzfs create -u -o mountpoint=/home zroot/home\nzfs create -u -o mountpoint=/tmp -o exec=on -o setuid=off zroot/tmp\nzfs create -u -o mountpoint=/usr -o canmount=off zroot/usr\nzfs create -u -o setuid=off zroot/usr/ports\nzfs create -u zroot/usr/src\nzfs create -u -o mountpoint=/var -o canmount=off zroot/var\nzfs create -u -o exec=off -o setuid=off zroot/var/audit\nzfs create -u -o exec=off -o setuid=off zroot/var/crash\nzfs create -u -o exec=off -o setuid=off zroot/var/log\nzfs create -u -o atime=on zroot/var/mail\nzfs create -u -o setuid=off zroot/var/tmp\nzpool set bootfs=zroot/ROOT/default zroot\n\n# ---- mount ----\nzfs mount zroot/ROOT/default\nzfs mount zroot/home\nzfs mount zroot/tmp\nzfs mount zroot\nmkdir -p /mnt/bko-target/boot/efi\nmount -t msdosfs -o rw /dev/vtbd1p1 /mnt/bko-target/boot/efi\nzfs mount zroot/usr/ports\nzfs mount zroot/usr/src\nzfs mount zroot/var/audit\nzfs mount zroot/var/crash\nzfs mount zroot/var/log\nzfs mount zroot/var/mail\nzfs mount zroot/var/tmp\n\n# ---- restore ----\nmkdir -p -m 700 /var/run/bko-holt\n# the restore errors msdosfs's mount roots give, and only those, let pass\ncat > /var/run/bko-holt/restore.fatroots <<'EOF'\n[WARN] restore boot/efi: setting UID/GID failed.\n[WARN] restore boot/efi: setting User/Group failed.\n[WARN] restore boot/efi: chmod failed.\n[WARN] restore boot/efi: setting file times failed.\nEOF\n# snapshot latest:/mnt/src of /root/repo, with BackOtter's restore flags\nRUSTIC_STRICT_EXIT=true sh -c '\"$@\" 2>/var/run/bko-holt/restore.err; s=$?; cat /var/run/bko-holt/restore.err >&2; [ $s -eq 1 ] || exit $s; e=$(printf '\\''\\033'\\''); sed -e \"s/$e\\[[0-9;]*m//g\" -e '\\''s/[[:space:]]*$//'\\'' /var/run/bko-holt/restore.err > /var/run/bko-holt/restore.err.plain; n=$(sed -n '\\''s/^error: There were \\([0-9][0-9]*\\) errors.*/\\1/p'\\'' /var/run/bko-holt/restore.err.plain); k=$(grep -cxF -f /var/run/bko-holt/restore.fatroots /var/run/bko-holt/restore.err.plain); [ -n \"$n\" ] && [ \"$n\" = \"$k\" ] || exit 1; echo '\\''bko-holt: the restore set no owner, mode or times on the root of /boot/efi: msdosfs keeps none there'\\'' >&2' sh /root/rustic-bko --repository /root/repo --password-file /root/ht1-keys/repo-password --no-progress restore --numeric-id latest:/mnt/src /mnt/bko-target\n\n# ---- boot ----\n# the boot code (MBR, freebsd-boot) was written with the partition table\n# vtbd0p3: /var/backups' GELI metadata backup, written again for the new provider (the restored one is the old provider's)\nsh -c 'f=; for n in vtbd0p3; do [ ! -f /mnt/bko-target/var/backups/$n.eli ] || f=1; done; [ -z \"$f\" ] || { (umask 077; geli backup /dev/vtbd1p3 /mnt/bko-target/var/backups/vtbd1p3.eli) && for n in vtbd0p3; do [ $n = vtbd1p3 ] || rm -f /mnt/bko-target/var/backups/$n.eli; done; }'\n# the restored system's zpool.cache names the new pool\nsh -c 'for c in /etc/zfs/zpool.cache /boot/zfs/zpool.cache; do [ -f /mnt/bko-target$c ] && zpool set cachefile=/mnt/bko-target$c zroot; done; true'\nmkdir -p /mnt/bko-target/var/log/bko-holt\n# this restore's log, on the restored system\ncp -Rp /var/run/bko-holt/log/. /mnt/bko-target/var/log/bko-holt/\n\n# ---- close ----\n# everything under the target, deepest first\nsh -c 'mount -p | awk '\\''{ print $2 }'\\'' | awk '\\''$0 == \"/mnt/bko-target\" || index($0, \"/mnt/bko-target/\") == 1'\\'' | sort -r | while read -r m; do umount \"$m\" || exit; done'\nzpool export zroot\ngeli detach /dev/vtbd1p3.eli\n\n# Nothing was written.  To run it: bko-holt load /root/layout.json ... --through close --commit\n"}
