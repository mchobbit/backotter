[ -f /mnt/bko-target/etc/versions/build ] && [ ! -h /mnt/bko-target/etc/versions/build ] || exit 0; for f in /mnt/bko-target/etc/versions/build.*; do if [ -e \"$f\" ] || [ -h \"$f\" ]; then exit 0; fi; done; touch -r /mnt/bko-target/etc/versions /var/run/bko-holt/versref && cp -p /mnt/bko-target/etc/versions/build /mnt/bko-target/etc/versions/build.bko-holt && s=$(/usr/gnu/bin/stat -c %.9Y /mnt/bko-target/etc/versions/build) && case $s in *.000000000) /usr/gnu/bin/touch -m -d @${s%.*}.000000001 /mnt/bko-target/etc/versions/build;; esac'\n# the boot archive, with the new pool's zpool.cache\nbootadm update-archive -R /mnt/bko-target\n# etc/versions/build's fragment gone again, and its mtime back\nsh -c '[ ! -f /var/run/bko-holt/versref ] || { /usr/gnu/bin/touch -m -r /mnt/bko-target/etc/versions/build.bko-holt /mnt/bko-target/etc/versions/build && rm -f /mnt/bko-target/etc/versions/build.bko-holt && touch -r /var/run/bko-holt/versref /mnt/bko-target/etc/versions && rm -f /var/run/bko-holt/versref; }'\n# illumos' gptzfsboot, in the pool's boot area\ninstallboot -f -b /mnt/bko-target/boot /dev/rdsk/c3t0d0s1\nmkdir -p /mnt/bko-target/var/log/bko-holt\n# this restore's log, on the restored system\ncp -Rp /var/run/bko-holt/log/. /mnt/bko-target/var/log/bko-holt/\n\n# ---- close ----\n# everything under the target, deepest first\nsh -c 'awk '\\''{ print $2 }'\\'' /etc/mnttab | awk '\\''$0 == \"/mnt/bko-target\" || index($0, \"/mnt/bko-target/\") == 1'\\'' | sort -r | while read -r m; do umount \"$m\" || exit; done'\nzfs inherit mountpoint rpool_bko\nzpool export rpool_bko\n\n# Nothing was written.  To run it: bko-holt load /root/layout.json ... --through close --commit\n"}
