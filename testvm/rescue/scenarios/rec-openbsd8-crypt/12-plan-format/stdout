n\n# ---- mount ----\nmkdir -p /mnt/bko-target\nmount -t ffs -o rw,wxallowed 217f006caef0ad87.a /mnt/bko-target\n\n# ---- restore ----\n# no --repo: restore the backup into /mnt/bko-target yourself, then run `bko-holt load ... --only boot`\n\n# ---- boot ----\n# the boot code (MBR, freebsd-boot) was written with the partition table\n# OpenBSD's biosboot, and /boot it loads, through the softraid volume / is in (onto its chunk)\nsh -c 'v=$(bioctl softraid0 2>/dev/null | awk '\\''{ for (i = 1; i <= NF; i++) if ($i ~ /^sd[0-9]+$/) d = $i } index($0, \"<sd1a>\") { print d; exit }'\\''); [ -n \"$v\" ] || { echo '\\''no softraid volume on sd1a'\\'' >&2; exit 1; }; installboot -v -r /mnt/bko-target \"$v\" /usr/mdec/biosboot /usr/mdec/boot'\nmkdir -p /mnt/bko-target/var/log/bko-holt\n# this restore's log, on the restored system\ncp -Rp /var/run/bko-holt/log/. /mnt/bko-target/var/log/bko-holt/\n\n# ---- close ----\n# everything under the target, deepest first\nsh -c 'mount | sed -n '\\''s/^.* on \\(.*\\) type .*/\\1/p'\\'' | awk '\\''$0 == \"/mnt/bko-target\" || index($0, \"/mnt/bko-target/\") == 1'\\'' | sort -r | while read -r m; do umount \"$m\" || { o=$(fstat) && ! printf '\\''%s\\n'\\'' \"$o\" | awk -v m=\"$m\" '\\''{ for (i = 5; i <= NF; i++) if ($i == m) f = 1 } END { exit !f }'\\'' && echo \"bko-holt: $m is busy with no file open on it: umount -f\" >&2 && umount -f \"$m\"; } || exit; done'\n# <volume of sd1a>, the softraid volume, stays attached: bioctl -d would clear the bootable flag installboot set; shut the rescue system down (or reboot) to detach it\nrm -f /var/run/bko-holt/keys/sd1.pass\n\n# Nothing was written.  To run it: bko-holt load /root/layout.json ... --through mount --commit\n"}
