# The batch runner's own smoke test (docs/design/batch.md §11.4): every
# mechanism, mostly on the two small hosts, in under an hour, at least two
# entries at once.  Done when it passes twice, its summary.tsv matches the runs' own
# reports, and each entry ran on the hosts `plan` predicted.
# No `set round`: t2 entries take the round at the fork heads (the backotter HEADs
# of ~/git/restic, rustic_core, rustic), built as t2r-... when none exists yet
# (testvm/test2/README.md).
# stic1 must name a round directory (drive.py): it stays pinned.
# Cinqcent is there so HoltTest2 can build bko-holt: a HoltTest2 builds bko-holt linux
# on a big build host (role build, class big in testvm/hosts.json), and with only
# the small hosts it stopped 9 s in (bt-20261115T1132-e4ca).  --holt-bin isn't
# the way round here: the promoted holt-bin (~/backotter-work/holt-bin) keeps
# linux's binary at linux/bko-holt, where HoltTest2's --holt-bin wants DIR/bko-holt,
# and a ready set would make its rows count only where equal (R14).  So the
# entry's hosts= adds cinqcent (never chopin: its cooler is weak).  hosts= is
# never split, so its cell may run on any of copland, cage, cinqcent; the other
# entries stay on copland and cage by their own hosts=.
set hosts copland,cage,cinqcent

t2      GateTest2 selftest hosts=cage
t2      HoltTest2 alpine324 hosts=copland,cage,cinqcent
stic1   rel9 alpine324 hosts=copland,cage
cmd     true -- true
