 "dragonfly": [
  "^\\[ ?N/N\\] (Upgrading|Installing|Reinstalling|Deleting|Deinstalling|Extracting) ",
  "^\\[ ?N/N\\] Fetching \\S+(: \\.* ?done)?$",
  "^Updating .* repository catalogue",
  "^Fetching \\S+: (\\.* ?done|N% )",
  "^Number of packages to be ",
