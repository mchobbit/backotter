  "^fetch ",
  "^OK: N(\\.N)? ",
  "^Executing "
 ],
 "moss": [
  "^(Fetched|Downloading|Unpacking) ",
  "^Installed \\S+$",
  "^\\S+ N\\S* -> N\\S*$"
 ],
 "nix": [
  "^(?!.*\\b([Ee]rror|[Ff]ailed|[Cc]annot)\\b).*/nix/store/",
  "^(?!.*\\b([Ee]rror|[Ff]ailed|[Cc]annot)\\b)(building|copying|unpacking|evaluating|activating|restarting|these N )"
