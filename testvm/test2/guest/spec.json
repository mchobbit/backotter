{
 "v": 1,
 "family": "guest",
 "about": "What a GuestTest2 cell's key covers (contract 1.4, 2.1). keys.py reads it: entries[GUEST] merges over kinds[its kind], lists adding up. A kind says how the guest is reached: ssh (vm-update --try), probe (no --try: vm-update --probe), redox and sculpt (no SSH: a console probe). checks is what the judge reads, and keyed as a judge input; the rest (ram_gib, cpus, memory, timeout_s, update) is the runner's. S-*, L-*, K-*, B-* and M-* are guest_judge.py's rule codes. Not in guest: keys: update/trim.sh, update/pkgset.sh, update/fingerprint.py, holttest1d/judge.py (contract D2). sculpt2610 has no SSH: its no-ssh file (written by make-sculpt.sh) makes vm-update refuse it, and testvm/sculpt-update updates it offline, recording image-state, so its generation keys its cells as any guest's does.",
 "plumbing": [
  "testvm/vm-run",
  "testvm/vm-lib.sh",
  "shared:cmp-run.sh",
  "shared:testvm/compare/iolog.sh"
 ],
 "soft": [
  "kernel",
  "zfs"
 ],
 "defaults": {
  "host": [
   "qemu",
   "ovmf"
  ],
  "judge": [
   "testvm/test2/t2lib/guest_judge.py",
   "entry:testvm/test2/guest/known-lines.json#all",
   "entry:testvm/test2/guest/limits.json#{guest}",
   "entry:testvm/test2/guest/spec.json#entries.{guest}.checks",
   "entry:testvm/test2/classes.json#policy.guest.judge"
  ],
  "bins": []
 },
 "excluded": {
  "freebsd15-builder": "a build helper"
 },
 "kinds": {
  "ssh": {
   "try": true,
   "harness": [
    "testvm/vm-update",
    "testvm/update/in-guest.sh#prologue",
    "testvm/test2/guest/job.sh",
    "testvm/test2/guest/check-image.sh",
    "testvm/test2/guest/check-after.sh"
   ]
  },
  "probe": {
   "try": false,
   "harness": [
    "testvm/vm-update",
    "testvm/update/in-guest.sh#prologue",
    "testvm/test2/guest/job.sh",
    "testvm/test2/guest/check-image.sh",
    "testvm/test2/guest/check-after.sh"
   ]
  },
  "redox": {
   "try": false,
   "harness": [
    "testvm/test2/guest/job.sh"
   ]
  },
  "sculpt": {
   "try": false,
   "harness": [
    "testvm/test2/guest/job.sh"
   ]
  }
 },
