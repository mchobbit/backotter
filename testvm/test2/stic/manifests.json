{
 "v": 1,
 "family": "stic",
 "notes": "SticTest's input specs, one entry per check (cell stic:GUEST): what its key covers (contract 1.3, rulings R2, R3, R5). harness: the check's own directory and the repo files outside it its scripts use; judge: what reads the records (judge.py, verdict.py, expected-coverage.json) and its limits.json entry. The guest group (generation and vm-run-options, ssh-user, console-passphrase, luks-passphrase, zfs-passphrase, no-ssh) and the soft host facts come by default. check-manifests.py checks it.",
 "plumbing": [
  "testvm/vm-run",
  "testvm/vm-lib.sh",
  "testvm/compare/guest-slot.sh",
  "testvm/hosts.sh",
  "testvm/hosts.json",
  "testvm/test2/t2lib/hosts.py",
  "testvm/console-boot.py",
  "testvm/stictest1/drive.py",
  "shared:cmp-run.sh",
  "shared:testvm/compare/iolog.sh"
 ],
 "soft": [
  "kernel",
  "zfs",
  "qemu",
  "ovmf"
 ],
