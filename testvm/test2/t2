UNIT_JOBS = 6   # test files at once (T2_SELFTEST_JOBS): 688 s one after another, test_plan's ~120 s the floor
UNIT_COUNTS = ("failures", "errors", "skipped", "expected failures", "unexpected successes")
# Tests that run after the pool, alone, one entry at a time (a file's module, or a test
# class or test in it): their wall-clock asserts guard speed, so they need the CPU to
# themselves.  test_plan.Performance: three plans over every cell and 10,000 rows, and
# three nothing-due plans over 12 commits, each under 2 s (U2.6); 1.56 s alone, 2.49 s
# beside 5 other files.  The pool skips them; ~6 s alone.  Nothing reruns to pass: a FAIL
# that passes again is a FLAKY-FAIL (docs/design/test2.md), so a failure in the pool or
# alone fails the self-test.
UNIT_SERIAL = ("test_plan.Performance",)
# One test file, by unittest's loader: "pool" leaves out the ids given (and what is under
# them), "alone" runs only those, and fails when one names no test.  It prints what
# python -m unittest prints.
UNIT_RUNNER = r"""
import sys, unittest
tests, name, mode, sel = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4:]
def flat(s):
    for t in s:
        if isinstance(t, unittest.TestSuite):
            yield from flat(t)
        else:
            yield t
def hit(i, s):
    return i == s or i.startswith(s + ".")
every = list(flat(unittest.defaultTestLoader.discover(tests, pattern=name)))
if mode == "alone":
    gone = [s for s in sel if not any(hit(t.id(), s) for t in every)]
    if gone:
        sys.exit("UNIT_SERIAL names no test: " + ", ".join(gone))
    pick = [t for t in every if any(hit(t.id(), s) for s in sel)]
else:
    pick = [t for t in every if not any(hit(t.id(), s) for s in sel)]
r = unittest.TextTestRunner().run(unittest.TestSuite(pick))
sys.exit(0 if r.wasSuccessful() else 1)
"""


def unit_summary(texts):
    """unittest's last line over several runs' outputs: "OK", "OK (skipped=3)", "FAILED
    (failures=1, errors=2, skipped=3)", as one run of them all prints it.  An output with no
    result line (the process died) counts as an error."""
    import re
    n, bad = {k: 0 for k in UNIT_COUNTS}, False
    for text in texts:
        last = next((l.strip() for l in reversed((text or "").splitlines()) if re.match(r"(OK|FAILED)\b", l.strip())), None)
        if last is None:
            n["errors"] += 1
            bad = True
            continue
        bad = bad or last.startswith("FAILED")
        for k, v in re.findall(r"([a-z ]+)=(\d+)", last):
            if k.strip() in n:
                n[k.strip()] += int(v)
    parts = ", ".join(f"{k}={v}" for k, v in n.items() if v)
    return ("FAILED" if bad else "OK") + (f" ({parts})" if parts else "")


def unit_tests(py, env, tests=None, jobs=None, serial=None):
    """Each tests/test_*.py in a process of its own, JOBS at once (never more than the Mac's
    CPUs), the biggest files first (the slow ones, test_plan's ~120 s, don't start last), each
    with a TMPDIR of its own (removed after), less SERIAL's tests (UNIT_SERIAL for the real
    tests/, none for another TESTS); then each file's SERIAL tests alone, one file after
    another, in a process and TMPDIR of their own.  [(name, rc, output, wall_s)]: the files in
    order, then the alone runs, named "test_x.py (alone: test_x.C)".  Nothing runs twice and
    any nonzero exit is the caller's FAIL.  The files share no temp or fixture state: each
    makes its own temporary roots (tempfile, under its TMPDIR) and reads the fixtures only."""
    import shutil
    import tempfile
    from concurrent.futures import ThreadPoolExecutor
    if serial is None:
        serial = UNIT_SERIAL if tests is None else ()
    tests = tests or os.path.join(HERE, "tests")
    if jobs is None:
        try:
            jobs = int(os.environ.get("T2_SELFTEST_JOBS") or UNIT_JOBS)
        except ValueError:
            jobs = UNIT_JOBS
    jobs = max(1, min(jobs, os.cpu_count() or 1))
    files = sorted(os.path.basename(f) for f in glob.glob(os.path.join(tests, "test_*.py")))
    alone = {}
    for s in serial:
        alone.setdefault(s.split(".", 1)[0] + ".py", []).append(s)

    def one(name, mode, label):
        tmp = tempfile.mkdtemp(prefix="t2-selftest-" + name[:-3] + "-")
        t0 = time.time()
        try:
            r = subprocess.run([py, "-B", "-c", UNIT_RUNNER, tests, name, mode] + alone.get(name, []), cwd=CHECKOUT,
                               capture_output=True, text=True, env=dict(env, TMPDIR=tmp))
            return label, r.returncode, r.stdout + r.stderr, time.time() - t0
        finally:
            shutil.rmtree(tmp, ignore_errors=True)
    pool = [n for n in files if n[:-3] not in alone.get(n, [])]   # a whole file listed: alone only
    big = sorted(pool, key=lambda n: (-os.path.getsize(os.path.join(tests, n)), n))
    with ThreadPoolExecutor(jobs) as ex:
        done = {r[0]: r for r in ex.map(lambda n: one(n, "pool", n), big)}
    out = [done[n] for n in pool]
    for n in sorted(alone):
        label = f"{n} (alone: {', '.join(alone[n])})"
        if n in files:
            out.append(one(n, "alone", label))
        else:
            out.append((label, 2, f"UNIT_SERIAL names {n}, which {tests} lacks\n", 0.0))
    return out


