            "resume": cmd_resume, "self-test": cmd_self_test,
            "guest-lines": guest_tool("cmd_lines"), "guest-fingerprints": guest_tool("cmd_fingerprints"),
            "batch": lambda argv: importlib.import_module("t2lib.batch").main(argv, CHECKOUT)}   # docs/design/batch.md


def main(argv):
    """t2 ARGV's exit code; the outermost t2 sends one notification once a run's work began
    (t2lib/notify.py), whatever its end."""
    token = notify.claim()
    code = exc = None
    try:
        code = dispatch(argv)
        return code
    except BaseException as e:
        exc = e
        raise
    finally:
        notify.done(token, code, exc)


def dispatch(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        say(__doc__.strip())
        return 0 if argv else 2
    try:
        if os.environ.get(HARNESS_STOP_ENV, "").strip():
            try:
                parse_harness_stop(os.environ[HARNESS_STOP_ENV])
            except ValueError as e:
                raise Usage(f"{HARNESS_STOP_ENV}: {e}")
        if argv[0] in COMMANDS:
            return COMMANDS[argv[0]](argv[1:])
        return cmd_word(argv)
    except (Usage, words.Refused) as e:
        err(str(e))
        return 2
    except Fatal as e:
        err(str(e))
        return 3
    except KeyboardInterrupt:
        err("interrupted")
        return 130


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except SystemExit:
        raise
    except Exception:   # noqa: BLE001 - exit 3: an internal error, with its traceback
        traceback.print_exc()
        sys.exit(3)
