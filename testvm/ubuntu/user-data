#cloud-config
# Ubuntu Server test guest for BackOtter: an unattended "autoinstall" from an
# official live-server ISO, offline (the VM has no network during the install,
# so everything comes from the ISO).  The disk layout is storage-zfs.yaml's
# or, for UEFI, storage-direct.yaml's.
#
# make-ubuntu.sh fills in the @...@ settings (the storage line with one of
# those files) and puts this file, with an empty meta-data, on a small ISO
# labelled CIDATA that cloud-init finds.
autoinstall:
  version: 1
  interactive-sections: []
  refresh-installer:
    update: no
  locale: en_US.UTF-8
  keyboard:
    layout: us
  timezone: UTC
  source:
    id: ubuntu-server
  apt:
    fallback: offline-install
  network:
    version: 2
    ethernets:
      wired:
        match:
          name: "en*"
        dhcp4: true
  # Ubuntu wants an ordinary user; it gets root's password too.
  identity:
    hostname: @HOSTNAME@
    username: tester
    realname: Test user
    password: '@PASSWORD_HASH@'
  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      - '@AUTHORIZED_KEY@'
@STORAGE@
  late-commands:
    # Root: the same password, and the SSH key, as on the other test guests.
    - curtin in-target -- sh -c 'echo "root:@PASSWORD_HASH@" | chpasswd -e'
    - mkdir -p -m 700 /target/root/.ssh
    - echo '@AUTHORIZED_KEY@' >/target/root/.ssh/authorized_keys
    - chmod 600 /target/root/.ssh/authorized_keys
    # A serial console too.
    - sed -i 's/^GRUB_CMDLINE_LINUX_DEFAULT=.*/GRUB_CMDLINE_LINUX_DEFAULT="console=tty0 console=ttyS0,115200n8"/' /target/etc/default/grub
    - curtin in-target -- update-grub
    # Freeze the guest at this release, like the others: Ubuntu's snapshot
    # service serves the archive as it was at @SNAPSHOT@.
    # (Folded, because YAML doesn't allow ": " in an unquoted string.)
    - >-
      sed -i -E 's#^URIs: http://(archive|security)\.ubuntu\.com/ubuntu/?$#URIs: https://snapshot.ubuntu.com/ubuntu/@SNAPSHOT@/#'
      /target/etc/apt/sources.list.d/ubuntu.sources
  shutdown: poweroff
