#!/usr/bin/env bash
# Bigfoot's SHUTDOWNCMD: stop what writes to DantePool, then power off
# (docs/design/ups-shutdown.md, UPS-A).
#
# Usage (as root, from upsmon.conf on Bigfoot):
#   SHUTDOWNCMD "/usr/local/sbin/bigfoot-ups-halt"
#   bigfoot-ups-halt --dry-run
#
#   1. Logs "UPS: bigfoot halt" to syslog (logger -t ups) and stderr.
#   2. Stops deluged, deluge-web, smbd, nmbd, nfs-server and vncserver@:1
#      (UPS_UNITS overrides the list), all at once, each under
#      `timeout UPS_STOP_WAIT` (default 60 s).  A unit that isn't there is
#      skipped; one that won't stop in time is logged and left to systemd.
#   3. systemctl poweroff.
#
# It never runs `zpool export` (the user's decision, 2026-11-16): a normal
# poweroff leaves DantePool consistent and in /etc/zfs/zpool.cache, so the
# stock zfs-import-cache.service imports it at boot.  An export would drop it
# from the cache file, and could hang on a stalled USB bridge.
#
# Any trouble in 2 is logged and the host still powers off.
#
#   --dry-run   print each unit's state and what it would stop, change nothing
#
# Installs as /usr/local/sbin/bigfoot-ups-halt (testvm/ups/README.md).
# Needs: bash 4.4+, logger, systemctl, timeout.

set -euo pipefail
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

dry=0
for a in "$@"; do
    case $a in
        --dry-run) dry=1 ;;
        -h|--help) sed -n '2,/^$/s/^# \{0,1\}//p' "$0"; exit 0 ;;
        *) echo "bigfoot-ups-halt: unknown argument $a (see --help)" >&2; exit 2 ;;
    esac
done

log() {
    if [ $dry = 1 ]; then echo "bigfoot-ups-halt: $*"; return; fi
    logger -t ups -- "bigfoot-halt: $*" 2>/dev/null || true
    echo "bigfoot-ups-halt: $*" >&2
}

read -r -a units <<<"${UPS_UNITS:-deluged deluge-web smbd nmbd nfs-server vncserver@:1}"
stop_wait=${UPS_STOP_WAIT:-60}
[[ $stop_wait =~ ^[1-9][0-9]*$ ]] || { log "UPS_STOP_WAIT=$stop_wait is not a number of seconds, using 60"; stop_wait=60; }

log "UPS: bigfoot halt"

# LoadState and ActiveState of a unit, e.g. "loaded active" or "not-found inactive".
state() {
    local kv load=unknown active=unknown
    while IFS= read -r kv; do
        case $kv in
            LoadState=*) load=${kv#*=} ;;
            ActiveState=*) active=${kv#*=} ;;
        esac
    done < <(systemctl show -p LoadState -p ActiveState -- "$1" 2>/dev/null || true)
    echo "$load $active"
}

names=() pids=()
for u in "${units[@]}"; do
    read -r load active <<<"$(state "$u")"
    if [ "$load" != loaded ]; then
        log "$u: $load, skipped"
        continue
    fi
    if [ $dry = 1 ]; then
        if [ "$active" = inactive ]; then log "$u: inactive, nothing to stop"
        else log "$u: $active, would stop (timeout ${stop_wait}s)"; fi
        continue
    fi
    timeout "$stop_wait" systemctl stop -- "$u" &
    names+=("$u") pids+=($!)
done
for i in "${!pids[@]}"; do
    rc=0
    wait "${pids[$i]}" || rc=$?
    case $rc in
        0) log "stopped ${names[$i]}" ;;
        124) log "${names[$i]} didn't stop in ${stop_wait}s, left to systemd" ;;
        *) log "stopping ${names[$i]} failed ($rc)" ;;
    esac
done

if [ $dry = 1 ]; then
    log "would systemctl poweroff (no zpool export)"
    exit 0
fi
log "systemctl poweroff"
systemctl poweroff || { log "systemctl poweroff failed ($?), trying shutdown -h now"; shutdown -h now; }
