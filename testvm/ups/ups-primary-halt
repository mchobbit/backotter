#!/usr/bin/env bash
# A NUT primary's SHUTDOWNCMD: wait until the UPS's secondaries are dark,
# then power this host off (docs/design/ups-shutdown.md, D4).
#
# Usage (as root, from upsmon.conf on the UPS's master):
#   SHUTDOWNCMD "/usr/local/sbin/ups-primary-halt HOST..."
#   ups-primary-halt --dry-run HOST...
#
# On FSD, upsmon's primary waits only until its secondaries' upsmon log out
# (HOSTSYNC), which they do early in their own shutdown; the UPS then cuts
# its output OFFDELAY seconds after this host halts.  So this pings each HOST
# (one packet, 1 s timeout, all at once) every UPS_PING_EVERY seconds
# (default 5) until none answers, or until UPS_WAIT_MAX seconds (default
# 300; GMKThree sets 180) have passed, logs who was still up then, and runs
# `systemctl poweroff`.  A HOST that doesn't resolve counts as down.  It
# never exports a ZFS pool: the stock poweroff leaves pools consistent and
# in the cache file (the user's decision, 2026-11-16).  POWERDOWNFLAG and
# Debian's nutshutdown hook then tell the UPS to cut and restore power.
#
# Everything goes to syslog (logger -t ups) and to stderr.  Any trouble
# here (a bad UPS_WAIT_MAX, no ping, no hosts) is logged and the host still
# powers off: a SHUTDOWNCMD that gives up would leave it to the dead battery.
#
#   --dry-run   ping each HOST once, print who answers, change nothing (no
#               syslog, no poweroff)
#
# Installs as /usr/local/sbin/ups-primary-halt (testvm/ups/README.md).
# Needs: bash 4.4+, ping (iputils), logger, systemctl.

set -euo pipefail
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

dry=0
hosts=()
for a in "$@"; do
    case $a in
        --dry-run) dry=1 ;;
        -h|--help) sed -n '2,/^$/s/^# \{0,1\}//p' "$0"; exit 0 ;;
        -*) echo "ups-primary-halt: unknown option $a (see --help)" >&2; exit 2 ;;
        *) hosts+=("$a") ;;
    esac
done

log() {
    if [ $dry = 1 ]; then echo "ups-primary-halt: $*"; return; fi
    logger -t ups -- "primary-halt: $*" 2>/dev/null || true
    echo "ups-primary-halt: $*" >&2
}

# The hosts of "$@" that answer one ping now, one per line.
answering() {
    local -a pids=()
    local h i=0
    for h in "$@"; do
        ping -c 1 -W 1 -q "$h" >/dev/null 2>&1 &
        pids+=($!)
    done
    for h in "$@"; do
        if wait "${pids[$i]}"; then echo "$h"; fi
        i=$((i + 1))
    done
}

max=${UPS_WAIT_MAX:-300}
every=${UPS_PING_EVERY:-5}
[[ $max =~ ^[0-9]+$ ]] || { log "UPS_WAIT_MAX=$max is not a number of seconds, using 300"; max=300; }
[[ $every =~ ^[1-9][0-9]*$ ]] || { log "UPS_PING_EVERY=$every is not a number of seconds, using 5"; every=5; }

if ! command -v ping >/dev/null 2>&1; then
    log "no ping here: not waiting for ${hosts[*]:-anyone}"
    hosts=()
fi

if [ $dry = 1 ]; then
    [ ${#hosts[@]} -gt 0 ] || { log "no hosts given"; exit 0; }
    mapfile -t up < <(answering "${hosts[@]}")
    for h in "${hosts[@]}"; do
        s=down
        for u in "${up[@]}"; do [ "$u" = "$h" ] && s=up; done
        log "$h: $s"
    done
    log "would wait up to ${max}s (pinging every ${every}s) for ${#up[@]} of ${#hosts[@]} host(s), then systemctl poweroff"
    exit 0
fi

log "UPS shutdown: waiting up to ${max}s for ${hosts[*]:-no secondaries} to go dark"
start=$SECONDS
last=
while [ ${#hosts[@]} -gt 0 ]; do
    mapfile -t up < <(answering "${hosts[@]}")
    if [ ${#up[@]} -eq 0 ]; then
        log "all secondaries dark after $((SECONDS - start))s"
        break
    fi
    if [ $((SECONDS - start)) -ge "$max" ]; then
        log "cap of ${max}s reached, still up: ${up[*]}"
        break
    fi
    [ "${up[*]}" = "$last" ] || log "still up after $((SECONDS - start))s: ${up[*]}"
    last=${up[*]}
    left=$((max - (SECONDS - start)))
    sleep $((left < every ? left : every))
done

log "systemctl poweroff"
systemctl poweroff || { log "systemctl poweroff failed ($?), trying shutdown -h now"; shutdown -h now; }
