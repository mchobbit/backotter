#!/usr/bin/env bash
# Run a shell (or a command) inside a test VM's filesystem mounted by vm-mount.
#
# Usage: sudo vm-chroot MOUNTPOINT [COMMAND [ARG...]]
#
# The guest is of the host's architecture (an amd64 guest on an x86_64 host,
# an arm64 one on Bigfoot: docs/design/arm64.md), so its programs run
# directly; a guest whose /bin/sh is another machine's ELF is refused, as
# its programs couldn't run here.  This binds
# the host's /proc, /sys and /dev in, stops package scripts from starting
# services (policy-rc.d) and needrestart from inspecting the host's processes,
# and undoes all of that on exit.  It is still the host's kernel and devices:
# a command such as grub-install must be pointed at the image's /dev/nbdN,
# never at a host disk.
#
# ostree (vm-mount put the physical root at MOUNTPOINT): the root is the
# default deployment (ostree_paths.py's), as at boot: what vm-mount mounted
# below MOUNTPOINT is bound at the deployment's paths for it (/var, /home
# through its var/home link, /boot, /boot/efi), and the physical root at
# /sysroot; /sysroot and the deployment's /usr are read-only, /sysroot as
# the booted system has it (sysroot.readonly), since the deployment's
# /ostree links into it.  /usr's files are hard links into the repository,
# whose checksums cover their content, mode, owner and SELinux label: a
# write there, or through /sysroot (a restorecon -R / would relabel the
# objects), would corrupt the repository unseen.  So nothing that installs
# or rebuilds runs here (rpm-ostree and bootc need the booted system);
# reading does, and `ostree admin --sysroot=/sysroot status`, which only
# reads.
#
# ABRoot (Vanilla OS: vm-mount put the present root at MOUNTPOINT, its /etc
# the raw lower): /etc is the overlay the guest boots with (ABRoot's
# mount-sys), lowerdir MOUNTPOINT/etc, upperdir
# MOUNTPOINT/var/lib/abroot/etc/LABEL and its LABEL-work beside it, LABEL
# the present root's; on a read-only mount, the same two as lower layers
# only (upper over lower), which overlayfs makes read-only.  So commands see
# the guest's own configuration (its live fstab, users, SSH keys).
#
# For more isolation (its own /proc, hostname and process tree), use instead:
#   sudo systemd-nspawn -D MOUNTPOINT

set -euo pipefail

die() { echo "vm-chroot: $*" >&2; exit 1; }

[[ $# -ge 1 ]] || die "usage: $0 MOUNTPOINT [COMMAND [ARG...]]"
[[ $EUID -eq 0 ]] || die "must run as root"
mp=$(realpath "$1")
shift
here=$(dirname "$(realpath "$0")")
root=$mp ostree=""
# -e, not -f: NixOS's /etc/fstab is a link into /nix/store, which only
# resolves inside the guest (-L for that).
if [[ ! -e $mp/etc/fstab && ! -L $mp/etc/fstab && -d $mp/ostree/deploy ]]; then
    ostree=$(python3 "$here/ostree_paths.py" default "$mp") || die "$mp holds ostree deployments, but no default one"
    root=$mp/$ostree
fi
# Ubuntu Core (vm-mount's snapcore mode: a tmpfs with the gadget's four
# partitions under run/mnt): no root filesystem to enter.  The root is the
# base snap, a squashfs file in ubuntu-data, whose / snap-bootstrap puts
# together at boot from binds of ubuntu-data's system-data.
if [[ ! -e $mp/etc && -f $mp/run/mnt/data/system-data/var/lib/snapd/modeenv ]]; then
    die "$mp is Ubuntu Core's four partitions (run/mnt/ubuntu-seed, ubuntu-boot, ubuntu-save, data), with no root filesystem to chroot into: its / is the base snap (run/mnt/data/system-data/var/lib/snapd/snaps/core*.snap, a squashfs) with ubuntu-data's binds, which only its boot puts together; read the partitions where they are, or boot the guest"
fi
[[ -e $root/etc/fstab || -L $root/etc/fstab ]] || die "$mp does not look like a mounted guest (run vm-mount first)"
# The guest's machine, from its /bin/sh's ELF header (its links followed
# inside the guest), against this host's: x86_64 62, aarch64 183.
guest_machine=$(python3 -I -B -c '
import os, struct, sys
sys.path.insert(0, sys.argv[1])
import ostree_paths
rel = ostree_paths.resolve(sys.argv[2], "bin/sh")
try:
    with open(os.path.join(sys.argv[2], rel), "rb") as f:
        head = f.read(20)
except (OSError, TypeError):
    sys.exit()
if head[:4] == b"\x7fELF" and len(head) == 20:
    print(struct.unpack("<H" if head[5] == 1 else ">H", head[18:20])[0])
' "$here" "$root" 2>/dev/null || true)
case $(uname -m) in x86_64) host_machine=62 ;; aarch64) host_machine=183 ;; *) host_machine="" ;; esac
declare -A machine_names=([3]=i386 [40]=arm [62]=x86_64 [183]=aarch64 [243]=riscv64)
if [[ -n $guest_machine && -n $host_machine && $guest_machine != "$host_machine" &&
      ! ( $host_machine == 62 && $guest_machine == 3 ) ]]; then
    die "$mp is a ${machine_names[$guest_machine]:-machine $guest_machine} guest (its /bin/sh), and this host is $(uname -m): its programs can't run here; chroot into it on a host of its architecture"
fi
abroot=""
if [[ -z $ostree && -f $mp/usr/share/abroot/abroot.json ]]; then
    abroot=$(blkid -s LABEL -o value "$(findmnt -n -o SOURCE --mountpoint "$mp")" 2>/dev/null || true)
    [[ -n $abroot && -d $mp/var/lib/abroot/etc/$abroot ]] ||
        die "$mp is an ABRoot root, but its /etc upper (var/lib/abroot/etc/${abroot:-LABEL}) isn't there: is /var mounted?"
fi
[[ $# -gt 0 ]] || set -- /bin/bash --login

mounted=()
added_policy=no
cleanup() {
    local i
    for ((i = ${#mounted[@]} - 1; i >= 0; i--)); do umount "${mounted[i]}" || true; done
    # (Not `&&`: a false test last would make it, under set -e, the exit status.)
    [[ $added_policy != yes ]] || rm -f "$root/usr/sbin/policy-rc.d"
}
trap cleanup EXIT
if [[ -n $ostree ]]; then
    # What vm-mount mounted, before anything here is.
    pending=()
    while read -r t; do [[ $t == "$mp" ]] || pending+=("${t#"$mp"/}"); done < <(findmnt -R -n -l -o TARGET "$mp")
    # /usr first, so nothing below can write there.
    mount --bind "$root/usr" "$root/usr"
    mounted+=("$root/usr")
    mount -o remount,bind,ro "$root/usr"
    # vm-mount's mounts below MOUNTPOINT, each at the path the deployment
    # has for it, its links followed (home -> var/home): parents first, and
    # a mount whose path only a later bind makes (var/home, by /var's) in a
    # later round.
    while ((${#pending[@]})); do
        left=()
        for rel in "${pending[@]}"; do
            above=no
            for o in "${pending[@]}"; do [[ $rel == "$o"/* ]] && above=yes; done
            at=""
            [[ $above == yes ]] || at=$(python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); import ostree_paths as o
r = o.resolve(sys.argv[2], sys.argv[3]); print(r if r is not None else "")' "$here" "$root" "$rel")
            if [[ -n $at && -d $root/$at ]]; then
                mount --bind "$mp/$rel" "$root/$at"
                mounted+=("$root/$at")
            else
                left+=("$rel")
            fi
        done
        ((${#left[@]} < ${#pending[@]})) || die "the default deployment ($ostree) has no directory for: ${left[*]}"
        pending=("${left[@]}")
    done
    # Read-only, as the booted system has it (sysroot.readonly): the
    # deployment's /ostree links to sysroot/ostree, so a read-write /sysroot
    # would reach the repository and every deployment's /usr.
    mount --bind "$mp" "$root/sysroot"
    mounted+=("$root/sysroot")
    mount -o remount,bind,ro "$root/sysroot"
fi
if [[ -n $abroot ]]; then
    upper=$mp/var/lib/abroot/etc/$abroot
    if [[ ,$(findmnt -n -o OPTIONS --mountpoint "$mp/var"), == *,ro,* ]]; then
        mount -t overlay overlay -o "ro,lowerdir=$upper:$mp/etc" "$mp/etc"
    else
        [[ -d $upper-work ]] || mkdir "$upper-work"
        mount -t overlay overlay -o "lowerdir=$mp/etc,upperdir=$upper,workdir=$upper-work" "$mp/etc"
    fi
    mounted+=("$mp/etc")
fi
for m in proc sys dev dev/pts; do
    mount --bind "/$m" "$root/$m"
    mounted+=("$root/$m")
done
# (On a read-only mount, nothing can be installed anyway.)
if [[ -z $ostree && ! -e $root/usr/sbin/policy-rc.d && -w $root/usr/sbin ]]; then
    printf '#!/bin/sh\nexit 101\n' >"$root/usr/sbin/policy-rc.d"
    chmod 755 "$root/usr/sbin/policy-rc.d"
    added_policy=yes
fi
NEEDRESTART_SUSPEND=1 chroot "$root" "$@"
