#!/usr/bin/env bash
# Run a shell (or a command) inside a test VM's filesystem mounted by vm-mount.
#
# Usage: sudo vm-chroot MOUNTPOINT [COMMAND [ARG...]]
#
# The guest is amd64 like the host, so its programs run directly.  This binds
# the host's /proc, /sys and /dev in, stops package scripts from starting
# services (policy-rc.d) and needrestart from inspecting the host's processes,
# and undoes all of that on exit.  It is still the host's kernel and devices:
# a command such as grub-install must be pointed at the image's /dev/nbdN,
# never at a host disk.
#
# ostree (vm-mount put the physical root at MOUNTPOINT): the root is the
# default deployment (ostree_paths.py's), as at boot: what vm-mount mounted
# below MOUNTPOINT is bound at the deployment's paths for it (/var, /home
# through its var/home link, /boot, /boot/efi), the physical root at
# /sysroot, and the deployment's /usr is read-only.  Its files are hard links
# into the repository, whose checksums cover their content, mode, owner and
# SELinux label: a write there would corrupt the repository unseen.  So
# nothing that installs or rebuilds runs here (rpm-ostree and bootc need the
# booted system); reading does, and `ostree admin --sysroot=/sysroot status`.
#
# For more isolation (its own /proc, hostname and process tree), use instead:
#   sudo systemd-nspawn -D MOUNTPOINT

set -euo pipefail

die() { echo "vm-chroot: $*" >&2; exit 1; }

[[ $# -ge 1 ]] || die "usage: $0 MOUNTPOINT [COMMAND [ARG...]]"
[[ $EUID -eq 0 ]] || die "must run as root"
mp=$(realpath "$1")
shift
here=$(dirname "$(realpath "$0")")
root=$mp ostree=""
# -e, not -f: NixOS's /etc/fstab is a link into /nix/store, which only
# resolves inside the guest (-L for that).
if [[ ! -e $mp/etc/fstab && ! -L $mp/etc/fstab && -d $mp/ostree/deploy ]]; then
    ostree=$(python3 "$here/ostree_paths.py" default "$mp") || die "$mp holds ostree deployments, but no default one"
    root=$mp/$ostree
fi
[[ -e $root/etc/fstab || -L $root/etc/fstab ]] || die "$mp does not look like a mounted guest (run vm-mount first)"
[[ $# -gt 0 ]] || set -- /bin/bash --login

mounted=()
added_policy=no
cleanup() {
    local i
    for ((i = ${#mounted[@]} - 1; i >= 0; i--)); do umount "${mounted[i]}" || true; done
    # (Not `&&`: a false test last would make it, under set -e, the exit status.)
    [[ $added_policy != yes ]] || rm -f "$root/usr/sbin/policy-rc.d"
}
trap cleanup EXIT
if [[ -n $ostree ]]; then
    # What vm-mount mounted, before anything here is.
    pending=()
    while read -r t; do [[ $t == "$mp" ]] || pending+=("${t#"$mp"/}"); done < <(findmnt -R -n -l -o TARGET "$mp")
    # /usr first, so nothing below can write there.
    mount --bind "$root/usr" "$root/usr"
    mounted+=("$root/usr")
    mount -o remount,bind,ro "$root/usr"
    # vm-mount's mounts below MOUNTPOINT, each at the path the deployment
    # has for it, its links followed (home -> var/home): parents first, and
    # a mount whose path only a later bind makes (var/home, by /var's) in a
    # later round.
    while ((${#pending[@]})); do
        left=()
        for rel in "${pending[@]}"; do
            above=no
            for o in "${pending[@]}"; do [[ $rel == "$o"/* ]] && above=yes; done
            at=""
            [[ $above == yes ]] || at=$(python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); import ostree_paths as o
r = o.resolve(sys.argv[2], sys.argv[3]); print(r if r is not None else "")' "$here" "$root" "$rel")
            if [[ -n $at && -d $root/$at ]]; then
                mount --bind "$mp/$rel" "$root/$at"
                mounted+=("$root/$at")
            else
                left+=("$rel")
            fi
        done
        ((${#left[@]} < ${#pending[@]})) || die "the default deployment ($ostree) has no directory for: ${left[*]}"
        pending=("${left[@]}")
    done
    mount --bind "$mp" "$root/sysroot"
    mounted+=("$root/sysroot")
fi
for m in proc sys dev dev/pts; do
    mount --bind "/$m" "$root/$m"
    mounted+=("$root/$m")
done
# (On a read-only mount, nothing can be installed anyway.)
if [[ -z $ostree && ! -e $root/usr/sbin/policy-rc.d && -w $root/usr/sbin ]]; then
    printf '#!/bin/sh\nexit 101\n' >"$root/usr/sbin/policy-rc.d"
    chmod 755 "$root/usr/sbin/policy-rc.d"
    added_policy=yes
fi
NEEDRESTART_SUSPEND=1 chroot "$root" "$@"
