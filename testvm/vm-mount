#!/usr/bin/env bash
# Mount a test VM's disk image on the host, while the VM is off.
#
# Usage: sudo vm-mount [--ro] [--disk IMAGE2]... [--key FILE] IMAGE MOUNTPOINT
#
# Attaches IMAGE (qcow2 or raw) to a free /dev/nbdN, mounts the filesystem that
# holds /etc/fstab at MOUNTPOINT, then the guest's other filesystems from that
# fstab beneath it (swap and noauto entries are skipped).  Look around, or
# use vm-chroot, then undo it all with vm-umount MOUNTPOINT.
#
#   --ro          attach and mount read-only; nothing in the image can change
#   --disk IMAGE2 the guest's other disks (repeatable), e.g. a ZFS mirror's
#                 second half: attached too, their partitions searched as well
#   --key FILE    the passphrase (as a file) that unlocks the guest's LUKS
#                 partitions and its ZFS pool's encryption: a passphrase key,
#                 or the LUKS keystore volume that Ubuntu's installer puts in
#                 the pool to hold the real key
#
# LVM: a volume group on the guest's partitions, arrays or LUKS volumes is
# activated under its own name (read-only with --ro), its logical volumes
# counting as partitions; vm-umount deactivates it.  LVM looks at this
# image's devices only (--devices), with no devices file of this host's,
# and a volume group of the same name already active here is refused.
#
# / may be a partition, a logical volume, a btrfs subvolume, or a ZFS dataset.  A ZFS pool is
# imported from the image's partition only, under a temporary name (so it
# can't clash with a pool of the host's, and the guest's own name is kept),
# with MOUNTPOINT as its altroot; vm-umount exports it again, so the guest
# imports it normally at its next boot.  That needs OpenZFS on the host.
#
# VM_MOUNT_NBD="nbd40 nbd41 ..." limits the nbd devices it may take to those
# (compare.py's COMPARE_NBD sets it).
#
# QEMU locks an image while the VM runs, so this refuses a running VM's disk.
# Never write to a guest's filesystems while it runs.

set -euo pipefail

STATE_DIR=/run/vm-mount
die() { echo "vm-mount: $*" >&2; exit 1; }

ro=no key="" images=()
while [[ $# -gt 0 ]]; do
    case $1 in
        --ro) ro=yes; shift ;;
        --disk) images+=("$(realpath "$2")"); shift 2 ;;
        --key) key=$(realpath "$2"); shift 2 ;;
        -*) die "unknown option $1" ;;
        *) break ;;
    esac
done
[[ $# -eq 2 ]] || die "usage: $0 [--ro] [--disk IMAGE2]... [--key FILE] IMAGE MOUNTPOINT"
[[ $EUID -eq 0 ]] || die "must run as root"
image=$(realpath "$1")
images=("$image" "${images[@]}")
mkdir -p "$2"
mp=$(realpath "$2")
for i in "${images[@]}"; do [[ -f $i ]] || die "no such image: $i"; done
[[ -z $key || -f $key ]] || die "no such key file: $key"
mountpoint -q "$mp" && die "$mp is already a mount point"
state=$STATE_DIR/$(systemd-escape --path "$mp")
[[ -e $state ]] && die "$mp is already in use by vm-mount (see $state)"

[[ -d /sys/module/nbd ]] || modprobe nbd max_part=16
mkdir -p "$STATE_DIR"
# The state file: line 1, the first image's nbd device; further lines, what
# else was set up, as "nbd DEVICE", "md DEVICE", "loop DEVICE", "luks NAME",
# "vg NAME DEVICE,..." (the volume group and the PVs it was activated from)
# or "pool NAME", which
# vm-umount undoes in reverse order.
: >"$state"
undo() { "$(dirname "$(realpath "$0")")/vm-umount" "$mp" >/dev/null 2>&1 || rm -f "$state"; }
devs=()
for i in "${images[@]}"; do
    # Shared with make-from-live.sh: finding a free device and attaching it
    # must be one step, or two at once pick the same device.
    exec 9>/run/lock/backotter-nbd.lock
    flock 9
    dev=""
    for b in /sys/block/nbd*; do
        [[ -n ${VM_MOUNT_NBD:-} && " $VM_MOUNT_NBD " != *" ${b##*/} "* ]] && continue
        # An nbd device is free while no qemu-nbd process serves it.
        if [[ ! -e $b/pid ]]; then dev=/dev/${b##*/}; break; fi
    done
    [[ -n $dev ]] || { flock -u 9; undo; die "no free /dev/nbd device${VM_MOUNT_NBD:+ in VM_MOUNT_NBD}"; }
    info=$(qemu-img info --output=json "$i" 2>&1) ||
        { flock -u 9; undo; die "can't open $i (is the VM running?): $(head -n 1 <<<"$info")"; }
    format=$(python3 -c 'import json, sys; print(json.load(sys.stdin)["format"])' <<<"$info")
    nbd_opts=(--format="$format")
    [[ $ro == yes ]] && nbd_opts+=(--read-only)
    qemu-nbd --connect="$dev" "${nbd_opts[@]}" "$i" ||
        { flock -u 9; undo; die "qemu-nbd could not attach $i (is the VM running?)"; }
    flock -u 9
    if [[ ${#devs[@]} -eq 0 ]]; then echo "$dev" >>"$state"; else echo "nbd $dev" >>"$state"; fi
    devs+=("$dev")
done
trap 'undo; die "failed"' ERR
exec 9>&-       # the nbd lock, not for the commands below (LVM complains of it)
udevadm settle
parts=()
for dev in "${devs[@]}"; do
    for _ in 1 2 3 4 5; do compgen -G "${dev}p*" >/dev/null && break; sleep 1; done
    mapfile -t -O "${#parts[@]}" parts < <(compgen -G "${dev}p*" || true)
done
[[ ${#parts[@]} -gt 0 ]] || { undo; die "no partitions on $image"; }

# mdadm RAID members, assembled into arrays that count as partitions, e.g. a
# /boot mirrored across two disks.  md won't take read-only devices, so with
# --ro a RAID 1 is read through one member instead: its data area, on a
# read-only loop device.  A RAID 10 with two near copies on an even number
# of members (mdadm's default) is a RAID 0 of each pair's first member that
# is there: read so, through device-mapper's striped target over those
# members' data areas, with no md (this host's md may not read a newer
# kernel's superblock: Linux 7's records its logical block size where 6.12's
# expects zeros).  Any other level (RAID 5) is assembled read-only from
# throwaway snapshots of its members (device-mapper's snapshot target, which
# reads its origin only), their copy-on-write space a sparse file vm-umount
# deletes.
declare -A raids=() raid_uuid=()
for p in "${parts[@]}"; do
    [[ $(blkid -s TYPE -o value "$p" || true) == linux_raid_member ]] || continue
    u=$(blkid -s UUID -o value "$p")
    raids[$u]="${raids[$u]:-} $p"
done
n=0
for u in "${!raids[@]}"; do
    # shellcheck disable=SC2206  # the members, one word each
    members=(${raids[$u]})
    # This host's udev may have assembled the array by itself the moment the
    # members appeared (mdadm --incremental, as md126 and up): stop that, so
    # it is set up here as below, and isn't left behind.
    # (This host's LVM may have activated a group on it by itself too: that
    # first, or the array is busy.)
    for m in "${members[@]}"; do
        for h in /sys/class/block/"${m##*/}"/holders/md*; do
            [[ -e $h ]] || continue
            for d in "$h"/holders/dm-*; do
                [[ -e $d ]] && { dmsetup remove "$(cat "$d/dm/name")" || { undo; die "${d##*/} holds ${h##*/}"; }; }
            done
            mdadm --stop "/dev/${h##*/}" >/dev/null || { undo; die "could not stop ${h##*/}, which this host assembled from ${m##*/}"; }
        done
    done
    level=""
    [[ $ro == yes ]] && level=$(mdadm --examine "${members[0]}" | awk -F' : ' '/Raid Level/ { print $2 }')
    if [[ $level == raid10 ]]; then
        info=$(mdadm --examine "${members[0]}")
        ndev=$(awk -F' : ' '/Raid Devices/ { print $2 + 0 }' <<<"$info")
        chunk=$(awk -F' : ' '/Chunk Size/ { print $2 + 0 }' <<<"$info")     # KiB
        size=$(awk -F' : ' '/Array Size/ { print $2 + 0 }' <<<"$info")      # KiB
        if [[ $(awk -F' : ' '/Layout/ { print $2 }' <<<"$info") != near=2 ]] || ((ndev % 2)); then
            echo "vm-mount: skipping the RAID 10 of ${members[*]}: only two near copies on an even number of members can be read with --ro" >&2
            continue
        fi
        unset slot; declare -A slot=()
        for m in "${members[@]}"; do
            r=$(mdadm --examine "$m" | awk -F' : ' '/Device Role/ { print $2 }')
            [[ $r == "Active device "* ]] && slot[${r##* }]=$m
        done
        table="0 $((size * 2)) striped $((ndev / 2)) $((chunk * 2))"
        for ((i = 0; i < ndev; i += 2)); do
            m=${slot[$i]:-${slot[$((i + 1))]:-}}
            [[ -n $m ]] || { table=""; break; }
            # The member itself, from its data offset: a loop device of the
            # data area would show this host's LVM a PV it might activate.
            table+=" $m $(mdadm --examine "$m" | awk -F' : ' '/Data Offset/ { print $2 + 0 }')"
        done
        [[ -n $table ]] || { echo "vm-mount: skipping the RAID 10 of ${members[*]}: a pair has neither member" >&2; continue; }
        c=vm-mount-$$-raid10-$((n++))
        dmsetup create --readonly "$c" --table "$table"
        echo "dm $c" >>"$state"
        udevadm settle
        parts+=("$(realpath "/dev/mapper/$c")")
        raid_uuid[$(realpath "/dev/mapper/$c")]=$(mdadm --examine --export "${members[0]}" | sed -n 's/^MD_UUID=//p')
    elif [[ -n $level && $level != raid1 ]]; then
        cows=()
        for m in "${members[@]}"; do
            f=$(mktemp -p "${TMPDIR:-/tmp}" vm-mount-cow.XXXXXX)
            truncate -s 1G "$f"
            l=$(losetup --find --show "$f")
            c=vm-mount-$$-cow-${m##*/}
            dmsetup create "$c" --table "0 $(blockdev --getsz "$m") snapshot $m $l N 8"
            echo "cow $c $l $f" >>"$state"
            cows+=("/dev/mapper/$c")
        done
        udevadm settle
        # This host's udev may have assembled them by itself, as above.
        for c in "${cows[@]}"; do
            for h in /sys/class/block/"$(basename "$(realpath "$c")")"/holders/md*; do
                [[ -e $h ]] && { mdadm --stop "/dev/${h##*/}" >/dev/null || { undo; die "could not stop ${h##*/}, which this host assembled from $c"; }; }
            done
        done
        modprobe -q raid456 raid10 || true
        md=/dev/md/vm-mount-$$-$((n++))
        if ! mdadm --assemble --readonly --run "$md" "${cows[@]}" >/dev/null 2>&1; then
            echo "vm-mount: skipping the RAID of ${members[*]}: this host's md can't assemble it" >&2
            continue
        fi
        echo "md $md" >>"$state"
        parts+=("$(realpath "$md")")
        raid_uuid[$(realpath "$md")]=$(mdadm --examine --export "${members[0]}" | sed -n 's/^MD_UUID=//p')
    elif [[ $ro == yes ]]; then
        info=$(mdadm --examine "${members[0]}")
        offset=$(awk -F' : ' '/Data Offset/ { print $2 + 0 }' <<<"$info")
        size=$(awk -F' : ' '/Array Size/ { print $2 + 0 }' <<<"$info")
        loop=$(losetup --read-only --find --show --offset $((offset * 512)) \
            --sizelimit $((size * 1024)) "${members[0]}")
        echo "loop $loop" >>"$state"
        parts+=("$loop")
        raid_uuid[$loop]=$(mdadm --examine --export "${members[0]}" | sed -n 's/^MD_UUID=//p')
    else
        modprobe -q raid1 raid456 raid10 || true
        md=/dev/md/vm-mount-$$-$((n++))
        # Writing to one member alone would leave the mirror's halves
        # different, unknown to md, so there is no fallback here.  (A newer
        # guest's superblock may be one this host's md can't read.)
        if ! mdadm --assemble --run "$md" "${members[@]}" >/dev/null 2>&1; then
            echo "vm-mount: skipping the RAID of ${members[*]}: this host's md can't assemble it (try --ro)" >&2
            continue
        fi
        echo "md $md" >>"$state"
        parts+=("$(realpath "$md")")
        raid_uuid[$(realpath "$md")]=$(mdadm --examine --export "${members[0]}" | sed -n 's/^MD_UUID=//p')
    fi
    udevadm settle
done

# LUKS partitions, opened with --key; the opened devices count as partitions.
for p in "${parts[@]}"; do
    [[ $(blkid -s TYPE -o value "$p" || true) == crypto_LUKS ]] || continue
    [[ -n $key ]] || { echo "vm-mount: $p is LUKS-encrypted; skipped (no --key)" >&2; continue; }
    name=vm-mount-$$-${p##*/}
    # The passphrase without the file's final newline, as typed at boot.
    tr -d '\n' <"$key" | cryptsetup open $([[ $ro == yes ]] && echo --readonly) --key-file - "$p" "$name" ||
        { undo; die "could not unlock $p with $key"; }
    echo "luks $name" >>"$state"
    udevadm settle
    parts+=("/dev/mapper/$name")
done

# LVM physical volumes: their volume groups activated, the logical volumes
# counted as partitions.
pvs=()
for p in "${parts[@]}"; do
    [[ $(blkid -s TYPE -o value "$p" || true) == LVM2_member ]] && pvs+=("$(realpath "$p")")
done
if [[ ${#pvs[@]} -gt 0 ]]; then
    pvlist=$(IFS=,; echo "${pvs[*]}")
    lvm_opts=(--devicesfile "" --devices "$pvlist")
    # The PVs' device numbers, as dmsetup deps prints them: "(MAJOR, MINOR)".
    ours=$(for p in "${pvs[@]}"; do stat -L -c '%t %T' "$p"; done | while read -r ma mi; do
        printf '(%d, %d)\n' "0x$ma" "0x$mi"; done)
    for vg in $(vgs "${lvm_opts[@]}" --noheadings -o vg_name 2>/dev/null | sort -u); do
        # A VG's name in read_only_volume_list covers all of its LVs ("*"
        # there would match only a VG named "*").
        ro_cfg=()
        [[ $ro == yes ]] && ro_cfg=(--config "activation { read_only_volume_list = [ \"$vg\" ] }")
        # device-mapper names a VG's volumes VG-LV, with VG's dashes doubled.
        # Active already: on this image's PVs when this host's LVM activated
        # it by itself as they appeared (event activation), which is undone
        # here to activate it as below; on others, it's another group of
        # the same name (another mount of this guest, or the host's own).
        active=$(dmsetup ls 2>/dev/null | awk '{ print $1 }' | grep "^${vg//-/--}-[^-]" || true)
        for lv in $active; do
            dmsetup deps -o devno "$lv" | grep -o '([0-9]*, [0-9]*)' | grep -qvxF "$ours" &&
                { undo; die "a volume group named $vg is already active on this host"; }
        done
        [[ -n $active ]] && { vgchange "${lvm_opts[@]}" -a n "$vg" >/dev/null || { undo; die "could not deactivate $vg"; }; }
        vgchange "${lvm_opts[@]}" "${ro_cfg[@]}" -a y "$vg" >/dev/null || { undo; die "could not activate volume group $vg"; }
        echo "vg $vg $pvlist" >>"$state"
        udevadm settle
        while read -r lv; do
            [[ -n $lv && -b $lv ]] && parts+=("$(realpath "$lv")")
        done < <(lvs "${lvm_opts[@]}" --noheadings -o lv_dm_path "$vg" 2>/dev/null | tr -d ' ')
    done
fi

# Resolve fstab's device names against this image's partitions only, never
# the host's disks (a cloned image may share UUIDs with something else).
resolve() {
    local spec=$1 p
    for p in "${parts[@]}"; do
        # Both spellings: UUID=... and /dev/disk/by-uuid/... (Ubuntu's installer).
        case $spec in
            UUID=*|/dev/disk/by-uuid/*)
                [[ $(blkid -s UUID -o value "$p") == "${spec##*[=/]}" ]] && { echo "$p"; return; } ;;
            PARTUUID=*|/dev/disk/by-partuuid/*)
                [[ $(blkid -s PARTUUID -o value "$p") == "${spec##*[=/]}" ]] && { echo "$p"; return; } ;;
            /dev/disk/by-id/md-uuid-*)
                [[ ${raid_uuid[$p]:-} == "${spec#*md-uuid-}" ]] && { echo "$p"; return; } ;;
            LABEL=*|/dev/disk/by-label/*)
                [[ $(blkid -s LABEL -o value "$p") == "${spec##*[=/]}" ]] && { echo "$p"; return; } ;;
            # A logical volume, as /dev/mapper/VG-LV or /dev/VG/LV: activated
            # above under the guest's own names.
            /dev/mapper/*|/dev/*/*)
                [[ -b $spec && $(realpath "$spec") == "$(realpath "$p")" ]] && { echo "$p"; return; } ;;
        esac
    done
    return 1
}

# mount_fs DEVICE TARGET [OPTIONS]; read-only mounts must not replay a
# journal or log, since that would mean writing.
mount_fs() {
    local opts=$3
    if [[ $ro == yes ]]; then
        case $(blkid -s TYPE -o value "$1") in
            ext3|ext4) opts=ro,noload${opts:+,$opts} ;;   # ext2 has no journal, and rejects noload
            btrfs) opts=ro,rescue=nologreplay${opts:+,$opts} ;;
            xfs|f2fs|nilfs2) opts=ro,norecovery${opts:+,$opts} ;;
            bcachefs) opts=ro,nochanges${opts:+,$opts} ;;
            *) opts=ro${opts:+,$opts} ;;
        esac
    fi
    mount ${opts:+-o "$opts"} "$1" "$2"
}
# guest_file ROOT PATH: PATH inside the guest mounted at ROOT, its symlinks
# followed as the guest would follow them (an absolute link means ROOT/...,
# never the host's file), as a host path; fails if there is no such file.
# NixOS's /etc/fstab, for one, is a link into /nix/store.
guest_file() {
    python3 - "$1" "$2" <<'PY'
import os, sys
root, path = sys.argv[1], sys.argv[2]
parts, done, hops = path.strip("/").split("/"), [], 0
while parts:
    name = parts.pop(0)
    if name in ("", "."):
        continue
    if name == "..":
        done = done[:-1]
        continue
    host = os.path.join(root, *done, name)
    if os.path.islink(host):
        hops += 1
        if hops > 40:
            sys.exit(1)
        target = os.readlink(host)
        if target.startswith("/"):
            done = []
        parts = target.strip("/").split("/") + parts
        continue
    done.append(name)
host = os.path.join(root, *done)
if not os.path.isfile(host):
    sys.exit(1)
print(host)
PY
}
# The btrfs subvolume options (subvol=, subvolid=) from fstab options on stdin.
subvol_opts() { tr ',' '\n' | grep -E '^subvol(id)?=' | paste -sd, - || true; }

# Find /: the filesystem whose /etc/fstab this is.  On btrfs it is usually
# in a subvolume: one level down from the top level (Debian's installer uses
# @rootfs, Fedora's root), in which case mount the subvolume fstab names for
# /, or the default subvolume (openSUSE's snapper makes that a snapshot,
# @/.snapshots/1/snapshot), which fstab doesn't name.
# load_zfs_keys POOL: with --key, load the keys of POOL's locked encryption
# roots: from the LUKS keystore volume POOL/keystore if there is one (the key
# file inside it), else the passphrase itself.
load_zfs_keys() {
    local pool=$1 roots ks tmp keyfile r
    roots=$(zfs get -H -r -o name,value keystatus "$pool" | awk '$2 == "unavailable" { print $1 }')
    [[ -n $roots && -n $key ]] || return 0
    ks=/dev/zvol/$pool/keystore
    keyfile=$key
    if zfs list "$pool/keystore" >/dev/null 2>&1; then
        udevadm settle
        for _ in 1 2 3 4 5; do [[ -e $ks ]] && break; sleep 1; done
        tr -d '\n' <"$key" | cryptsetup open --readonly --key-file - "$ks" "vm-mount-$$-keystore" || return 1
        tmp=$(mktemp -d)
        mount -o ro "/dev/mapper/vm-mount-$$-keystore" "$tmp"
        keyfile=$(find "$tmp" -maxdepth 1 -name '*.key' | head -n 1)
    fi
    for r in $(zfs get -H -r -o name,value encryptionroot "$pool" | awk '$1 == $2 { print $1 }'); do
        grep -qx "$r" <<<"$roots" && zfs load-key -L "file://$keyfile" "$r"
    done
    if [[ -n ${tmp:-} ]]; then
        umount "$tmp"; rmdir "$tmp"
        cryptsetup close "vm-mount-$$-keystore"
    fi
}
# mount_zfs_root PARTITION: import the pool on it and mount its / dataset at
# $mp; fails (leaving nothing imported) if there is no such dataset.
mount_zfs_root() {
    local p=$1 id name rootds q search=()
    command -v zpool >/dev/null || { echo "vm-mount: $p is ZFS, but this host has no OpenZFS" >&2; return 1; }
    # Every ZFS partition of the guest's disks, so a mirror's halves are found.
    for q in "${parts[@]}"; do
        [[ $(blkid -s TYPE -o value "$q" || true) == zfs_member ]] && search+=(-d "$q")
    done
    id=$(zpool import -d "$p" 2>/dev/null | awk '$1 == "id:" { print $2; exit }')
    [[ -n $id ]] || return 1
    name=vm-mount-$$
    local opts=(-N -f "${search[@]}" -R "$mp")
    [[ $ro == yes ]] && opts+=(-o readonly=on)
    # -f: a root pool is never exported by the guest itself.
    zpool import "${opts[@]}" -t "$id" "$name" || return 1
    echo "pool $name" >>"$state"
    load_zfs_keys "$name"
    # With an altroot, zfs list shows mountpoints under it: / appears as $mp.
    # The pool's own top dataset often says / too, but with canmount=off.
    rootds=$(zfs list -H -o name,canmount,mountpoint -r "$name" |
        awk -v root="$mp" '$2 != "off" && $3 == root { print $1; exit }')
    if [[ -z $rootds ]]; then
        zpool export "$name"
        sed -i '$d' "$state"
        return 1
    fi
    if [[ $(zfs get -H -o value keystatus "$rootds") == unavailable ]]; then
        echo "vm-mount: $rootds is encrypted and locked (give --key)" >&2
        zpool export "$name"
        sed -i '$d' "$state"
        return 1
    fi
    # Ubuntu's root dataset is canmount=noauto, so mount it by name; then the
    # pool's datasets that mount by themselves.
    zfs mount "$rootds"
    zfs list -H -o name,canmount,mountpoint -r "$name" |
        awk '$2 == "on" && $3 != "none" && $3 != "legacy" { print $1 }' |
        while read -r ds; do zfs mount "$ds" 2>/dev/null || true; done
}

root=""
for p in "${parts[@]}"; do
    type=$(blkid -s TYPE -o value "$p" || true)
    [[ -z $type || $type == swap ]] && continue
    if [[ $type == zfs_member ]]; then
        mount_zfs_root "$p" || continue
        if [[ -f $mp/etc/fstab ]]; then root=$p; break; fi
        umount -R "$mp"
        zpool export "$(tail -n 1 "$state" | cut -d' ' -f2)"
        sed -i '$d' "$state"
        continue
    fi
    top=""
    [[ $type == btrfs ]] && top=subvolid=5   # the top level, whatever the default
    mount_fs "$p" "$mp" "$top" 2>/dev/null || continue
    fstab=$(guest_file "$mp" /etc/fstab || true)
    if [[ -z $fstab && $type == btrfs ]]; then
        # One level down: the subvolume's fstab.
        fstab=$(compgen -G "$mp/*/etc/fstab" | head -n 1 || true)
        if [[ -z $fstab ]]; then
            umount "$mp"
            mount_fs "$p" "$mp" "" 2>/dev/null || continue
            if guest_file "$mp" /etc/fstab >/dev/null; then root=$p; break; fi
        fi
    fi
    if [[ -z $fstab ]]; then umount "$mp"; continue; fi
    root=$p
    if [[ $fstab == "$mp"/*/etc/fstab && ! -e $mp/etc ]]; then
        sub=$(awk '!/^[[:space:]]*#/ && $2 == "/" { print $4 }' "$fstab" | subvol_opts)
        [[ -n $sub ]] || sub=subvol=$(basename "$(dirname "$(dirname "$fstab")")")
        umount "$mp"
        mount_fs "$p" "$mp" "$sub"
    fi
    break
done
[[ -n $root ]] || { undo; die "no partition holds /etc/fstab"; }

# The guest's other ZFS pools (Ubuntu's bpool, /boot): those with a dataset
# that mounts somewhere ZFS itself mounts it, not through fstab.  A
# canmount=noauto dataset (Ubuntu's bpool/BOOT/ubuntu_X) is mounted when its
# last name part is the root dataset's.
if command -v zpool >/dev/null; then
    rootsuffix=$(zfs list -H -o name,mountpoint 2>/dev/null | awk -v root="$mp" '$2 == root { n = $1; sub(/.*\//, "", n); print n; exit }')
    n=0
    while read -r id; do
        [[ -n $id ]] || continue
        n=$((n + 1))
        name=vm-mount-$$-$n
        search=()
        for q in "${parts[@]}"; do
            [[ $(blkid -s TYPE -o value "$q" || true) == zfs_member ]] && search+=(-d "$q")
        done
        opts=(-N -f "${search[@]}" -R "$mp")
        [[ $ro == yes ]] && opts+=(-o readonly=on)
        zpool import "${opts[@]}" -t "$id" "$name" || continue
        echo "pool $name" >>"$state"
        load_zfs_keys "$name"
        zfs list -H -o name,canmount,mountpoint -r "$name" |
            awk -v sfx="$rootsuffix" '$3 != "none" && $3 != "legacy" { n = $1; sub(/.*\//, "", n); if ($2 == "on" || ($2 == "noauto" && n == sfx)) print $1 }' |
            while read -r ds; do zfs mount "$ds" 2>/dev/null || true; done
    done < <(
        # Pools on the guest's partitions that aren't imported yet.
        imported=$(zpool list -H -o guid 2>/dev/null)
        for q in "${parts[@]}"; do
            [[ $(blkid -s TYPE -o value "$q" || true) == zfs_member ]] || continue
            zpool import -d "$q" 2>/dev/null | awk '$1 == "id:" { print $2 }'
        done | sort -u | grep -vxF "${imported:-none}" || true
    )
fi

# The guest's other filesystems, parents before children.
while read -r spec target type options; do
    [[ $target == / || $type == swap || $target != /* || ,$options, == *,noauto,* ]] && continue
    p=$(resolve "$spec") || { echo "vm-mount: skipping $target: $spec is not on this image" >&2; continue; }
    mount_fs "$p" "$mp$target" "$(subvol_opts <<<"$options")"
done < <(awk '!/^[[:space:]]*(#|$)/ { print $1, $2, $3, $4 }' "$(guest_file "$mp" /etc/fstab)" |
    awk '{ print gsub("/", "/", $2), $0 }' | sort -n | cut -d' ' -f2-)

trap - ERR
how=read-write
[[ $ro == yes ]] && how=read-only
echo "Mounted $image ($dev, $how) at $mp:"
findmnt -R -n -o TARGET,SOURCE,FSTYPE "$mp" | sed 's/^/  /'
