#!/usr/bin/env bash
# Mount a test VM's disk image on the host, while the VM is off.
#
# Usage: sudo vm-mount [--ro] [--disk IMAGE2]... [--key FILE] IMAGE MOUNTPOINT
#
# Attaches IMAGE (qcow2 or raw) to a free /dev/nbdN, mounts the filesystem that
# holds /etc/fstab at MOUNTPOINT, then the guest's other filesystems from that
# fstab beneath it (swap and noauto entries are skipped).  Look around, or
# use vm-chroot, then undo it all with vm-umount MOUNTPOINT.
#
#   --ro          attach and mount read-only; nothing in the image can change
#   --disk IMAGE2 the guest's other disks (repeatable), e.g. a ZFS mirror's
#                 second half: attached too, their partitions searched as well
#   --key FILE    the passphrase (as a file) that unlocks the guest's LUKS
#                 partitions and its ZFS pool's encryption: a passphrase key,
#                 or the LUKS keystore volume that Ubuntu's installer puts in
#                 the pool to hold the real key
#
# LVM: the logical volumes of a volume group on the guest's partitions,
# arrays or LUKS volumes are set up as device-mapper devices named
# vmm-nbdN-VG-LV (read-only with --ro), from the group's metadata, and count
# as partitions; fstab's /dev/mapper/VG-LV and the like resolve to them, and
# vm-umount removes them.  So two guests whose groups share a name
# (ubuntu-vg), or two mounts of one guest, can be mounted at once.  A group
# with a thin, cache or RAID LV, or a snapshot, is activated by LVM itself,
# under its own name, which another group of that name active here makes it refuse.  LVM
# looks at this image's devices only (--devices), with no devices file of
# this host's.  Under vm-chroot, the LVs aren't at the guest's own
# /dev/mapper names: don't make an initramfs or grub.cfg there.
#
# ostree (Fedora's atomic desktops, Bazzite): MOUNTPOINT gets the physical
# root (fstab's /, which holds ostree/repo and the deployments), with the
# default deployment's fstab mounted beneath it: /boot, /boot/efi, /home,
# /var.  That is the tree load's mount stage makes, and what a backup of
# the system holds; the composefs / it boots from is made from it at boot.
# vm-chroot runs commands in the default deployment, with /usr read-only.
#
# ABRoot (Vanilla OS): MOUNTPOINT gets the present root (the one the master
# grub.cfg's default boots), with /var, /boot, /boot/efi, the init LV at
# /boot/init and the other root at /part-future beneath it: the tree
# bko-holt's dump lists (mount_abroot below).  / is read raw (its /etc is
# the lower); vm-chroot runs commands with /etc as the guest's overlay.
# The roots are thin LVs, so vos-root is activated by LVM: refused while a
# group of that name is active here (another Vanilla OS disk's).
#
# / may be a partition, a logical volume, a btrfs subvolume, or a ZFS dataset.  A ZFS pool is
# imported from the image's partition only, under a temporary name (so it
# can't clash with a pool of the host's, and the guest's own name is kept),
# with MOUNTPOINT as its altroot; vm-umount exports it again, so the guest
# imports it normally at its next boot.  That needs OpenZFS on the host.
# A dataset whose mount point is ZFS's default, made of the pool's name
# (Proxmox's rpool at /rpool, rpool/data at /rpool/data), is mounted at that
# path under the guest's own pool name, not the temporary one; one whose
# mount point directory isn't in its parent is skipped (nothing is made).
#
# VM_MOUNT_NBD="nbd40 nbd41 ..." limits the nbd devices it may take to those
# (compare.py's COMPARE_NBD sets it).
#
# QEMU locks an image while the VM runs, so this refuses a running VM's disk.
# Never write to a guest's filesystems while it runs.
# A vm-store object (testvm/vm-store) is never written: it mounts only with --ro.

set -euo pipefail

STATE_DIR=/run/vm-mount
die() { echo "vm-mount: $*" >&2; exit 1; }
# Whether FILE is a vm-store object (as in vm-run): by path, not -w.
in_store() {
    local d
    d=$(realpath -- "$1" 2>/dev/null) || return 1
    d=${d%/*}
    while [[ $d == /?* ]]; do
        [[ ${d##*/} == objects && -f ${d%/*}/store.json ]] && return 0
        d=${d%/*}
    done
    return 1
}

ro=no key="" images=()
while [[ $# -gt 0 ]]; do
    case $1 in
        --ro) ro=yes; shift ;;
        --disk) images+=("$(realpath "$2")"); shift 2 ;;
        --key) key=$(realpath "$2"); shift 2 ;;
        -*) die "unknown option $1" ;;
        *) break ;;
    esac
done
[[ $# -eq 2 ]] || die "usage: $0 [--ro] [--disk IMAGE2]... [--key FILE] IMAGE MOUNTPOINT"
if [[ $ro == no ]]; then
    for i in "$1" "${images[@]}"; do
        if in_store "$i"; then die "$(realpath -- "$i") is a vm-store object: mount it with --ro"; fi
    done
fi
[[ $EUID -eq 0 ]] || die "must run as root"
image=$(realpath "$1")
images=("$image" "${images[@]}")
mkdir -p "$2"
mp=$(realpath "$2")
for i in "${images[@]}"; do [[ -f $i ]] || die "no such image: $i"; done
[[ -z $key || -f $key ]] || die "no such key file: $key"
mountpoint -q "$mp" && die "$mp is already a mount point"
state=$STATE_DIR/$(systemd-escape --path "$mp")
[[ -e $state ]] && die "$mp is already in use by vm-mount (see $state)"

[[ -d /sys/module/nbd ]] || modprobe nbd max_part=16
mkdir -p "$STATE_DIR"
# The state file: line 1, the first image's nbd device; further lines, what
# else was set up, as "nbd DEVICE", "md DEVICE", "loop DEVICE", "luks NAME",
# "vg NAME DEVICE,..." (the volume group and the PVs LVM activated it from),
# "lvm NAME DEVICE,..." and "lv VG LV DMNAME" (a group set up by hand, and
# each of its LVs, a record), "dm NAME" or "pool NAME", which vm-umount
# undoes in reverse order.
: >"$state"
undo() { "$(dirname "$(realpath "$0")")/vm-umount" "$mp" >/dev/null 2>&1 || rm -f "$state"; }
devs=()
for i in "${images[@]}"; do
    # Shared with make-from-live.sh: finding a free device and attaching it
    # must be one step, or two at once pick the same device.
    exec 9>/run/lock/backotter-nbd.lock
    flock 9
    dev=""
    for b in /sys/block/nbd*; do
        [[ -n ${VM_MOUNT_NBD:-} && " $VM_MOUNT_NBD " != *" ${b##*/} "* ]] && continue
        # An nbd device is free while no qemu-nbd process serves it.
        if [[ ! -e $b/pid ]]; then dev=/dev/${b##*/}; break; fi
    done
    [[ -n $dev ]] || { flock -u 9; undo; die "no free /dev/nbd device${VM_MOUNT_NBD:+ in VM_MOUNT_NBD}"; }
    info=$(qemu-img info --output=json "$i" 2>&1) ||
        { flock -u 9; undo; die "can't open $i (is the VM running?): $(head -n 1 <<<"$info")"; }
    format=$(python3 -c 'import json, sys; print(json.load(sys.stdin)["format"])' <<<"$info")
    nbd_opts=(--format="$format")
    [[ $ro == yes ]] && nbd_opts+=(--read-only)
    qemu-nbd --connect="$dev" "${nbd_opts[@]}" "$i" ||
        { flock -u 9; undo; die "qemu-nbd could not attach $i (is the VM running?)"; }
    flock -u 9
    if [[ ${#devs[@]} -eq 0 ]]; then echo "$dev" >>"$state"; else echo "nbd $dev" >>"$state"; fi
    devs+=("$dev")
done
trap 'undo; die "failed"' ERR
exec 9>&-       # the nbd lock, not for the commands below (LVM complains of it)
udevadm settle
parts=()
for dev in "${devs[@]}"; do
    for _ in 1 2 3 4 5; do compgen -G "${dev}p*" >/dev/null && break; sleep 1; done
    mapfile -t -O "${#parts[@]}" parts < <(compgen -G "${dev}p*" || true)
done
[[ ${#parts[@]} -gt 0 ]] || { undo; die "no partitions on $image"; }

# mdadm RAID members, assembled into arrays that count as partitions, e.g. a
# /boot mirrored across two disks.  md won't take read-only devices, so with
# --ro a RAID 1 is read through one member instead: its data area, on a
# read-only loop device.  A RAID 10 with two near copies on an even number
# of members (mdadm's default) is a RAID 0 of each pair's first member that
# is there: read so, through device-mapper's striped target over those
# members' data areas, with no md (this host's md may not read a newer
# kernel's superblock: Linux 7's records its logical block size where 6.12's
# expects zeros).  Any other level (RAID 5) is assembled read-only from
# throwaway snapshots of its members (device-mapper's snapshot target, which
# reads its origin only), their copy-on-write space a sparse file vm-umount
# deletes.
declare -A raids=() raid_uuid=()
for p in "${parts[@]}"; do
    [[ $(blkid -s TYPE -o value "$p" || true) == linux_raid_member ]] || continue
    u=$(blkid -s UUID -o value "$p")
    raids[$u]="${raids[$u]:-} $p"
done
# This host's udev may have assembled an array by itself the moment DEV, one
# of its members, appeared (mdadm --incremental, as md126 and up): stop that,
# so it is set up here as below, and isn't left behind.  This host's LVM may
# have activated a group on it by itself too (event activation): that first,
# or the array is busy.
release_host_md() {
    local h d
    for h in /sys/class/block/"$(basename "$(realpath "$1")")"/holders/md*; do
        [[ -e $h ]] || continue
        for d in "$h"/holders/dm-*; do
            [[ -e $d ]] && { dmsetup remove "$(cat "$d/dm/name")" || { undo; die "${d##*/} holds ${h##*/}"; }; }
        done
        mdadm --stop "/dev/${h##*/}" >/dev/null || { undo; die "could not stop ${h##*/}, which this host assembled from ${1##*/}"; }
    done
}
n=0
for u in "${!raids[@]}"; do
    # shellcheck disable=SC2206  # the members, one word each
    members=(${raids[$u]})
    for m in "${members[@]}"; do release_host_md "$m"; done
    level=""
    [[ $ro == yes ]] && level=$(mdadm --examine "${members[0]}" | awk -F' : ' '/Raid Level/ { print $2 }')
    if [[ $level == raid10 ]]; then
        info=$(mdadm --examine "${members[0]}")
        ndev=$(awk -F' : ' '/Raid Devices/ { print $2 + 0 }' <<<"$info")
        chunk=$(awk -F' : ' '/Chunk Size/ { print $2 + 0 }' <<<"$info")     # KiB
        size=$(awk -F' : ' '/Array Size/ { print $2 + 0 }' <<<"$info")      # KiB
        if [[ $(awk -F' : ' '/Layout/ { print $2 }' <<<"$info") != near=2 ]] || ((ndev % 2)); then
            echo "vm-mount: skipping the RAID 10 of ${members[*]}: only two near copies on an even number of members can be read with --ro" >&2
            continue
        fi
        unset slot; declare -A slot=()
        for m in "${members[@]}"; do
            r=$(mdadm --examine "$m" | awk -F' : ' '/Device Role/ { print $2 }')
            [[ $r == "Active device "* ]] && slot[${r##* }]=$m
        done
        table="0 $((size * 2)) striped $((ndev / 2)) $((chunk * 2))"
        for ((i = 0; i < ndev; i += 2)); do
            m=${slot[$i]:-${slot[$((i + 1))]:-}}
            [[ -n $m ]] || { table=""; break; }
            # The member itself, from its data offset: a loop device of the
            # data area would show this host's LVM a PV it might activate.
            table+=" $m $(mdadm --examine "$m" | awk -F' : ' '/Data Offset/ { print $2 + 0 }')"
        done
        [[ -n $table ]] || { echo "vm-mount: skipping the RAID 10 of ${members[*]}: a pair has neither member" >&2; continue; }
        c=vm-mount-$$-raid10-$((n++))
        dmsetup create --readonly "$c" --table "$table"
        echo "dm $c" >>"$state"
        udevadm settle
        parts+=("$(realpath "/dev/mapper/$c")")
        raid_uuid[$(realpath "/dev/mapper/$c")]=$(mdadm --examine --export "${members[0]}" | sed -n 's/^MD_UUID=//p')
    elif [[ -n $level && $level != raid1 ]]; then
        cows=()
        for m in "${members[@]}"; do
            f=$(mktemp -p "${TMPDIR:-/tmp}" vm-mount-cow.XXXXXX)
            truncate -s 1G "$f"
            l=$(losetup --find --show "$f")
            c=vm-mount-$$-cow-${m##*/}
            dmsetup create "$c" --table "0 $(blockdev --getsz "$m") snapshot $m $l N 8"
            echo "cow $c $l $f" >>"$state"
            cows+=("/dev/mapper/$c")
        done
        udevadm settle
        # This host's udev (and LVM) may have assembled them by itself, as above.
        for c in "${cows[@]}"; do release_host_md "$c"; done
        modprobe -q raid456 raid10 || true
        md=/dev/md/vm-mount-$$-$((n++))
        if ! mdadm --assemble --readonly --run "$md" "${cows[@]}" >/dev/null 2>&1; then
            echo "vm-mount: skipping the RAID of ${members[*]}: this host's md can't assemble it" >&2
            continue
        fi
        echo "md $md" >>"$state"
        parts+=("$(realpath "$md")")
        raid_uuid[$(realpath "$md")]=$(mdadm --examine --export "${members[0]}" | sed -n 's/^MD_UUID=//p')
    elif [[ $ro == yes ]]; then
        info=$(mdadm --examine "${members[0]}")
        offset=$(awk -F' : ' '/Data Offset/ { print $2 + 0 }' <<<"$info")
        size=$(awk -F' : ' '/Array Size/ { print $2 + 0 }' <<<"$info")
        loop=$(losetup --read-only --find --show --offset $((offset * 512)) \
            --sizelimit $((size * 1024)) "${members[0]}")
        echo "loop $loop" >>"$state"
        parts+=("$loop")
        raid_uuid[$loop]=$(mdadm --examine --export "${members[0]}" | sed -n 's/^MD_UUID=//p')
    else
        modprobe -q raid1 raid456 raid10 || true
        md=/dev/md/vm-mount-$$-$((n++))
        # Writing to one member alone would leave the mirror's halves
        # different, unknown to md, so there is no fallback here.  (A newer
        # guest's superblock may be one this host's md can't read.)
        if ! mdadm --assemble --run "$md" "${members[@]}" >/dev/null 2>&1; then
            echo "vm-mount: skipping the RAID of ${members[*]}: this host's md can't assemble it (try --ro)" >&2
            continue
        fi
        echo "md $md" >>"$state"
        parts+=("$(realpath "$md")")
        raid_uuid[$(realpath "$md")]=$(mdadm --examine --export "${members[0]}" | sed -n 's/^MD_UUID=//p')
    fi
    udevadm settle
done

# LUKS partitions, opened with --key; the opened devices count as partitions.
# open_luks FROM: those from parts[FROM] on.  Called again after LVM below,
# for LUKS on a logical volume (ABRoot's encrypted /var, on vos-var/var).
open_luks() {
    local p name
    for p in "${parts[@]:$1}"; do
        [[ $(blkid -s TYPE -o value "$p" || true) == crypto_LUKS ]] || continue
        [[ -n $key ]] || { echo "vm-mount: $p is LUKS-encrypted; skipped (no --key)" >&2; continue; }
        name=vm-mount-$$-${p##*/}
        # The passphrase without the file's final newline, as typed at boot.
        tr -d '\n' <"$key" | cryptsetup open $([[ $ro == yes ]] && echo --readonly) --key-file - "$p" "$name" ||
            { undo; die "could not unlock $p with $key"; }
        echo "luks $name" >>"$state"
        udevadm settle || true
        parts+=("/dev/mapper/$name")
    done
}
open_luks 0

# LVM physical volumes: each volume group's logical volumes set up as
# device-mapper devices under names of this mount's own (TAG-VG-LV, TAG from
# the first image's nbd device), from the group's metadata, and counted as
# partitions.  LVM itself activates nothing: its names are the host's, and
# two guests' groups often share one (ubuntu-vg), as do two mounts of one
# guest.  The guest's own names for them (/dev/mapper/VG-LV, /dev/VG/LV,
# /dev/disk/by-id/dm-name-... and dm-uuid-LVM-...) are resolved in fstab to
# those devices.  A group with an LV of another type than linear or striped
# (thin, cache, raid), or a classic snapshot, is activated by LVM as it was
# before, under its own names, and refused if a group of that name is active
# here already.
declare -A lvdev=()
pvs=()
before_lvm=${#parts[@]}
for p in "${parts[@]}"; do
    [[ $(blkid -s TYPE -o value "$p" || true) == LVM2_member ]] && pvs+=("$(realpath "$p")")
done
if [[ ${#pvs[@]} -gt 0 ]]; then
    pvlist=$(IFS=,; echo "${pvs[*]}")
    lvm_opts=(--devicesfile "" --devices "$pvlist")
    # (The process substitutions' descriptors, which LVM would warn of.)
    export LVM_SUPPRESS_FD_WARNINGS=1
    tag=vmm-${devs[0]##*/}
    # The PVs' kernel names (nbd0p3), as dm_leaves prints them.
    ours=$(for p in "${pvs[@]}"; do echo "${p##*/}"; done)
    # dm_leaves NAME: the block devices below device-mapper device NAME,
    # through any devices stacked between (a thin LV's pool and its data and
    # metadata LVs), one kernel name a line; one of the PVs (a LUKS volume's
    # dm-N) is as far as it goes.
    dm_leaves() {
        local d
        d=$(realpath "/dev/mapper/$1" 2>/dev/null) || return 0
        leaves_of "${d##*/}"
    }
    leaves_of() {
        local s below=no
        grep -qxF "$1" <<<"$ours" && { echo "$1"; return 0; }
        for s in "/sys/class/block/$1/slaves/"*; do
            [[ -e $s ]] || continue
            below=yes
            leaves_of "${s##*/}"
        done
        [[ $below == yes ]] || echo "$1"
    }
    declare -A pestart=()
    while IFS='|' read -r pv start; do
        pv=${pv// /}; [[ -n $pv ]] && pestart[$(realpath "$pv")]=${start// /}
    done < <(pvs "${lvm_opts[@]}" --noheadings --separator '|' --units s --nosuffix -o pv_name,pe_start 2>/dev/null)
    for vg in $(vgs "${lvm_opts[@]}" --noheadings -o vg_name 2>/dev/null | sort -u); do
        # device-mapper names a VG's volumes VG-LV, with VG's dashes doubled.
        # Active already on this image's PVs when this host's LVM activated it
        # by itself as they appeared (event activation): undone here.  On
        # others, it's another group of the same name (another guest's, or a
        # mount of this one): no matter, but for a group LVM activates below.
        active=$(dmsetup ls 2>/dev/null | awk '{ print $1 }' | grep "^${vg//-/--}-[^-]" || true)
        mine=no others=no
        for lv in $active; do
            # Down any stack of device-mapper devices (a thin LV's pool) to the disks.
            # (All read: grep -q's early exit would break dm_leaves' pipe, under pipefail.)
            if [[ -n $(dm_leaves "$lv" | grep -vxF "$ours") ]]; then others=yes; else mine=yes; fi
        done
        [[ $mine == yes ]] && { vgchange "${lvm_opts[@]}" -a n "$vg" >/dev/null || { undo; die "could not deactivate $vg"; }; }
        types=$(lvs "${lvm_opts[@]}" --noheadings --segments -o segtype "$vg" 2>/dev/null | tr -d ' ' | sort -u)
        # A classic snapshot and its origin have linear segments too, but are
        # no plain mapping of their extents (lv_attr o, O, s or S).
        snaps=$(lvs "${lvm_opts[@]}" --noheadings -o lv_attr "$vg" 2>/dev/null | tr -d ' ' | grep '^[oOsS]' || true)
        if [[ -z $(grep -vxE 'linear|striped' <<<"$types" || true) && -z $snaps ]]; then
            esz=$(vgs "${lvm_opts[@]}" --noheadings --units s --nosuffix -o vg_extent_size "$vg" | tr -d ' ')
            echo "lvm $vg $pvlist" >>"$state"
            while IFS='|' read -r lv lvuuid vguuid; do
                lv=${lv// /} lvuuid=${lvuuid// /} vguuid=${vguuid// /}
                [[ -n $lv ]] || continue
                table=""
                while IFS='|' read -r start size type stripes ssize ranges; do
                    start=${start// /} size=${size// /} type=${type// /} stripes=${stripes// /} ssize=${ssize// /}
                    targets=()
                    for r in $ranges; do
                        d=$(realpath "${r%:*}") pe=${r##*:}; pe=${pe%%-*}
                        [[ -n ${pestart[$d]:-} ]] || { undo; die "$vg/$lv: no PV $d among $pvlist"; }
                        targets+=("$d $((pestart[$d] + pe * esz))")
                    done
                    case $type in
                        linear) table+="$start $size linear ${targets[0]}"$'\n' ;;
                        striped) table+="$start $size striped $stripes $ssize ${targets[*]}"$'\n' ;;
                    esac
                done < <(lvs "${lvm_opts[@]}" --noheadings --segments --separator '|' --units s --nosuffix \
                             -o seg_start,seg_size,segtype,stripes,stripe_size,seg_pe_ranges "$vg/$lv")
                name=$tag-${vg//-/--}-${lv//-/--}
                ro_opt=(); [[ $ro == yes ]] && ro_opt=(--readonly)
                printf '%s' "$table" | dmsetup create "${ro_opt[@]}" "$name" || { undo; die "could not set up $vg/$lv as $name"; }
                echo "dm $name" >>"$state"
                echo "lv $vg $lv $name" >>"$state"
                lvd=$(realpath "/dev/mapper/$name")
                parts+=("$lvd")
                for n in "/dev/mapper/${vg//-/--}-${lv//-/--}" "/dev/$vg/$lv" "/dev/disk/by-id/dm-name-${vg//-/--}-${lv//-/--}" \
                         "/dev/disk/by-id/dm-uuid-LVM-${vguuid//-/}${lvuuid//-/}"; do
                    lvdev[$n]=$lvd
                done
            done < <(lvs "${lvm_opts[@]}" --noheadings --separator '|' -o lv_name,lv_uuid,vg_uuid "$vg")
            udevadm settle
            # The host's event activation of this group, if it came only now:
            # its own mappings of these PVs, by the group's UUIDs (vm-umount
            # does this again, for one later still).
            dmsetup ls 2>/dev/null | awk '{ print $1 }' | grep -q "^${vg//-/--}-[^-]" &&
                { vgchange "${lvm_opts[@]}" -a n "$vg" >/dev/null 2>&1 || true; }
            continue
        fi
        # LVM's own activation, under the guest's names.  (ABRoot's vos-root,
        # whose roots are thin: every Vanilla OS disk has one.)
        [[ $others == yes ]] && { undo; die "a volume group named $vg is already active on this host (another guest's or disk's of that name, or another mount of this one): vm-umount or deactivate it first"; }
        # A VG's name in read_only_volume_list covers all of its LVs ("*"
        # there would match only a VG named "*").
        ro_cfg=()
        [[ $ro == yes ]] && ro_cfg=(--config "activation { read_only_volume_list = [ \"$vg\" ] }")
        act_pvs=$pvlist
        if [[ $ro == yes ]] && grep -qx thin-pool <<<"$types"; then
            # A thin pool is never a read-only table ("thin-pool: target type
            # may not be included in a read-only table"), and its data and
            # metadata need writable devices.  So with --ro LVM activates the
            # group from throwaway snapshots of its PVs (device-mapper's
            # snapshot target, which reads its origin only, the read-only
            # nbd device), their copy-on-write space a sparse file vm-umount
            # deletes: what the pool writes at activation never reaches the
            # image, and the filesystems are mounted read-only as ever.
            ro_cfg=() cows=()
            for pv in $(pvs "${lvm_opts[@]}" --noheadings --separator '|' -o pv_name,vg_name 2>/dev/null |
                        awk -F'|' -v vg="$vg" '{ gsub(/ /, ""); } $2 == vg { print $1 }'); do
                pv=$(realpath "$pv")
                f=$(mktemp -p "${TMPDIR:-/tmp}" vm-mount-cow.XXXXXX)
                truncate -s 1G "$f"
                l=$(losetup --find --show "$f")
                c=vm-mount-$$-cow-${pv##*/}
                dmsetup create "$c" --table "0 $(blockdev --getsz "$pv") snapshot $pv $l N 8" ||
                    { losetup -d "$l"; rm -f "$f"; undo; die "could not make a throwaway snapshot of $pv"; }
                echo "cow $c $l $f" >>"$state"
                cows+=("$(realpath "/dev/mapper/$c")")
            done
            act_pvs=$(IFS=,; echo "${cows[*]}")
            udevadm settle
        fi
        # Recorded first: vm-umount deactivates what a failed activation left.
        echo "vg $vg $act_pvs" >>"$state"
        vgchange --devicesfile "" --devices "$act_pvs" "${ro_cfg[@]}" -a y "$vg" >/dev/null || { undo; die "could not activate volume group $vg"; }
        udevadm settle
        while read -r lv; do
            [[ -n $lv && -b $lv ]] && parts+=("$(realpath "$lv")")
        done < <(lvs --devicesfile "" --devices "$act_pvs" --noheadings -o lv_dm_path "$vg" 2>/dev/null | tr -d ' ')
    done
fi
open_luks "$before_lvm"

# Resolve fstab's device names against this image's partitions only, never
# the host's disks (a cloned image may share UUIDs with something else).
resolve() {
    local spec=$1 p
    # A logical volume by one of the guest's own names for it (above).
    [[ -n ${lvdev[$spec]:-} ]] && { echo "${lvdev[$spec]}"; return; }
    for p in "${parts[@]}"; do
        # Both spellings: UUID=... and /dev/disk/by-uuid/... (Ubuntu's installer).
        case $spec in
            UUID=*|/dev/disk/by-uuid/*)
                [[ $(blkid -s UUID -o value "$p") == "${spec##*[=/]}" ]] && { echo "$p"; return; } ;;
            PARTUUID=*|/dev/disk/by-partuuid/*)
                [[ $(blkid -s PARTUUID -o value "$p") == "${spec##*[=/]}" ]] && { echo "$p"; return; } ;;
            /dev/disk/by-id/md-uuid-*)
                [[ ${raid_uuid[$p]:-} == "${spec#*md-uuid-}" ]] && { echo "$p"; return; } ;;
            LABEL=*|/dev/disk/by-label/*)
                [[ $(blkid -s LABEL -o value "$p") == "${spec##*[=/]}" ]] && { echo "$p"; return; } ;;
            # A logical volume of a group LVM activated above, under the
            # guest's own names: as /dev/mapper/VG-LV or /dev/VG/LV.
            /dev/mapper/*|/dev/*/*)
                [[ -b $spec && $(realpath "$spec") == "$(realpath "$p")" ]] && { echo "$p"; return; } ;;
        esac
    done
    return 1
}

# mount_fs DEVICE TARGET [OPTIONS]; read-only mounts must not replay a
# journal or log, since that would mean writing.
mount_fs() {
    local opts=$3 fstype
    fstype=$(blkid -s TYPE -o value "$1" || true)
    if [[ $ro == yes ]]; then
        case $fstype in
            ext3|ext4) opts=ro,noload${opts:+,$opts} ;;   # ext2 has no journal, and rejects noload
            btrfs) opts=ro,rescue=nologreplay${opts:+,$opts} ;;
            xfs|f2fs|nilfs2) opts=ro,norecovery${opts:+,$opts} ;;
            bcachefs) opts=ro,nochanges${opts:+,$opts} ;;
            *) opts=ro${opts:+,$opts} ;;
        esac
    fi
    # XFS refuses a second filesystem of a UUID already mounted on this host
    # ("Filesystem has duplicate UUID"): another slot's copy of the same
    # guest, a source and its restore.  nouuid lets both mount.
    [[ $fstype == xfs ]] && opts=${opts:+$opts,}nouuid
    # btrfs: this host's kernel keeps a device it once scanned, by path, after
    # the nbd device is gone (a multi-device filesystem attached again on
    # other nbd devices then fails to mount: "failed to open device for path
    # /dev/nbd10p3").  So forget every unmounted one, and name this image's
    # members of the filesystem (device=), which registers them at the mount
    # itself, whatever another mount forgets meanwhile.
    if [[ $fstype == btrfs ]]; then
        local u q devs=""
        u=$(blkid -s UUID -o value "$1")
        command -v btrfs >/dev/null && btrfs device scan --forget >/dev/null 2>&1
        for q in "${parts[@]}"; do
            [[ $(blkid -s UUID -o value "$q" 2>/dev/null) == "$u" && $(blkid -s TYPE -o value "$q") == btrfs ]] && devs+=,device=$q
        done
        opts=${opts:+$opts}${devs:+${opts:+,}${devs#,}}
    fi
    mount ${opts:+-o "$opts"} "$1" "$2"
}
# try_mount DEVICE TARGET [OPTIONS]: mount_fs, quietly; a failure's message
# is kept in mount_err (the last one is in the error if no partition turns
# out to hold /etc/fstab).
mount_err=""
try_mount() {
    local e
    { e=$(mount_fs "$@" 2>&1 1>&3 3>&-); } 3>&1 && return 0
    mount_err="$1: ${e//$'\n'/; }"
    return 1
}
# guest_file ROOT PATH: PATH inside the guest mounted at ROOT, its symlinks
# followed as the guest would follow them (an absolute link means ROOT/...,
# never the host's file), as a host path; fails if there is no such file.
# NixOS's /etc/fstab, for one, is a link into /nix/store.
guest_file() {
    python3 - "$1" "$2" <<'PY'
import os, sys
root, path = sys.argv[1], sys.argv[2]
parts, done, hops = path.strip("/").split("/"), [], 0
while parts:
    name = parts.pop(0)
    if name in ("", "."):
        continue
    if name == "..":
        done = done[:-1]
        continue
    host = os.path.join(root, *done, name)
    if os.path.islink(host):
        hops += 1
        if hops > 40:
            sys.exit(1)
        target = os.readlink(host)
        if target.startswith("/"):
            done = []
        parts = target.strip("/").split("/") + parts
        continue
    done.append(name)
host = os.path.join(root, *done)
if not os.path.isfile(host):
    sys.exit(1)
print(host)
PY
}
# store_link_copy MP TARGET: for a link to TARGET (/gnu/store/NAME) that the
# btrfs top level mounted at MP can't follow, the file from the top-level
# subvolume that holds it as store/NAME (the one mounted at /gnu), copied to
# a temporary file whose name it prints; fails if none holds it.
fstab_copy=""
store_link_copy() {
    local d f c rest=${2#/}
    rest=${rest#*/}
    [[ $2 == /* && -n $rest && $rest != "${2#/}" ]] || return 1
    for d in "$1"/*/; do
        f=$d$rest
        [[ -f $f && ! -L $f ]] || continue
        c=$(mktemp "${TMPDIR:-/tmp}/vm-mount-fstab.XXXXXX")
        cp "$f" "$c" && { echo "$c"; return 0; }
    done
    return 1
}
# The btrfs subvolume options (subvol=, subvolid=) from fstab options on stdin.
subvol_opts() { tr ',' '\n' | grep -E '^subvol(id)?=' | paste -sd, - || true; }
# fstab_line FSTAB TARGET: TARGET's line in FSTAB, as SPEC TYPE OPTIONS.
fstab_line() { awk -v t="$2" '!/^[[:space:]]*(#|$)/ && $2 == t { print $1, $3, $4; exit }' "$1"; }

# ostree (docs/design/bazzite.md): no /etc/fstab at the top of anything,
# but one in each deployment, ostree/deploy/STATEROOT/deploy/CSUM.N/etc/, in
# the physical root (a btrfs subvolume one level down, Fedora's "root", or a
# filesystem's top).  It is mounted at MP as load's mount stage mounts it:
# fstab's / (the physical root), then the rest of the default deployment's
# fstab beneath it (/boot, /boot/efi, /home, /var).  The default deployment
# is ostree_paths.py's: the BLS entry on /boot with the highest version,
# followed to its deployment, so /boot is mounted first, by any deployment's
# fstab, to find it.  Its etc/fstab is then the one the rest is mounted by.
# Called with PARTITION mounted at MP at its top level; on success sets
# ostree_dep and fstab_file, and leaves the physical root mounted at MP.
ostree_dep=""
mount_ostree() {
    local p=$1 type=$2 cands cand phys="" sub sub2 line spec bdev booted=no
    cands=$(compgen -G "$mp/ostree/deploy/*/deploy/*/etc/fstab" || true)
    if [[ -z $cands && $type == btrfs ]]; then
        cands=$(compgen -G "$mp/*/ostree/deploy/*/deploy/*/etc/fstab" || true)
    fi
    [[ -n $cands ]] || return 1
    cand=$(head -n 1 <<<"$cands")
    if [[ $cand != "$mp"/ostree/* ]]; then phys=${cand#"$mp"/}; phys=${phys%%/*}; fi
    sub=$(fstab_line "$cand" / | awk '{ print $3 }' | subvol_opts)
    if [[ -n $phys ]]; then
        [[ -n $sub ]] || sub=subvol=$phys
        umount "$mp"
        mount_fs "$p" "$mp" "$sub" || { undo; die "ostree: could not mount $p's $sub"; }
        cand=$mp/${cand#"$mp/$phys/"}       # now at MP's top
        [[ -f $cand ]] || { undo; die "ostree: $p's $sub isn't the subvolume $phys"; }
    fi
    line=$(fstab_line "$cand" /boot)
    if [[ -n $line ]]; then
        read -r spec _ _ <<<"$line"
        bdev=$(resolve "$spec") || { undo; die "ostree: /boot's $spec is not on this image"; }
        mount_fs "$bdev" "$mp/boot" "" || { undo; die "ostree: could not mount /boot ($bdev)"; }
        booted=yes
    fi
    ostree_dep=$(python3 "$(dirname "$(realpath "$0")")/ostree_paths.py" default "$mp" || true)
    [[ $booted == no ]] || umount "$mp/boot"
    [[ -n $ostree_dep ]] || { undo; die "ostree: no default deployment among the $(wc -l <<<"$cands") on $p"; }
    fstab_file=$mp/$ostree_dep/etc/fstab
    [[ -f $fstab_file ]] || { undo; die "ostree: the default deployment $ostree_dep has no etc/fstab"; }
    # The default deployment's / may name another subvolume than the first's.
    sub2=$(fstab_line "$fstab_file" / | awk '{ print $3 }' | subvol_opts)
    if [[ $sub2 != "$sub" ]]; then
        [[ -n $sub2 || -z $phys ]] || sub2=subvol=$phys
        umount "$mp"
        mount_fs "$p" "$mp" "$sub2" || { undo; die "ostree: could not mount $p's $sub2"; }
        [[ -f $fstab_file ]] || { undo; die "ostree: $p's ${sub2:-top level} holds no $ostree_dep"; }
    fi
}

# ABRoot (Vanilla OS; docs/design/vanillaos.md): two root filesystems on
# thin LVs (labels vos-a and vos-b: abroot.json's partLabelA and
# partLabelB), an LV `init` (label vos-init: thinInitVolume) with both
# roots' kernels and GRUB configs, /boot (vos-boot: partLabelBoot), whose
# master grub.cfg's `set default=` entry leads to the root that boots
# (`configfile "/vos-b/abroot.cfg"`), and /var (vos-var: partLabelVar; on
# LUKS with the installer's encryption, which --key opens).  No fstab holds
# the tree: a root's lower /etc/fstab lists both roots at /, and its live
# one, in its /etc overlay's upper on /var, only itself, /boot and
# /boot/efi.  So MOUNTPOINT gets the tree bko-holt's dump and load use, at
# ABRoot's own mount points: / the present root (the one the master
# grub.cfg's default leads to), /var, the live fstab's /boot and /boot/efi
# (the lower fstab's without one), /boot/init the init LV and /part-future
# the other root.  / is read raw: its /etc is the lower, and both roots'
# /etc uppers are in /var/lib/abroot/etc/; vm-chroot puts the overlay
# together.  abroot.json is the root's /usr/share/abroot/abroot.json, then
# its /etc/abroot/abroot.json (the upper's if there is one), merged as
# ABRoot's viper does (keys whatever their case, the later value winning).
# Recognised by an LV named init and a root holding
# /usr/share/abroot/abroot.json (the init LV first, so no other guest's
# filesystems are mounted to look); then the whole tree is mounted or
# vm-mount fails.  Sets abroot_present and abroot_future (labels) and
# abroot_root (the present root's device).
abroot_present="" abroot_future="" abroot_root=""
# abroot_py config FILE...: abroot.json's labels from FILEs merged, as
# KEY=VALUE lines (keys in lower case, ABRoot's defaults for those missing).
# abroot_py present GRUBCFG: the label the master grub.cfg's default entry
# leads to, as bko-holt's abroot::parse_master reads it.
abroot_py() {
    python3 -I - "$@" <<'PY'
import json, re, sys
cmd, args = sys.argv[1], sys.argv[2:]
if cmd == "config":
    keys = {}
    for f in args:
        try:
            with open(f) as fh:
                pairs = json.load(fh, object_pairs_hook=lambda kv: kv)
        except (OSError, ValueError):
            continue
        for k, v in pairs if isinstance(pairs, list) else ():
            keys[k.lower()] = v
    for k, d in (("partlabela", "vos-a"), ("partlabelb", "vos-b"), ("partlabelvar", "vos-var"),
                 ("partlabelboot", "vos-boot"), ("thininitvolume", "vos-init")):
        v = keys.get(k)
        v = v if isinstance(v, str) and v else d
        if not re.fullmatch(r"[A-Za-z0-9._-]+", v):
            sys.exit(f"abroot.json's {k} is {v!r}")
        print(f"{k}={v}")
elif cmd == "present":
    default, entries, inside = None, [], False
    with open(args[0], errors="replace") as fh:
        for line in fh:
            l = line.strip()
            if l.startswith("#"):
                continue
            if l.startswith("menuentry "):
                m = re.match(r"""menuentry\s+(?:"([^"]*)"|'([^']*)'|(\S+))""", l)
                title = next((g for g in m.groups() if g is not None), "") if m else ""
                entries.append({"title": title, "cfg": None})
                inside = True
            elif l.startswith("}"):
                inside = False
            elif not inside:
                if default is None and l.startswith("set default="):
                    default = l[len("set default="):].strip().strip("\"'")
            elif l.startswith("configfile "):
                entries[-1]["cfg"] = l.split(None, 1)[1].strip().strip("\"'")
    e = None
    if default is not None and default.isdigit():
        e = entries[int(default)] if int(default) < len(entries) else None
    elif default is not None:
        e = next((x for x in entries if x["title"] == default), None)
    if e is None or not e["cfg"]:
        sys.exit(f"{args[0]}: no default entry ({default!r}) with a configfile among its {len(entries)}")
    # "/vos-b/abroot.cfg", or with a (device) in front
    print(re.sub(r"^\([^)]*\)", "", e["cfg"]).strip("/").split("/")[0])
PY
}
# part_label LABEL: the first of the image's partitions and volumes whose
# filesystem is labelled LABEL (ABRoot's own search: the first match).
part_label() {
    local p t
    for p in "${parts[@]}"; do
        t=$(blkid -s TYPE -o value "$p" 2>/dev/null || true)
        [[ $t == crypto_LUKS || $t == LVM2_member || $t == linux_raid_member ]] && continue
        [[ $(blkid -s LABEL -o value "$p" 2>/dev/null || true) == "$1" ]] && { echo "$p"; return 0; }
    done
    return 1
}
mount_abroot() {
    local p n init=no tmp cfgroot="" conf l0 up A B V BOOT I dI dA dB dV dB0 dP dF present
    local spec target type options q
    for p in "${parts[@]}"; do
        n=$(cat "/sys/class/block/${p##*/}/dm/name" 2>/dev/null) || continue
        # VG-init, the VG's dashes doubled (vmm-nbdN-VG-init by hand)
        [[ $n == *-init && $n != *--init ]] && { init=yes; break; }
    done
    [[ $init == yes ]] || return 1
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/vm-mount-abroot.XXXXXX")
    for p in "${parts[@]}"; do
        case $(blkid -s TYPE -o value "$p" 2>/dev/null || true) in btrfs|ext4|xfs) ;; *) continue ;; esac
        ro=yes try_mount "$p" "$tmp" "" || continue
        [[ -f $tmp/usr/share/abroot/abroot.json ]] && { cfgroot=$p; break; }
        umount "$tmp"
    done
    [[ -n $cfgroot ]] || { rmdir "$tmp"; return 1; }
    abroot_fail() { umount "$tmp" 2>/dev/null; rmdir "$tmp" 2>/dev/null; undo; die "ABRoot: $*"; }
    conf=$(abroot_py config "$tmp/usr/share/abroot/abroot.json" "$tmp/etc/abroot/abroot.json") || abroot_fail "$conf"
    V=$(sed -n 's/^partlabelvar=//p' <<<"$conf")
    # This root's /etc upper on /var: its abroot.json, if it has one, is
    # the /etc one ABRoot reads (a whiteout there: none).
    l0=$(blkid -s LABEL -o value "$cfgroot" || true)
    if [[ -n $l0 ]] && dV=$(part_label "$V"); then
        up=$(mktemp -d "${TMPDIR:-/tmp}/vm-mount-abroot-var.XXXXXX")
        if ro=yes try_mount "$dV" "$up" ""; then
            q=$up/lib/abroot/etc/$l0/abroot/abroot.json
            if [[ -f $q ]]; then
                conf=$(abroot_py config "$tmp/usr/share/abroot/abroot.json" "$q") || { umount "$up"; rmdir "$up"; abroot_fail "$conf"; }
            elif [[ -c $q ]]; then
                conf=$(abroot_py config "$tmp/usr/share/abroot/abroot.json") || { umount "$up"; rmdir "$up"; abroot_fail "$conf"; }
            fi
            umount "$up"
        fi
        rmdir "$up"
    fi
    umount "$tmp"
    A=$(sed -n 's/^partlabela=//p' <<<"$conf") B=$(sed -n 's/^partlabelb=//p' <<<"$conf")
    V=$(sed -n 's/^partlabelvar=//p' <<<"$conf") BOOT=$(sed -n 's/^partlabelboot=//p' <<<"$conf")
    I=$(sed -n 's/^thininitvolume=//p' <<<"$conf")
    dA=$(part_label "$A") || abroot_fail "no filesystem labelled $A (partLabelA) on this image"
    dB=$(part_label "$B") || abroot_fail "no filesystem labelled $B (partLabelB) on this image"
    dI=$(part_label "$I") || abroot_fail "no filesystem labelled $I (thinInitVolume) on this image"
    if ! dV=$(part_label "$V"); then
        for p in "${parts[@]}"; do
            [[ -z $key && $(blkid -s TYPE -o value "$p" 2>/dev/null || true) == crypto_LUKS ]] &&
                abroot_fail "no filesystem labelled $V (partLabelVar): is it in the LUKS volume $p? (give --key)"
        done
        abroot_fail "no filesystem labelled $V (partLabelVar) on this image"
    fi
    dB0=$(part_label "$BOOT") || abroot_fail "no filesystem labelled $BOOT (partLabelBoot) on this image"
    # The master grub.cfg's default: the present root.
    ro=yes try_mount "$dB0" "$tmp" "" || abroot_fail "could not mount /boot ($dB0) to read its grub.cfg: $mount_err"
    present=$(abroot_py present "$tmp/grub/grub.cfg" 2>&1) || abroot_fail "$present"
    umount "$tmp"
    rmdir "$tmp"
    if [[ $present == "$A" ]]; then dP=$dA dF=$dB abroot_future=$B
    elif [[ $present == "$B" ]]; then dP=$dB dF=$dA abroot_future=$A
    else abroot_fail "the master grub.cfg's default boots $present, neither $A nor $B"
    fi
    abroot_present=$present abroot_root=$dP
    # The tree, parents first.
    mount_fs "$dP" "$mp" "" || { undo; die "ABRoot: could not mount the present root $present ($dP)"; }
    mount_fs "$dV" "$mp/var" "" || { undo; die "ABRoot: could not mount /var ($dV)"; }
    q=$mp/var/lib/abroot/etc/$present/fstab
    [[ -f $q ]] || q=$mp/etc/fstab
    while read -r spec target type options; do
        # / (in the lower fstab both roots), and what ABRoot mounts itself
        case $target in /|/var|/boot/init|/part-future) continue ;; esac
        [[ $type == swap || $target != /* || ,$options, == *,noauto,* ]] && continue
        p=$(resolve "$spec") || { echo "vm-mount: skipping $target: $spec is not on this image" >&2; continue; }
        mount_fs "$p" "$mp$target" "$(subvol_opts <<<"$options")" || { undo; die "ABRoot: could not mount $target ($p)"; }
    done < <([[ -f $q ]] && awk '!/^[[:space:]]*(#|$)/ { print $1, $2, $3, $4 }' "$q" |
                 awk '{ print gsub("/", "/", $2), $0 }' | sort -n | cut -d' ' -f2-)
    mountpoint -q "$mp/boot" || mount_fs "$dB0" "$mp/boot" "" || { undo; die "ABRoot: could not mount /boot ($dB0)"; }
    for q in boot/init:"$dI" part-future:"$dF"; do
        if [[ ! -d $mp/${q%%:*} ]]; then
            # ABRoot's own empty directories; made only on a read-write mount
            [[ $ro == no ]] && mkdir "$mp/${q%%:*}" ||
                { undo; die "ABRoot: there is no /${q%%:*} to mount ${q#*:} at (and --ro makes none)"; }
        fi
        mount_fs "${q#*:}" "$mp/${q%%:*}" "" || { undo; die "ABRoot: could not mount /${q%%:*} (${q#*:})"; }
    done
    return 0
}

# Find /: the filesystem whose /etc/fstab this is.  On btrfs it is usually
# in a subvolume: one level down from the top level (Debian's installer uses
# @rootfs, Fedora's root), in which case mount the subvolume fstab names for
# /, or the default subvolume (openSUSE's snapper makes that a snapshot,
# @/.snapshots/1/snapshot), which fstab doesn't name.
# load_zfs_keys POOL: with --key, load the keys of POOL's locked encryption
# roots: from the LUKS keystore volume POOL/keystore if there is one (the key
# file inside it), else the passphrase itself.
load_zfs_keys() {
    local pool=$1 roots ks tmp keyfile r
    roots=$(zfs get -H -r -o name,value keystatus "$pool" | awk '$2 == "unavailable" { print $1 }')
    [[ -n $roots && -n $key ]] || return 0
    ks=/dev/zvol/$pool/keystore
    keyfile=$key
    if zfs list "$pool/keystore" >/dev/null 2>&1; then
        udevadm settle
        for _ in 1 2 3 4 5; do [[ -e $ks ]] && break; sleep 1; done
        tr -d '\n' <"$key" | cryptsetup open --readonly --key-file - "$ks" "vm-mount-$$-keystore" || return 1
        tmp=$(mktemp -d)
        mount -o ro "/dev/mapper/vm-mount-$$-keystore" "$tmp"
        keyfile=$(find "$tmp" -maxdepth 1 -name '*.key' | head -n 1)
    fi
    for r in $(zfs get -H -r -o name,value encryptionroot "$pool" | awk '$1 == $2 { print $1 }'); do
        grep -qx "$r" <<<"$roots" && zfs load-key -L "file://$keyfile" "$r"
    done
    if [[ -n ${tmp:-} ]]; then
        umount "$tmp"; rmdir "$tmp"
        cryptsetup close "vm-mount-$$-keystore"
    fi
}
# mount_renamed NAME ORIG: pool NAME (the guest's ORIG, imported under a
# temporary name) has datasets whose mount point is ZFS's default, made of
# the pool's name: with the altroot, $mp/NAME/..., not the guest's path.
# Mount them at $mp/ORIG/... instead, parents first (the canmount=on ones,
# as ZFS would), skipping one whose mount point directory isn't there.
# The mount loops below leave them out (in_tmp_name).
mount_renamed() {
    local name=$1 orig=$2 at ds opts=zfsutil
    [[ -n $orig && $orig != "$name" ]] || return 0
    [[ $ro == yes ]] && opts+=,ro
    zfs list -H -o mountpoint,canmount,name -t filesystem -r "$name" |
        awk -F'\t' -v t="$mp/$name" '$2 == "on" && ($1 == t || index($1, t "/") == 1) { print $1 "\t" $3 }' |
        LC_ALL=C sort |
        while IFS=$'\t' read -r at ds; do
            at=$mp/$orig${at#"$mp/$name"}
            mountpoint -q "$at" && continue
            [[ -d $at ]] || { echo "vm-mount: skipping $ds: no directory ${at#"$mp"} to mount it on" >&2; continue; }
            mount -t zfs -o "$opts" "$ds" "$at" || echo "vm-mount: could not mount $ds at ${at#"$mp"}" >&2
        done
}
# in_tmp_name NAME: awk's filter for the datasets mount_renamed mounts.
in_tmp_name() { printf '($3 == "%s" || index($3, "%s/") == 1)' "$mp/$1" "$mp/$1"; }
# mount_zfs_root PARTITION: import the pool on it and mount its / dataset at
# $mp; fails (leaving nothing imported) if there is no such dataset.
mount_zfs_root() {
    local p=$1 id name orig rootds q search=() listing
    command -v zpool >/dev/null || { echo "vm-mount: $p is ZFS, but this host has no OpenZFS" >&2; return 1; }
    # Every ZFS partition of the guest's disks, so a mirror's halves are found.
    for q in "${parts[@]}"; do
        [[ $(blkid -s TYPE -o value "$q" || true) == zfs_member ]] && search+=(-d "$q")
    done
    listing=$(zpool import -d "$p" 2>/dev/null || true)
    id=$(awk '$1 == "id:" { print $2; exit }' <<<"$listing")
    orig=$(awk '$1 == "pool:" { print $2; exit }' <<<"$listing")
    [[ -n $id ]] || return 1
    name=vm-mount-$$
    local opts=(-N -f "${search[@]}" -R "$mp")
    [[ $ro == yes ]] && opts+=(-o readonly=on)
    # -f: a root pool is never exported by the guest itself.
    zpool import "${opts[@]}" -t "$id" "$name" || return 1
    echo "pool $name" >>"$state"
    load_zfs_keys "$name"
    # With an altroot, zfs list shows mountpoints under it: / appears as $mp.
    # The pool's own top dataset often says / too, but with canmount=off.
    rootds=$(zfs list -H -o name,canmount,mountpoint -r "$name" |
        awk -v root="$mp" '$2 != "off" && $3 == root { print $1; exit }')
    if [[ -z $rootds ]]; then
        zpool export "$name"
        sed -i '$d' "$state"
        return 1
    fi
    if [[ $(zfs get -H -o value keystatus "$rootds") == unavailable ]]; then
        echo "vm-mount: $rootds is encrypted and locked (give --key)" >&2
        zpool export "$name"
        sed -i '$d' "$state"
        return 1
    fi
    # Ubuntu's root dataset is canmount=noauto, so mount it by name; then the
    # pool's datasets that mount by themselves.
    zfs mount "$rootds"
    zfs list -H -o name,canmount,mountpoint -r "$name" |
        awk '$2 == "on" && $3 != "none" && $3 != "legacy" && !'"$(in_tmp_name "$name")"' { print $1 }' |
        while read -r ds; do zfs mount "$ds" 2>/dev/null || true; done
    mount_renamed "$name" "$orig"
}

root=""
# (Not under the ERR trap: mount_abroot fails by itself, through undo and die.)
mount_abroot && root=$abroot_root
for p in "${parts[@]}"; do
    [[ -z $root ]] || break
    type=$(blkid -s TYPE -o value "$p" || true)
    [[ -z $type || $type == swap ]] && continue
    if [[ $type == zfs_member ]]; then
        mount_zfs_root "$p" || continue
        if [[ -f $mp/etc/fstab ]]; then root=$p; break; fi
        umount -R "$mp"
        zpool export "$(tail -n 1 "$state" | cut -d' ' -f2)"
        sed -i '$d' "$state"
        continue
    fi
    top=""
    [[ $type == btrfs ]] && top=subvolid=5   # the top level, whatever the default
    try_mount "$p" "$mp" "$top" || continue
    fstab=$(guest_file "$mp" /etc/fstab || true)
    if [[ -z $fstab ]] && mount_ostree "$p" "$type"; then root=$p; break; fi
    if [[ -z $fstab && $type == btrfs ]]; then
        # One level down: the subvolume's fstab.
        fstab=$(compgen -G "$mp/*/etc/fstab" | head -n 1 || true)
        # Guix: @/etc/fstab is a link into /gnu/store, and /gnu may be a
        # subvolume of its own (guix15-bios's @gnu), so from the top level
        # the link leads nowhere: read the file from the subvolume that
        # holds it (one with store/NAME for /gnu/store/NAME), and keep a copy.
        if [[ -n $fstab && -L $fstab && ! -e $fstab ]]; then
            fstab_copy=$(store_link_copy "$mp" "$(readlink "$fstab")") || fstab_copy=""
        fi
        if [[ -z $fstab ]]; then
            umount "$mp"
            try_mount "$p" "$mp" "" || continue
            if guest_file "$mp" /etc/fstab >/dev/null; then root=$p; break; fi
        fi
    fi
    if [[ -z $fstab ]]; then umount "$mp"; continue; fi
    root=$p
    if [[ $fstab == "$mp"/*/etc/fstab && ! -e $mp/etc ]]; then
        sub=$(awk '!/^[[:space:]]*#/ && $2 == "/" { print $4 }' "${fstab_copy:-$fstab}" | subvol_opts)
        [[ -n $sub ]] || sub=subvol=$(basename "$(dirname "$(dirname "$fstab")")")
        umount "$mp"
        mount_fs "$p" "$mp" "$sub"
    fi
    break
done
[[ -n $root ]] || { undo; die "no partition holds /etc/fstab${mount_err:+ (the last mount that failed: $mount_err)}"; }

# The guest's other ZFS pools (Ubuntu's bpool, /boot): those with a dataset
# that mounts somewhere ZFS itself mounts it, not through fstab.  A
# canmount=noauto dataset (Ubuntu's bpool/BOOT/ubuntu_X) is mounted when its
# last name part is the root dataset's.
if command -v zpool >/dev/null; then
    rootsuffix=$(zfs list -H -o name,mountpoint 2>/dev/null | awk -v root="$mp" '$2 == root { n = $1; sub(/.*\//, "", n); print n; exit }')
    n=0
    while read -r id orig; do
        [[ -n $id ]] || continue
        n=$((n + 1))
        name=vm-mount-$$-$n
        search=()
        for q in "${parts[@]}"; do
            [[ $(blkid -s TYPE -o value "$q" || true) == zfs_member ]] && search+=(-d "$q")
        done
        opts=(-N -f "${search[@]}" -R "$mp")
        [[ $ro == yes ]] && opts+=(-o readonly=on)
        zpool import "${opts[@]}" -t "$id" "$name" || continue
        echo "pool $name" >>"$state"
        load_zfs_keys "$name"
        zfs list -H -o name,canmount,mountpoint -r "$name" |
            awk -v sfx="$rootsuffix" '$3 != "none" && $3 != "legacy" && !'"$(in_tmp_name "$name")"' { n = $1; sub(/.*\//, "", n); if ($2 == "on" || ($2 == "noauto" && n == sfx)) print $1 }' |
            while read -r ds; do zfs mount "$ds" 2>/dev/null || true; done
        mount_renamed "$name" "$orig"
    done < <(
        # Pools on the guest's partitions that aren't imported yet: "ID NAME".
        imported=$(zpool list -H -o guid 2>/dev/null)
        for q in "${parts[@]}"; do
            [[ $(blkid -s TYPE -o value "$q" || true) == zfs_member ]] || continue
            zpool import -d "$q" 2>/dev/null | awk '$1 == "pool:" { n = $2 } $1 == "id:" { print $2, n }'
        done | sort -u | awk -v imp="${imported:-none}" 'BEGIN { k = split(imp, g, "\n"); for (i = 1; i <= k; i++) skip[g[i]] = 1 } !($1 in skip)' || true
    )
fi

# The guest's other filesystems, parents before children.
[[ -n $ostree_dep || -n $abroot_present ]] || fstab_file=${fstab_copy:-$(guest_file "$mp" /etc/fstab)}
[[ -z $abroot_present ]] || fstab_file=/dev/null     # mount_abroot mounted the tree
while read -r spec target type options; do
    [[ $target == / || $type == swap || $target != /* || ,$options, == *,noauto,* ]] && continue
    p=$(resolve "$spec") || { echo "vm-mount: skipping $target: $spec is not on this image" >&2; continue; }
    mount_fs "$p" "$mp$target" "$(subvol_opts <<<"$options")"
done < <(awk '!/^[[:space:]]*(#|$)/ { print $1, $2, $3, $4 }' "$fstab_file" |
    awk '{ print gsub("/", "/", $2), $0 }' | sort -n | cut -d' ' -f2-)

trap - ERR
[[ -z $fstab_copy ]] || rm -f "$fstab_copy"
how=read-write
[[ $ro == yes ]] && how=read-only
echo "Mounted $image ($dev, $how) at $mp:"
findmnt -R -n -o TARGET,SOURCE,FSTYPE "$mp" | sed 's/^/  /'
[[ -z $ostree_dep ]] || echo "ostree: the default deployment is $ostree_dep (its etc/fstab mounted the rest)"
[[ -z $abroot_present ]] || echo "ABRoot: the present root (the master grub.cfg's default) is $abroot_present, at /; the future root $abroot_future is at /part-future"
