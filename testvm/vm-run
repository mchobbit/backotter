#!/usr/bin/env bash
# Boot a BackOtter test VM from its disk image.
#
# Usage: vm-run [--uefi [--no-secure-boot] [--uefi-vars FILE] [--mok CERT]... | --q35] [--cdrom ISO] [--snapshot | --ram [--keep]]
#               [--discard] [--disk-bus BUS] [--disk IMAGE]... [--disk-serials LIST] [--disk-slots LIST] [--nic MODEL]
#               [--legacy-virtio-net] [--mac ADDR] [--tpm DIR] [--cpus N] [--memory MB] [--serial-log FILE] [--no-vga]
#               IMAGE [-- QEMU_ARGS...]
#
# The VM gets 2 CPUs, 2 GB RAM (MEMORY=MB overrides), KVM, and QEMU's
# user-mode network with the guest's SSH port on 127.0.0.1:2222 (SSH_PORT
# overrides).
# Its serial console is this terminal: log in there, or from another terminal:
#   ssh -i WORK_DIR/id_ed25519 -p 2222 root@127.0.0.1
# Ctrl-A X quits QEMU (Ctrl-A H lists the other keys).
#
#   --cdrom ISO   attach ISO and boot from it first, e.g. an installer, or
#                 BackOtter's rescue image as a CD (it's ISO9660 inside)
#   --uefi        boot with OVMF (UEFI) instead of SeaBIOS (BIOS), with Secure
#                 Boot on and Microsoft's keys enrolled, like a stock PC
#   --no-secure-boot
#                 with --uefi: Secure Boot off (Pop!_OS, for one, needs that):
#                 OVMF_CODE_4M.fd, built without SMM, on a plain q35 machine
#                 (Secure Boot's firmware needs SMM and flash only SMM may
#                 write; given those, this one could neither read nor write
#                 its variable store and kept its variables in RAM)
#   --uefi-vars FILE
#                 with --uefi: keep OVMF's variable store in FILE instead of a
#                 fresh copy per run (made from the template when FILE doesn't
#                 exist), so boot entries outlive the VM: BackShot2's tier 2
#                 boots a rescuer and then the restored disk on one NVRAM.
#                 FILE is read and written in place, so give a copy of a
#                 guest's own (its install's uefi-vars.fd: cachyos-zfs's has
#                 Limine's entry) to boot through its entries; --snapshot
#                 keeps FILE's writes in its temporary file too
#   --mok CERT    with --uefi: enroll CERT in shim's MokList (virt-fw-vars
#                 --add-mok, owner shim's GUID) in this run's variable store
#                 before the boot, as MokManager would, so that a GRUB signed
#                 with a machine's own key (AnduinOS's MOK) boots under Secure
#                 Boot with a fresh store; repeatable.  CERT is a DER or PEM
#                 file, or the DER itself in base64 (PEM's body, no spaces), as
#                 vm-run-options carries it: that holds wherever the guest's
#                 disk is booted from.  With --uefi-vars, only into a FILE
#                 this run makes: a kept one has its MokList already
#   --q35         SeaBIOS on QEMU's q35 machine (ICH9, PCIe; --uefi has it
#                 too) instead of its PC machine (i440FX, from 1996), for a
#                 guest that needs newer hardware but can't boot with OVMF
#                 (Sculpt OS)
#   --snapshot    throw away every disk write when QEMU exits (QEMU keeps them
#                 in a temporary file in $TMPDIR: by default /var/tmp, or
#                 /mnt/bko-ram where that tmpfs of its own is mounted with
#                 8 GiB free, sparing the host's disk, else /bkoscratch/tmp
#                 where that scratch disk is mounted; RT_RAM=0: not in RAM)
#   --ram         keep every disk write in RAM instead: a qcow2 overlay in
#                 /dev/shm (RAM_DIR overrides) on top of IMAGE, with
#                 cache=unsafe; deleted when QEMU exits.  IMAGE itself is only
#                 read, so several --ram VMs can share it (give each its own
#                 SSH_PORT).
#   --keep        with --ram, keep the overlay when QEMU exits and print how to
#                 merge it into IMAGE (qemu-img commit) or delete it.  Don't
#                 change IMAGE while a kept overlay exists: it would no longer
#                 match.  A kept overlay is gone when the host reboots.  On a
#                 vm-store object it prints only how to delete it: an object
#                 is never committed into.
#   --discard     pass the guest's TRIM (fstrim, zpool trim) and its writes of
#                 zeros on to the image or overlay (discard=unmap,
#                 detect-zeroes=unmap): clusters that hold no data then, so
#                 room the guest frees doesn't stay allocated in the image
#   --serial-log FILE
#                 run headless, writing the serial console to FILE (for scripts)
#   --cpus N      N CPUs instead of 2
#   --memory MB   MB of RAM instead of 2048 (or MEMORY), e.g. for a builder
#   --no-vga      no graphics card, for a guest whose boot loader waits at a
#                 video-mode menu for a key on the PS/2 keyboard, which the
#                 serial console never sends (Redox)
#
# Other hardware, e.g. to restore onto a machine unlike the original:
#   --disk-bus BUS
#                 attach the disks as virtio (the default: virtio-blk), scsi
#                 (virtio-scsi), nvme or sata (AHCI).  The guest sees other
#                 device names (vda, sda, nvme0n1) and needs the driver in its
#                 initramfs.
#   --disk IMAGE  another disk on the same bus, after IMAGE (repeatable), e.g.
#                 for RAID; --snapshot and --ram cover it too
#   --disk-serials S0,S1,...
#                 give the disks (IMAGE first, then each --disk) these serial
#                 numbers, as real disks have: a guest then has device IDs
#                 (illumos' devids, /dev/disk/by-id) to find a disk by when it
#                 sits in another slot than before.  Without it, virtio disks
#                 have none (and the PCI layout is the same either way)
#   --disk-slots N0,N1,...
#                 put the virtio disks in these PCI slots (decimal), IMAGE's
#                 first; IMAGE then boots first whatever slot it has.  A
#                 rescuer's own disk out of the way, so that the disks it
#                 works on have the slots they have in the machine itself
#   --nic MODEL   the network card's QEMU model instead of virtio-net-pci, e.g.
#                 e1000e, e1000 or rtl8139: another driver.  It keeps the PCI
#                 slot, so names by slot (ens3) stay the same.
#   --legacy-virtio-net
#                 the virtio network card without its modern (virtio 1.0)
#                 interface: illumos' vioif can't map the modern one's
#                 registers, and the guest then has no network (OmniOS)
#   --mac ADDR    the network card's MAC address instead of QEMU's default
#                 52:54:00:12:34:56 (the same for every model), e.g.
#                 52:54:00:00:00:02, as a new machine's card would have
#   --tpm DIR     a TPM 2.0 (swtpm), its state kept in DIR (created if
#                 missing), so that what a guest seals to it survives reboots
#                 and --ram.  A new DIR is a new machine's TPM.
#
# The defaults (virtio disk, virtio-net-pci) are what every builder installs
# on; changing them changes the guest's PCI layout too.
#
# QEMU locks IMAGE while it runs, so vm-mount can't attach it meanwhile.
# A vm-store object (testvm/vm-store) is never written: it boots only with
# --ram or --snapshot.

set -euo pipefail

RAM_DIR=${RAM_DIR:-/dev/shm}
if [[ -z ${TMPDIR:-} && ${RT_RAM:-1} != 0 ]] && mountpoint -q /mnt/bko-ram 2>/dev/null &&
       (( $(df -Pk /mnt/bko-ram | awk 'NR == 2 { print $4 }') >= 8 << 20 )); then
    export TMPDIR=/mnt/bko-ram
elif [[ -z ${TMPDIR:-} ]] && mountpoint -q /bkoscratch 2>/dev/null && mkdir -p /bkoscratch/tmp 2>/dev/null; then
    export TMPDIR=/bkoscratch/tmp        # Chopin's cool scratch disk, not its root's /var/tmp
fi
die() { echo "vm-run: $*" >&2; exit 1; }
# Whether FILE is a vm-store object: its realpath lies in (or below) some
# ROOT/objects/ whose ROOT holds store.json.  By path, not -w, so root is
# refused too; other files under a store root are not objects.
in_store() {
    local d
    d=$(realpath -- "$1" 2>/dev/null) || return 1
    d=${d%/*}
    while [[ $d == /?* ]]; do
        [[ ${d##*/} == objects && -f ${d%/*}/store.json ]] && return 0
        d=${d%/*}
    done
    return 1
}

uefi_vars="" moks=() cdrom="" uefi=no q35=no secure_boot=yes snapshot=() ram=no keep=no discard="" console=(-nographic) vga=()
bus=virtio extra=() serials=() slots=() nic=virtio-net-pci nic_global=() mac="" tpm="" cpus=2 memory=${MEMORY:-2048}
while [[ $# -gt 0 ]]; do
    case $1 in
        --cdrom) cdrom=$(realpath "$2"); shift 2 ;;
        --uefi) uefi=yes; shift ;;
        --no-secure-boot) secure_boot=no; shift ;;
        --uefi-vars) uefi_vars=$2; shift 2 ;;
        --mok) moks+=("$2"); shift 2 ;;
        --q35) q35=yes; shift ;;
        --snapshot) snapshot=(-snapshot); shift ;;
        --ram) ram=yes; shift ;;
        --keep) keep=yes; shift ;;
        --discard) discard=,discard=unmap,detect-zeroes=unmap; shift ;;
        --serial-log) console=(-display none -serial "file:$2" -monitor none); shift 2 ;;
        --no-vga) vga=(-vga none); shift ;;
        --disk-bus) bus=$2; shift 2 ;;
        --disk) extra+=("$(realpath "$2")"); shift 2 ;;
        --disk-serials) IFS=, read -ra serials <<<"$2"; shift 2 ;;
        --disk-slots) IFS=, read -ra slots <<<"$2"; shift 2 ;;
        --nic) nic=$2; shift 2 ;;
        --legacy-virtio-net) nic_global=(-global virtio-net-pci.disable-modern=on); shift ;;
        --mac) mac=,mac=$2; shift 2 ;;
        --tpm) tpm=$(realpath -m "$2"); shift 2 ;;
        --cpus) cpus=$2; shift 2 ;;
        --memory) memory=$2; shift 2 ;;
        -h|--help) sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        -*) die "unknown option $1" ;;
        *) break ;;
    esac
done
[[ $# -ge 1 ]] || die "usage: $0 [--uefi [--no-secure-boot] [--uefi-vars FILE] [--mok CERT]... | --q35] [--cdrom ISO] [--snapshot | --ram [--keep]] [--discard] [--disk-bus BUS] [--disk IMAGE]... [--disk-serials LIST] [--disk-slots LIST] [--nic MODEL] [--legacy-virtio-net] [--mac ADDR] [--tpm DIR] [--cpus N] [--memory MB] [--serial-log FILE] [--no-vga] IMAGE [-- QEMU_ARGS...]"
image=$(realpath "$1")
shift
[[ ${1:-} == -- ]] && shift
[[ $ram == yes && ${#snapshot[@]} -gt 0 ]] && die "--ram and --snapshot don't combine"
[[ $keep == yes && $ram == no ]] && die "--keep needs --ram"
[[ $uefi == yes && $q35 == yes ]] && die "--uefi is on q35 already; --q35 is for SeaBIOS"
[[ $uefi == yes ]] && q35=yes
[[ ${#moks[@]} -eq 0 || $uefi == yes ]] || die "--mok needs --uefi"
case $bus in virtio|scsi|nvme|sata) ;; *) die "--disk-bus must be virtio, scsi, nvme or sata" ;; esac
[[ $cpus =~ ^[1-9][0-9]*$ && $memory =~ ^[1-9][0-9]*$ ]] || die "--cpus and --memory take whole numbers"

tmp=$(mktemp -d)
overlays=() swtpm_pid="" started=no
cleanup() {
    [[ -n $swtpm_pid ]] && kill "$swtpm_pid" 2>/dev/null
    rm -rf "$tmp"
    # --keep keeps only what a QEMU run wrote: not the overlays of a run that
    # failed before QEMU started.
    if [[ ($keep == no || $started == no) && ${#overlays[@]} -gt 0 ]]; then rm -f "${overlays[@]}"; fi
}
trap cleanup EXIT

# One disk's -drive options: the image itself, or with --ram an overlay on it.
drive_opts() {
    local image=$1 info format overlay
    [[ -f $image ]] || die "no such image: $image"
    # A store object is never written: only an overlay or QEMU's temporary file is.
    if [[ $ram == no && ${#snapshot[@]} -eq 0 ]] && in_store "$image"; then
        die "$image is a vm-store object: boot it with --ram or --snapshot"
    fi
    info=$(qemu-img info --output=json "$image" 2>&1) ||
        die "can't open $image (already running, or mounted by vm-mount?): $(head -n 1 <<<"$info")"
    format=$(python3 -c 'import json, sys; print(json.load(sys.stdin)["format"])' <<<"$info")
    if [[ $ram == yes ]]; then
        overlay=$(mktemp --suffix=.qcow2 "$RAM_DIR/vm-run.$(basename "$image" ."$format").XXXXXX")
        overlays+=("$overlay")
        qemu-img create -q -f qcow2 -b "$image" -F "$format" "$overlay"
        # cache=unsafe: ignore the guest's flushes.  Harmless here, since the
        # writes live in RAM and are thrown away (or kept by choice) anyway.
        echo "file=$overlay,format=qcow2,cache=unsafe$discard"
    else
        echo "file=$image,format=$format$discard"
    fi
}

disk_args=()
images=("$image" "${extra[@]}")
case $bus in
    scsi) disk_args+=(-device virtio-scsi-pci,id=scsi0) ;;
    # q35 has an AHCI controller of its own; the PC machine needs one added.
    sata) [[ $q35 == yes ]] || disk_args+=(-device ich9-ahci,id=ahci0) ;;
esac
for i in "${!images[@]}"; do
    # Not $(drive_opts): a subshell would lose the overlays it records.
    drive_opts "${images[$i]}" >"$tmp/drive"
    opts=$(<"$tmp/drive")
    if [[ $bus == virtio && ( -n ${serials[$i]:-} || ${#slots[@]} -gt 0 ) ]]; then
        # A virtio-blk device of its own, for the serial or the slot: added
        # in the same order, it takes the same PCI slot if=virtio would.
        dev="virtio-blk-pci,drive=disk$i"
        [[ -n ${serials[$i]:-} ]] && dev+=",serial=${serials[$i]}"
        if [[ -n ${slots[$i]:-} ]]; then
            dev+=",addr=$(printf '0x%x' "${slots[$i]}")"
            ((i == 0)) && dev+=",bootindex=0"
        fi
        disk_args+=(-drive "$opts,if=none,id=disk$i" -device "$dev")
        continue
    elif [[ $bus == virtio ]]; then
        # Exactly as every guest was installed: if=virtio keeps its PCI layout.
        disk_args+=(-drive "$opts,if=virtio")
        continue
    fi
    disk_args+=(-drive "$opts,if=none,id=disk$i")
    case $bus in
        scsi) disk_args+=(-device "scsi-hd,drive=disk$i,bus=scsi0.0") ;;
        nvme) disk_args+=(-device "nvme,drive=disk$i,serial=${serials[$i]:-backotter$i}") ;;
        # On q35, from port 2: --cdrom (a legacy IDE drive) takes port 0.
        sata) if [[ $q35 == yes ]]; then disk_args+=(-device "ide-hd,drive=disk$i,bus=ide.$((i + 2))")
              else disk_args+=(-device "ide-hd,drive=disk$i,bus=ahci0.$i"); fi ;;
    esac
done

args=(
    -enable-kvm -cpu host -smp "$cpus" -m "$memory"
    "${disk_args[@]}"
    # IPv4 only: the hosts have no IPv6 route out (a ULA prefix alone), so
    # the IPv6 address QEMU's user network would hand out leads nowhere, and
    # a guest that tries IPv6 first (NetBSD's libfetch, pkgin) stalls on it.
    -nic "user,ipv6=off,model=$nic$mac,hostfwd=tcp:127.0.0.1:${SSH_PORT:-2222}-:22"
    "${nic_global[@]}"
    "${console[@]}"
    "${vga[@]}"
    "${snapshot[@]}"
)
if [[ -n $tpm ]]; then
    mkdir -p "$tpm"
    # --terminate: swtpm exits when QEMU disconnects.
    swtpm socket --tpm2 --tpmstate "dir=$tpm" --ctrl "type=unixio,path=$tmp/swtpm.sock" \
        --terminate --daemon --pid "file=$tmp/swtpm.pid" || die "swtpm didn't start"
    swtpm_pid=$(<"$tmp/swtpm.pid")
    args+=(-chardev "socket,id=chrtpm,path=$tmp/swtpm.sock" -tpmdev emulator,id=tpm0,chardev=chrtpm
        -device tpm-tis,tpmdev=tpm0)
fi
if [[ -n $cdrom ]]; then
    args+=(-drive "file=$cdrom,media=cdrom,readonly=on" -boot order=dc)
fi
if [[ $uefi == yes ]]; then
    # A fresh copy of OVMF's variable store per run: no leftover boot entries.
    if [[ $secure_boot == yes ]]; then
        code=OVMF_CODE_4M.secboot.fd vars=OVMF_VARS_4M.ms.fd
    else
        code=OVMF_CODE_4M.fd vars=OVMF_VARS_4M.fd
    fi
    vfile=$tmp/vars.fd fresh=yes
    if [[ -n $uefi_vars ]]; then
        vfile=$uefi_vars
        if [[ -f $vfile ]]; then fresh=no; else cp "/usr/share/OVMF/$vars" "$vfile"; fi
    else
        cp "/usr/share/OVMF/$vars" "$vfile"
    fi
    # shim's MokList, as MokManager leaves it once a key is enrolled: in a
    # store made for this run only (a kept --uefi-vars store has it already).
    for i in "${!moks[@]}"; do
        [[ $fresh == yes ]] || break
        command -v virt-fw-vars >/dev/null || die "--mok needs virt-fw-vars (python3-virt-firmware)"
        pem=$tmp/mok$i.pem m=${moks[$i]}
        if [[ -f $m ]]; then
            openssl x509 -in "$m" -out "$pem" 2>/dev/null || openssl x509 -inform der -in "$m" -out "$pem" 2>/dev/null ||
                die "--mok $m: not a DER or PEM certificate"
        elif ! [[ $m =~ ^[A-Za-z0-9+/]+=*$ ]] ||
            ! { echo "-----BEGIN CERTIFICATE-----"; fold -w 64 <<<"$m"; echo "-----END CERTIFICATE-----"; } |
                openssl x509 -out "$pem" 2>/dev/null; then
            die "--mok: no such file, nor a base64 DER certificate: ${m:0:40}"
        fi
        # 605dab50-...: shim's own GUID, the owner MokManager gives the keys it enrolls.
        virt-fw-vars -l error --inplace "$vfile" --add-mok 605dab50-e046-4300-abb6-3dd810dd8b23 "$pem" >/dev/null ||
            die "--mok: virt-fw-vars could not add the key to $vfile"
    done
    # SMM, and flash only SMM may write, for Secure Boot's firmware alone:
    # OVMF_CODE_4M.fd has no SMM, so it couldn't use a secure flash at all.
    if [[ $secure_boot == yes ]]; then
        args+=(-machine q35,smm=on -global driver=cfi.pflash01,property=secure,value=on)
    else
        args+=(-machine q35)
    fi
    args+=(-drive "if=pflash,format=raw,unit=0,readonly=on,file=/usr/share/OVMF/$code"
        -drive "if=pflash,format=raw,unit=1,file=$vfile")
elif [[ $q35 == yes ]]; then
    args+=(-machine q35)
else
    args+=(-machine pc)
fi

# Not exec: the cleanup above has to run after QEMU exits.  QEMU runs in the
# background so that stopping vm-run (TERM, INT, HUP) stops QEMU too instead
# of orphaning it; <&0 keeps the terminal as its input, which a background
# command would otherwise lose.
qemu-system-x86_64 "${args[@]}" "$@" <&0 &
qemu=$! started=yes
trap 'kill -TERM "$qemu" 2>/dev/null' TERM INT HUP
status=0
wait "$qemu" || status=$?
# A trapped signal ends wait early; wait for QEMU itself to finish.
while kill -0 "$qemu" 2>/dev/null; do wait "$qemu" || status=$?; done
if [[ $keep == yes ]]; then
    for i in "${!overlays[@]}"; do
        overlay=${overlays[$i]}
        # An overlay nothing was written to (QEMU failed at once, or never
        # touched that disk) isn't worth keeping.
        if ! qemu-img map --output=json "$overlay" 2>/dev/null |
            python3 -c 'import json, sys; sys.exit(not any(e["depth"] == 0 for e in json.load(sys.stdin)))'; then
            rm -f "$overlay"
            echo "vm-run: nothing was written to ${images[$i]}; no overlay kept." >&2
            continue
        fi
        echo "vm-run: kept this run's writes to ${images[$i]} in $overlay ($(du -h "$overlay" | cut -f1))." >&2
        if in_store "${images[$i]}"; then
            # Never qemu-img commit into a store object: every version and cache copy names it.
            echo "  ${images[$i]} is a vm-store object, which is never written: boot the overlay itself to go on" >&2
            echo "  throw them away:  rm $overlay" >&2
        else
            echo "  merge them into it:  qemu-img commit $overlay && rm $overlay" >&2
            echo "  or throw them away:  rm $overlay" >&2
        fi
    done
fi
exit "$status"
